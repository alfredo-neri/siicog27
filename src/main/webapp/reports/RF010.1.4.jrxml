	<parameter name="QUERY_EGRESOS5002" class="java.lang.String"/>
	<parameter name="entidadName" class="java.lang.String"/>
	<parameter name="firmaP1" class="java.lang.String"/>
	<parameter name="firmaP2" class="java.lang.String"/>
	<parameter name="firmaP3" class="java.lang.String"/>
	<parameter name="firmaN1" class="java.lang.String"/>
	<parameter name="firmaN2" class="java.lang.String"/>
	<parameter name="firmaN3" class="java.lang.String"/>
	<parameter name="lastDayOfMonth" class="java.lang.String"/>
	<parameter name="pNoFirmas" class="java.lang.Integer"/>
	<parameter name="nameMonth" class="java.lang.String"/>
	<parameter name="tipoOrganismo" class="java.lang.String"/>
	<parameter name="municipioNo" class="java.lang.String"/>
	<query language="sql"><![CDATA[SELECT  
         F.L1,NVL(F.N1,'') AS N4,
          F.L2,NVL(F.N2,'') AS N27,
          F.L3,NVL(F.N3,'') AS N5,
    TU.NOMBRE,
    TU.ID_TIPO_USUARIO,
    F.CAMPO3,
    EPC."DESC" as DESCRIPCION,
    D.NOMDEP AS NOMMUN,
    '' as RUTA_MUN
     FROM FIRMAS F
     LEFT JOIN TC_U_REFERENCIA TCR ON F.ID_REF = TCR.ID_REF 
     LEFT JOIN CATDEP D ON  TCR.ID_DEP = D.ID
     LEFT JOIN TC_ENTE_PUB_CENTRAL EPC ON TCR.ID_ENTE_PUBLICO = EPC.ID
     LEFT JOIN TC_USUARIOS TU ON F.IDSECTOR = TU.ID_TIPO_USUARIO
    WHERE TU.USUARIO = $P{USUARIO}]]></query>
	<field name="L1" class="java.lang.String"/>
	<field name="N4" class="java.lang.String"/>
	<field name="L2" class="java.lang.String"/>
	<field name="N27" class="java.lang.String"/>
	<field name="L3" class="java.lang.String"/>
	<field name="N5" class="java.lang.String"/>
	<field name="NOMBRE" class="java.lang.String"/>
	<field name="ID_TIPO_USUARIO" class="java.lang.Long"/>
	<field name="CAMPO3" class="java.lang.Integer"/>
	<field name="DESCRIPCION" class="java.lang.String"/>
	<field name="NOMMUN" class="java.lang.String"/>
	<field name="RUTA_MUN" class="java.lang.String"/>
	<variable name="V_mes" incrementType="Report" class="java.util.List">
		<expression><![CDATA[java.util.Arrays.asList("","ENERO","FEBRERO","MARZO","ABRIL","MAYO","JUNIO","JULIO","AGOSTO","SEPTIEMBRE","OCTUBRE","NOVIEMBRE","DICIEMBRE")]]></expression>
		<initialValueExpression><![CDATA[new java.util.ArrayList()]]></initialValueExpression>
	</variable>
	<variable name="V_dia" incrementType="Report" class="java.util.List">
		<expression><![CDATA[java.util.Arrays.asList(0,31,28,31,30,31,30,31,31,30,31,30,31)]]></expression>
	</variable>
	<variable name="V_get_day" incrementType="Report" class="java.lang.Integer">
		<expression><![CDATA[($P{MES}==2)?(
($F{CAMPO3}%4==0)?
(29)
:($V{V_dia}.get($P{MES}))
):($V{V_dia}.get($P{MES}))]]></expression>
	</variable>
	<variable name="V_head_1" class="java.lang.String">
		<expression><![CDATA[($F{ID_TIPO_USUARIO}.intValue()==1)?1:2]]></expression>
	</variable>
	<variable name="V_head_vacio" class="java.lang.String"/>
	<variable name="V_edo" class="java.lang.String">
		<expression><![CDATA["ESTADO"]]></expression>
	</variable>
