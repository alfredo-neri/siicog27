		</element>
		<element kind="staticText" uuid="4612e039-7bd2-45cb-bb3d-5476cf4f8b12" x="200" y="100" width="100" height="12" stretchType="NoStretch" fontName="Arial" fontSize="9.0" hTextAlign="Right">
			<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
