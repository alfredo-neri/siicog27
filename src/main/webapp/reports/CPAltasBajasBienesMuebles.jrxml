	<queryString language="SQL">
		<![CDATA[SELECT CAMPO3, CUENTA, NOMCTA, NOMMUEBLE,MARCA, MODELO,SERIE, ESTADO, FACTURA, FECALTA, FECBAJA, OBS, COSTO, PORCENTAJE
	FROM BIENESM
WHERE 	IDSECTOR = $P{sector} AND
		(YEAR(FECALTA) = $P{year} OR
		YEAR(FECBAJA) = $P{year})]]>
	</queryString>
