	</field>
	<variable name="costoAltas" class="java.math.BigDecimal">
		<variableExpression><![CDATA[Integer.parseInt(DATEFORMAT($F{FECALTA},"yyyy")) == $P{year} ? $F{COSTO} : BigDecimal.ZERO]]></variableExpression>
	</variable>
	<variable name="aniosDiferencia" class="java.lang.Integer">
		<variableExpression><![CDATA[YEAR($F{FECBAJA}) - YEAR($F{FECALTA})]]></variableExpression>
	</variable>
	<variable name="preDepreciacion" class="java.math.BigDecimal">
		<variableExpression><![CDATA[$F{COSTO}.multiply($F{PORCENTAJE}).multiply(new BigDecimal($V{aniosDiferencia}))]]></variableExpression>
	</variable>
	<variable name="depreciacion" class="java.math.BigDecimal">
		<variableExpression><![CDATA[$F{COSTO}.subtract($V{preDepreciacion})]]></variableExpression>
	</variable>
	<variable name="costoBajas" class="java.math.BigDecimal">
		<variableExpression><![CDATA[$V{depreciacion}.compareTo( BigDecimal.ZERO ) <= 0 ? BigDecimal.ZERO : $V{depreciacion}]]></variableExpression>
	</variable>
	<variable name="fechaMovimiento" class="java.sql.Date">
		<variableExpression><![CDATA[(DATEFORMAT($F{FECBAJA}, "dd/MM/yyyy") == null ) ? $F{FECALTA}  :  $F{FECBAJA}]]></variableExpression>
	</variable>
	<variable name="sumAltas" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$V{costoAltas}]]></variableExpression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="sumBajas" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$V{costoBajas}]]></variableExpression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
