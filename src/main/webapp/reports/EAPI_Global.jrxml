	<variable name="V_PorEjec" class="java.math.BigDecimal">
		<expression><![CDATA[$V{V_Modificado}.subtract($V{V_Recaudado})]]></expression>
	</variable>
	<variable name="V_Total_Estimada" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[($F{DI_SCTA}.equals("")?$F{DI_SALINI}:BigDecimal.ZERO)]]></expression>
	</variable>
	<variable name="V_Total_Ampliacion" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[($F{DI_SCTA}.equals("")?$V{V_Ampliacion}:BigDecimal.ZERO)]]></expression>
	</variable>
	<variable name="V_Total_Reduccion" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[($F{DI_SCTA}.equals("")?$V{V_Reduccion}:BigDecimal.ZERO)]]></expression>
	</variable>
	<variable name="V_Total_Recaudado" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[($F{DI_SCTA}.equals("")?$V{V_Recaudado}:BigDecimal.ZERO)]]></expression>
	</variable>
	<variable name="V_Total_Modificado" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[($F{DI_SCTA}.equals("")?$V{V_Modificado}:BigDecimal.ZERO)]]></expression>
	</variable>
	<variable name="V_Total_Ejecutar" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[($F{DI_SCTA}.equals("")?$V{V_PorEjec}:BigDecimal.ZERO)]]></expression>
	</variable>
	<variable name="v_mes" class="java.util.List">
		<expression><![CDATA[java.util.Arrays.asList("","ENERO","FEBRERO","MARZO","ABRIL","MAYO","JUNIO","JULIO","AGOSTO","SEPTIEMBRE","OCTUBRE","NOVIEMBRE","DICIEMBRE")]]></expression>
	</variable>
	<variable name="v_dias" class="java.util.List">
		<expression><![CDATA[java.util.Arrays.asList(0,31,28,31,30,31,30,31,31,30,31,30,31)]]></expression>
	</variable>
	<variable name="Get_day" class="java.lang.Integer">
		<expression><![CDATA[($P{mes}==2)?(
								(($P{year}%4)==0)?(29):($V{v_dias}.get($P{mes}))
				):($V{v_dias}.get($P{mes})
)]]></expression>
	</variable>
