	<query language="sql"><![CDATA[SELECT 
DI.CUENTA DI_CUENTA, 
SUBSTR(DI.SCTA,7) DI_SCTA, 
SUBSTR(DI.SSCTA,14) DI_SSCTA,
SUBSTR(DI.SSSCTA,3) DI_SSSCTA,
SUBSTR(DI.SSSSCTA,2) DI_SSSSCTA,
SUBSTR(DI.NOMCTA,1,100) DI_NOMCTA, 
DI.SALINI DI_SALINI,
DI.CARGOS_1 DI_CARGO_1, 
DI.CARGOS_2 DI_CARGO_2, 
DI.CARGOS_3 DI_CARGO_3, 
DI.CARGOS_4 DI_CARGO_4, 
DI.CARGOS_5 DI_CARGO_5, 
DI.CARGOS_6 DI_CARGO_6, 
DI.CARGOS_7 DI_CARGO_7, 
DI.CARGOS_8 DI_CARGO_8, 
DI.CARGOS_9 DI_CARGO_9, 
DI.CARGOS_10 DI_CARGO_10, 
DI.CARGOS_11 DI_CARGO_11, 
DI.CARGOS_12 DI_CARGO_12, 
DI.ABONOS_1 DI_ABONO_1, 
DI.ABONOS_2 DI_ABONO_2, 
DI.ABONOS_3 DI_ABONO_3, 
DI.ABONOS_4 DI_ABONO_4, 
DI.ABONOS_5 DI_ABONO_5, 
DI.ABONOS_6 DI_ABONO_6, 
DI.ABONOS_7 DI_ABONO_7, 
DI.ABONOS_8 DI_ABONO_8, 
DI.ABONOS_9 DI_ABONO_9, 
DI.ABONOS_10 DI_ABONO_10, 
DI.ABONOS_11 DI_ABONO_11, 
DI.ABONOS_12 DI_ABONO_12,
CI.SALINI CI_SALINI,
CI.CARGOS_1 CI_CARGO_1, 
CI.CARGOS_2 CI_CARGO_2, 
CI.CARGOS_3 CI_CARGO_3, 
CI.CARGOS_4 CI_CARGO_4, 
CI.CARGOS_5 CI_CARGO_5, 
CI.CARGOS_6 CI_CARGO_6, 
CI.CARGOS_7 CI_CARGO_7, 
CI.CARGOS_8 CI_CARGO_8, 
CI.CARGOS_9 CI_CARGO_9, 
CI.CARGOS_10 CI_CARGO_10, 
CI.CARGOS_11 CI_CARGO_11, 
CI.CARGOS_12 CI_CARGO_12, 
CI.ABONOS_1 CI_ABONO_1, 
CI.ABONOS_2 CI_ABONO_2, 
CI.ABONOS_3 CI_ABONO_3, 
CI.ABONOS_4 CI_ABONO_4, 
CI.ABONOS_5 CI_ABONO_5, 
CI.ABONOS_6 CI_ABONO_6, 
CI.ABONOS_7 CI_ABONO_7, 
CI.ABONOS_8 CI_ABONO_8, 
CI.ABONOS_9 CI_ABONO_9, 
CI.ABONOS_10 CI_ABONO_10, 
CI.ABONOS_11 CI_ABONO_11, 
CI.ABONOS_12 CI_ABONO_12
FROM 
CUENTA AS DI
INNER JOIN CUENTA AS CI ON CI.CUENTA='8150' AND CI.SCTA=DI.SCTA AND CI.SSCTA=DI.SSCTA AND CI.SSSCTA=DI.SSSCTA AND CI.SSSSCTA=DI.SSSSCTA AND CI.IDSECTOR = DI.IDSECTOR
WHERE (DI.CUENTA='8110') AND DI.NOTCTA=0 AND DI.SSCTA='' AND DI.IDSECTOR= $P{idSector} 
ORDER BY DI.CUENTA,DI.SCTA, DI.SSCTA, DI.SSSCTA, DI.SSSSCTA]]></query>
