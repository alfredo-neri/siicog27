	<parameter name="firmaN1" class="java.lang.String"/>
	<parameter name="firmaL2" class="java.lang.String"/>
	<parameter name="firmaN2" class="java.lang.String"/>
	<parameter name="firmaL3" class="java.lang.String"/>
	<parameter name="firmaN3" class="java.lang.String"/>
	<parameter name="firmaL4" class="java.lang.String"/>
	<parameter name="firmaN4" class="java.lang.String"/>
	<parameter name="firmaL5" class="java.lang.String"/>
	<parameter name="firmaN5" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT	SUBSTR (P.CLAVE,1,3)DEPG, SUBSTR (P.CLAVE,4,3)DEPA, SUBSTR (P.PROGRAMA,1,2)FN,
		SUBSTR (P.PROGRAMA,3,2)FUN, SUBSTR (P.PROGRAMA,5,2)SFUN, SUBSTR (P.PROGRAMA,7,2)PROG,
		SUBSTR (P.PROGRAMA,9,2)SPROG, SUBSTR (P.PROGRAMA,11,2)PROY, SUM(P.AUTORIZADO_13)SUMA,
		CAT.NOMBRE NOMDG, DAA.NOMBRE NOMDA, M1.CAMPO6 NFN, M2.CAMPO6 NFUN, 
		M3.CAMPO6 NSFUN, M4.CAMPO6 NPROG, M5.CAMPO6 NSPROG, M6.CAMPO6 NPROY,
		SUBSTR(P.CLAVE,1,6)||SUBSTR(P.PROGRAMA,1,10) GRUPO		 
	FROM TW_ANTEPROYECTO P
		LEFT JOIN CATDGM CAT ON SUBSTR(P.CLAVE,1,3)= CAT.CLAVE
		LEFT JOIN CATDAA DAA ON SUBSTR(P.CLAVE,4,3) = DAA.CLAVE
		LEFT JOIN MUNINEP M1 ON  SUBSTR (P.PROGRAMA,1,2)= M1.CAMPO7 AND P.IDSECTOR = M1.IDSECTOR
		LEFT JOIN MUNINEP M2 ON  SUBSTR (P.PROGRAMA,1,4)= M2.CAMPO7 AND P.IDSECTOR = M2.IDSECTOR
		LEFT JOIN MUNINEP M3 ON  SUBSTR (P.PROGRAMA,1,6)= M3.CAMPO7 AND P.IDSECTOR = M3.IDSECTOR
		LEFT JOIN MUNINEP M4 ON  SUBSTR (P.PROGRAMA,1,8)= M4.CAMPO7 AND P.IDSECTOR = M4.IDSECTOR
		LEFT JOIN MUNINEP M5 ON  SUBSTR (P.PROGRAMA,1,10)= M5.CAMPO7 AND P.IDSECTOR = M5.IDSECTOR
		LEFT JOIN MUNINEP M6 ON  SUBSTR (P.PROGRAMA,1,12)= M6.CAMPO7 AND P.IDSECTOR = M6.IDSECTOR
WHERE 	P.IDSECTOR = $P{sector}
	AND SUBSTR(P.PARTIDA,2,3)='000'
GROUP BY 	SUBSTR (P.CLAVE,1,3), 	SUBSTR (P.CLAVE,4,3),
			SUBSTR (P.PROGRAMA,1,2),SUBSTR (P.PROGRAMA,3,2),
			SUBSTR (P.PROGRAMA,5,2),SUBSTR (P.PROGRAMA,7,2),
			SUBSTR (P.PROGRAMA,9,2),SUBSTR (P.PROGRAMA,11,2),
			CAT.NOMBRE,	DAA.NOMBRE, M1.CAMPO6, M2.CAMPO6,
			M3.CAMPO6,	M4.CAMPO6,	M5.CAMPO6, M6.CAMPO6,
			SUBSTR(P.CLAVE,1,6)||SUBSTR(P.PROGRAMA,1,10)
ORDER BY SUBSTR(P.CLAVE,1,3)]]>
	</queryString>
