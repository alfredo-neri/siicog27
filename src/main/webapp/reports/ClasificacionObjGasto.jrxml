				<textElement>
					<font fontName="Arial" size="10" isBold="true"/>
					<paragraph leftIndent="3" spacingBefore="1"/>
				</textElement>
				<textFieldExpression><![CDATA["III. Total de Egresos (III = I + II)"]]></textFieldExpression>
			</textField>
		</band>
	</summary>
</jasperReport>
