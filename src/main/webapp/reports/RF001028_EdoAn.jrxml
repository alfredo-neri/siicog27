					</datasetRun>
					<column kind="single" uuid="da18847d-52ee-4f2c-bfe4-ce32bdd39c7a" width="302">
						<property name="com.jaspersoft.studio.components.table.model.column.name" value="Column1"/>
						<property name="com.jaspersoft.studio.unit.width" value="px"/>
						<columnHeader height="30" rowSpan="1" style="Table_CH">
							<element kind="staticText" uuid="5403d959-b9e3-43d1-96da-88c39fda2a6d" x="0" y="0" width="302" height="30" stretchType="NoStretch" fontName="Arial" fontSize="8.0" hTextAlign="Center" vTextAlign="Middle"
								><text><![CDATA[Estado Analítico de Ingresos por Fuente de Financiamiento]]></text>
							</element>
						</columnHeader>
						<groupHeader groupName="GroupFirst">
							<cell height="15" rowSpan="1" style="Table_TD">
								<property name="com.jaspersoft.studio.unit.height" value="px"/>
								<element kind="textField" uuid="39032db5-425f-4624-a8c5-c2c33fc68cdf" x="0" y="0" width="302" height="15" stretchType="ElementGroupHeight" fontName="Arial" fontSize="8.0" textAdjust="StretchHeight" bold="true" vTextAlign="Middle">
									<property name="com.jaspersoft.studio.unit.leftIndent" value="px"/>
									<paragraph leftIndent="2"/>
									<expression><![CDATA[$F{GRUPO} == 1 ? "Ingresos del Poder Ejecutivo Federal o Estatal y de los Municipios" : $F{GRUPO} == 2 ? "Ingresos de los Entes Públicos de los Poderes Legislativo y Judicial, de los Órganos Autónomos y del Sector Paraestatal o Paramunicipal, así como de las Empresas Productivas del Estado" : $F{GRUPO} == 3 ? "Ingresos Derivados de Financiamientos":""]]></expression>
								</element>
							</cell>
						</groupHeader>
						<columnFooter height="15" rowSpan="1" style="Table_TD">
							<property name="com.jaspersoft.studio.unit.height" value="px"/>
							<element kind="staticText" uuid="a401b537-2fad-426d-8795-e6edd5e96b92" x="0" y="0" width="302" height="15" stretchType="NoStretch" fontName="Arial" fontSize="8.0" hTextAlign="Center" vTextAlign="Middle"
								><text><![CDATA[Total]]></text>
							</element>
						</columnFooter>
						<detailCell height="15" style="Table_TD">
							<property name="com.jaspersoft.studio.unit.height" value="px"/>
							<element kind="textField" uuid="a0c1bba3-8415-4fe3-8ad5-c9469a702eab" x="0" y="0" width="302" height="15" stretchType="ElementGroupHeight" fontName="Arial" fontSize="8.0" textAdjust="StretchHeight" hTextAlign="Left" vTextAlign="Middle">
								<property name="com.jaspersoft.studio.unit.leftIndent" value="px"/>
								<paragraph leftIndent="12"/>
								<expression><![CDATA[$F{CLAVE} == 1 ? "Impuestos" : $F{CLAVE} == 2 ? "Cuotas y Aportaciones de Seguridad Social" : $F{CLAVE} == 3 ? "Contribuciones de Mejoras" : $F{CLAVE} == 4 ? "Derechos"  : $F{CLAVE} == 5 ? "Productos"  : $F{CLAVE} == 6 ? "Aprovechamientos" : $F{CLAVE} == 7 ? "Ingresos por Ventas de Bienes, Prestación de Servicios y Otros Ingresos" : $F{CLAVE} == 8 ? "Participaciones, Aportaciones, Convenios, Incentivos Derivados de la Colaboración Fiscal y Fondos Distintos de Aportaciones" : $F{CLAVE} == 9 ? "Transferencias, Asignaciones, Subsidios y Subvenciones, Pensiones y Jubilaciones" : $F{CLAVE} == 10 ? "Ingresos Derivados de Financiamientos" : ""]]></expression>
							</element>
						</detailCell>
					</column>
