	<dataset name="declaracioines" uuid="db8ac6ee-60e9-4978-9dd1-03a617295b37">
		<query language="sql"><![CDATA[]]></query>
	</dataset>
	<parameter name="idContrato" class="java.lang.Long"/>
	<query language="SQL"><![CDATA[SELECT AA.DESCRIPCION, AA.DESCRIPCION_TECNICA, AA.UNIDAD_MEDIDA, AA.CANTIDAD, AC.PRECIO, AC.IVA, AC.TOTAL FROM TC_ARTICULOS_CONTRATOS AC
		INNER JOIN TC_ARTICULOS_ADQUISICIONES AA ON AC.ID_ARTICULO = AA.ID 
WHERE AC.ID_CONTRATO =  $P{idContrato}]]></query>
	<field name="DESCRIPCION" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="DESCRIPCION"/>
		<property name="com.jaspersoft.studio.field.label" value="DESCRIPCION"/>
