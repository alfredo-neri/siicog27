		<property name="com.jaspersoft.studio.field.tree.path" value="TC_ARTICULOS_CONTRATOS"/>
	</field>
	<variable name="consecutivo" incrementType="Column" class="java.lang.Integer">
		<expression><![CDATA[$V{consecutivo} +1]]></expression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
	<variable name="total" class="java.math.BigDecimal">
		<expression><![CDATA[$F{PRECIO}.multiply(new BigDecimal($F{CANTIDAD}))]]></expression>
	</variable>
	<variable name="ivaByRow" class="java.math.BigDecimal">
		<expression><![CDATA[$V{total}.multiply($F{IVA}).divide(new BigDecimal(100))]]></expression>
	</variable>
	<variable name="totalAdjudicado" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$V{total}]]></expression>
	</variable>
	<variable name="iva" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$V{ivaByRow}]]></expression>
	</variable>
	<variable name="granTotal" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{TOTAL}]]></expression>
	</variable>
