			<element kind="staticText" uuid="46bcdd6d-f029-4225-92d6-fc4934abab94" x="464" y="22" width="396" height="78" stretchType="NoStretch" fontName="Arial" fontSize="15.0" hTextAlign="Left" vTextAlign="Middle">
				<box padding="2">
					<topPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<text><![CDATA[Adjuntar a este formato la documentación que avale la experiencia para ocupar el puesto (Por ejemplo. Nombramientos en Administraciones Municipales anteriores).]]></text>
			</element>
			<element kind="staticText" uuid="ec379a10-4d1a-4f79-a725-757eb16fb03d" x="0" y="100" width="324" height="80" stretchType="NoStretch" fontName="Arial" fontSize="15.0" hTextAlign="Center" vTextAlign="Middle">
				<box padding="2">
					<topPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<text><![CDATA[Certificación en competencia Laboral expedida por el Instituto Hacendario del Estado de México]]></text>
			</element>
			<element kind="textField" uuid="efe20911-42c7-4263-8656-19e10009140e" x="324" y="100" width="70" height="80" stretchType="NoStretch" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle">
				<box>
					<topPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<expression><![CDATA[$F{CERTIFICACION}.equals( "1" )? "X":""]]></expression>
			</element>
			<element kind="textField" uuid="a5943b48-8b71-432b-a757-552213516d38" x="394" y="100" width="70" height="80" stretchType="NoStretch" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle">
				<box>
