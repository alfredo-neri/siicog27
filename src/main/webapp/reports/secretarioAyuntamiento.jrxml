					<leftPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<expression><![CDATA[$F{CERTIFICACION}.equals( "0" )? "X":""]]></expression>
			</element>
			<element kind="staticText" uuid="bb4a19f5-6659-4be3-a38c-d8cd74f7b4c4" x="464" y="100" width="396" height="80" stretchType="NoStretch" fontName="Arial" fontSize="15.0" hTextAlign="Left" vTextAlign="Middle">
				<box padding="2">
					<topPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<text><![CDATA[Remitir fotocopia legible de la misma. Cabe señalar que, de conformidad con el articulo T del Reglamento de COCERTEM, la vigencia de la certificación en competencia laboral  es de 3 años.]]></text>
			</element>
