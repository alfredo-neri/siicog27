			</element>
			<element kind="textField" uuid="cfd44df1-3f08-433c-b84b-60e458c5b5d1" x="394" y="0" width="70" height="22" stretchType="NoStretch" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle">
