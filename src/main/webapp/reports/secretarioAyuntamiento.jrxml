			</element>
			<element kind="textField" uuid="585434ec-12af-404c-887e-83f85803fc43" x="394" y="22" width="70" height="78" stretchType="NoStretch" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle">
				<box>
					<topPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
