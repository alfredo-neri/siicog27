	<parameter name="firmaN5" class="java.lang.String"/>
	<query language="sql"><![CDATA[SELECT	SUBSTR(PA.PROGRAMA,1,2) FIN, SUBSTR(PA.PROGRAMA,3,2) FUN, SUBSTR(PA.PROGRAMA,5,2) SF, SUBSTR(PA.PROGRAMA,7,2) PG,
		SUBSTR(PA.PROGRAMA,9,2) SP, SUBSTR(PA.PROGRAMA,11,2) PY, SUBSTR(PA.PROGRAMA,13,2) FF, PA.PARTIDA,
		PA.AUTO1_1, PA.AUTO1_2, PA.AUTO1_3, PA.AUTO1_4, PA.AUTO1_5, PA.AUTO1_6, PA.AUTO1_7, PA.AUTO1_8, PA.AUTO1_9, PA.AUTO1_10, PA.AUTO1_11, PA.AUTO1_12, PA.PROGRAMA,
		(PA.AUTO1_1 + PA.AUTO1_2 + PA.AUTO1_3 + PA.AUTO1_4 + PA.AUTO1_5 + PA.AUTO1_6 + PA.AUTO1_7 + PA.AUTO1_8 + PA.AUTO1_9 + PA.AUTO1_10 + PA.AUTO1_11 + PA.AUTO1_12) AUTO13,
		NA.NOMGAS, CD.NOMBRE, FF.CLVFTE
	FROM PASO AS PA,
		 NATGAS AS NA,
		 FUENTEF AS FF,
		 CATDGM AS CD
WHERE	PA.IDSECTOR = NA.IDSECTOR
	AND PA.IDSECTOR = FF.IDSECTOR
	AND PA.PARTIDA = NA.CLVGAS
	AND SUBSTR(PA.PROGRAMA,13,3) = FF.LIGA
	AND SUBSTR(PA.CLAVE,1,3) = CD.CLAVE
	AND PA.IDSECTOR=$P{idSector}
	AND PA.PARTIDA IN ('6159','6139')
ORDER BY PA.PROGRAMA, PA.PARTIDA]]></query>
