	<query language="sql"><![CDATA[SELECT 	PAS.PARTIDA, NAT.NOMGAS, SUM(PAS.AUTORIZADO_1) AUTO1_1,
		SUM(PAS.AUTORIZADO_2) AUTO1_2, SUM(PAS.AUTORIZADO_3) AUTO1_3, SUM(PAS.AUTORIZADO_4) AUTO1_4,
		SUM(PAS.AUTORIZADO_5) AUTO1_5, SUM(PAS.AUTORIZADO_6) AUTO1_6, SUM(PAS.AUTORIZADO_7) AUTO1_7,
		SUM(PAS.AUTORIZADO_8) AUTO1_8, SUM(PAS.AUTORIZADO_9) AUTO1_9, SUM(PAS.AUTORIZADO_10) AUTO1_10,
		SUM(PAS.AUTORIZADO_11) AUTO1_11, SUM(PAS.AUTORIZADO_12) AUTO1_12, SUM(PAS.AUTORIZADO_13) AUTO1_13
	FROM TW_ANTEPROYECTO PAS 
		LEFT JOIN NATGAS NAT ON PAS.PARTIDA = NAT.CLVGAS AND PAS.IDSECTOR=NAT.IDSECTOR 
WHERE PAS.IDSECTOR= $P{sector}
GROUP BY PAS.PARTIDA, NAT.NOMGAS
ORDER BY PAS.PARTIDA]]></query>
