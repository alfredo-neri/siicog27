	<parameter name="firmaN5" class="java.lang.String"/>
	<query language="SQL"><![CDATA[SELECT CAMPO3, CUENTA, NOMCTA, NOMMUEBLE, 
				UBICACION, REGISTRO, CVECATAS, ESCRITURA, 
				MODADQUI, VALORINM, FECALTA, FECBAJA, 
				OBS, PORCENTAJE
	FROM BIENESINM
WHERE 	IDSECTOR = $P{sector} AND
		(YEAR(FECALTA) = $P{year} OR
		YEAR(FECBAJA) = $P{year})]]></query>
	<field name="CAMPO3" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="CAMPO3"/>
		<property name="com.jaspersoft.studio.field.label" value="CAMPO3"/>
