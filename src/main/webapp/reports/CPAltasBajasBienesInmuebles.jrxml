	</field>
	<field name="VALORINM" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="VALORINM"/>
		<property name="com.jaspersoft.studio.field.label" value="VALORINM"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="BIENESINM"/>
	</field>
	<field name="FECALTA" class="java.sql.Date">
		<property name="com.jaspersoft.studio.field.name" value="FECALTA"/>
		<property name="com.jaspersoft.studio.field.label" value="FECALTA"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="BIENESINM"/>
	</field>
	<field name="FECBAJA" class="java.sql.Date">
		<property name="com.jaspersoft.studio.field.name" value="FECBAJA"/>
		<property name="com.jaspersoft.studio.field.label" value="FECBAJA"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="BIENESINM"/>
	</field>
	<field name="OBS" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="OBS"/>
		<property name="com.jaspersoft.studio.field.label" value="OBS"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="BIENESINM"/>
	</field>
	<field name="PORCENTAJE" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="PORCENTAJE"/>
		<property name="com.jaspersoft.studio.field.label" value="PORCENTAJE"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="BIENESINM"/>
	</field>
	<variable name="costoAltas" class="java.math.BigDecimal">
		<expression><![CDATA[Integer.parseInt(DATEFORMAT($F{FECALTA},"yyyy")) == $P{year} ?$F{VALORINM} : BigDecimal.ZERO]]></expression>
	</variable>
	<variable name="aniosDiferencia" class="java.lang.Integer">
		<expression><![CDATA[YEAR($F{FECBAJA}) - YEAR($F{FECALTA})]]></expression>
	</variable>
	<variable name="preDepreciacion" class="java.math.BigDecimal">
		<expression><![CDATA[$F{VALORINM}.multiply($F{PORCENTAJE}).multiply(new BigDecimal($V{aniosDiferencia}))]]></expression>
	</variable>
	<variable name="depreciacion" class="java.math.BigDecimal">
		<expression><![CDATA[$F{VALORINM}.subtract($V{preDepreciacion})]]></expression>
	</variable>
	<variable name="costoBajas" class="java.math.BigDecimal">
		<expression><![CDATA[$V{depreciacion}.compareTo( BigDecimal.ZERO ) <= 0 ? BigDecimal.ZERO : $V{depreciacion}]]></expression>
	</variable>
	<variable name="fechaMovimiento" class="java.sql.Date">
		<expression><![CDATA[(DATEFORMAT($F{FECBAJA}, "dd/MM/yyyy") == null ) ? $F{FECALTA}  :  $F{FECBAJA}]]></expression>
	</variable>
	<variable name="sumAltas" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$V{costoAltas}]]></expression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="sumBajas" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$V{costoBajas}]]></expression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
