		<element kind="staticText" uuid="6f209d51-30a4-49dd-aa6a-7aac34d205df" x="0" y="5" width="752" height="15" stretchType="NoStretch" fontName="Arial" fontSize="10.0" bold="true" italic="true" hTextAlign="Left" vTextAlign="Middle">
			<property name="com.jaspersoft.studio.unit.width" value="px"/>
			<property name="com.jaspersoft.studio.unit.height" value="px"/>
			<text><![CDATA["Bajo protesta de decir verdad declaramos que los estados financieros y sus notas, son razonablemente correctos y son responsabilidad del emisor".]]></text>
		</element>
		<element kind="textField" uuid="c0531300-7400-4de4-af82-e16d5a3ab21c" x="607" y="30" width="145" height="30" stretchType="NoStretch" fontName="Arial" fontSize="8.0" evaluationTime="Report" bold="false" blankWhenNull="true" hTextAlign="Center">
