	<variable name="ejercido" class="java.math.BigDecimal">
		<expression><![CDATA[$F{COMPROMETIDO}.add($F{DEVENGADO}).add($F{PAGADO})]]></expression>
	</variable>
	<variable name="porEjercer" class="java.math.BigDecimal">
		<expression><![CDATA[$F{MODIFICADO}.subtract($V{ejercido})]]></expression>
	</variable>
	<variable name="totAprobado" calculation="Sum" class="java.math.BigDecimal">
