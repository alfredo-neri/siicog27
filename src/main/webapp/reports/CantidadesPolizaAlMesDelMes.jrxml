	<parameter name="P_DelMes_OR_AlMes" class="java.lang.String"
		><description><![CDATA[]]></description>
		<defaultValueExpression><![CDATA["D"]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[SELECT 
 CATFLU.*
, POLIDE.*
, POLIEN.*
, POLIFL.ANOPOL || POLIFL.MESPOL || DAY(POLIDE.FECPOL) GRUPO
,NVL(POLIFL.CANFLU, 0) CANFLU
FROM CATFLU
LEFT JOIN POLIFL ON CATFLU.CLVFLU = POLIFL.CLVFLU
AND CATFLU.IDSECTOR = POLIFL.IDSECTOR
LEFT JOIN POLIDE ON POLIFL.TIPPOL = POLIDE.TIPPOL
AND POLIFL.MESPOL = POLIDE.MESPOL
AND POLIFL.ANOPOL = POLIDE.ANOPOL
AND POLIFL.RENPOL = POLIDE.RENPOL
AND POLIFL.IDSECTOR = POLIDE.IDSECTOR
AND POLIFL.CONPOL = POLIDE.CONPOL
LEFT JOIN POLIEN ON POLIFL.CONPOL = POLIEN.CONPOL
AND POLIFL.TIPPOL = POLIEN.TIPPOL
AND POLIFL.MESPOL = POLIEN.MESPOL
AND POLIFL.ANOPOL = POLIEN.ANOPOL
AND POLIFL.IDSECTOR = POLIEN.IDSECTOR

WHERE CATFLU.IDSECTOR = $P{P_SECTOR} 
AND (POLIFL.MESPOL IS NULL OR ($P{P_DelMes_OR_AlMes} = 'D' AND POLIFL.MESPOL = $P{P_MES} ) 
	OR ($P{P_DelMes_OR_AlMes} = 'A' AND POLIFL.MESPOL <= $P{P_MES} ) 
)

AND CATFLU.CLVFLU = $P{P_CLVFLU} 
AND (POLIFL.ANOPOL IS NULL OR POLIFL.ANOPOL = $P{P_CAMPO3})
ORDER BY POLIFL.ANOPOL || POLIFL.MESPOL || DAY(POLIDE.FECPOL)]]></query>
