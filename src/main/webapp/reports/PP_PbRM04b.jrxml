	<query language="sql"><![CDATA[SELECT 	SUBSTR(P.CLAVE,1,3) DEP, P.PARTIDA, N.NOMGAS, C.NOMBRE NOMDEPGEN, 
		SUM(P.AUTORIZADO_1) ENERO, SUM(P.AUTORIZADO_2) FEBRERO, SUM(P.AUTORIZADO_3) MARZO, 
		SUM(P.AUTORIZADO_4) ABRIL, SUM(P.AUTORIZADO_5) MAYO, SUM(P.AUTORIZADO_6) JUNIO, 
		SUM(P.AUTORIZADO_7) JULIO, SUM(P.AUTORIZADO_8) AGOSTO, SUM(P.AUTORIZADO_9) SEPTIEMBRE, 
		SUM(P.AUTORIZADO_10) OCTUBRE, SUM(P.AUTORIZADO_11) NOVIEMBRE, SUM(P.AUTORIZADO_12) DICIEMBRE, 
		SUM(P.AUTORIZADO_13) TOTAL
	FROM TW_ANTEPROYECTO P 
 		LEFT JOIN NATGAS N ON N.CLVGAS= P.PARTIDA AND N.IDSECTOR = P.IDSECTOR
	 	LEFT JOIN CATDGM C ON C.CLAVE = SUBSTR(P.CLAVE,1,3)
WHERE P.IDSECTOR= $P{sector}
GROUP BY SUBSTR(P.CLAVE,1,3), P.PARTIDA, N.NOMGAS, C.NOMBRE
ORDER BY SUBSTR(P.CLAVE,1,3), P.PARTIDA]]></query>
