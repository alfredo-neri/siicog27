	<parameter name="mes" class="java.lang.Integer"/>
	<parameter name="year" class="java.lang.Integer"/>
	<parameter name="mesName" class="java.lang.String"/>
	<parameter name="lastDayOfMonth" class="java.lang.Integer"/>
	<parameter name="pathImage1" class="java.lang.String"/>
	<parameter name="pathImage2" class="java.lang.String"/>
	<parameter name="municipioName" class="java.lang.String"/>
	<parameter name="municipioNo" class="java.lang.String"
		><description><![CDATA[]]></description>
	</parameter>
	<parameter name="idSector" class="java.lang.Integer"/>
	<parameter name="tipoOrganismo" class="java.lang.String"/>
	<parameter name="noFirmas" class="java.lang.Integer"/>
	<parameter name="firmaL1" class="java.lang.String"/>
	<parameter name="firmaN1" class="java.lang.String"/>
	<parameter name="firmaL2" class="java.lang.String"/>
	<parameter name="firmaN2" class="java.lang.String"/>
	<parameter name="firmaL3" class="java.lang.String"/>
	<parameter name="firmaN3" class="java.lang.String"/>
	<parameter name="firmaL4" class="java.lang.String"/>
	<parameter name="firmaN4" class="java.lang.String"/>
	<parameter name="firmaL5" class="java.lang.String"/>
	<parameter name="firmaN5" class="java.lang.String"/>
	<query language="sql"><![CDATA[SELECT	NCONFIANZA, 
				NSINDICALIZADOS, 
				NEVENTUAL, 
				NVL(DIETAS, 0) DIETAS,
				NVL(SBASE, 0) SBASE,
				NVL(SBASEEVEN, 0) SBASEEVEN,
				NVL(COMPENSACION, 0) COMPENSACION,
				NVL(GRATIFICACION, 0) GRATIFICACION,
				NVL(OPERCEPCIONES,0) OPERCEPCIONES,
				NVL(AGUINALDO, 0) AGUINALDO,
				NVL(AGUINALDOEVEN, 0) AGUINALDOEVEN,
				NVL(PV,0) PV, 
				NOMPUESTO, 
				NIVEL 
FROM TSUELDOS
WHERE SECTORID=$P{idSector}
	AND MONTH(FECCAP) <= $P{mes}
ORDER BY CVEPUESTO]]></query>
	<field name="NCONFIANZA" class="java.lang.Integer"/>
	<field name="NSINDICALIZADOS" class="java.lang.Integer"/>
	<field name="NEVENTUAL" class="java.lang.Integer"/>
	<field name="DIETAS" class="java.math.BigDecimal"/>
	<field name="SBASE" class="java.math.BigDecimal"/>
	<field name="COMPENSACION" class="java.math.BigDecimal"/>
	<field name="GRATIFICACION" class="java.math.BigDecimal"/>
	<field name="OPERCEPCIONES" class="java.math.BigDecimal"/>
	<field name="AGUINALDO" class="java.math.BigDecimal"/>
	<field name="PV" class="java.math.BigDecimal"/>
	<field name="NOMPUESTO" class="java.lang.String"/>
	<field name="NIVEL" class="java.lang.String"/>
	<field name="SBASEEVEN" class="java.math.BigDecimal"/>
	<field name="AGUINALDOEVEN" class="java.math.BigDecimal"/>
	<variable name="plazas" class="java.lang.Integer">
		<expression><![CDATA[$F{NCONFIANZA} + $F{NSINDICALIZADOS} + $F{NEVENTUAL}]]></expression>
	</variable>
	<variable name="total" class="java.math.BigDecimal">
		<expression><![CDATA[$F{DIETAS}.add($F{SBASE}).add($F{COMPENSACION}).add($F{GRATIFICACION}).add($F{OPERCEPCIONES}).add($F{AGUINALDO}).add($F{PV})]]></expression>
	</variable>
