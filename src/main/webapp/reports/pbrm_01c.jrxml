	<variable name="varAbs" class="java.lang.Double">
		<expression><![CDATA[$F{CAN_METI}.doubleValue() -  $F{CAN_METIA}.doubleValue()]]></expression>
	</variable>
	<variable name="varPor" class="java.lang.Double">
		<expression><![CDATA[($F{CAN_METI}.doubleValue() == 0.00 ) ? 0.00 : (($V{varAbs}  / $F{CAN_METI}.doubleValue()) * 100.00)]]></expression>
	</variable>
