	</parameter>
	<parameter name="noFirmas" class="java.lang.Integer"/>
	<parameter name="firmaL1" class="java.lang.String"/>
	<parameter name="firmaN1" class="java.lang.String"/>
	<parameter name="firmaL2" class="java.lang.String"/>
	<parameter name="firmaN2" class="java.lang.String"/>
	<parameter name="firmaL3" class="java.lang.String"/>
	<parameter name="firmaN3" class="java.lang.String"/>
	<parameter name="firmaL4" class="java.lang.String"/>
	<parameter name="firmaN4" class="java.lang.String"/>
	<parameter name="firmaL5" class="java.lang.String"/>
	<parameter name="firmaN5" class="java.lang.String"/>
	<query language="sql"><![CDATA[SELECT	MET.CLVDEP||MET.CLVNEP||MET.CLVFUEN GRUPO,
		SUBSTR(MET.CLVNEP,11,2) TPROY,
  		MET.ANIO_CAP,
		MET.NUM_VER, 
		MET.CLVDEP, 
		MET.CLVMET, 
		MET.NOM_IND, 
		MET.UNI_MED, 
		MET.CAN_METIA, 
		MET.CAN_METI,  
		MET.CLVNEP,
		MET.PROGANTE,
		DEP.NOMDEP,
		DEP.TITULAR,
		DEP.ELABORO,
		DEP.CARGO_T,
		DEP.CARGO_E,
		MU1.CAMPO6  FN,
		MU2.CAMPO6  FUN,
		MU3.CAMPO6  SF,
		MU4.CAMPO6  PROG,
		MU5.CAMPO6  SP,
		MU6.CAMPO6  PROY,
		SUBSTR( MET.CLVDEP,1,3)  DG, 
		SUBSTR( MET.CLVDEP,4,3)  DA, 
		DGM.NOMBRE NOMDG,
		DAA.NOMBRE NOMDA,
		CAP.OBJ_PROY,
		--PAS.PROGRAMA PROGRA,
		PAS.CLAVE,
		SUM(PAS.AUTO1_1 + PAS.AUTO1_2 + PAS.AUTO1_3 +
		PAS.AUTO1_4 + PAS.AUTO1_5 + PAS.AUTO1_6 +
		PAS.AUTO1_7 + PAS.AUTO1_8 + PAS.AUTO1_9 +
		PAS.AUTO1_10 + PAS.AUTO1_11 + PAS.AUTO1_12 ) AUTO	
	FROM PP_METT MET 
			INNER JOIN CATDEP DEP ON MET.CLVDEP = DEP.CLVDEP AND MET.IDSECTOR= DEP.IDSECTOR
			INNER JOIN PASO PAS ON MET.CLVNEP = SUBSTR(PAS.PROGRAMA,1,12) AND MET.CLVDEP = PAS.CLAVE AND SUBSTR(PAS.PARTIDA,4,1) <> '0' AND MET.IDSECTOR = PAS.IDSECTOR
			INNER JOIN PP_CAPP CAP ON MET.CLVNEP = CAP.CLVNEP AND MET.CLVDEP = CAP.CLVDEP AND MET.IDSECTOR = CAP.IDSECTOR AND CAP.CLVFUEN = MET.CLVFUEN
 			INNER JOIN CATDGM DGM ON SUBSTR(MET.CLVDEP,1,3) = DGM.CLAVE 
			INNER JOIN CATDAA DAA ON SUBSTR(MET.CLVDEP,4,3) = DAA.CLAVE 
			INNER JOIN MUNINEP MU1 ON SUBSTR(MET.CLVNEP,1,2) = MU1.CAMPO7 AND MET.IDSECTOR = MU1.IDSECTOR
			INNER JOIN MUNINEP MU2 ON SUBSTR(MET.CLVNEP,1,4) = MU2.CAMPO7 AND MET.IDSECTOR = MU2.IDSECTOR
			INNER JOIN MUNINEP MU3 ON SUBSTR(MET.CLVNEP,1,6) = MU3.CAMPO7 AND MET.IDSECTOR = MU3.IDSECTOR
			INNER JOIN MUNINEP MU4 ON SUBSTR(MET.CLVNEP,1,8) = MU4.CAMPO7 AND MET.IDSECTOR = MU4.IDSECTOR
			INNER JOIN MUNINEP MU5 ON SUBSTR(MET.CLVNEP,1,10) = MU5.CAMPO7 AND MET.IDSECTOR = MU5.IDSECTOR
			INNER JOIN MUNINEP MU6 ON SUBSTR(MET.CLVNEP,1,12) = MU6.CAMPO7 AND MET.IDSECTOR = MU6.IDSECTOR
WHERE MET.IDSECTOR= $P{idSector}
GROUP BY MET.CLVDEP||MET.CLVNEP||MET.CLVFUEN,
		SUBSTR(MET.CLVNEP,11,2),
		MET.ANIO_CAP,
		MET.NUM_VER, 
		MET.CLVDEP, 
		MET.CLVMET,
		MET.NOM_IND, 
		MET.UNI_MED, 
		MET.CAN_METIA, 
		MET.CAN_METI,  
		MET.CLVNEP,
		MET.PROGANTE,
		DEP.NOMDEP,
		DEP.TITULAR,
		DEP.ELABORO,
		DEP.CARGO_T,
		DEP.CARGO_E,
		MU1.CAMPO6,
		MU2.CAMPO6,
		MU3.CAMPO6,
		MU4.CAMPO6,
		MU5.CAMPO6,
		MU6.CAMPO6,
		SUBSTR( MET.CLVDEP,1,3), 
		SUBSTR( MET.CLVDEP,4,3),
		DGM.NOMBRE,
		DAA.NOMBRE,
		CAP.OBJ_PROY,
		--PAS.PROGRAMA,
		PAS.CLAVE
ORDER BY 1,
		 MET.CLVDEP, 
		 MET.CLVNEP,
		 MET.CLVMET]]></query>
