$F{STACTA}.toUpperCase().equals("D") ?	$V{saldoMarzo}.add($F{CARGOS_4}).subtract($F{ABONOS_4}) :$V{saldoMarzo}.add($F{ABONOS_4}).subtract($F{CARGOS_4}) :$V{saldoMarzo}]]></expression>
	</variable>
	<variable name="saldoMayo" class="java.math.BigDecimal">
		<expression><![CDATA[$P{trimestre} >= 2 ? $F{STACTA}.toUpperCase().equals("D") ?	$V{saldoAbril}.add($F{CARGOS_5}).subtract($F{ABONOS_5}) :$V{saldoAbril}.add($F{ABONOS_5}).subtract($F{CARGOS_5}): $V{saldoAbril}]]></expression>
