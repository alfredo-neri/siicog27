			<property name="com.jaspersoft.studio.unit.height" value="px"/>
			<property name="com.jaspersoft.studio.unit.y" value="px"/>
			<property name="com.jaspersoft.studio.unit.width" value="px"/>
			<printWhenExpression><![CDATA[$P{noFirmas}==2 ||  $P{noFirmas} == 4 || $P{noFirmas} == 5]]></printWhenExpression>
			<expression><![CDATA[$P{noFirmas} == 2 ? $P{firmaN1} :$P{firmaN2}]]></expression>
		</element>
		<element kind="textField" uuid="4ac3c17a-a501-4ea2-ac92-fffca7ff02fe" x="2100" y="10" width="160" height="30" stretchType="NoStretch" fontName="Arial" fontSize="9.0" evaluationTime="Report" bold="false" blankWhenNull="true" hTextAlign="Center">
			<property name="com.jaspersoft.studio.unit.height" value="px"/>
			<printWhenExpression><![CDATA[$P{noFirmas}==2 ||  $P{noFirmas} == 4 || $P{noFirmas} == 5]]></printWhenExpression>
			<box>
				<bottomPen lineWidth="1.0"/>
			</box>
			<expression><![CDATA[$P{noFirmas}==2 ? $P{firmaL2}  : $P{noFirmas}==4 ? $P{firmaL3}  : $P{firmaL4}]]></expression>
		</element>
		<element kind="textField" uuid="064bd7c3-d3fb-4a51-bf85-cfe9021f10e3" x="660" y="40" width="160" height="30" stretchType="NoStretch" fontName="Arial" fontSize="9.0" evaluationTime="Report" bold="false" blankWhenNull="true" hTextAlign="Center">
