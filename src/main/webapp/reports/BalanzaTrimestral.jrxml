	<variable name="saldoInicialDebe" class="java.math.BigDecimal">
		<expression><![CDATA[$F{STACTA}.toUpperCase().equals("D") ?	$F{SALINI}:BigDecimal.ZERO]]></expression>
	</variable>
	<variable name="saldoInicialHaber" class="java.math.BigDecimal">
		<expression><![CDATA[$F{STACTA}.toUpperCase().equals("A") ?	$F{SALINI}:BigDecimal.ZERO]]></expression>
	</variable>
	<variable name="saldoEnero" class="java.math.BigDecimal">
		<expression><![CDATA[$F{STACTA}.toUpperCase().equals("D") ?	$V{saldoInicialDebe}.add($F{CARGOS_1}).subtract($F{ABONOS_1}) :$V{saldoInicialHaber}.add($F{ABONOS_1}).subtract($F{CARGOS_1})]]></expression>
	</variable>
	<variable name="saldoFebrero" class="java.math.BigDecimal">
