		(($F{SALINI} + ($F{CARGOS_1} + $F{CARGOS_2} + $F{CARGOS_3} + $F{CARGOS_4} + $F{CARGOS_5} + $F{CARGOS_6} + $F{CARGOS_7} + $F{CARGOS_8} + $F{CARGOS_9})) - ($F{ABONOS_1} + $F{ABONOS_2} + $F{ABONOS_3} + $F{ABONOS_4} + $F{ABONOS_5} + $F{ABONOS_6} + $F{ABONOS_7} + $F{ABONOS_8} + $F{ABONOS_9}))
	:($P{mes}.intValue()==10)?
		(($F{SALINI} + ($F{CARGOS_1} + $F{CARGOS_2} + $F{CARGOS_3} + $F{CARGOS_4} + $F{CARGOS_5} + $F{CARGOS_6} + $F{CARGOS_7} + $F{CARGOS_8} + $F{CARGOS_9} + $F{CARGOS_10})) - ($F{ABONOS_1} + $F{ABONOS_2} + $F{ABONOS_3} + $F{ABONOS_4} + $F{ABONOS_5} + $F{ABONOS_6} + $F{ABONOS_7} + $F{ABONOS_8} + $F{ABONOS_9} + $F{ABONOS_10}))
	:($P{mes}.intValue()==11)?
		(($F{SALINI} + ($F{CARGOS_1} + $F{CARGOS_2} + $F{CARGOS_3} + $F{CARGOS_4} + $F{CARGOS_5} + $F{CARGOS_6} + $F{CARGOS_7} + $F{CARGOS_8} + $F{CARGOS_9} + $F{CARGOS_10} + $F{CARGOS_11})) - ($F{ABONOS_1} + $F{ABONOS_2} + $F{ABONOS_3} + $F{ABONOS_4} + $F{ABONOS_5} + $F{ABONOS_6} + $F{ABONOS_7} + $F{ABONOS_8} + $F{ABONOS_9} + $F{ABONOS_10} + $F{ABONOS_11}))
	:($P{mes}.intValue()==12)?
		(($F{SALINI} + ($F{CARGOS_1} + $F{CARGOS_2} + $F{CARGOS_3} + $F{CARGOS_4} + $F{CARGOS_5} + $F{CARGOS_6} + $F{CARGOS_7} + $F{CARGOS_8} + $F{CARGOS_9} + $F{CARGOS_10} + $F{CARGOS_11} + $F{CARGOS_12})) - ($F{ABONOS_1} + $F{ABONOS_2} + $F{ABONOS_3} + $F{ABONOS_4} + $F{ABONOS_5} + $F{ABONOS_6} + $F{ABONOS_7} + $F{ABONOS_8} + $F{ABONOS_9} + $F{ABONOS_10} + $F{ABONOS_11} + $F{ABONOS_12}))
	:0.00
:0.00]]></expression>
	</variable>
	<variable name="V_S3_Haber" class="java.math.BigDecimal">
		<expression><![CDATA[($F{STACTA}.toUpperCase()=="A")? 
	($P{mes}.intValue()==1)?
		(($F{SALINI} + $F{ABONOS_1}) - $F{CARGOS_1})
	:($P{mes}.intValue()==2)?
		(($F{SALINI} + ($F{ABONOS_1} + $F{ABONOS_2})) - ($F{CARGOS_1} + $F{CARGOS_2}))
	:($P{mes}.intValue()==3)?
		(($F{SALINI} + ($F{ABONOS_1} + $F{ABONOS_2} + $F{ABONOS_3})) - ($F{CARGOS_1} + $F{CARGOS_2} + $F{CARGOS_3}))
	:($P{mes}.intValue()==4)?
		(($F{SALINI} + ($F{ABONOS_1} + $F{ABONOS_2} + $F{ABONOS_3} + $F{ABONOS_4})) - ($F{CARGOS_1} + $F{CARGOS_2} + $F{CARGOS_3} + $F{CARGOS_4}))
	:($P{mes}.intValue()==5)?
		(($F{SALINI} + ($F{ABONOS_1} + $F{ABONOS_2} + $F{ABONOS_3} + $F{ABONOS_4} + $F{ABONOS_5})) - ($F{CARGOS_1} + $F{CARGOS_2} + $F{CARGOS_3} + $F{CARGOS_4} + $F{CARGOS_5}))
	:($P{mes}.intValue()==6)?
		(($F{SALINI} + ($F{ABONOS_1} + $F{ABONOS_2} + $F{ABONOS_3} + $F{ABONOS_4} + $F{ABONOS_5} + $F{ABONOS_6})) - ($F{CARGOS_1} + $F{CARGOS_2} + $F{CARGOS_3} + $F{CARGOS_4} + $F{CARGOS_5} + $F{CARGOS_6}))
	:($P{mes}.intValue()==7)?
		(($F{SALINI} + ($F{ABONOS_1} + $F{ABONOS_2} + $F{ABONOS_3} + $F{ABONOS_4} + $F{ABONOS_5} + $F{ABONOS_6} + $F{ABONOS_7})) - ($F{CARGOS_1} + $F{CARGOS_2} + $F{CARGOS_3} + $F{CARGOS_4} + $F{CARGOS_5} + $F{CARGOS_6} + $F{CARGOS_7}))
	:($P{mes}.intValue()==8)?
		(($F{SALINI} + ($F{ABONOS_1} + $F{ABONOS_2} + $F{ABONOS_3} + $F{ABONOS_4} + $F{ABONOS_5} + $F{ABONOS_6} + $F{ABONOS_7} + $F{ABONOS_8})) - ($F{CARGOS_1} + $F{CARGOS_2} + $F{CARGOS_3} + $F{CARGOS_4} + $F{CARGOS_5} + $F{CARGOS_6} + $F{CARGOS_7} + $F{CARGOS_8}))
	:($P{mes}.intValue()==9)?
		(($F{SALINI} + ($F{ABONOS_1} + $F{ABONOS_2} + $F{ABONOS_3} + $F{ABONOS_4} + $F{ABONOS_5} + $F{ABONOS_6} + $F{ABONOS_7} + $F{ABONOS_8} + $F{ABONOS_9})) - ($F{CARGOS_1} + $F{CARGOS_2} + $F{CARGOS_3} + $F{CARGOS_4} + $F{CARGOS_5} + $F{CARGOS_6} + $F{CARGOS_7} + $F{CARGOS_8} + $F{CARGOS_9}))
	:($P{mes}.intValue()==10)?
		(($F{SALINI} + ($F{ABONOS_1} + $F{ABONOS_2} + $F{ABONOS_3} + $F{ABONOS_4} + $F{ABONOS_5} + $F{ABONOS_6} + $F{ABONOS_7} + $F{ABONOS_8} + $F{ABONOS_9} + $F{ABONOS_10})) - ($F{CARGOS_1} + $F{CARGOS_2} + $F{CARGOS_3} + $F{CARGOS_4} + $F{CARGOS_5} + $F{CARGOS_6} + $F{CARGOS_7} + $F{CARGOS_8} + $F{CARGOS_9} + $F{CARGOS_10}))
	:($P{mes}.intValue()==11)?
		(($F{SALINI} + ($F{ABONOS_1} + $F{ABONOS_2} + $F{ABONOS_3} + $F{ABONOS_4} + $F{ABONOS_5} + $F{ABONOS_6} + $F{ABONOS_7} + $F{ABONOS_8} + $F{ABONOS_9} + $F{ABONOS_10} + $F{ABONOS_11})) - ($F{CARGOS_1} + $F{CARGOS_2} + $F{CARGOS_3} + $F{CARGOS_4} + $F{CARGOS_5} + $F{CARGOS_6} + $F{CARGOS_7} + $F{CARGOS_8} + $F{CARGOS_9} + $F{CARGOS_10} + $F{CARGOS_11}))
	:($P{mes}.intValue()==12)?
		(($F{SALINI} + ($F{ABONOS_1} + $F{ABONOS_2} + $F{ABONOS_3} + $F{ABONOS_4} + $F{ABONOS_5} + $F{ABONOS_6} + $F{ABONOS_7} + $F{ABONOS_8} + $F{ABONOS_9} + $F{ABONOS_10} + $F{ABONOS_11} + $F{ABONOS_12})) - ($F{CARGOS_1} + $F{CARGOS_2} + $F{CARGOS_3} + $F{CARGOS_4} + $F{CARGOS_5} + $F{CARGOS_6} + $F{CARGOS_7} + $F{CARGOS_8} + $F{CARGOS_9} + $F{CARGOS_10} + $F{CARGOS_11} + $F{CARGOS_12}))
	:0.00
:0.00]]></expression>
	</variable>
	<variable name="vNegativoS3Haber" class="java.math.BigDecimal">
		<expression><![CDATA[$P{idSector} == 1 ? 
($F{CUENTA}.equals("1115") || $F{CUENTA}.equals("1161") || $F{CUENTA}.equals("3241")) ?
$V{V_S3_Haber}.multiply(new BigDecimal(-1))
:
$V{V_S3_Haber}
:
$V{V_S3_Haber}]]></expression>
	</variable>
