	<query language="sql"><![CDATA[SELECT CUENTA,
 		NOMCTA,
		STACTA,
		SALINI SALINI,
		CARGOS_1 ,
		CARGOS_2 ,
		CARGOS_3 ,
		CARGOS_4 ,
		CARGOS_5 ,
		CARGOS_6 ,
		CARGOS_7 ,
		CARGOS_8 ,
		CARGOS_9 ,
		CARGOS_10 ,
		CARGOS_11 ,
		CARGOS_12 ,
		ABONOS_1 ,
		ABONOS_2 ,
		ABONOS_3 ,
		ABONOS_4 ,
		ABONOS_5 ,
		ABONOS_6 ,
		ABONOS_7 ,
		ABONOS_8 ,
		ABONOS_9 ,
		ABONOS_10 ,
		ABONOS_11 ,
		ABONOS_12 
	 FROM CUENTA
 WHERE  SCTA='' AND 
 		SSCTA='' AND 
 		SSSCTA='' AND 
 		NOTCTA=0 AND 
 		(SUBSTR(CUENTA,4,1)<>'0' OR SUBSTR(CUENTA,1,1)='5' OR SUBSTR(CUENTA,1,2)='81'  OR CUENTA LIKE '7%0') AND 
 		$P!{where}
 ORDER BY CUENTA]]></query>
