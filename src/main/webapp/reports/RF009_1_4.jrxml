		(($F{SALINI} + ($F{CARGOS_1} + $F{CARGOS_2} + $F{CARGOS_3} + $F{CARGOS_4} + $F{CARGOS_5} + $F{CARGOS_6} + $F{CARGOS_7} + $F{CARGOS_8} + $F{CARGOS_9})) - ($F{ABONOS_1} + $F{ABONOS_2} + $F{ABONOS_3} + $F{ABONOS_4} + $F{ABONOS_5} + $F{ABONOS_6} + $F{ABONOS_7} + $F{ABONOS_8} + $F{ABONOS_9}))
