			<expression><![CDATA[$P{firmaN1}]]></expression>
		</element>
		<element kind="textField" uuid="7eab5209-a1cc-4cdb-ae93-70bb5ab7f3dc" x="362" y="0" width="90" height="30" stretchType="NoStretch" fontName="Arial" fontSize="8.0" evaluationTime="Report" bold="false" blankWhenNull="true" hTextAlign="Center">
			<property name="com.jaspersoft.studio.unit.height" value="px"/>
			<property name="com.jaspersoft.studio.unit.width" value="px"/>
			<printWhenExpression><![CDATA[$P{noFirmas}==2 ||  $P{noFirmas} == 4 || $P{noFirmas} == 5]]></printWhenExpression>
			<box>
				<bottomPen lineWidth="1.0"/>
			</box>
			<expression><![CDATA[$P{noFirmas}==2 ? $P{firmaL2}  : $P{noFirmas}==4 ? $P{firmaL3}  : $P{firmaL4}]]></expression>
		</element>
		<element kind="textField" uuid="0c262fdf-22e5-456d-b677-63378bca00d0" x="242" y="0" width="90" height="30" stretchType="NoStretch" fontName="Arial" fontSize="8.0" evaluationTime="Report" bold="false" blankWhenNull="true" hTextAlign="Center">
			<property name="com.jaspersoft.studio.unit.height" value="px"/>
			<property name="com.jaspersoft.studio.unit.width" value="px"/>
			<printWhenExpression><![CDATA[$P{noFirmas} ==1 || $P{noFirmas} == 3 ||  $P{noFirmas} == 5]]></printWhenExpression>
			<box>
				<bottomPen lineWidth="1.0"/>
			</box>
			<expression><![CDATA[$P{noFirmas}==1 ? $P{firmaL1} : $P{noFirmas}==3 ? $P{firmaL2} :   $P{noFirmas}==5 ? $P{firmaL3} : ""]]></expression>
		</element>
		<element kind="textField" uuid="d1d52150-0925-46bd-9c29-3b287efade48" x="0" y="0" width="90" height="30" stretchType="ElementGroupHeight" fontName="Arial" fontSize="8.0" evaluationTime="Report" bold="false" blankWhenNull="true" hTextAlign="Center">
			<property name="com.jaspersoft.studio.unit.height" value="px"/>
			<property name="com.jaspersoft.studio.unit.width" value="px"/>
			<printWhenExpression><![CDATA[$P{noFirmas} >= 3]]></printWhenExpression>
			<box>
				<bottomPen lineWidth="1.0"/>
			</box>
			<expression><![CDATA[$P{firmaL1}]]></expression>
		</element>
		<element kind="textField" uuid="c9d954d7-cecb-49e9-91ad-2f19387146b3" x="482" y="30" width="90" height="30" stretchType="NoStretch" fontName="Arial" fontSize="8.0" evaluationTime="Report" bold="false" blankWhenNull="true" hTextAlign="Center">
			<property name="com.jaspersoft.studio.unit.height" value="px"/>
			<property name="com.jaspersoft.studio.unit.y" value="px"/>
			<property name="com.jaspersoft.studio.unit.width" value="px"/>
			<printWhenExpression><![CDATA[$P{noFirmas} >= 3]]></printWhenExpression>
			<expression><![CDATA[$P{noFirmas}==3 ? $P{firmaN3}  : $P{noFirmas}==4 ? $P{firmaN4}  : $P{firmaN5}]]></expression>
		</element>
		<element kind="textField" uuid="00b8681d-461a-4b6b-aa28-6513eec6b480" x="126" y="0" width="90" height="30" stretchType="NoStretch" fontName="Arial" fontSize="8.0" evaluationTime="Report" bold="false" blankWhenNull="true" hTextAlign="Center">
			<property name="com.jaspersoft.studio.unit.height" value="px"/>
			<property name="com.jaspersoft.studio.unit.width" value="px"/>
			<printWhenExpression><![CDATA[$P{noFirmas}==2 ||  $P{noFirmas} == 4 || $P{noFirmas} == 5]]></printWhenExpression>
			<box>
				<bottomPen lineWidth="1.0"/>
			</box>
			<expression><![CDATA[$P{noFirmas} == 2 ? $P{firmaL1} :$P{firmaL2}]]></expression>
		</element>
	</lastPageFooter>
