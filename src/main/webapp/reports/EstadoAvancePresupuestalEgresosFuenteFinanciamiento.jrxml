	<variable name="lastDayOfMonth" resetType="None" class="java.lang.Integer">
		<expression><![CDATA[DAYSINMONTH( (new SimpleDateFormat("dd-MM-yyyy")).parse(String.valueOf("01-"+$P{mes}+"-"+ $P{year})))]]></expression>
	</variable>
	<variable name="mes_extenso" resetType="None" class="java.lang.String">
		<expression><![CDATA[UPPER(new java.text.SimpleDateFormat("MMMMM", new Locale("es", "ES")).format(new SimpleDateFormat("yyyy/MM/dd").parse("1970/" + $P{mes}.toString() + "/01")) )]]></expression>
	</variable>
	<variable name="modificado" class="java.math.BigDecimal">
		<expression><![CDATA[$F{AUTO1}.add($F{AMPLI1}).subtract($F{REDU1})]]></expression>
	</variable>
	<variable name="ejercido" class="java.math.BigDecimal">
		<expression><![CDATA[$F{COMPRO1}.add($F{EJXPA1}).add($F{EJPA1})]]></expression>
	</variable>
	<variable name="porEjercer" class="java.math.BigDecimal">
		<expression><![CDATA[$V{modificado}.subtract($V{ejercido})]]></expression>
	</variable>
	<variable name="totalAprobado" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[($F{PARTIDA}.substring(1).equals("000")) ? $F{AUTO1} : BigDecimal.ZERO]]></expression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="totalPagado" calculation="Sum" class="java.math.BigDecimal">
