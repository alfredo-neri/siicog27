		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="totalModificado" class="java.math.BigDecimal">
		<expression><![CDATA[$V{totalAprobado}.add($V{totalAmpliacion}).subtract($V{totalReduccion})]]></expression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="totalComprometido" calculation="Sum" class="java.math.BigDecimal">
