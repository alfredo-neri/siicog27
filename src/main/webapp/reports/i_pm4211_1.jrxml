		<element kind="textField" uuid="c8d0096f-845f-4cd4-8981-74d089946c01" x="0" y="104" width="555" height="11" stretchType="NoStretch" fontName="Arial" fontSize="8.0">
			<expression><![CDATA["DEL 1 DE ENERO AL "+ 
($P{Mes} == 1 ? "31" : 
$P{Mes} == 2 && $P{ANO_EMP} %  4 == 0 ? "29" :
$P{Mes} == 2 ?	"28" : 
$P{Mes} == 3 ?	"31" : 
$P{Mes} == 4 ? "30" :
$P{Mes} == 5 ? "31" :
$P{Mes} == 6 ? "30" :
$P{Mes} == 7 ? "31":
$P{Mes} == 8 ? "31":
$P{Mes} == 9 ? "30":
$P{Mes} == 10 ? "31":
$P{Mes} == 11 ? "30" : "31")

 +" DE "+ 

($P{Mes} == 1 ? "ENERO" : 
$P{Mes} == 2 ?	"FEBRERO": 
$P{Mes} == 3 ?	"MARZO": 
$P{Mes} == 4 ? "ABRIL" :
$P{Mes} == 5 ?"MAYO" :
$P{Mes} == 6 ? "JUNIO" :
$P{Mes} == 7 ? "JULIO":
$P{Mes} == 8 ? "AGOSTO":
$P{Mes} == 9 ? "SEPTIEMBRE":
$P{Mes} == 10 ? "OCTUBRE":
$P{Mes} == 11 ? "NOVIEMBRE": "DICIEMBRE")
 
 +" DE " + $P{ANO_EMP}]]></expression>
		</element>
		<element kind="image" uuid="1672dd57-e91f-4280-9921-082b1272e194" x="0" y="0" width="80" height="80" stretchType="NoStretch" hImageAlign="Center" vImageAlign="Middle" onErrorType="Blank">
