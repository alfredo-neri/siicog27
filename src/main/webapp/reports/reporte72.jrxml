<jasperReport name="reporte72" language="java" columnCount="1" dpi="72" pageWidth="1300" pageHeight="612" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="1300" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" whenResourceMissingType="Empty" uuid="37ed2b96-4991-4df6-a685-0545e5bf7158">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
