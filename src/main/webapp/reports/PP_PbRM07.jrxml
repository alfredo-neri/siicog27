	<queryString>
		<![CDATA[SELECT	SUBSTR(PA.PROGRAMA,1,2) FIN, SUBSTR(PA.PROGRAMA,3,2) FUN, SUBSTR(PA.PROGRAMA,5,2) SF, 
		SUBSTR(PA.PROGRAMA,7,2) PG,  SUBSTR(PA.PROGRAMA,9,2) SP,  SUBSTR(PA.PROGRAMA,11,2) PY, 
		SUBSTR(PA.PROGRAMA,13,2) FF, PA.PARTIDA, PA.PROGRAMA, PA.AUTORIZADO_1,
		PA.AUTORIZADO_2,  PA.AUTORIZADO_3,  PA.AUTORIZADO_4,
		PA.AUTORIZADO_5,  PA.AUTORIZADO_6,  PA.AUTORIZADO_7, 
		PA.AUTORIZADO_8,  PA.AUTORIZADO_9,  PA.AUTORIZADO_10,
		PA.AUTORIZADO_11, PA.AUTORIZADO_12, PA.AUTORIZADO_13,
		NA.NOMGAS, CD.NOMBRE, FF.CLVFTE
	FROM TW_ANTEPROYECTO AS PA
		LEFT JOIN NATGAS AS NA ON PA.IDSECTOR = NA.IDSECTOR	AND PA.PARTIDA = NA.CLVGAS
		LEFT JOIN FUENTEF AS FF ON PA.IDSECTOR = FF.IDSECTOR AND SUBSTR(PA.PROGRAMA,13,3) = FF.LIGA
		LEFT JOIN CATDGM AS CD ON SUBSTR(PA.CLAVE,1,3) = CD.CLAVE
WHERE	PA.IDSECTOR= $P{sector}
	AND PA.PARTIDA IN ('6159','6139')
ORDER BY PA.PROGRAMA, PA.PARTIDA]]>
	</queryString>
