	<parameter name="P_MES_INICIAL" class="java.lang.Integer"
		><description><![CDATA[]]></description>
	</parameter>
	<parameter name="P_SECTOR" class="java.lang.Integer"
		><description><![CDATA[]]></description>
	</parameter>
	<parameter name="P_IMG" class="java.lang.String"/>
	<parameter name="P_CAMPO1" class="java.lang.String"
		><description><![CDATA[]]></description>
	</parameter>
	<parameter name="P_MES_FINAL" class="java.lang.Integer"/>
	<parameter name="P_CUENTAS_CON_SALDO_CERO" class="java.lang.String"/>
	<query language="sql"><![CDATA[SELECT CUENTA.CUENTA
,CUENTA.SSSCTA
,NVL(POLIDE.CANPOL, 0) CANPOL
,NVL(POLIDE.CANPOLH, 0) CANPOLH

FROM CUENTA
LEFT OUTER JOIN POLIDE 
ON  CUENTA.CUENTA=POLIDE.CUENTA
AND CUENTA.SCTA=NVL(POLIDE.SCTA,'')
AND CUENTA.SSCTA=NVL(POLIDE.SSCTA,'')
AND CUENTA.SSSCTA=NVL(POLIDE.SSSCTA,'')
AND CUENTA.SSSSCTA=NVL(POLIDE.SSSSCTA,'')
AND CUENTA.IDSECTOR=POLIDE.IDSECTOR

LEFT OUTER JOIN POLIEN 
ON POLIDE.TIPPOL=POLIEN.TIPPOL
AND POLIDE.MESPOL=POLIEN.MESPOL
AND POLIDE.CONPOL= POLIEN.CONPOL
AND POLIDE.ANOPOL=POLIEN.ANOPOL
AND POLIDE.IDSECTOR=POLIEN.IDSECTOR

WHERE (SUBSTR(CUENTA.CUENTA,1,3)='824'
OR SUBSTR(CUENTA.CUENTA,1,3)='825'
OR SUBSTR(CUENTA.CUENTA,1,3) = '827'
OR SUBSTR(CUENTA.CUENTA,1,1)='5')
AND CUENTA.NIVCTA = 'S'
AND CUENTA.IDSECTOR= $P{P_SECTOR} 
AND POLIDE.MESPOL>= $P{P_MES_INICIAL} 
AND POLIDE.MESPOL<= $P{P_MES_FINAL}
AND (CUENTA.SSSCTA IS NOT NULL AND CUENTA.SSSCTA <> '')

ORDER BY  CUENTA.SSSCTA]]></query>
	<field name="CUENTA" class="java.lang.String"/>
	<field name="SSSCTA" class="java.lang.String"/>
	<field name="CANPOL" class="java.math.BigDecimal"/>
	<field name="CANPOLH" class="java.math.BigDecimal"/>
	<variable name="V_CURRENT_PAGE_NUMBER" resetType="Page" class="java.lang.Integer">
		<expression><![CDATA[1]]></expression>
		<initialValueExpression><![CDATA[$V{PAGE_NUMBER}]]></initialValueExpression>
	</variable>
	<variable name="saldo" resetType="Group" calculation="Sum" resetGroup="GROUP_CUENTA" class="java.math.BigDecimal">
		<expression><![CDATA[$F{CUENTA}.substring( 0, 1 ).equals("5") ?  $F{CANPOL}.subtract($F{CANPOLH} ) : BigDecimal.ZERO]]></expression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="saldo1" resetType="Group" calculation="Sum" resetGroup="GROUP_CUENTA" class="java.math.BigDecimal">
		<expression><![CDATA[$F{CUENTA}.substring( 0, 3 ).equals("824") ?  $F{CANPOL}.subtract($F{CANPOLH} ) : BigDecimal.ZERO]]></expression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="saldo2" resetType="Group" calculation="Sum" resetGroup="GROUP_CUENTA" class="java.math.BigDecimal">
		<expression><![CDATA[$F{CUENTA}.substring( 0, 3 ).equals("825") ?  $F{CANPOL}.subtract($F{CANPOLH} ) : BigDecimal.ZERO]]></expression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="saldo3" resetType="Group" calculation="Sum" resetGroup="GROUP_CUENTA" class="java.math.BigDecimal">
		<expression><![CDATA[$F{CUENTA}.substring( 0, 3 ).equals("827") ?  $F{CANPOL}.subtract($F{CANPOLH} ) : BigDecimal.ZERO]]></expression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="final" resetType="Group" resetGroup="GROUP_CUENTA" class="java.math.BigDecimal">
		<expression><![CDATA[$V{saldo}.subtract( $V{saldo3}).add($V{saldo2}).add($V{saldo1}).multiply(new BigDecimal(-1))]]></expression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<group name="GROUP_CUENTA" reprintHeaderOnEachPage="true">
		<expression><![CDATA[$F{SSSCTA}]]></expression>
