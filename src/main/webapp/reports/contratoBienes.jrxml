	<query language="SQL"><![CDATA[SELECT C.*, CD.*, P.*, PA.*
	FROM TC_CONTRATOS C
		INNER JOIN TR_CONTRATO_DETAIL CD ON CD.ID_CONTRATO = C.ID
		INNER JOIN TC_PROVEEDORES_NUEVO P ON C.ID_PROVEEDOR = P.ID
--		INNER JOIN TR_CONTRATO_SOLICITUDES CS ON CS.ID_CONTRATO = C.ID
--		INNER JOIN TC_ADQUISICIONES A ON CS.ID_SOLICITUD = A.ID
		INNER JOIN TC_PROCEDIMIENTOS_ADQUISITIVOS PA ON C.ID_PROCEDIMIENTO_ADQUISITIVO = PA.ID
WHERE C.ID =  $P{idContrato}]]></query>
