<jasperReport name="reporte79" language="java" columnCount="1" dpi="72" pageWidth="792" pageHeight="612" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="792" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="55497c1d-fbc4-43f7-8962-041ce7dcb8c7" ignorePagination="true">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="LOCAL"/>
	<property name="com.jaspersoft.studio.unit." value="pixel"/>
	<parameter name="mes" class="java.lang.Integer"/>
	<parameter name="anopol" class="java.lang.Integer"/>
	<parameter name="xssscta" class="java.lang.String"/>
	<parameter name="xssscta2" class="java.lang.String"/>
	<parameter name="SECTOR" class="java.lang.Integer"/>
	<query language="SQL"><![CDATA[SELECT 
       cuenta,
       nvl(scta, '') scta,
       nvl(sscta, '') sscta,
       nvl(ssscta, '') ssscta,
       nvl(sssscta,'') sssscta,
       conpol,
       tippol,
       mespol,
       refpol,
       nvl(canpol, 0) canpol,
       nvl(canpolh, 0) canpolh,
       concep
FROM POLIDE 
WHERE MESPOL <= $P{mes}
AND anopol = $P{anopol}
AND (CUENTA LIKE '827%' OR CUENTA LIKE '825%')
AND SUBSTR(CUENTA,4,1) <> '0'
AND SSSCTA >= $P{xssscta}
AND SSSCTA <= $P{xssscta2}
AND REFPOL <> 0
AND REFPOL <> 60000
AND idSector = $P{SECTOR}
ORDER BY MESPOL]]></query>
	<field name="CUENTA" class="java.lang.String"/>
	<field name="SCTA" class="java.lang.String"/>
	<field name="SSCTA" class="java.lang.String"/>
	<field name="SSSCTA" class="java.lang.String"/>
	<field name="SSSSCTA" class="java.lang.String"/>
	<field name="CONPOL" class="java.lang.Integer"/>
	<field name="TIPPOL" class="java.lang.String"/>
	<field name="MESPOL" class="java.lang.Integer"/>
	<field name="REFPOL" class="java.math.BigDecimal"/>
	<field name="CANPOL" class="java.math.BigDecimal"/>
	<field name="CANPOLH" class="java.math.BigDecimal"/>
	<field name="CONCEP" class="java.lang.String"/>
	<variable name="smes" resetType="Group" calculation="Sum" resetGroup="GpoMESPOL" class="java.lang.Double">
		<expression><![CDATA[$F{CANPOL}.subtract( $F{CANPOLH})]]></expression>
	</variable>
	<variable name="totalCanpol" calculation="Sum" class="java.lang.Double">
		<expression><![CDATA[$F{CANPOL}]]></expression>
	</variable>
	<variable name="totalCanpolh" calculation="Sum" class="java.lang.Double">
		<expression><![CDATA[$F{CANPOLH}]]></expression>
	</variable>
	<variable name="totalDiferencia" calculation="Sum" class="java.lang.Double">
		<expression><![CDATA[$F{CANPOL}.subtract( $F{CANPOLH})]]></expression>
	</variable>
	<group name="GpoMESPOL">
		<expression><![CDATA[$F{MESPOL}]]></expression>
		<groupFooter>
			<band height="15">
				<element kind="textField" uuid="99655c00-f71d-408b-b681-fb485eadf806" x="381" y="0" width="50" height="15" stretchType="NoStretch" fontName="Arial" fontSize="10.0" pattern="#,##0.00#" hTextAlign="Right">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
					<expression><![CDATA[($V{smes}==null?0.00:$V{smes})]]></expression>
				</element>
				<element kind="staticText" uuid="23622b44-65e4-4bc2-a2fa-f0897d27969c" x="440" y="0" width="88" height="15" stretchType="NoStretch" fontName="Arial" fontSize="10.0" hTextAlign="Left"
					><text><![CDATA[Suma por Mes]]></text>
				</element>
			</band>
		</groupFooter>
	</group>
