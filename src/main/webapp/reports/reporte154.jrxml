	<query language="sql"><![CDATA[SELECT 
anual
, nobs
, totobr
, obsnobs
, obstotobr
 FROM pm3211
WHERE IDSECTOR=  $P{pSector} 
AND ANUAL = $P{pAnio}]]></query>
