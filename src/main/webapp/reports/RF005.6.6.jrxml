	<parameter name="USUARIO" class="java.lang.String"
		><description><![CDATA[]]></description>
	</parameter>
	<parameter name="AN" class="java.lang.Integer"/>
	<parameter name="LOGO_A" class="java.lang.String"/>
	<parameter name="LOGO_O" class="java.lang.String"/>
	<query language="sql"><![CDATA[SELECT NOMMUN,CON.CLAVE, FIR.CAMPO3 ,FIR.L1,COALESCE(FIR.N1,'') AS N1,FIR.L28,COALESCE(FIR.N28,'') AS N28,FIR.L2,COALESCE(FIR.N2,'') AS N2,FIR.L3,COALESCE(FIR.N3,'') AS N3 FROM FIRMAS as FIR, CATMUN AS CAT INNER JOIN TC_USUARIOS AS TCU ON TCU.ID_LOCALIDAD=CAT.CLVMUN 
INNER JOIN CONCTB AS CON
ON CON.USERID= TCU.USUARIO AND CON.IDSECTOR=1
WHERE TCU.USUARIO=$P{USUARIO}]]></query>
