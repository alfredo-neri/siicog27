		<parameter name="USUARIOS" class="java.lang.String"/>
		<query language="sql"><![CDATA[SELECT 
 NULL AS FN
, NULL AS FUN
, NULL AS SUBFUN
, NULL AS PROG
, NULL AS SUBPROG
, NULL AS PROY
, NULL AS FFIN
, NULL AS NCONTROL
, NULL AS NOMOBRA
, NULL AS TIPOEJEC
, NULL AS UBICACION
, NULL AS JUSTIFICACION
, NULL AS POBLACION
,'Total: ' AS TIPOASIG
,DECIMAL(SUM(OB.AUTO_13),24,2)  
,DECIMAL(SUM(OB.AUTO_1),24,2)
,DECIMAL(SUM(OB.AUTO_2),24,2)
,DECIMAL(SUM(OB.AUTO_3),24,2)
,DECIMAL(SUM(OB.AUTO_4),24,2)
,DECIMAL(SUM(OB.AUTO_5),24,2)
,DECIMAL(SUM(OB.AUTO_6),24,2)
,DECIMAL(SUM(OB.AUTO_7),24,2)
,DECIMAL(SUM(OB.AUTO_8),24,2)
,DECIMAL(SUM(OB.AUTO_9),24,2)
,DECIMAL(SUM(OB.AUTO_10),24,2)
,DECIMAL(SUM(OB.AUTO_11),24,2)
,DECIMAL(SUM(OB.AUTO_12),24,2)

FROM OBRAS AS OB INNER JOIN TC_USUARIOS AS TCU ON OB.USERID= TCU.USUARIO WHERE TCU.USUARIO=$P{USUARIOS}
UNION ALL
SELECT 
OB.FN
,OB.FUN
,OB.SUBFUN
,OB.PROG
,OB.SUBPROG
,OB.PROY
,OB.FFIN
,OB.NCONTROL
,OB.NOMOBRA
,OB.TIPOEJEC
,OB.UBICACION
,OB.JUSTIFICACION
,OB.POBLACION
,OB.TIPOASIG
,DECIMAL(OB.AUTO_13,24,2)  
,DECIMAL(OB.AUTO_1,24,2)
,DECIMAL(OB.AUTO_2,24,2)
,DECIMAL(OB.AUTO_3,24,2)
,DECIMAL(OB.AUTO_4,24,2)
,DECIMAL(OB.AUTO_5,24,2)
,DECIMAL(OB.AUTO_6,24,2)
,DECIMAL(OB.AUTO_7,24,2)
,DECIMAL(OB.AUTO_8,24,2)
,DECIMAL(OB.AUTO_9,24,2)
,DECIMAL(OB.AUTO_10,24,2)
,DECIMAL(OB.AUTO_11,24,2)
,DECIMAL(OB.AUTO_12,24,2)
FROM OBRAS AS OB INNER JOIN TC_USUARIOS AS TCU ON OB.USERID= TCU.USUARIO WHERE TCU.USUARIO=$P{USUARIOS}]]></query>
