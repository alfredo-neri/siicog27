<jasperReport name="ImpresionPoliza" language="java" columnCount="1" dpi="72" pageWidth="850" pageHeight="612" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="810" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="02c8c94e-3768-411f-8e33-0373c0bc5455">
