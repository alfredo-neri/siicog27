		<element kind="textField" uuid="e36996d9-9b36-47c0-b7d4-63a90c95f7b2" x="160" y="0" width="488" height="60" stretchType="NoStretch" fontName="Arial" fontSize="16.0" bold="true" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle">
