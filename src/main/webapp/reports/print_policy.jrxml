	<parameter name="pTipoPolizaName" class="java.lang.String"/>
	<parameter name="pEntidadName" class="java.lang.String"/>
	<parameter name="pMesPoliza" class="java.lang.Integer"/>
	<parameter name="pConsecutivoPolizaMin" class="java.lang.Integer"/>
	<parameter name="pConsecutivoPolizaMax" class="java.lang.Integer"/>
	<parameter name="pSector" class="java.lang.Integer"/>
	<parameter name="pImg" class="java.lang.String"/>
	<parameter name="pImg2" class="java.lang.String"
		><description><![CDATA[]]></description>
	</parameter>
	<parameter name="noFirmas" class="java.lang.Integer"/>
	<parameter name="firmaL1" class="java.lang.String"/>
	<parameter name="firmaL2" class="java.lang.String"/>
	<parameter name="firmaL3" class="java.lang.String"/>
	<parameter name="firmaN1" class="java.lang.String"/>
	<parameter name="firmaN2" class="java.lang.String"/>
	<parameter name="firmaN3" class="java.lang.String"/>
	<parameter name="firmaL4" class="java.lang.String"/>
	<parameter name="firmaN4" class="java.lang.String"/>
	<parameter name="firmaL5" class="java.lang.String"/>
	<parameter name="firmaN5" class="java.lang.String"/>
	<query language="sql"><![CDATA[SELECT  PN.CLVPOL, 
		PN.FECPOL,
		PN.STAPOL,
		PN.STAAFE,
		PN.TIPPOL,
		PN.MESPOL,
		PN.CONPOL,
		PN.CAPPOL,
		PN.POLCLV1,
		PD.RENPOL,
		PD.CUENTA,
		PD.SCTA,
		PD.SSCTA,
		PD.SSSCTA,
		PD.SSSSCTA,
		PD.REFPOL,
		PD.DN,
		PD.CONCEP,
		PD.CANPOL CANPOL,
		PD.CANPOLH CANPOLH,
		TU.NOMBRE,
		SUM(PF.CANFLU) CANFLU
	FROM POLIEN PN
		INNER JOIN POLIDE PD ON PN.MESPOL = PD.MESPOL
							AND PN.TIPPOL = PD.TIPPOL
							AND PN.CONPOL = PD.CONPOL
							AND PN.IDSECTOR = PD.IDSECTOR
		LEFT JOIN POLIFL PF ON PN.MESPOL = PF.MESPOL
							AND PN.TIPPOL = PF.TIPPOL
							AND PN.CONPOL = PF.CONPOL
							AND PN.IDSECTOR = PF.IDSECTOR
		INNER JOIN TC_USUARIOS TU ON PN.CAPPOL = TU.USUARIO
WHERE PN.IDSECTOR = $P{pSector}
	AND PN.TIPPOL = $P{pTipoPoliza}
	AND PN.MESPOL = $P{pMesPoliza}
	AND PN.CONPOL BETWEEN $P{pConsecutivoPolizaMin} AND $P{pConsecutivoPolizaMax}
GROUP BY PN.CLVPOL, 
		PN.FECPOL,
		PN.STAPOL,
		PN.STAAFE,
		PN.TIPPOL,
		PN.MESPOL,
		PN.CONPOL,
		PN.CAPPOL,
		PN.POLCLV1,
		PD.RENPOL,
		PD.CUENTA,
		PD.SCTA,
		PD.SSCTA,
		PD.SSSCTA,
		PD.SSSSCTA,
		PD.REFPOL,
		PD.DN,
		PD.CONCEP,
		PD.CANPOL,
		PD.CANPOLH,
		TU.NOMBRE]]></query>
