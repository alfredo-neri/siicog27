<jasperReport name="activo" language="java" columnCount="1" dpi="72" pageWidth="792" pageHeight="612" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="792" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" whenResourceMissingType="Error" uuid="adb6b51c-30dd-49dc-bc70-4989735dd919">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Zayra"/>
	<parameter name="p_Idsector" class="java.lang.Integer"/>
	<parameter name="decimalFormat" class="java.lang.String"/>
	<parameter name="pesos" class="java.lang.Integer"/>
	<parameter name="year" class="java.lang.Integer"/>
	<query language="sql"><![CDATA[SELECT
	SUBSTR(C.CUENTA,1,2)GRUPO, C.STACTA NATCTA, C.NOMCTA, 
	C.CUENTA, C.SALINIANT, C.SALINI, 
	SUM(C.CARGOS_1 + C.CARGOS_2 + C.CARGOS_3 + C.CARGOS_4 + 
		C.CARGOS_5 + C.CARGOS_6 + C.CARGOS_7 + C.CARGOS_8 + 
		C.CARGOS_9 + C.CARGOS_10 + C.CARGOS_11) CARGOS_ANT, 
	SUM(C.ABONOS_1 + C.ABONOS_2 + C.ABONOS_3 + C.ABONOS_4 + 
		C.ABONOS_5 + C.ABONOS_6 + C.ABONOS_7 + C.ABONOS_8 + 
		C.ABONOS_9 + C.ABONOS_10 + C.ABONOS_11) ABONOS_ANT, 
	SUM(C.ABONOS_1 + C.ABONOS_2 + C.ABONOS_3 + C.ABONOS_4 + 
		C.ABONOS_5 + C.ABONOS_6 + C.ABONOS_7 + C.ABONOS_8 + 
		C.ABONOS_9 + C.ABONOS_10 + C.ABONOS_11 + C.ABONOS_12) ABONOS_ACT, 
	SUM(C.CARGOS_1 + C.CARGOS_2 + C.CARGOS_3 + C.CARGOS_4 + 
		C.CARGOS_5 + C.CARGOS_6 + C.CARGOS_7 + C.CARGOS_8 +
		C.CARGOS_9 + C.CARGOS_10 + C.CARGOS_11 + C.CARGOS_12) CARGOS_ACT
FROM CUENTA C
WHERE	C.CUENTA >= '1000' 
	AND C.CUENTA <= '1293' 
	AND C.SCTA = '' 
	AND C.IDSECTOR = $P{p_Idsector}
GROUP BY
	C.STACTA, C.NOMCTA, C.CUENTA, C.SALINIANT, C.SALINI, SUBSTR(C.CUENTA,1,2)
ORDER BY
	C.CUENTA]]></query>
	<field name="GRUPO" class="java.lang.String"/>
	<field name="NATCTA" class="java.lang.String"/>
	<field name="NOMCTA" class="java.lang.String"/>
	<field name="CUENTA" class="java.lang.String"/>
	<field name="SALINIANT" class="java.math.BigDecimal"/>
	<field name="CARGOS_ANT" class="java.math.BigDecimal"/>
	<field name="ABONOS_ANT" class="java.math.BigDecimal"/>
	<field name="ABONOS_ACT" class="java.math.BigDecimal"/>
	<field name="CARGOS_ACT" class="java.math.BigDecimal"/>
	<field name="SALINI" class="java.math.BigDecimal"/>
	<variable name="v_Grupo" class="java.lang.String">
		<expression><![CDATA[$F{GRUPO}.equals("11")
?
("ACTIVO PASIVO")
:
("ACTIVO NO PASIVO")]]></expression>
	</variable>
	<variable name="v_MesAnt" class="java.math.BigDecimal">
		<expression><![CDATA[$P{pesos} == 1 ?


	
	$F{SALINIANT} 
:
	
	$F{SALINIANT}.divide(new BigDecimal("1000.0"))]]></expression>
	</variable>
	<variable name="v_MesAct" class="java.math.BigDecimal">
		<expression><![CDATA[$P{pesos} == 1 ?
$F{NATCTA}.toUpperCase().equals("D")?(
	($F{SALINI}.add($F{CARGOS_ACT}).subtract($F{ABONOS_ACT}))
)
:
(
	($F{CUENTA}.substring(0,2).equals("12")  || $F{CUENTA}.substring(0,3).equals("116"))  && $F{NATCTA}.toUpperCase().equals("A")?
		($F{SALINI}.multiply(new BigDecimal (-1)).add($F{CARGOS_ACT}).subtract($F{ABONOS_ACT}))
	:
	
       ($F{CUENTA}.equals("1115")  )?(
 	($F{SALINI}.add($F{CARGOS_ACT}).subtract($F{ABONOS_ACT}))
 ):
      ($F{SALINI}.subtract($F{CARGOS_ACT}).add($F{ABONOS_ACT})) 

)
:
$F{NATCTA}.toUpperCase().equals("D")?(
	($F{SALINI}.add($F{CARGOS_ACT}).subtract($F{ABONOS_ACT})).divide(new BigDecimal("1000.0"))
)
:
(
	($F{CUENTA}.substring(0,2).equals("12")  || $F{CUENTA}.substring(0,3).equals("116"))  && $F{NATCTA}.toUpperCase().equals("A")?
		($F{SALINI}.multiply(new BigDecimal (-1)).add($F{CARGOS_ACT}).subtract($F{ABONOS_ACT})).divide(new BigDecimal("1000.0"))
	:
	
       ($F{CUENTA}.equals("1115")  )?(
 	($F{SALINI}.add($F{CARGOS_ACT}).subtract($F{ABONOS_ACT})).divide(new BigDecimal("1000.0"))
 ):
      ($F{SALINI}.subtract($F{CARGOS_ACT}).add($F{ABONOS_ACT})) .divide(new BigDecimal("1000.0"))

)]]></expression>
	</variable>
	<variable name="v_Variacion" class="java.math.BigDecimal">
		<expression><![CDATA[$V{v_MesAct}.subtract($V{v_MesAnt})]]></expression>
	</variable>
	<variable name="v_Total" class="java.lang.String">
		<expression><![CDATA[($F{GRUPO}.equals("11"))?(
	("TOTAL ACTIVO CIRCULANTE")
):
(
	($F{GRUPO}.equals("12")?("TOTAL ACTIVO NO CIRCULANTE")
		:
		("TOTAL OTROS ACTIVOS")
		
	)
	
)]]></expression>
	</variable>
	<variable name="v_SumaMesAnt" resetType="Group" calculation="Sum" resetGroup="Group1" class="java.math.BigDecimal">
		<expression><![CDATA[$F{CUENTA}.substring(3).equals("0") ? BigDecimal.ZERO : $V{v_MesAnt}]]></expression>
	</variable>
	<variable name="v_SumMesAct" resetType="Group" calculation="Sum" resetGroup="Group1" class="java.math.BigDecimal">
		<expression><![CDATA[$F{CUENTA}.substring(3).equals("0") ? BigDecimal.ZERO :  $V{v_MesAct}]]></expression>
	</variable>
	<variable name="v_SumVar" resetType="Group" calculation="Sum" resetGroup="Group1" class="java.math.BigDecimal">
		<expression><![CDATA[$F{CUENTA}.substring(3).equals("0") ? BigDecimal.ZERO :  $V{v_Variacion}]]></expression>
	</variable>
	<variable name="vSalini" class="java.math.BigDecimal">
		<expression><![CDATA[($F{CUENTA}.equals("1162") || $F{CUENTA}.equals("1261")|| $F{CUENTA}.equals("1263") )?
    ($F{SALINIANT}.multiply(new BigDecimal (-1))):
    ($F{SALINIANT})]]></expression>
	</variable>
	<variable name="v_SumaTotalMesAnt" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{CUENTA}.substring(3).equals("0") ? BigDecimal.ZERO :  $V{v_MesAnt}]]></expression>
	</variable>
	<variable name="v_SumaTotalMesAct" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{CUENTA}.substring(3).equals("0") ? BigDecimal.ZERO :  $V{v_MesAct}]]></expression>
	</variable>
	<variable name="v_SumaTotalVar" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{CUENTA}.substring(3).equals("0") ? BigDecimal.ZERO :  $V{v_Variacion}]]></expression>
	</variable>
