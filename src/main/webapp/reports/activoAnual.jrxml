		<groupFooter>
			<band height="20">
				<element kind="staticText" uuid="c506436b-d550-4ffb-b9c1-2db088a01734" x="0" y="0" width="179" height="20" stretchType="NoStretch" fontName="Arial" fontSize="9.0" bold="true" hTextAlign="Right" vTextAlign="Middle">
