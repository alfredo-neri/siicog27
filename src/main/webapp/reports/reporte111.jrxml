	<query language="SQL"><![CDATA[SELECT TRIMESTRE, AGUA, POBLACION, ACUMAGUA, OBSAGUA, OBSPOB
FROM PM2511
WHERE TRIMESTRE = $P{TRIMESTRE}
AND IDSECTOR = $P{SECTOR}]]></query>
