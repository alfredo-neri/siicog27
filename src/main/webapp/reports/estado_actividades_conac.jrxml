	</variable>
	<variable name="vTotalIngresosActual" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{GRUPO} <= 3 ?$F{SALDO_ACT} : BigDecimal.ZERO]]></expression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="vTotalPerdidasActual" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{GRUPO} > 3   ?$F{SALDO_ACT} : BigDecimal.ZERO]]></expression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="vTotalIngresosAnt" calculation="Sum" class="java.math.BigDecimal">
