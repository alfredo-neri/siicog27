	</variable>
	<variable name="vTotalPerdidasAnt" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{GRUPO} >  3 &&  $F{GRUPO} <=9 ?$F{SALDO_ANT} : BigDecimal.ZERO]]></expression>
