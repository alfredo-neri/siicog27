	<query language="sql"><![CDATA[SELECT	SEMES,
				MANORGNO,
				MANORGPRO,
				MANORGSI,
				MANORGVIG,
				ORGNO,
				ORGPRO,
				ORGSI,
				ORGVIG,
				REGNO,
				REGPRO,
				REGSI,
				REGVIG,
				MANPRONO,
				MANPROPRO,
				MANPROSI,
				MANPROVIG,
				OBSMANPRO,
				PERINIMO,
				PERFINMO,
				OBSERVACIONES,
				PERINIO,
				PERFINO,
				PREINIREG,
				PERFINREG,
				PERINIMAN,
				PERFINMAN
	FROM  PM3911
WHERE  SEMES  = $P{semestre}
	AND IDSECTOR=$P{idSector}]]></query>
