	<query language="sql"><![CDATA[SELECT PM.ANUAL,
       PM.NJML,
       PM.TJIL,
       PM.NJMC,
       PM.TJIC,
       PM.NJMA,
       PM.TJIA,
       PM.NJMD,
       PM.TJID,
       PM.OBSNJM,
       PM.OBSTJI,
       PM.TOTJUGA,
       PM.TOTJUCON
    FROM PM0111 PM
    WHERE PM.IDSECTOR = $P{pIdSector}
          AND PM.ANUAL=$P{pAnio}]]></query>
	<field name="ANUAL" class="java.lang.Integer"/>
