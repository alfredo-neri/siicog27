	<parameter name="firmaN1" class="java.lang.String"/>
	<parameter name="firmaL2" class="java.lang.String"/>
	<parameter name="firmaN2" class="java.lang.String"/>
	<parameter name="firmaL3" class="java.lang.String"/>
	<parameter name="firmaN3" class="java.lang.String"/>
	<parameter name="firmaL4" class="java.lang.String"/>
	<parameter name="firmaN4" class="java.lang.String"/>
	<parameter name="firmaL5" class="java.lang.String"/>
	<parameter name="firmaN5" class="java.lang.String"/>
	<query language="sql"><![CDATA[SELECT 
 SUBSTR(P.CLAVE,1,3) DG
, SUBSTR(P.CLAVE,4,3) DA
, SUBSTR(P.PROGRAMA,1,2) FIN
, SUBSTR(P.PROGRAMA,3,2) FUN
, SUBSTR(P.PROGRAMA,5,2) SFN
, SUBSTR(P.PROGRAMA,7,2) PG
, SUBSTR(P.PROGRAMA,9,2) SPG
, SUBSTR(P.PROGRAMA,11,2) PY
, SUBSTR(P.PROGRAMA,13,3) FF
, DECODE(SUBSTR(P.PARTIDA,2,3),'000',P.PARTIDA,'') CAPITULO
, DECODE(SUBSTR(P.PARTIDA,2,3),'000','',P.PARTIDA) CUENTA
, P.PARTIDA
, P.AUTO1_1
, P.AUTO1_2
, P.AUTO1_3
, P.AUTO1_4
, P.AUTO1_5
, P.AUTO1_6
, P.AUTO1_7
, P.AUTO1_8
, P.AUTO1_9
, P.AUTO1_10
, P.AUTO1_11
, P.AUTO1_12
, (P.AUTO1_1 + P.AUTO1_2 + P.AUTO1_3 + P.AUTO1_4 + P.AUTO1_5 + P.AUTO1_6 + P.AUTO1_7 + P.AUTO1_8 + P.AUTO1_9 + P.AUTO1_10 + P.AUTO1_11 + P.AUTO1_12)  PRESUPUESTADO
, N.NOMGAS
, F.CLVFTE
FROM PASO P, NATGAS N, FUENTEF F
WHERE  P.PARTIDA= N.CLVGAS
AND SUBSTR(P.PROGRAMA,13,3) = F.LIGA
AND N.IDSECTOR = P.IDSECTOR
AND F.IDSECTOR = P.IDSECTOR
AND P.IDSECTOR= $P{sector} 
ORDER BY P.CLAVE,P.PROGRAMA, P.PARTIDA]]></query>
