	<query language="sql"><![CDATA[SELECT 	SUBSTR(P.CLAVE,1,3) DG, SUBSTR(P.CLAVE,4,3) DA, SUBSTR(P.PROGRAMA,1,2) FIN, 
		SUBSTR(P.PROGRAMA,3,2) FUN, SUBSTR(P.PROGRAMA,5,2) SFN, SUBSTR(P.PROGRAMA,7,2) PG, 
		SUBSTR(P.PROGRAMA,9,2) SPG, SUBSTR(P.PROGRAMA,11,2) PY, SUBSTR(P.PROGRAMA,13,3) FF, 
		DECODE(SUBSTR(P.PARTIDA,2,3),'000',P.PARTIDA,'') CAPITULO, 
		DECODE(SUBSTR(P.PARTIDA,2,3),'000','',P.PARTIDA) CUENTA, P.PARTIDA, 
		P.AUTORIZADO_1, P.AUTORIZADO_2, P.AUTORIZADO_3, P.AUTORIZADO_4, 
		P.AUTORIZADO_5, P.AUTORIZADO_6, P.AUTORIZADO_7, P.AUTORIZADO_8, 
		P.AUTORIZADO_9, P.AUTORIZADO_10, P.AUTORIZADO_11, P.AUTORIZADO_12, 
		P.AUTORIZADO_13  PRESUPUESTADO, N.NOMGAS, F.CLVFTE
	FROM TW_ANTEPROYECTO P 
		LEFT JOIN NATGAS N ON  P.PARTIDA = N.CLVGAS AND P.IDSECTOR = N.IDSECTOR
		LEFT JOIN FUENTEF F ON SUBSTR(P.PROGRAMA,13,3) = F.LIGA AND P.IDSECTOR = F.IDSECTOR
WHERE 
	P.IDSECTOR =  $P{sector} 
ORDER BY P.CLAVE, P.PROGRAMA, P.PARTIDA]]></query>
