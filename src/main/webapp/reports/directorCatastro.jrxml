					<rightPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<text><![CDATA[Adjuntar a este formato la documentación que avale la experiencia para ocupar el puesto Nombramientos en Administraciones Municipales anteriores ]]></text>
			</element>
			<element kind="staticText" uuid="6b74a377-8862-420d-b66a-43072f7e5337" x="465" y="79" width="395" height="109" stretchType="NoStretch" fontName="Arial" fontSize="15.0" hTextAlign="Left" vTextAlign="Middle">
