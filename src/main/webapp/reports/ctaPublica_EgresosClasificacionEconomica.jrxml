<jasperReport name="tipoGasto" language="java" columnCount="1" dpi="72" pageWidth="832" pageHeight="612" orientation="Landscape" columnWidth="792" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="afe48764-c43f-48aa-934c-aab556d3c252">
