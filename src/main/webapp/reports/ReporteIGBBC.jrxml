	<queryString>
		<![CDATA[SELECT BC.MES,
       BC.CONSEC,
       BC.CUENTA,
       BC.SSSCTA,
       BC.NOMCTA,
       BC.INVENTARIO,
       BC.RESGUARDO,
       BC.RESGUARDATARIO,
       BC.NOMMUEBLE,
       BC.MARCA,
       BC.MODELO,
       BC.SERIE,
       BC.ESTADO,
       BC.FACTURA,
       BC.FECFACTURA,
       BC.PROVEEDOR,
       BC.COSTO,
       BC.TIPPOL,
       BC.FECPOL,
       BC.CONPOL,
       BC.RECURSO,
       BC.FECALTA,
       BC.FECBAJA,
       BC.AREA,
       BC.LOCALIDAD,
       BC.OBS,
       BC.TVIDAUTIL,
       BC.DEPREPERIODO,
       BC.DEPREACUM
 FROM BIENESBC BC
 WHERE BC.IDSECTOR=$P{pIdSector}
      AND BC.MES<=$P{pSemestre}
       ORDER BY BC.MES, BC.CONSEC  ASC]]>
	</queryString>
