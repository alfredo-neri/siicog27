             + c.cargos_8 + c.cargos_9 + c.cargos_10 + c.cargos_11
             - c.abonos_1 - c.abonos_2 - c.abonos_3 - c.abonos_4 - c.abonos_5 - c.abonos_6 - c.abonos_7
