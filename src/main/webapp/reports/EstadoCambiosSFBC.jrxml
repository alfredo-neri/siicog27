             + c.abonos_1 + c.abonos_2 + c.abonos_3 + c.abonos_4 + c.abonos_5 + c.abonos_6 + c.abonos_7 + c.abonos_8 + c.abonos_9 + c.abonos_10 + c.abonos_11 + c.abonos_12)

             END

