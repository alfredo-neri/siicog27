	<query language="sql"><![CDATA[WITH pasivo AS (

SELECT

c.cuenta AS cuenta,

c.nomcta AS nomcta,



to_number(
CASE  WHEN maycta.natcta = 'D'
	THEN CASE
             WHEN 1 <= $P{MES}   THEN
             to_char(c.salini + c.cargos_1 - c.abonos_1)
             WHEN 2 <= $P{MES}   THEN
             to_char(c.salini + c.cargos_1 + c.cargos_2 - c.abonos_1 - c.abonos_2)
             WHEN 3 <= $P{MES}   THEN
