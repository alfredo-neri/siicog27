			<element kind="textField" uuid="6ce5c44b-c4a3-4e4b-a1ef-6ef7fd9a9803" x="352" y="1" width="100" height="15" stretchType="NoStretch" fontSize="10.0" pattern="#,##0.00;-#,##0.00" blankWhenNull="true" hTextAlign="Right">
