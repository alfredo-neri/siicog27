	<query language="sql"><![CDATA[SELECT OB.FN,OB.FUN,OB.SUBFUN,OB.PROG,OB.SUBPROG,OB.PROY,FF.CLVFTE,
OB.NCONTROL, OB.NOMOBRA, OB.TIPOEJEC, OB.UBICACION, OB.JUSTIFICACION, OB.POBLACION,OB.TIPOASIG, 
(AUTO_1 + AUTO_2 + AUTO_3 + AUTO_4 + AUTO_5 + AUTO_6 + AUTO_7 + AUTO_8 + AUTO_9 + AUTO_10 + AUTO_11 + AUTO_12) TOTAL,
AUTO_1,
AUTO_2,
AUTO_3,
AUTO_4,
AUTO_5,
AUTO_6,
AUTO_7,
AUTO_8,
AUTO_9,
AUTO_10,
AUTO_11,
AUTO_12
FROM OBRAS AS OB
INNER JOIN FUENTEF  AS FF ON OB.FFIN = FF.LIGA
WHERE OB.IDSECTOR = FF.IDSECTOR AND OB.IDSECTOR=$P{idSector}
ORDER BY OB.NCONTROL]]></query>
