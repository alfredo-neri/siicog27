	<variable name="queryDetails" class="java.lang.String">
		<variableExpression><![CDATA[$P{pesos} == 1 ?"SELECT CUENTA, SCTA, SSCTA, SSSCTA, SSSSCTA, CONCEP, CANPOL, CANPOLH, FECPOL FROM POLIDE WHERE IDSECTOR =" + $P{sector} +" AND CUENTA = '"+$F{CUENTA}+"' AND SCTA='"+$F{SCTA}+"' AND SSCTA='"+$F{SSCTA}+"' AND SSSCTA='"+$F{SSSCTA}+"' AND SSSSCTA='"+$F{SSSSCTA}+"' ORDER BY MESPOL, TIPPOL, CONPOL" : "SELECT CUENTA, SCTA, SSCTA, SSSCTA, SSSSCTA, CONCEP, (CANPOL / 1000) CANPOL, (CANPOLH / 1000) CANPOLH, FECPOL FROM POLIDE WHERE IDSECTOR =" + $P{sector} +" AND CUENTA = '"+$F{CUENTA}+"' AND SCTA='"+$F{SCTA}+"' AND SSCTA='"+$F{SSCTA}+"' AND SSSCTA='"+$F{SSSCTA}+"' AND SSSSCTA='"+$F{SSSSCTA}+"' ORDER BY MESPOL, TIPPOL, CONPOL"]]></variableExpression>
	</variable>
