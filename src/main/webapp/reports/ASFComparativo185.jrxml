			<element kind="textField" uuid="02c25471-4245-40fd-9a14-9d12fffa9284" x="460" y="0" width="88" height="15" stretchType="NoStretch" fontName="Arial" fontSize="8.0" pattern="#,##0.00" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle">
