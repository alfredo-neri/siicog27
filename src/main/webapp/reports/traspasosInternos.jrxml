	<variable name="queryReducciones" class="java.lang.String">
		<expression><![CDATA[String.format("SELECT T1.PROGRAMA, F.CLVFTE FUENTE, T1.PARTIDA, P.DESCRIPCION MES_NAME, T1.IMPORTE FROM ( SELECT 	SUBSTR(P.PROGRAMA,1,8) PROGRAMA, SUBSTR(P.PROGRAMA,13,3) FUENTE, P.PARTIDA, %4$s MES, P.REDU1_%4$s IMPORTE FROM PASO P WHERE SUBSTR(P.PARTIDA,4,1) <> '0' AND  P.IDSECTOR = %1$s AND P.CLAVE = '%2$s' AND P.PROGRAMA = '%3$s' UNION SELECT 	SUBSTR(P.PROGRAMA,1,8) PROGRAMA, SUBSTR(P.PROGRAMA,13,3) FUENTE, P.PARTIDA, %5$s , P.REDU1_%5$s FROM PASO P WHERE SUBSTR(P.PARTIDA,4,1) <> '0' AND P.IDSECTOR = %1$s AND P.CLAVE = '%2$s' AND P.PROGRAMA = '%3$s' UNION SELECT 	SUBSTR(P.PROGRAMA,1,8) PROGRAMA, SUBSTR(P.PROGRAMA,13,3) FUENTE, P.PARTIDA, %6$s , P.REDU1_%6$s FROM PASO P  WHERE SUBSTR(P.PARTIDA,4,1) <> '0' AND P.IDSECTOR = %1$s AND P.CLAVE = '%2$s' AND P.PROGRAMA = '%3$s' ) T1 INNER JOIN TC_PERIODO P ON T1.MES = P.PERIODO AND P.TIPO_PERIODO = 1 INNER JOIN FUENTEF F ON T1.FUENTE = F.LIGA AND F.IDSECTOR = %1$s WHERE T1.IMPORTE <> 0 ORDER BY T1.MES", $P{sector}, $F{CLAVE}, $F{PROGRAMA}, $P{mesInicial}, $P{mesInicial} +1, $P{mesInicial} +2)]]></expression>
	</variable>
	<variable name="queryAmpliaciones" class="java.lang.String">
		<expression><![CDATA[String.format("SELECT T1.PROGRAMA, F.CLVFTE FUENTE, T1.PARTIDA, P.DESCRIPCION MES_NAME, T1.IMPORTE FROM ( SELECT 	SUBSTR(P.PROGRAMA,1,8) PROGRAMA, SUBSTR(P.PROGRAMA,13,3) FUENTE, P.PARTIDA, %4$s MES, P.AMPLI1_%4$s IMPORTE FROM PASO P WHERE SUBSTR(P.PARTIDA,4,1) <> '0' AND P.IDSECTOR = %1$s AND P.CLAVE = '%2$s' AND P.PROGRAMA = '%3$s' UNION SELECT SUBSTR(P.PROGRAMA,1,8) PROGRAMA, SUBSTR(P.PROGRAMA,13,3) FUENTE, P.PARTIDA, %5$s , P.AMPLI1_%5$s FROM PASO P WHERE SUBSTR(P.PARTIDA,4,1) <> '0' AND P.IDSECTOR = %1$s AND P.CLAVE = '%2$s' AND P.PROGRAMA = '%3$s' UNION SELECT SUBSTR(P.PROGRAMA,1,8) PROGRAMA, SUBSTR(P.PROGRAMA,13,3) FUENTE, P.PARTIDA, %6$s , P.AMPLI1_%6$s FROM PASO P WHERE SUBSTR(P.PARTIDA,4,1) <> '0' AND P.IDSECTOR = %1$s AND P.CLAVE = '%2$s' AND P.PROGRAMA = '%3$s' ) T1 INNER JOIN TC_PERIODO P ON T1.MES = P.PERIODO AND P.TIPO_PERIODO = 1 INNER JOIN FUENTEF F ON T1.FUENTE = F.LIGA AND F.IDSECTOR = %1$s WHERE T1.IMPORTE <> 0 ORDER BY T1.MES", $P{sector}, $F{CLAVE}, $F{PROGRAMA}, $P{mesInicial}, $P{mesInicial} +1, $P{mesInicial} +2)]]></expression>
	</variable>
	<group name="Group" startNewPage="true">
