<jasperReport name="estado_ambios_ituacion_financiera_conac" language="java" columnCount="1" dpi="72" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="3f9bc3ac-b684-472d-9a88-92e59705bf44">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="data base 24"/>
	<parameter name="ente" class="java.lang.String"/>
