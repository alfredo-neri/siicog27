	<parameter name="month" class="java.lang.String"/>
	<parameter name="year" class="java.lang.Integer"/>
	<parameter name="img1" class="java.lang.String"/>
	<parameter name="img2" class="java.lang.String"/>
	<parameter name="sSql" class="java.lang.String"/>
	<parameter name="noFirmas" class="java.lang.Integer"/>
	<parameter name="firmaL1" class="java.lang.String"/>
	<parameter name="firmaN1" class="java.lang.String"/>
	<parameter name="firmaL2" class="java.lang.String"/>
	<parameter name="firmaN2" class="java.lang.String"/>
	<parameter name="firmaL3" class="java.lang.String"/>
	<parameter name="firmaN3" class="java.lang.String"/>
	<parameter name="firmaL4" class="java.lang.String"/>
	<parameter name="firmaN4" class="java.lang.String"/>
	<parameter name="firmaL5" class="java.lang.String"/>
	<parameter name="firmaN5" class="java.lang.String"/>
	<query language="SQL"><![CDATA[SELECT CASE WHEN CUENTA = '2110' THEN 2 ELSE 1 END PRINCIPAL, CASE WHEN CUENTA = '1111' THEN 1 WHEN CUENTA = '1123' THEN 1 WHEN CUENTA = '1241' THEN 2 WHEN CUENTA = '1263' THEN 2 WHEN CUENTA = '2110' THEN 3 END GRUPO, CASE WHEN CUENTA = '1111' THEN 1 WHEN CUENTA = '1123' THEN 2 WHEN CUENTA = '1241' THEN 4 WHEN CUENTA = '1263' THEN 6 WHEN CUENTA = '2110' THEN 1 END ORDEN, NOMBRE, CASE WHEN CUENTA = '1111' THEN TOTAL*-1 WHEN CUENTA = '1123' THEN 0.00 WHEN CUENTA = '1241' THEN TOTAL*-1 WHEN CUENTA = '1263' THEN 0.00 WHEN CUENTA = '2110' THEN TOTAL*-1 END ORIGEN, CASE WHEN CUENTA = '1111' THEN 0.00 WHEN CUENTA = '1123' THEN TOTAL WHEN CUENTA = '1241' THEN 0.00 WHEN CUENTA = '1263' THEN TOTAL WHEN CUENTA = '2110' THEN 0.00 END APLICACION FROM( SELECT CUENTA,NOMBRE,  (SUM(SALINI)+SUM(CARGOS_ACT)-SUM(ABONOS_ACT))- (SUM(SALINI)+SUM(CARGOS_ANT)-SUM(ABONOS_ANT)) TOTAL FROM( SELECT CASE  WHEN GRUPO = 11 AND CUENTA IN ('1111','1112') THEN '1111' WHEN GRUPO = 11 AND CUENTA = '1123' THEN '1123' WHEN GRUPO = 11 AND CUENTA = '1191' THEN '1191' WHEN GRUPO = 12 AND NATCTA = 'D' THEN '1241' WHEN GRUPO = 12 AND NATCTA = 'A' THEN '1263' WHEN GRUPO = 21 AND NATCTA = '' THEN '2110' END CUENTA, CASE  WHEN GRUPO = 11 AND CUENTA IN ('1111','1112') THEN 'Efectivo y Equivalentes' WHEN GRUPO = 11 AND CUENTA = '1123' THEN 'Derechos a Recibir Efectivo o Equivalentes' WHEN GRUPO = 11 AND CUENTA = '1191' THEN 'Otros Activos Circulantes' WHEN GRUPO = 12 AND NATCTA = 'D' THEN 'Bienes Muebles' WHEN GRUPO = 12 AND NATCTA = 'A' THEN 'Depreciación, Deterioro y Amortización Acumulada de Bienes' WHEN GRUPO = 21 AND NATCTA = '' THEN 'Cuentas por Pagar a Corto Plazo' 
END NOMBRE, SALINI, SALINI_ANT, CARGOS_ANT,ABONOS_ANT,CARGOS_ACT,ABONOS_ACT 
FROM ( SELECT 		 SUBSTR(C.CUENTA,1,2)GRUPO, MA.NATCTA,  C.NOMCTA,  C.CUENTA,   C.SALINI,  CA.SALINI SALINI_ANT,  
SUM(CA.CARGOS_1 + CA.CARGOS_2 + CA.CARGOS_3 + CA.CARGOS_4 + CA.CARGOS_5 + CA.CARGOS_6 + CA.CARGOS_7 + CA.CARGOS_8 + CA.CARGOS_9 + CA.CARGOS_10 + CA.CARGOS_11 + CA.CARGOS_12) CARGOS_ANT, 
SUM(CA.ABONOS_1 + CA.ABONOS_2 + CA.ABONOS_3 + CA.ABONOS_4 + CA.ABONOS_5 + CA.ABONOS_6 + CA.ABONOS_7 + CA.ABONOS_8 + CA.ABONOS_9 + CA.ABONOS_10 + CA.ABONOS_11 + CA.ABONOS_12) ABONOS_ANT, 
SUM(C.ABONOS_1 + C.ABONOS_2 + C.ABONOS_3 + C.ABONOS_4 + C.ABONOS_5 + C.ABONOS_6 + C.ABONOS_7 + C.ABONOS_8 + C.ABONOS_9 + C.ABONOS_10 + C.ABONOS_11 + C.ABONOS_12) ABONOS_ACT, 
SUM(C.CARGOS_1 + C.CARGOS_2 + C.CARGOS_3 + C.CARGOS_4 + C.CARGOS_5 + C.CARGOS_6 + C.CARGOS_7 + C.CARGOS_8 + C.CARGOS_9 + C.CARGOS_10 + C.CARGOS_11 + C.CARGOS_12) CARGOS_ACT 
FROM   MAYCTA MA INNER JOIN CUENTA C ON MA.CUENTA = C.CUENTA  INNER JOIN CUENTA_ANTERIOR CA ON CA.CUENTA = C.CUENTA  AND CA.SCTA = C.SCTA AND CA.IDSECTOR = C.IDSECTOR WHERE  C.CUENTA IN ('1111','1112','1123', '1241','1242','1244','1246','1263', '2110') AND C.SCTA = ''  AND C.IDSECTOR = 2 GROUP BY  MA.NATCTA,  C.NOMCTA,  C.CUENTA,   C.SALINI,  CA.SALINI,  SUBSTR(C.CUENTA,1,2) ORDER BY C.CUENTA)) GROUP BY CUENTA,NOMBRE ) UNION SELECT 3 PRINCIPAL, 6 GRUPO, 1 ORDEN, 'Resultados del Ejercicio (Ahorro/Desahorro)' NOMBRE, 0.00 ORIGEN, ((SUM(T3.VACT4)-SUM(T3.VACT5))-(SUM(T3.VAN4)-SUM(T3.VAN5)))*-1 APLICACION FROM ( SELECT CASE WHEN T2.GRUPO='4' THEN SUM(T2.VMANT) ELSE 0.00 END VAN4, CASE WHEN T2.GRUPO='5' THEN SUM(T2.VMANT) ELSE 0.00 END VAN5, CASE WHEN T2.GRUPO='4' THEN SUM(T2.VMACT) ELSE 0.00 END VACT4, CASE WHEN T2.GRUPO='5' THEN SUM(T2.VMACT) ELSE 0.00 END VACT5 FROM ( SELECT T1.GRUPO, T1.SALINI, CASE WHEN T1.GRUPO ='4' THEN (T1.SALINI+ABONOS_ANT-CARGOS_ANT) ELSE  (T1.SALINI-ABONOS_ANT+CARGOS_ANT) END VMANT, CASE WHEN T1.GRUPO ='4' THEN (T1.SALINI+ABONOS_ACT-CARGOS_ACT) ELSE  (T1.SALINI-ABONOS_ACT+CARGOS_ACT) END VMACT FROM ( SELECT SUBSTR(C.CUENTA,1,1) GRUPO, C.CUENTA CUENTA , C.SALINI SALINI, CA.SALINI SALINI_ANT, 
SUM(CA.CARGOS_1 + CA.CARGOS_2 + CA.CARGOS_3 + CA.CARGOS_4 + CA.CARGOS_5 + CA.CARGOS_6 + CA.CARGOS_7 + CA.CARGOS_8 + CA.CARGOS_9 + CA.CARGOS_10 + CA.CARGOS_11 + CA.CARGOS_12) CARGOS_ANT, 
SUM(CA.ABONOS_1 + CA.ABONOS_2 + CA.ABONOS_3 + CA.ABONOS_4 + CA.ABONOS_5 + CA.ABONOS_6 + CA.ABONOS_7 + CA.ABONOS_8 + CA.ABONOS_9 + CA.ABONOS_10 + CA.ABONOS_11 + CA.ABONOS_12) ABONOS_ANT, 
SUM(C.CARGOS_1 + C.CARGOS_2 + C.CARGOS_3 + C.CARGOS_4 + C.CARGOS_5 + C.CARGOS_6 + C.CARGOS_7 + C.CARGOS_8 + C.CARGOS_9 + C.CARGOS_10 + C.CARGOS_11 + C.CARGOS_12) CARGOS_ACT, 
SUM(C.ABONOS_1 + C.ABONOS_2 + C.ABONOS_3 + C.ABONOS_4 + C.ABONOS_5 + C.ABONOS_6 + C.ABONOS_7 + C.ABONOS_8 + C.ABONOS_9 + C.ABONOS_10 + C.ABONOS_11 + C.ABONOS_12) ABONOS_ACT FROM CUENTA C INNER JOIN CUENTA_ANTERIOR CA ON CA.CUENTA = C.CUENTA  AND CA.SCTA = C.SCTA AND CA.IDSECTOR = C.IDSECTOR WHERE C.IDSECTOR= 2 AND ( ( (SUBSTR(C.CUENTA,1,1) =4 AND SUBSTR(C.CUENTA,4,1)<>'0') OR (SUBSTR(C.CUENTA,1,1) = 5 AND SUBSTR(C.CUENTA,2,1) > 0) ) AND C.SCTA ='') GROUP BY C.CUENTA, C.SALINI, CA.SALINI ORDER BY C.CUENTA)T1)T2 GROUP BY T2.GRUPO )T3 UNION ALL SELECT * FROM ( VALUES (1, 1, 3, 'Derechos a Recibir Bienes o Servicios', 0.00, 0.00), (1, 1, 4, 'Inventarios', 0.00, 0.00), (1, 1, 5, 'Almacenes', 0.00, 0.00), (1, 1, 6, 'Estimación por Pérdida o Deterioro de Activos Circulantes', 0.00, 0.00), (1, 1, 7, 'Otros Activos Circulantes', 0.00, 0.00), (1, 2, 1, 'Inversiones Financieras a Largo Plazo', 0.00, 0.00), (1, 2, 2, 'Derechos a Recibir Efectivo o Equivalentes a Largo Plazo', 0.00, 0.00), (1, 2, 3, 'Bienes Inmuebles, Infraestructura y Construcciones en Proceso', 0.00, 0.00), (1, 2, 5, 'Activos Intangibles', 0.00, 0.00), (1, 2, 7, 'Activos Diferidos', 0.00, 0.00), (1, 2, 8, 'Estimación por Pérdida o Deterioro de Activos no Circulantes', 0.00, 0.00), (1, 2, 9, 'Otros Activos no Circulantes', 0.00, 0.00), (2, 3, 2, 'Documentos por Pagar a Corto Plazo', 0.00, 0.00), (2, 3, 3, 'Porción a Corto Plazo de la Deuda Pública a Largo Plazo', 0.00, 0.00), (2, 3, 4, 'Títulos y Valores a Corto Plazo', 0.00, 0.00), (2, 3, 5, 'Pasivos Diferidos a Corto Plazo', 0.00, 0.00), (2, 3, 6, 'Fondos y Bienes de Terceros en Garantía y/o Administración a Corto Plazo', 0.00, 0.00), (2, 3, 7, 'Provisiones a Corto Plazo', 0.00, 0.00), (2, 3, 8, 'Otros Pasivos a Corto Plazo', 0.00, 0.00), (2, 4, 1, 'Cuentas por Pagar a Largo Plazo', 0.00, 0.00), (2, 4, 2, 'Documentos por Pagar a Largo Plazo', 0.00, 0.00), (2, 4, 3, 'Deuda Pública a Largo Plazo', 0.00, 0.00), (2, 4, 4, 'Pasivos Diferidos a Largo Plazo', 0.00, 0.00), (2, 4, 5, 'Fondos y Bienes de Terceros en Garantía y/o en Administración a Largo Plazo', 0.00, 0.00), (2, 4, 6, 'Provisiones a Largo Plazo', 0.00, 0.00), (3, 5, 1, 'Aportaciones', 0.00, 0.00), (3, 5, 2, 'Donaciones de Capital', 0.00, 0.00), (3, 5, 3, 'Actualización de la Hacienda Pública/Patrimonio', 0.00, 0.00), (3, 6, 2, 'Resultados de Ejercicios Anteriores', 0.00, 0.00), (3, 6, 3, 'Revalúos', 0.00, 0.00), (3, 6, 4, 'Reservas', 0.00, 0.00), (3, 6, 5, 'Rectificaciones de Resultados de Ejercicios Anteriores', 0.00, 0.00), (3, 7, 1, 'Resultado por Posición Monetaria', 0.00, 0.00), (3, 7, 2, 'Resultado por Tenencia de Activos no Monetarios', 0.00, 0.00) ) 
AS TEMP (PRINCIPAL, GRUPO, ORDEN, NOMBRE, ORIGEN, APLICACION) ORDER BY 1,2,3]]></query>
