	<detail>
		<band height="10" splitType="Stretch">
			<element kind="textField" uuid="8c18a678-152a-4535-a8a8-15be68d3b1af" x="0" y="0" width="352" height="10" stretchType="NoStretch" fontSize="7.0">
				<property name="com.jaspersoft.studio.spreadsheet.connectionID" value="a1199900-18ae-4260-a571-cd310f0d731b"/>
				<property name="com.jaspersoft.studio.unit.height" value="px"/>
				<box>
					<leftPen lineWidth="1.0"/>
