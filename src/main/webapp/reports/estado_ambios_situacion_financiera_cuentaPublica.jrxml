				<element kind="textField" uuid="5ff008c0-e169-4ff6-a1ef-6c8bdd9f9dff" x="352" y="0" width="100" height="10" stretchType="NoStretch" markup="styled" fontSize="7.0" evaluationTime="Group" pattern="#,##0.00" bold="true" evaluationGroup="Group1" hTextAlign="Right">
