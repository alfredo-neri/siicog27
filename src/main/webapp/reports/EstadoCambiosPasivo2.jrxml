	<field name="TOTAL" class="java.math.BigDecimal"/>
	<variable name="vOrigen" class="java.lang.Double">
		<expression><![CDATA[(($V{vTotal1})>=0.00)?($V{vTotal1}):(0.00)]]></expression>
	</variable>
	<variable name="vAplicacion" class="java.lang.Double">
		<expression><![CDATA[(($V{vTotal1})<=0.00)?($V{vTotal1}):(0.00)]]></expression>
	</variable>
	<variable name="vTotal1" class="java.lang.Double">
		<expression><![CDATA[IF($F{CUENTA}.equals("3211"),$P{pCuenta3211},$F{TOTAL}.doubleValue())]]></expression>
	</variable>
