		<element kind="textField" uuid="e8a24aec-e510-4e27-9717-c3d922e7f695" x="352" y="0" width="100" height="30" stretchType="NoStretch" fontName="Arial" fontSize="9.0" evaluationTime="Report" bold="false" blankWhenNull="true" hTextAlign="Center">
			<property name="com.jaspersoft.studio.unit.height" value="px"/>
			<printWhenExpression><![CDATA[$P{noFirmas}==2 ||  $P{noFirmas} == 4 || $P{noFirmas} == 5]]></printWhenExpression>
			<box>
				<bottomPen lineWidth="1.0"/>
			</box>
			<expression><![CDATA[$P{noFirmas}==2 ? $P{firmaL2}  : $P{noFirmas}==4 ? $P{firmaL3}  : $P{firmaL4}]]></expression>
		</element>
		<element kind="textField" uuid="26d6950e-4cbc-4a93-b4c8-ed1fa3db79ac" x="472" y="30" width="100" height="30" stretchType="NoStretch" fontName="Arial" fontSize="9.0" evaluationTime="Report" bold="false" blankWhenNull="true" hTextAlign="Center">
			<property name="com.jaspersoft.studio.unit.height" value="px"/>
			<property name="com.jaspersoft.studio.unit.y" value="px"/>
			<printWhenExpression><![CDATA[$P{noFirmas} >= 3]]></printWhenExpression>
			<expression><![CDATA[$P{noFirmas}==3 ? $P{firmaN3}  : $P{noFirmas}==4 ? $P{firmaN4}  : $P{firmaN5}]]></expression>
		</element>
