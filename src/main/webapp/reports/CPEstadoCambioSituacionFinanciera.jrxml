			<property name="com.jaspersoft.studio.field.label" value="NATCTA"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="MAYCTA"/>
		</field>
		<field name="CUENTA" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="CUENTA"/>
			<property name="com.jaspersoft.studio.field.label" value="CUENTA"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="CUENTA"/>
		</field>
		<field name="NOMCTA" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="NOMCTA"/>
			<property name="com.jaspersoft.studio.field.label" value="NOMCTA"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="CUENTA"/>
		</field>
		<field name="TOTAL" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="TOTAL"/>
			<property name="com.jaspersoft.studio.field.label" value="TOTAL"/>
		</field>
		<variable name="vOrigen" class="java.math.BigDecimal">
			<expression><![CDATA[$F{TOTAL}.compareTo(BigDecimal.ZERO) <= 0  ? $F{TOTAL}:BigDecimal.ZERO
/*--(($F{TOTAL}.doubleValue())<=0.00)?($F{TOTAL}.doubleValue()):(0.00)*/]]></expression>
		</variable>
		<variable name="vAplicacion" class="java.math.BigDecimal">
			<expression><![CDATA[//(($F{TOTAL}.doubleValue())>=0.00)?($F{TOTAL}.doubleValue()):(0.00)
$F{TOTAL}.compareTo(BigDecimal.ZERO) == 1  ? $F{TOTAL}:BigDecimal.ZERO]]></expression>
		</variable>
		<group name="Group1">
			<expression><![CDATA[$F{GRUPO}]]></expression>
		</group>
	</dataset>
	<dataset name="DatasetPasivo" uuid="fe60ddcc-0176-4031-9c31-98dc0c1f229c">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="gem21"/>
		<parameter name="pSsqlPasivo" class="java.lang.String"/>
		<parameter name="pCuenta3211" class="java.math.BigDecimal"/>
		<parameter name="decimalFormat" class="java.lang.String"/>
		<query language="SQL"><![CDATA[SELECT T4.GRUPO, T4.NATCTA, T4.CUENTA, T4.NOMCTA, ((T4.MESACT)-(T4.MESANT))TOTAL FROM (SELECT T3.GRUPO, T3.NATCTA,T3.CUENTA, T3.NOMCTA,  CASE WHEN T3.CUENTA='3241' THEN  CASE WHEN T3.MESANT < 0 THEN ABS(T3.MESANT) ELSE (T3.MESANT)*(-1) END ELSE T3.MESANT END MESANT, CASE WHEN T3.CUENTA='3241' THEN CASE WHEN T3.MESACT< 0 THEN ABS(T3.MESACT) ELSE (T3.MESACT)*(-1) END ELSE T3.MESACT END MESACT  FROM (SELECT T2.GRUPO, T2.NATCTA, T2.CUENTA, T2.NOMCTA, CASE WHEN T2.CUENTA='3241' AND T2.NATCTA='D' THEN T2.SALINI-T2.CARGOSANT+T2.ABONOSANT ELSE T2.MESANT END MESANT, CASE WHEN T2.CUENTA='3241' AND T2.NATCTA='D' THEN T2.SALINI-T2.CARGOSACT+T2.ABONOSACT ELSE T2.MESACT END MESACT FROM (SELECT T1.GRUPO, T1.NATCTA, T1.CUENTA, T1.NOMCTA, T1.SALINI, T1.CARGOSANT, T1.ABONOSANT, T1.CARGOSACT, T1.ABONOSACT, CASE WHEN T1.NATCTA ='D' THEN T1. SALINI+T1.CARGOSANT-T1.ABONOSANT ELSE T1. SALINI-T1.CARGOSANT+T1.ABONOSANT END MESANT, CASE WHEN T1.NATCTA ='D' THEN T1. SALINI+T1.CARGOSACT-T1.ABONOSACT ELSE T1. SALINI-T1.CARGOSACT+T1.ABONOSACT END MESACT FROM (SELECT SUBSTR(C.CUENTA,1,2) GRUPO, M.NATCTA NATCTA, C.CUENTA CUENTA , C.NOMCTA NOMCTA, NVL(C.SALINI,0.00) SALINI, C.NOTCTA NOTCTA, SUM(NVL(C.CARGOS_1,0.00)+ NVL(C.CARGOS_2,0.00)) CARGOSANT, SUM(NVL(C.ABONOS_1,0.00)+ NVL(C.ABONOS_2,0.00)) ABONOSANT, SUM(NVL(C.CARGOS_1,0.00)+ NVL(C.CARGOS_2,0.00)+ NVL(C.CARGOS_3,0.00)) CARGOSACT, SUM(NVL(C.ABONOS_1,0.00)+ NVL(C.ABONOS_2,0.00)+ NVL(C.ABONOS_3,0.00)) ABONOSACT FROM CUENTA C JOIN MAYCTA M ON C.CUENTA = M.CUENTA WHERE C.IDSECTOR=1 AND (C.CUENTA >='2000' AND C.CUENTA <='3321') AND C.SCTA ='' AND C.NOTCTA=0 GROUP BY SUBSTR(C.CUENTA,1,2), M.NATCTA, C.CUENTA, C.NOMCTA, C.SALINI, C.NOTCTA ORDER BY C.CUENTA)T1)T2)T3)T4]]></query>
		<field name="GRUPO" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="GRUPO"/>
			<property name="com.jaspersoft.studio.field.label" value="GRUPO"/>
		</field>
		<field name="NATCTA" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="NATCTA"/>
			<property name="com.jaspersoft.studio.field.label" value="NATCTA"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="MAYCTA"/>
		</field>
		<field name="CUENTA" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="CUENTA"/>
			<property name="com.jaspersoft.studio.field.label" value="CUENTA"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="CUENTA"/>
		</field>
		<field name="NOMCTA" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="NOMCTA"/>
			<property name="com.jaspersoft.studio.field.label" value="NOMCTA"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="CUENTA"/>
		</field>
		<field name="TOTAL" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="TOTAL"/>
			<property name="com.jaspersoft.studio.field.label" value="TOTAL"/>
		</field>
		<variable name="vTotal1" class="java.math.BigDecimal">
			<expression><![CDATA[$F{CUENTA}.equals("3211")?$P{pCuenta3211}:$F{TOTAL}]]></expression>
		</variable>
		<variable name="vOrigen" class="java.math.BigDecimal">
			<expression><![CDATA[$V{vTotal1}.compareTo(BigDecimal.ZERO) >= 0 ? $V{vTotal1} : BigDecimal.ZERO]]></expression>
		</variable>
		<variable name="vAplicacion" class="java.math.BigDecimal">
			<expression><![CDATA[$V{vTotal1}.compareTo(BigDecimal.ZERO) <= 0 ? $V{vTotal1} : BigDecimal.ZERO]]></expression>
		</variable>
		<group name="Group1">
			<expression><![CDATA[$F{GRUPO}]]></expression>
		</group>
	</dataset>
