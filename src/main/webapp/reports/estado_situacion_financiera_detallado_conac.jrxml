									</box>
									<textElement>
										<font size="7" isBold="true"/>
									</textElement>
									<textFieldExpression><![CDATA[$F{GRUPO} ==1 ? " a. Cuentas por Pagar a Corto Plazo (a=a1+a2+a3+a4+a5+a6+a7+a8+a9)" : $F{GRUPO} == 2 ? " b. Documentos por Pagar a Corto Plazo (b=b1+b2+b3)" : $F{GRUPO} == 3 ? " c. Porción a Corto Plazo de la Deuda Pública a Largo Plazo (c=c1+c2) " : $F{GRUPO} == 4 ? " d. Titulos y Valores a Corto Plazo" : $F{GRUPO} == 5 ? " e. Pasivos Diferidos a Corto Plazo (e=e1+e2+e3)" :  $F{GRUPO} == 6 ? " f. Fondos y Bienes de Terceros en Garantia y/o Administración a Corto Plazo (f=f1+f2+f3+f4+f5+f6)":$F{GRUPO} == 7 ? " g. Provisiones a Corto Plazo (g=g1+g2+g3)" : $F{GRUPO} == 9 ? " h. Otros Pasivos a Corto Plazo (h=h1+h2+h3)" : "Pasivo No Circulante"]]></textFieldExpression>
								</textField>
							</jr:cell>
