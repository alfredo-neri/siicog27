	<subDataset name="hacienda" uuid="d5d0c884-0727-43d4-be63-a830faaa14dd">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="LENOVO PRUEBAS"/>
		<queryString language="SQL">
			<![CDATA[SELECT 1 PRINCIPAL, SUBSTR(T3.CUENTA, 3,2) GRUPO, 
      DECODE(SUBSTR(T3.CUENTA, 3,2), 10, 'a', 20, 'b', 30, 'c', 40, 'd', 'e')LETRA,
       T3.CUENTA, T3.NOMCTA, T3.SALDO_ACTUAL, T3.SALDO_ANTERIOR FROM
(SELECT T2.CUENTA, T2.NOMCTA, T2.NAT, 
	DECODE(T2.CUENTA,'3210',-FN_400500(2),(T2.SALINI + T2.ABONOS - T2.CARGOS)) SALDO_ACTUAL,
    
     DECODE(T2.CUENTA,'3210',(SELECT (T6.S4000 - T6.S5000) RESULTADO FROM (SELECT SUM(T4.MES12) S4000, (SELECT SUM(T5.MES12) FROM TC_CUENTAANTERIOR T5 WHERE SUBSTR(T5.CUENTA,1,1)='5') S5000
		FROM TC_CUENTAANTERIOR T4 
		WHERE SUBSTR(T4.CUENTA,1,1)='4') T6),MES12) SALDO_ANTERIOR
    FROM (       
		SELECT T1.CUENTA, T1.NOMCTA, T1.STACTA NAT, T1.SALINI ,
		T1.CARGOS_1 + T1.CARGOS_2 + T1.CARGOS_3 + T1.CARGOS_4 + T1.CARGOS_5 + T1.CARGOS_6 CARGOS,
		T1.ABONOS_1 + T1.ABONOS_2 + T1.ABONOS_3 + T1.ABONOS_4 + T1.ABONOS_5 + T1.ABONOS_6 ABONOS
		FROM CUENTA T1 
		WHERE SUBSTR(T1.CUENTA,1,2) = '32' 
		AND SUBSTR(T1.CUENTA,4,1)='0' 
		AND SUBSTR(T1.CUENTA,3,1)<>'0'
		AND T1.SCTA = ''  )T2 LEFT JOIN TC_CUENTAANTERIOR TA ON
		T2.CUENTA = TA.CUENTA ) T3 ORDER BY T3.CUENTA]]>
		</queryString>
		<field name="PRINCIPAL" class="java.lang.Integer">
			<property name="com.jaspersoft.studio.field.name" value="PRINCIPAL"/>
			<property name="com.jaspersoft.studio.field.label" value="PRINCIPAL"/>
		</field>
