		<element kind="textField" uuid="e91c24fa-2cf3-4b83-8587-b432bb05b4e5" x="0" y="0" width="130" height="30" stretchType="ElementGroupHeight" fontName="Arial" fontSize="8.0" evaluationTime="Report" bold="false" blankWhenNull="true" hTextAlign="Center">
			<property name="com.jaspersoft.studio.unit.height" value="px"/>
			<property name="com.jaspersoft.studio.unit.width" value="px"/>
			<printWhenExpression><![CDATA[$P{noFirmas} >= 3]]></printWhenExpression>
			<box>
				<bottomPen lineWidth="1.0"/>
			</box>
			<expression><![CDATA[$P{firmaL1}]]></expression>
		</element>
		<element kind="textField" uuid="c7ae7a2d-50a5-4e29-be83-1d49cbcbd046" x="680" y="0" width="140" height="30" stretchType="NoStretch" fontName="Arial" fontSize="8.0" evaluationTime="Report" bold="false" blankWhenNull="true" hTextAlign="Center">
			<property name="com.jaspersoft.studio.unit.height" value="px"/>
			<printWhenExpression><![CDATA[$P{noFirmas}==2 ||  $P{noFirmas} == 4 || $P{noFirmas} == 5]]></printWhenExpression>
			<box>
				<bottomPen lineWidth="1.0"/>
			</box>
			<expression><![CDATA[$P{noFirmas}==2 ? $P{firmaL2}  : $P{noFirmas}==4 ? $P{firmaL3}  : $P{firmaL4}]]></expression>
		</element>
	</lastPageFooter>
</jasperReport>
