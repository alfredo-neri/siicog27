				<printWhenExpression><![CDATA[!$P{competenciaName}.equals("TITULAR DE LA PROCURADURÍA DE PROTECCIÓN DE NIÑAS, NIÑOS Y ADOLESCENTES")]]></printWhenExpression>
				<box>
					<topPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
