	<variable name="porcentaje" class="java.lang.Double">
		<expression><![CDATA[($F{MODIFICADO_ACUMULADO}.doubleValue() == 0.00)?0.0: ABS((($F{RECAUDADO_ACUMULADO}.doubleValue() - $F{MODIFICADO_ACUMULADO}.doubleValue()) / $F{MODIFICADO_ACUMULADO}.doubleValue()) * 100)]]></expression>
