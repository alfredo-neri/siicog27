	<query language="SQL"><![CDATA[SELECT  BP.CONCEPTO,
		BP.EA "ESTIMADO APROBADO",
		BP.DEVENGADO,
		BP.RP "RECAUDADO / PAGADO"
	 FROM GEMUSER.BALANCEPRE BP
WHERE BP.ID_SECTOR= $P{sector}]]></query>
