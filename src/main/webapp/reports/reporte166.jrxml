	<query language="sql"><![CDATA[SELECT 
DEP
, PARTIDA
, SUM(AUTO1_1) AUTO1_1
, SUM(AUTO1_2) AUTO1_2
, SUM(AUTO1_3) AUTO1_3
, SUM(AUTO1_4) AUTO1_4
, SUM(AUTO1_5) AUTO1_5
, SUM(AUTO1_6) AUTO1_6
, SUM(AUTO1_7) AUTO1_7
, SUM(AUTO1_8) AUTO1_8
, SUM(AUTO1_9) AUTO1_9
, SUM(AUTO1_10) AUTO1_10
, SUM(AUTO1_11) AUTO1_11
, SUM(AUTO1_12) AUTO1_12
, (SUM(AUTO1_1) + SUM(AUTO1_2) + SUM(AUTO1_3) + SUM(AUTO1_4) + SUM(AUTO1_5) + SUM(AUTO1_6) + SUM(AUTO1_7) + SUM(AUTO1_8) + SUM(AUTO1_9) + SUM(AUTO1_10) + SUM(AUTO1_11) + SUM(AUTO1_12)) TOTALES
, NOMGAS
, NOMDEPGEN
FROM(
SELECT 
SUBSTR(P.CLAVE,1,3) DEP
, P.PARTIDA
, P.AUTO1_1 
, P.AUTO1_2
, P.AUTO1_3
, P.AUTO1_4
, P.AUTO1_5
, P.AUTO1_6
, P.AUTO1_7
, P.AUTO1_8
, P.AUTO1_9
, P.AUTO1_10
, P.AUTO1_11
, P.AUTO1_12
, N.NOMGAS
, C.NOMBRE NOMDEPGEN
 FROM PASO P, NATGAS N, CATDGM C
WHERE N.CLVGAS= P.PARTIDA
AND C.CLAVE = SUBSTR(P.CLAVE,1,3)
AND N.IDSECTOR = P.IDSECTOR
AND P.IDSECTOR=1 
ORDER BY P.CLAVE, P.PROGRAMA, P.PARTIDA
)
GROUP BY DEP, PARTIDA, NOMGAS, NOMDEPGEN
ORDER BY DEP, PARTIDA]]></query>
