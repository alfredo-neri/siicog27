<jasperReport name="m_dgralpol_resumen" language="java" columnCount="1" dpi="72" pageWidth="792" pageHeight="612" orientation="Landscape" columnWidth="792" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="f7068764-ad18-4150-bbfa-f54a8b39bd62">
