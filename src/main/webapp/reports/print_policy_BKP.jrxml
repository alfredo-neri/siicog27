<jasperReport name="Polizas_Reportjrxml" language="java" columnCount="1" dpi="72" pageWidth="792" pageHeight="612" orientation="Landscape" whenNoDataType="BlankPage" columnWidth="752" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="7e0db011-9766-4d94-9b77-93585809692b">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="gemdb"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.unit." value="pixel"/>
	<parameter name="pTipoPoliza" class="java.lang.String"
		><description><![CDATA[Tipo de Poliza]]></description>
		<defaultValueExpression><![CDATA['C']]></defaultValueExpression>
	</parameter>
	<parameter name="pNumPolMin" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[0]]></defaultValueExpression>
	</parameter>
	<parameter name="pNumPolMax" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[0]]></defaultValueExpression>
	</parameter>
	<parameter name="pMesPol" class="java.lang.Integer"
		><description><![CDATA[Mes de la Poliza]]></description>
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="pathImage" class="java.lang.String"/>
	<query language="sql"><![CDATA[SELECT
	CATTPO.TIPNOM,
	POLIEN.CLVPOL,
	POLIEN.FECPOL,
	POLIEN.STAPOL,
	POLIEN.STAAFE,
	POLIEN.TIPPOL,
	POLIEN.MESPOL,
	POLIEN.CONPOL,
	POLIEN.CAPPOL,
	POLIEN.POLCLV1,
	POLIDE.RENPOL,
	POLIDE.CUENTA,
	POLIDE.SCTA,
	POLIDE.SSCTA,
	POLIDE.SSSCTA,
	POLIDE.SSSSCTA,
	POLIDE.REFPOL,
	POLIDE.DN,
	POLIDE.CONCEP,
	POLIDE.CANPOL,
     POLIDE.CANPOLH,
     POLIFL.RENPOL,
     POLIFL.CLVFLU,
     POLIFL.CANFLU   
FROM POLIDE
INNER JOIN CATTPO ON  POLIDE.TIPPOL=CATTPO.TIPPOL
	INNER JOIN POLIEN ON 
	 POLIEN.MESPOL = POLIDE.MESPOL 
	 AND POLIDE.TIPPOL = POLIEN.TIPPOL 
	 AND POLIDE.CONPOL = POLIEN.CONPOL
	 LEFT JOIN POLIFL ON
 	POLIDE.MESPOL = POLIFL.MESPOL 
	 AND POLIDE.TIPPOL = POLIFL.TIPPOL 
	 AND POLIDE.CONPOL = POLIFL.CONPOL
	 AND POLIDE.RENPOL = POLIFL.RENPOL
where 1=1 
AND  POLIEN.TIPPOL =$P{pTipoPoliza} 
AND POLIEN.MESPOL= $P{pMesPol} 
AND 	POLIEN.CONPOL >= $P{pNumPolMin}  AND POLIEN.CONPOL <= $P{pNumPolMax}
ORDER BY POLIEN.CLVPOL,POLIEN.MESPOL,POLIEN.TIPPOL,POLIEN.CONPOL]]></query>
