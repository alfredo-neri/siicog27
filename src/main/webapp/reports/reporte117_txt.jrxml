	<parameter name="ANO_EMP" class="java.lang.Integer"/>
	<parameter name="TRIMESTRE" class="java.lang.Integer"/>
	<parameter name="IDSECTOR" class="java.lang.Integer"/>
	<parameter name="CLAVE" class="java.lang.String"/>
	<query language="sql"><![CDATA[SELECT '"' || SUBSTR( $P{CLAVE} ,1,1) || '"|"' || SUBSTR( $P{CLAVE} ,2,3) || '"|' || $P{ANO_EMP} || '|' || IND.PERIODO || '|' ||  $P{TRIMESTRE}  || '|' || LAST_DAY(CONCAT( $P{ANO_EMP} , CONCAT('-', CONCAT( $P{TRIMESTRE}*3 , CONCAT('-','01'))))) || '|' || IND.CVEIND || '|"' || IND.CLVFUN || '"|'|| LTRIM(VARCHAR_FORMAT(ITSA,'999,999,990.99')) || '|' || LTRIM(VARCHAR_FORMAT(TECA,'999,999,990.99')) || '|"' || OBSITSA || '"|"' || OBSTECA || '"' AS DATO
FROM pm5111 PM
INNER JOIN indicadores IND ON IND.IDSECTOR = PM.IDSECTOR
WHERE TRIMESTRE =  $P{TRIMESTRE} AND PM.IDSECTOR =  $P{IDSECTOR}  AND IND.CVEIND = 103]]></query>
	<field name="DATO" class="java.lang.String"/>
