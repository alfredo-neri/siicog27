	</parameter>
	<query language="sql"><![CDATA[SELECT CUENTA.CUENTA
,CUENTA.SSSCTA
,NVL(POLIDE.CANPOL, 0) CANPOL
,NVL(POLIDE.CANPOLH, 0) CANPOLH
,POLIDE.MESPOL
,POLIDE.TIPPOL
,POLIDE.CONPOL

FROM CUENTA
LEFT OUTER JOIN POLIDE 
ON  CUENTA.CUENTA=POLIDE.CUENTA
AND CUENTA.SCTA=POLIDE.SCTA
AND CUENTA.SSCTA=POLIDE.SSCTA
AND CUENTA.SSSCTA=POLIDE.SSSCTA
AND CUENTA.SSSSCTA=POLIDE.SSSSCTA
AND CUENTA.IDSECTOR=POLIDE.IDSECTOR

LEFT OUTER JOIN POLIEN 
ON POLIDE.TIPPOL=POLIEN.TIPPOL
AND POLIDE.MESPOL=POLIEN.MESPOL
AND POLIDE.CONPOL= POLIEN.CONPOL
AND POLIDE.ANOPOL=POLIEN.ANOPOL
AND POLIDE.IDSECTOR=POLIEN.IDSECTOR

WHERE (SUBSTR(CUENTA.CUENTA,1,3)='824'
OR SUBSTR(CUENTA.CUENTA,1,3)='825'
OR SUBSTR(CUENTA.CUENTA,1,3) = '827'
OR SUBSTR(CUENTA.CUENTA,1,1)='5')
AND CUENTA.NIVCTA = 'S'
AND CUENTA.SSSCTA = $P{P_SSSCTA} 
AND CUENTA.IDSECTOR= $P{P_SECTOR} 
AND POLIDE.MESPOL>= $P{P_MES_INICIAL} 
AND POLIDE.MESPOL<= $P{P_MES_FINAL}

ORDER BY  POLIDE.TIPPOL, POLIDE.MESPOL, POLIDE.CANPOL, POLIDE.CANPOLH]]></query>
	<field name="CUENTA" class="java.lang.String"/>
	<field name="SSSCTA" class="java.lang.String"/>
	<field name="CANPOL" class="java.math.BigDecimal"/>
	<field name="CANPOLH" class="java.math.BigDecimal"/>
	<field name="MESPOL" class="java.lang.Integer"/>
	<field name="TIPPOL" class="java.lang.String"/>
	<field name="CONPOL" class="java.lang.Integer"/>
	<variable name="V_CURRENT_PAGE_NUMBER" resetType="Page" class="java.lang.Integer">
		<expression><![CDATA[1]]></expression>
		<initialValueExpression><![CDATA[$V{PAGE_NUMBER}]]></initialValueExpression>
	</variable>
	<variable name="@5100" resetType="None" class="java.math.BigDecimal">
		<expression><![CDATA[$F{CUENTA}.substring( 0, 1 ).equals("5") ?  $V{validCanpolCanpolH} : BigDecimal.ZERO]]></expression>
	</variable>
	<variable name="@824" resetType="None" class="java.math.BigDecimal">
		<expression><![CDATA[$F{CUENTA}.substring( 0, 3 ).equals("824") ?  $V{validCanpolCanpolH} : BigDecimal.ZERO]]></expression>
	</variable>
	<variable name="@825" resetType="None" class="java.math.BigDecimal">
		<expression><![CDATA[$F{CUENTA}.substring( 0, 3 ).equals("825") ?  $V{validCanpolCanpolH} : BigDecimal.ZERO]]></expression>
	</variable>
	<variable name="@827" resetType="None" class="java.math.BigDecimal">
		<expression><![CDATA[$F{CUENTA}.substring( 0, 3 ).equals("827") ?  $V{validCanpolCanpolH} : BigDecimal.ZERO]]></expression>
	</variable>
	<variable name="final" resetType="None" class="java.math.BigDecimal">
		<expression><![CDATA[($V{@5100}.subtract($V{@824}.add($V{@825}).add($V{@827})))]]></expression>
	</variable>
	<variable name="validCanpolCanpolH" resetType="None" class="java.math.BigDecimal">
		<expression><![CDATA[$F{CANPOL}.compareTo( BigDecimal.ZERO) != 0 ? $F{CANPOL} :  $F{CANPOLH}.compareTo( BigDecimal.ZERO) != 0 ? $F{CANPOLH} :  BigDecimal.ZERO]]></expression>
	</variable>
	<variable name="total" class="java.math.BigDecimal">
		<expression><![CDATA[$V{final}.multiply(new BigDecimal(-1))]]></expression>
	</variable>
