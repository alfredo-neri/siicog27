	<detail>
		<band height="135">
			<element kind="staticText" uuid="962be487-606f-4e5b-b2a1-f9d7926298e6" x="330" y="0" width="422" height="45" stretchType="NoStretch" fontName="Arial" hTextAlign="Left" vTextAlign="Middle">
				<box>
					<topPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<paragraph leftIndent="3" rightIndent="0" spacingBefore="0"/>
				<text><![CDATA[Remitir fotocopia legible del mismo.]]></text>
			</element>
			<element kind="staticText" uuid="f9d48785-c91a-4202-900e-9ab8fc12190d" x="330" y="45" width="422" height="45" stretchType="NoStretch" fontName="Arial" fontSize="10.0" vTextAlign="Middle">
				<box>
					<topPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<paragraph leftIndent="3" rightIndent="3" spacingBefore="0"/>
				<text><![CDATA[Adjuntar a éste formato la documentación que avala la experiencia para ocupar el puesto. (Por ejemplo: Nombramiento en Administraciones Municipales anteriores).]]></text>
			</element>
			<element kind="staticText" uuid="96158849-c3e6-4685-b566-3c3ef2a369c6" x="330" y="90" width="422" height="45" stretchType="NoStretch" fontName="Arial" vTextAlign="Middle">
				<box>
					<topPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<paragraph leftIndent="3" rightIndent="3" spacingBefore="0"/>
				<text><![CDATA[Remitir fotocopia legible de la misma. Cabe señalar que, conformidad con el articulo 7 del Reglamento de la COCERTEM, la vigencia de la certificación en competencia laboral es de 2 años.]]></text>
			</element>
			<element kind="textField" uuid="0b82ffbd-fd5a-43b2-9604-1f7c1e7d92a2" x="210" y="0" width="60" height="45" stretchType="NoStretch" fontName="Arial" fontSize="10.0" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle">
				<property name="com.jaspersoft.studio.spreadsheet.connectionID" value="ac75388f-c457-4aa7-8a1d-6626ba916225"/>
				<box>
					<leftPen lineWidth="1.0"/>
					<bottomPen lineWidth="1.0"/>
				</box>
				<expression><![CDATA[$F{TITINGOARQ}.equals("SI")?"X":""]]></expression>
			</element>
			<element kind="staticText" uuid="8bc1c0db-bb94-419a-a974-8079995bc020" x="0" y="0" width="210" height="45" stretchType="NoStretch" fontName="Arial" hTextAlign="Center" vTextAlign="Middle">
				<property name="com.jaspersoft.studio.spreadsheet.connectionID" value="ac75388f-c457-4aa7-8a1d-6626ba916225"/>
				<box>
					<leftPen lineWidth="1.0"/>
					<bottomPen lineWidth="1.0"/>
				</box>
				<paragraph leftIndent="3"/>
				<text><![CDATA[Titulo en ingeniería, arquitectura o titulo profesional en áreas jurídicas ecónomicas o contable-administrativas o algún área afín.]]></text>
			</element>
			<element kind="textField" uuid="569c95f5-5cd8-408f-8eb8-de374597f1aa" x="210" y="45" width="60" height="45" stretchType="NoStretch" fontName="Arial" fontSize="10.0" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle">
				<property name="com.jaspersoft.studio.spreadsheet.connectionID" value="14b1ccbc-c35f-4004-a4fd-545eacb98cce"/>
				<box>
					<leftPen lineWidth="1.0"/>
					<bottomPen lineWidth="1.0"/>
				</box>
				<expression><![CDATA[$F{EXPLAB}.equals("SI")?"X":""]]></expression>
			</element>
			<element kind="staticText" uuid="99d2581e-5fed-4e73-9e37-96afc07a01c1" x="0" y="45" width="210" height="45" stretchType="NoStretch" fontName="Arial" hTextAlign="Center" vTextAlign="Middle">
				<property name="com.jaspersoft.studio.spreadsheet.connectionID" value="14b1ccbc-c35f-4004-a4fd-545eacb98cce"/>
				<box>
					<leftPen lineWidth="1.0"/>
					<bottomPen lineWidth="1.0"/>
				</box>
				<paragraph leftIndent="3"/>
				<text><![CDATA[Experiencia mínima de un año en la materia.]]></text>
			</element>
			<element kind="textField" uuid="63234e5a-1405-4a79-a23c-bccfefb5ea1a" x="210" y="90" width="60" height="45" stretchType="NoStretch" fontName="Arial" fontSize="10.0" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle">
				<property name="com.jaspersoft.studio.spreadsheet.connectionID" value="9af8187b-92fa-43de-a386-3a2c027278cc"/>
				<box>
					<leftPen lineWidth="1.0"/>
					<bottomPen lineWidth="1.0"/>
				</box>
				<expression><![CDATA[$F{CERT}.equals("SI")?"X":""]]></expression>
			</element>
			<element kind="staticText" uuid="7e37d2c1-7e09-470e-802c-c14266c5c311" x="0" y="90" width="210" height="45" stretchType="NoStretch" fontName="Arial" hTextAlign="Center" vTextAlign="Middle">
				<property name="com.jaspersoft.studio.spreadsheet.connectionID" value="9af8187b-92fa-43de-a386-3a2c027278cc"/>
				<box>
					<leftPen lineWidth="1.0"/>
					<bottomPen lineWidth="1.0"/>
				</box>
				<paragraph leftIndent="0"/>
				<text><![CDATA[Certificación en Comptencia Laboral expedida por el Instituto Hacendario del Estado de México.]]></text>
			</element>
			<element kind="textField" uuid="da37209f-b2a1-49bb-b27f-05f60bbf5cc3" x="270" y="0" width="60" height="45" stretchType="NoStretch" fontName="Arial" fontSize="10.0" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle">
				<property name="com.jaspersoft.studio.spreadsheet.connectionID" value="ac75388f-c457-4aa7-8a1d-6626ba916225"/>
				<box>
					<leftPen lineWidth="1.0"/>
					<bottomPen lineWidth="1.0"/>
				</box>
				<expression><![CDATA[$F{TITINGOARQ}.equals( "NO" )?"X":""]]></expression>
			</element>
			<element kind="textField" uuid="51448cdf-c941-4b65-b49e-59c5a9597e90" x="270" y="45" width="60" height="45" stretchType="NoStretch" fontName="Arial" fontSize="10.0" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle">
				<property name="com.jaspersoft.studio.spreadsheet.connectionID" value="14b1ccbc-c35f-4004-a4fd-545eacb98cce"/>
				<box>
					<leftPen lineWidth="1.0"/>
					<bottomPen lineWidth="1.0"/>
				</box>
				<expression><![CDATA[$F{EXPLAB}.equals( "NO" )?"X":""]]></expression>
			</element>
			<element kind="textField" uuid="d81b7377-2fa8-4f25-a2a9-11e71103ecdb" x="270" y="90" width="60" height="45" stretchType="NoStretch" fontName="Arial" fontSize="10.0" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle">
				<property name="com.jaspersoft.studio.spreadsheet.connectionID" value="9af8187b-92fa-43de-a386-3a2c027278cc"/>
