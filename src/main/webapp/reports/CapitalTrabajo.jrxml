			<expression><![CDATA[Math.abs($V{activo_sum_mes_actual}.doubleValue()) - Math.abs($V{pasivo_sum_mes_actual}.doubleValue())]]></expression>
		</element>
		<element kind="textField" uuid="e2d5db50-96dc-4f72-8fb4-13fe965f22d0" x="602" y="0" width="150" height="14" stretchType="NoStretch" fontName="Arial" fontSize="10.0" pattern="#,##0.00" hTextAlign="Right">
