				<bottomPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
				<rightPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
			</box>
			<expression><![CDATA[(Math.abs($V{activo_sum_mes_actual}.doubleValue()) - Math.abs($V{pasivo_sum_mes_actual}.doubleValue()) ) - (Math.abs($V{activo_sum_mes_anterior}.doubleValue()) - Math.abs($V{pasivo_sum_mes_anterior}.doubleValue()) )]]></expression>
