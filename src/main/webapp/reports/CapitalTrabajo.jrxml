		<element kind="textField" uuid="51825956-de44-47fa-b324-50855d8026bd" x="452" y="0" width="150" height="14" stretchType="NoStretch" fontName="Arial" fontSize="10.0" pattern="#,##0.00" hTextAlign="Right">
