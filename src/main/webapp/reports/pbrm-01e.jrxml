	<parameter name="sector" class="java.lang.Integer"/>
	<parameter name="claveEntidad" class="java.lang.String"/>
	<parameter name="nombreEntidad" class="java.lang.String"/>
	<parameter name="imagenPathLeft" class="java.lang.String"/>
	<parameter name="imagenPathRigth" class="java.lang.String"/>
	<parameter name="noFirmas" class="java.lang.Integer"/>
	<parameter name="firmaL1" class="java.lang.String"/>
	<parameter name="firmaN1" class="java.lang.String"/>
	<parameter name="firmaL2" class="java.lang.String"/>
	<parameter name="firmaN2" class="java.lang.String"/>
	<parameter name="firmaL3" class="java.lang.String"/>
	<parameter name="firmaN3" class="java.lang.String"/>
	<parameter name="firmaL4" class="java.lang.String"/>
	<parameter name="firmaN4" class="java.lang.String"/>
	<parameter name="firmaL5" class="java.lang.String"/>
	<parameter name="firmaN5" class="java.lang.String"/>
	<query language="SQL"><![CDATA[SELECT 	MU.CAMPO7, MU.CAMPO6, MU.CAMPO8, 
		CPD1.CVETEMAS, CPD1.DESCRIPCION PILAR_TEMATICO, 
		CPD2.DESCRIPCION TEMA_DESARROLLO, 
		DG.CLAVE, DG.NOMBRE, 
		M.ID
	FROM TC_MATRIZ M 
		INNER JOIN CATDGM DG ON M.ID_DEPENDENCIA = DG.ID
		INNER JOIN MUNINEP MU ON M.ID_PROYECTO = MU.ID
		INNER JOIN CPD CPD1 ON M.ID_TEMA = CPD1.ID
		INNER JOIN CPD CPD2 ON CPD2.CVETEMAS = SUBSTR(CPD1.CVETEMAS,1,4)
--		INNER JOIN TC_MATRIZ_NIVEL MN ON M.ID = MN.ID_MATRIZ
--		INNER JOIN TC_FICHA F ON MN.ID = F.ID_MATRIZ_NIVEL
WHERE M.ID_SECTOR =  $P{sector}]]></query>
