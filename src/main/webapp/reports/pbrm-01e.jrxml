	<dataset name="DatasetDetails" uuid="b7221498-dac0-47d9-a40d-2f08129ee2d2">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="gem2020Local"/>
		<parameter name="tipo" class="java.lang.String"/>
		<parameter name="idMatriz" class="java.lang.Long"/>
		<query language="SQL"><![CDATA[SELECT M.CONSEC, N.OBJETIVO, N.NOMBRE, N.FORMULA, N.FRECUENCIA, N.TIPO, N.MEDIOS_VERIFICACION, N.SUPUESTO
	FROM TR_MATRIZ_NIVEL MN
		INNER JOIN TC_NIVEL N ON MN.ID_NIVEL = N.ID
		INNER JOIN TC_TIPO_NIVEL TN ON N.ID_NIVEL = TN.ID
		INNER JOIN MIR M ON N.CODIGO_INDICADOR = M.CODIGO
WHERE MN.ID_MATRIZ = $P{idMatriz} AND TN.CLAVE= $P{tipo}]]></query>
		<field name="CONSEC" class="java.lang.Integer">
			<property name="com.jaspersoft.studio.field.label" value="CONSEC"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="MIR"/>
		</field>
