<jasperReport name="reporte263_subfuncion" language="java" columnCount="1" dpi="72" pageWidth="800" pageHeight="102" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="800" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="168b7bf2-1940-434f-9266-06f32556a86f">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="SERVER_CRUZ_ LINUX"/>
	<property name="com.jaspersoft.studio.unit." value="pixel"/>
	<property name="com.jaspersoft.studio.unit.pageHeight" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.pageWidth" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.topMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.bottomMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.leftMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.rightMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.columnWidth" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.columnSpacing" value="pixel"/>
	<parameter name="CLAVE" class="java.lang.String"/>
	<parameter name="FIN" class="java.lang.String"/>
	<parameter name="FUN" class="java.lang.String"/>
	<parameter name="SFUN" class="java.lang.String"/>
	<parameter name="PROG" class="java.lang.String"/>
	<parameter name="SPROG" class="java.lang.String"/>
	<parameter name="PROY" class="java.lang.String"/>
	<parameter name="FFIN" class="java.lang.String"/>
	<parameter name="pSector" class="java.lang.Integer"
		><description><![CDATA[]]></description>
	</parameter>
	<parameter name="pMes" class="java.lang.Integer"/>
	<parameter name="pAuto1" class="java.lang.String"/>
	<parameter name="pToeje1" class="java.lang.String"/>
	<parameter name="pAmpli1" class="java.lang.String"/>
	<parameter name="pRedu1" class="java.lang.String"/>
	<query language="SQL"><![CDATA[SELECT 
SUBSTR(paso.clave,1,6) as clave,
SUBSTR(paso.programa,1,2) as fin, 
SUBSTR(paso.programa,3,2) as fun,
SUBSTR(paso.programa,5,2) as sfun, 
SUBSTR(paso.programa,7,2) as prog, 
SUBSTR(paso.programa,9,2) as sprog,
SUBSTR(paso.programa,11,2) as proy,
SUBSTR(paso.programa, 13,3) as ffin,
paso.partida, 
(auto1_1+auto1_2+auto1_3+auto1_4+auto1_5+auto1_6+auto1_7+auto1_8+auto1_9+auto1_10+auto1_11+auto1_12) auto13
, (auto1_$P!{pMes} + ampli1_$P!{pMes} - redu1_$P!{pMes}) automes2
, toeje1_$P!{pMes}  impmes
, ( $P!{pAuto1} ) + ( $P!{pAmpli1} ) - ( $P!{pRedu1} )  autoacu2
, ( $P!{pToeje1} ) + ( $P!{pAmpli1} ) - ( $P!{pRedu1} ) impacum
FROM
PASO PASO
where paso.IDSECTOR= $P{pSector} 
and SUBSTR(paso.clave,1,6) =   $P{CLAVE} 
and SUBSTR(paso.programa,1,2) =  $P{FIN} 
and SUBSTR(paso.programa,3,2) =   $P{FUN} 
and SUBSTR(paso.programa,5,2) =  $P{SFUN}
and SUBSTR(paso.programa,7,2) =  $P{PROG}
and SUBSTR(paso.programa,9,2) =  $P{SPROG}
and SUBSTR(paso.programa,11,2) =  $P{PROY}
and SUBSTR(paso.programa,13,3) =  $P{FFIN}]]></query>
	<field name="CLAVE" class="java.lang.String"/>
	<field name="FIN" class="java.lang.String"/>
	<field name="FUN" class="java.lang.String"/>
	<field name="SFUN" class="java.lang.String"/>
	<field name="PROG" class="java.lang.String"/>
	<field name="PARTIDA" class="java.lang.String"/>
	<field name="AUTO13" class="java.math.BigDecimal"/>
	<field name="AUTOMES2" class="java.math.BigDecimal"/>
	<field name="IMPMES" class="java.math.BigDecimal"/>
	<field name="AUTOACU2" class="java.math.BigDecimal"/>
	<field name="IMPACUM" class="java.math.BigDecimal"/>
	<variable name="ampli" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[(MID($F{PARTIDA},2,3).equals("000"))? $F{AUTO13} : BigDecimal.ZERO]]></expression>
	</variable>
	<variable name="modificado" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[(MID($F{PARTIDA},2,3).equals("000"))? $F{AUTOMES2} : BigDecimal.ZERO]]></expression>
	</variable>
	<variable name="ejerdmes" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[(MID($F{PARTIDA},2,3).equals("000"))? $F{IMPMES} : BigDecimal.ZERO]]></expression>
	</variable>
	<variable name="modificadoacum" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[(MID($F{PARTIDA},2,3).equals("000"))? $F{AUTOACU2} : BigDecimal.ZERO]]></expression>
	</variable>
	<variable name="ejeralmes" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[(MID($F{PARTIDA},2,3).equals("000"))? $F{IMPACUM} : BigDecimal.ZERO]]></expression>
	</variable>
