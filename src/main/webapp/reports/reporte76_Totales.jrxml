				<property name="com.jaspersoft.studio.unit.x" value="pixel"/>
				<expression><![CDATA[$F{F1}]]></expression>
			</element>
			<element kind="textField" uuid="d0bdc38f-79d3-4637-b174-ed433b9c2567" x="400" y="0" width="100" height="13" stretchType="NoStretch" fontName="Arial" fontSize="8.0" pattern="#,##0.00#" blankWhenNull="true" hTextAlign="Right">
				<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				<property name="com.jaspersoft.studio.unit.width" value="pixel"/>
				<property name="com.jaspersoft.studio.unit.x" value="pixel"/>
				<expression><![CDATA[$F{G1}]]></expression>
			</element>
			<element kind="textField" uuid="feac8e06-6ef9-4f88-bb17-72b5a17d3a7b" x="600" y="0" width="100" height="13" stretchType="NoStretch" fontName="Arial" fontSize="8.0" pattern="#,##0.00#" blankWhenNull="true" hTextAlign="Right">
				<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				<property name="com.jaspersoft.studio.unit.width" value="pixel"/>
				<property name="com.jaspersoft.studio.unit.x" value="pixel"/>
				<expression><![CDATA[$F{CTM}]]></expression>
			</element>
			<element kind="textField" uuid="e6393c35-59b5-415f-9d60-9fe22fd35a8c" x="1000" y="0" width="100" height="13" stretchType="NoStretch" fontName="Arial" fontSize="8.0" pattern="#,##0.00#" blankWhenNull="true" hTextAlign="Right">
				<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				<expression><![CDATA[$V{e1}]]></expression>
			</element>
			<element kind="textField" uuid="2834e7a3-a528-455c-a5bf-568ff45bef92" x="500" y="0" width="100" height="13" stretchType="NoStretch" fontName="Arial" fontSize="8.0" pattern="#,##0.00#" blankWhenNull="true" hTextAlign="Right">
