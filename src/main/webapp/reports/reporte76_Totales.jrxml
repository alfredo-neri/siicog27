			<element kind="textField" uuid="82215a6f-6779-43bb-b31a-f345158441c8" x="700" y="0" width="100" height="13" stretchType="NoStretch" fontName="Arial" fontSize="8.0" pattern="#,##0.00#" blankWhenNull="true" hTextAlign="Right">
				<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
