			<element kind="textField" uuid="041ea089-d66b-4351-9331-8a93a92eeb6e" x="300" y="0" width="100" height="13" stretchType="NoStretch" fontName="Arial" fontSize="8.0" pattern="#,##0.00#" blankWhenNull="true" hTextAlign="Right">
