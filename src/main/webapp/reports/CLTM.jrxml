	<parameter name="pSemestre" class="java.lang.Integer"/>
	<query language="SQL"><![CDATA[SELECT 	SEMES,
				NOMBRE,
				ULTPUESTO CARGO,
				ESTSUP CERTIFICACION,
				FECING,
				GRADO TITULO,
				DOCU ANTECEDENTES, 
				ESPEST CONSTANCIA,
				ESPECER ISSEMYM, 
				EXPERI EXPERIENCIA
	FROM PM3511
WHERE IDSECTOR=$P{pIdSector} AND
		SEMES = $P{pSemestre}]]></query>
