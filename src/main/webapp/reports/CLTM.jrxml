				</box>
				<paragraph firstLineIndent="0" leftIndent="5"/>
				<text><![CDATA[Titulo Profesional en áreas jurídicas, ecónomicas o contable-administrativas.]]></text>
			</element>
			<element kind="staticText" uuid="ed3e4acb-0ace-4c91-830e-dd9a4a586859" x="0" y="45" width="280" height="45" stretchType="NoStretch" fontName="Arial" fontSize="12.0" hTextAlign="Center" vTextAlign="Middle">
				<property name="com.jaspersoft.studio.spreadsheet.connectionID" value="52b69092-4235-488e-a4bb-9e5de03cc31f"/>
				<box>
					<topPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<paragraph firstLineIndent="0" leftIndent="5"/>
				<text><![CDATA[Certificación de Competencia Laboral en funciones expedida por el Instituto Hacendario del Estado de México.]]></text>
			</element>
			<element kind="staticText" uuid="a9faec11-0776-4645-b53f-1ab627f05d6c" x="380" y="0" width="372" height="45" stretchType="NoStretch" fontName="Arial" fontSize="12.0" vTextAlign="Middle">
				<box>
					<topPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<paragraph leftIndent="5"/>
				<text><![CDATA[Remitir fotocopia legible del mismo.]]></text>
			</element>
			<element kind="staticText" uuid="5c35d501-3f51-4a6a-ba17-54b34cca07cd" x="380" y="45" width="372" height="45" stretchType="NoStretch" fontName="Arial" fontSize="12.0" vTextAlign="Middle">
				<box>
					<topPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<paragraph leftIndent="5"/>
				<text><![CDATA[Remitir fotocopia legible de la misma. Cabe señalar que, de conformidad con el árticulo 7 del Reglamento de la COCERTEM, la vigencia de la certificación en competencia laboral es de 2 años.]]></text>
			</element>
			<element kind="textField" uuid="3b680fca-513f-4774-95fc-4b94e9055bc1" x="280" y="45" width="50" height="45" stretchType="NoStretch" fontName="Arial" fontSize="12.0" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle">
