		<element kind="textField" uuid="5f65cb3f-eed1-46a2-9279-d22facf309e7" x="370" y="0" width="100" height="10" stretchType="NoStretch" fontSize="7.0" pattern="#,##0.00" bold="true" hTextAlign="Right">
