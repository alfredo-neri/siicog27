		<element kind="textField" uuid="00837d85-3b2e-4cc3-9f33-59f73cefb555" x="470" y="0" width="100" height="10" stretchType="NoStretch" fontSize="7.0" pattern="#,##0.00" bold="true" hTextAlign="Right">
