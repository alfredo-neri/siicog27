<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="grupo_3_balance_presupuestario" pageWidth="590" pageHeight="842" columnWidth="570" leftMargin="0" rightMargin="20" topMargin="0" bottomMargin="0" uuid="d0fef013-a40f-4a63-9cc9-f464d0f75234">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="conta 23.jrdax"/>
	<queryString language="SQL">
		<![CDATA[SELECT TI.PRINCIPAL,
       TI.GRUPO,
       TI.LETRA,
       TI.SCTA,
       TI.CONCEPTO,
       TI.ESTIMADO,
       TI.DEVENGADO,
       TI.RECAUDADO
     FROM(

SELECT 1 PRINCIPAL,
       1 GRUPO,
       'F' LETRA,
       T3.SCTA,
       'Financiamiento con Fuente de Pago de Ingresos de Libre Disposición' CONCEPTO,
       SUM(T3.ESTIMADO) ESTIMADO, 
       SUM(T3.DEVENGADO) DEVENGADO, SUM(T3.RECAUDADO) RECAUDADO
FROM
(SELECT T1.CUENTA, T1.SCTA, T1.SSCTA, T1.SSSCTA, T1.SSSSCTA, T1.NOMCTA , (T2.AUTOI_1 + T2.AUTOI_2 + T2.AUTOI_3) ESTIMADO,
DECODE(T1.CUENTA,'8140',(  ABONOS_1 + ABONOS_2 + ABONOS_3 + ABONOS_4 + ABONOS_5 + ABONOS_6 - CARGOS_1 - CARGOS_2 - CARGOS_3 - CARGOS_4 - CARGOS_5 - CARGOS_6),0.0) DEVENGADO,
DECODE(T1.CUENTA,'8150',(  ABONOS_1 + ABONOS_2 + ABONOS_3 + ABONOS_4 + ABONOS_5 + ABONOS_6 - CARGOS_1 - CARGOS_2 - CARGOS_3 - CARGOS_4 - CARGOS_5 - CARGOS_6),0.0) RECAUDADO

FROM CUENTA T1 
LEFT JOIN INGRESO T2
ON T1.CUENTA = T2.CUENTA 
AND T1.SCTA = T2.SCTA
AND T1.SSCTA = T2.SSCTA
AND T1.SSSCTA = T2.SSSCTA
AND T1.SSSSCTA = T2.SSSSCTA
WHERE 
T1.CUENTA IN ('8110','8140','8150')
AND SUBSTR(T1.SCTA,7,4) = ('4399') 
AND T1.SSCTA = '000000000000003'
AND T1.SSSCTA = '0002'
AND T1.SSSSCTA = '') T3
GROUP BY T3.SCTA

UNION ALL
SELECT 1 PRINCIPAL,
       1 GRUPO,
       'F' LETRA,
       '0000004444' SCTA,
       'Financiamiento con Fuente de Pago de Transferencias Federales Etiquetadas ' CONCEPTO,
      0.00 ESTIMADO, 
      0.0 DEVENGADO, 
      0.00 RECAUDADO
FROM SYSIBM.SYSDUMMY1

UNION ALL
SELECT 2 PRINCIPAL,
       2 GRUPO,
       'G' LETRA,
       '1' SCTA,
DECODE(SUBSTR(T5.CLVFTE,1,1),'1','Amortización de la Deuda Pública con Gasto No Etiquetado', 'Amortización de la Deuda Pública con Gasto Etiquetado')CONCEPTO ,
SUM(T5.ESTIMADO) ESTIMADO, SUM(T5.DEVENGADO) DEVENGADO, SUM(T5.RECAUDADO) RECAUDADO FROM
(SELECT T4.FTE, F.CLVFTE, T4.ESTIMADO, T4.DEVENGADO, T4.RECAUDADO FROM
(SELECT SUBSTR(T3.SSCTA,13,3) FTE, SUM(T3.ESTIMADO) ESTIMADO ,SUM(T3.DEVENGADO) DEVENGADO, SUM(T3.RECAUDADO) RECAUDADO FROM
(SELECT T2.SCTA, T2.SSCTA, SUM(T2.ESTIMADO) ESTIMADO ,SUM(T2.DEVENGADO) DEVENGADO, SUM(T2.RECAUDADO) RECAUDADO FROM
(SELECT T1.CUENTA, T1.SCTA, T1.SSCTA, T1.NOMCTA ,T1.SALINI ESTIMADO, 
DECODE(SUBSTR(T1.CUENTA,1,3),'825',(T1.CARGOS_1 + CARGOS_2 + CARGOS_3 + CARGOS_4 + CARGOS_5 + CARGOS_6 - ABONOS_1 - ABONOS_2 - ABONOS_3 - ABONOS_4 - ABONOS_5 - ABONOS_6),0.0) DEVENGADO,
DECODE(SUBSTR(T1.CUENTA,1,3),'827',(T1.CARGOS_1 + CARGOS_2 + CARGOS_3 + CARGOS_4 + CARGOS_5 + CARGOS_6 - ABONOS_1 - ABONOS_2 - ABONOS_3 - ABONOS_4 - ABONOS_5 - ABONOS_6),0.0) RECAUDADO
FROM CUENTA T1 WHERE T1.SSCTA<>'' AND T1.SSSCTA <> '' AND 
SUBSTR(T1.CUENTA,1,3) IN ('821','825','827')
AND SUBSTR(T1.SSSCTA,1,2) = '91'
) T2 GROUP BY T2.SCTA, T2.SSCTA ) T3 GROUP BY SUBSTR(T3.SSCTA,13,3)
) T4 LEFT JOIN FUENTEF F ON F.LIGA=T4.FTE WHERE F.NIVFTE=4 AND SUBSTR(F.CLVFTE,1,1) = '1'
) T5 GROUP BY SUBSTR(T5.CLVFTE,1,1)
UNION ALL
SELECT 2 PRINCIPAL,
       2 GRUPO,
       'G' LETRA,
       '2' SCTA,
       'Amortización de la Deuda Pública con Gasto Etiquetado' CONCEPTO ,
       0.00 ESTIMADO, 
       0.00 DEVENGADO, 
       0.00 RECAUDADO 
      FROM SYSIBM.SYSDUMMY1
) TI

ORDER BY TI.PRINCIPAL, TI.GRUPO, TI.SCTA ASC]]>
	</queryString>
