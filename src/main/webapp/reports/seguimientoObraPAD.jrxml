		<parameter name="idObra" class="java.lang.Long"/>
		<parameter name="importeContrato" class="java.math.BigDecimal">
			<defaultValueExpression><![CDATA[BigDecimal.ZERO]]></defaultValueExpression>
		</parameter>
		<queryString language="SQL">
			<![CDATA[SELECT 	P.AUTORIZACION_PAGO, P.NO_FACTURA, P.IMPORTE_FACTURA, 
		P.ESTIMACION, P.IMPORTE_AFECTACION_PRESUPUESTAL, 
		P.OBSERVACIONES, P.FECHA_PAGO, S.DESCRIPCION
	FROM TW_OBRA_PAGOS P
		INNER JOIN TC_STATUS_PAGO S ON P.ID_STATUS_PAGO = S.ID
WHERE P.ID_OBRA=$P{idObra}]]>
		</queryString>
