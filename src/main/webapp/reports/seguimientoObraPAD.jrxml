	<query language="SQL"><![CDATA[SELECT 	O.ID, O.NO_ACCION, O.NOMBRE_OBRA, O.ASIGNADO, O.AUTORIZADO, 
		C.NUMERO_CONTRATO, C.FECCHA_CREACION, C.IMPORTE_ADQUISICION,
		P.NOMBRE_PROVEEDOR
	FROM TW_OBRAS O
		INNER JOIN TC_CONTRATOS C ON O.ID_CONTRATO = C.ID
		INNER JOIN TC_PROVEEDORES_NUEVO P ON C.ID_PROVEEDOR = P.ID]]></query>
