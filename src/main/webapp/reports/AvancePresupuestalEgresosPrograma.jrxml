				<reportElement stretchType="RelativeToTallestObject" x="0" y="0" width="120" height="30" uuid="34c74931-7219-4c70-a05f-c8f79d6affbe">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
					<printWhenExpression><![CDATA[$P{noFirmas} >= 3]]></printWhenExpression>
				</reportElement>
