	<parameter name="firmaN5" class="java.lang.String"/>
	<query language="SQL"><![CDATA[SELECT * FROM (
	SELECT 	PA.PARTIDA CUENTA, NA.NOMGAS NOMCUENTA,	  
			SUBSTR (PA.PROGRAMA,1,2)FIN, SUBSTR (PA.PROGRAMA,3,2)FUN,
			SUBSTR (PA.PROGRAMA,5,2)SFN, SUBSTR (PA.PROGRAMA,7,2)PG,
			SUBSTR (PA.PROGRAMA,9,2)SPG, SUBSTR (PA.PROGRAMA,11,2)PY,
			SUBSTR (PA.PROGRAMA,13,2)FF, SUM(PA.AUTORIZADO_13)PREAUTO,
			SUM(PA.AUTORIZADO_1)  ENERO, SUM(PA.AUTORIZADO_2)  FEBRERO,
			SUM(PA.AUTORIZADO_3)  MARZO, SUM(PA.AUTORIZADO_4)  ABRIL,
       		SUM(PA.AUTORIZADO_5)  MAYO,  SUM(PA.AUTORIZADO_6)  JUNIO,
			SUM(PA.AUTORIZADO_7)  JULIO, SUM(PA.AUTORIZADO_8)  AGOSTO,
			SUM(PA.AUTORIZADO_9)  SEPTIEMBRE, SUM(PA.AUTORIZADO_10) OCTUBRE,
			SUM(PA.AUTORIZADO_11) NOVIEMBRE,  SUM(PA.AUTORIZADO_12) DICIEMBRE	  
		FROM TW_ANTEPROYECTO PA
     		LEFT JOIN NATGAS NA ON PA.PARTIDA=NA.CLVGAS AND PA.IDSECTOR=NA.IDSECTOR 
	WHERE 	PA.IDSECTOR= $P{sector}
		AND PA.PARTIDA BETWEEN 2000 AND 5999 
		AND PA.PARTIDA NOT BETWEEN 4000 AND 4999
	GROUP BY 	PA.PARTIDA, NA.NOMGAS, 	  SUBSTR(PA.PROGRAMA,1,2),
				SUBSTR(PA.PROGRAMA,3,2),  SUBSTR(PA.PROGRAMA,5,2),
				SUBSTR(PA.PROGRAMA,7,2),  SUBSTR(PA.PROGRAMA,9,2),
				SUBSTR(PA.PROGRAMA,11,2), SUBSTR(PA.PROGRAMA,13,2)
	)T1
$P!{saldoCero}
ORDER BY 3,4,5,6,7,8,9,1 ASC]]></query>
