<jasperReport name="ServiciosPersonalesDelMes" language="java" columnCount="1" dpi="72" pageWidth="595" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="4ca13698-03c7-447c-bcf6-1447bbca18e9" ignorePagination="true">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="alfredo"/>
	<parameter name="pMes" class="java.lang.Integer"/>
	<parameter name="pYear" class="java.lang.Integer"/>
	<parameter name="pSector" class="java.lang.Integer"/>
	<parameter name="pMesName" class="java.lang.String"/>
	<query language="SQL"><![CDATA[SELECT	SUBSTR(SCTA,1,3) GRUPO, 
		SCTA, 
		SUM((CANPOL) - (CANPOLH)) DIFERENCIA
FROM POLIDE
WHERE	ANOPOL = $P{pYear}
	AND IDSECTOR = $P{pSector}
	AND MESPOL = $P{pMes} 
	AND (SUBSTR(CUENTA,1,3) = '827' OR
		 SUBSTR(CUENTA,1,3) = '825' OR
		 SUBSTR(CUENTA,1,3) = '824'
		 )
	AND SUBSTR(SSSCTA,1,1) = '1'
GROUP BY SCTA
ORDER BY SCTA]]></query>
	<field name="GRUPO" class="java.lang.String"/>
	<field name="SCTA" class="java.lang.String"/>
	<field name="DIFERENCIA" class="java.math.BigDecimal"/>
	<variable name="vTotal" resetType="Group" calculation="Sum" resetGroup="Group1" class="java.math.BigDecimal">
		<expression><![CDATA[$F{DIFERENCIA}]]></expression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<group name="Group1">
		<expression><![CDATA[$F{GRUPO}]]></expression>
		<groupFooter>
			<band height="36">
				<element kind="staticText" uuid="d5a921c6-45b3-4329-9d3a-4528e45e1aa9" x="0" y="12" width="70" height="12" stretchType="NoStretch" fontName="Monospaced" fontSize="9.0">
					<property name="com.jaspersoft.studio.unit.y" value="pixel"/>
					<text><![CDATA[TOTAL]]></text>
				</element>
				<element kind="textField" uuid="f4ee8439-310d-4f73-9188-20f0efd9d92a" x="70" y="12" width="110" height="12" stretchType="NoStretch" fontName="Monospaced" fontSize="9.0" pattern="#,##0.00#" hTextAlign="Right">
					<property name="com.jaspersoft.studio.unit.x" value="pixel"/>
					<expression><![CDATA[$V{vTotal}]]></expression>
				</element>
				<element kind="staticText" uuid="a261b36e-d9fe-4956-a92a-3f027447eb20" x="70" y="0" width="110" height="12" stretchType="NoStretch" fontName="Monospaced" fontSize="9.0" hTextAlign="Center"
					><text><![CDATA[------------------------------]]></text>
				</element>
				<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
			</band>
		</groupFooter>
	</group>
	<title height="24">
		<element kind="textField" uuid="8afc5667-233d-466f-a479-e215969ef62d" x="0" y="0" width="555" height="12" stretchType="NoStretch" fontName="Monospaced" fontSize="9.0">
			<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
			<expression><![CDATA["SERVICIOS PERSONALES DEL MES DE " +$P{pMesName}]]></expression>
		</element>
		<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
	</title>
	<detail>
		<band height="12" splitType="Stretch">
			<element kind="textField" uuid="74ce5b2b-48ca-447c-8ae0-4c66572841a7" x="70" y="0" width="110" height="12" stretchType="NoStretch" fontName="Monospaced" fontSize="9.0" pattern="#,##0.00#" hTextAlign="Right">
				<property name="com.jaspersoft.studio.unit.x" value="pixel"/>
				<expression><![CDATA[$F{DIFERENCIA}]]></expression>
			</element>
			<element kind="textField" uuid="0c66a099-1fcb-4e31-b6b3-5acb6f87e0a8" x="0" y="0" width="70" height="12" stretchType="NoStretch" fontName="Monospaced" fontSize="9.0">
				<expression><![CDATA[$F{SCTA}]]></expression>
			</element>
			<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
