		<parameter name="MES2" class="java.lang.Integer"/>
		<query language="sql"><![CDATA[SELECT maycta.natcta
 , cuenta.nomcta
 , cuenta.cuenta
 , DECIMAL(cuenta.salini,20,2) AS salini
 , cuenta.scta
 , cuenta.sscta
 , cuenta.ssscta
 , cuenta.sssscta
 , cuenta.nivcta
 , maycta.cuenta
 , cuenta.notcta
 , COALESCE(DECIMAL(cuenta.cargos_1,20,2),0.00) AS cargos_1
 , COALESCE(DECIMAL(cuenta.cargos_2,20,2),0.00) AS cargos_2
 , COALESCE(DECIMAL(cuenta.cargos_3,20,2),0.00) AS cargos_3
 , COALESCE(DECIMAL(cuenta.cargos_4,20,2),0.00) AS cargos_4
 , COALESCE(DECIMAL(cuenta.cargos_5,20,2),0.00) AS cargos_5
 , COALESCE(DECIMAL(cuenta.cargos_6,20,2),0.00) AS cargos_6
 , COALESCE(DECIMAL(cuenta.cargos_7,20,2),0.00) AS cargos_7
 , COALESCE(DECIMAL(cuenta.cargos_8,20,2),0.00) AS cargos_8
 , COALESCE(DECIMAL(cuenta.cargos_9,20,2),0.00) AS cargos_9
 , COALESCE(DECIMAL(cuenta.cargos_10,20,2),0.00) AS cargos_10
 , COALESCE(DECIMAL(cuenta.cargos_11,20,2),0.00) AS cargos_11
 , COALESCE(DECIMAL(cuenta.cargos_12,20,2),0.00) AS cargos_12
 , COALESCE(DECIMAL(cuenta.abonos_1,20,2),0.00) AS abonos_1
 , COALESCE(DECIMAL(cuenta.abonos_2,20,2),0.00) AS abonos_2
 , COALESCE(DECIMAL(cuenta.abonos_3,20,2),0.00) AS abonos_3
 , COALESCE(DECIMAL(cuenta.abonos_4,20,2),0.00) AS abonos_4
 , COALESCE(DECIMAL(cuenta.abonos_5,20,2),0.00) AS abonos_5
 , COALESCE(DECIMAL(cuenta.abonos_6,20,2),0.00) AS abonos_6
 , COALESCE(DECIMAL(cuenta.abonos_7,20,2),0.00) AS abonos_7
 , COALESCE(DECIMAL(cuenta.abonos_8,20,2),0.00) AS abonos_8
 , COALESCE(DECIMAL(cuenta.abonos_9,20,2),0.00) AS abonos_9
 , COALESCE(DECIMAL(cuenta.abonos_10,20,2),0.00) AS abonos_10
 , COALESCE(DECIMAL(cuenta.abonos_11,20,2),0.00) AS abonos_11
 , COALESCE(DECIMAL(cuenta.abonos_12,20,2),0.00) AS abonos_12
 FROM   (maycta maycta INNER JOIN cuenta cuenta ON maycta.cuenta=cuenta.cuenta) 
 WHERE  (cuenta.cuenta>='1101' AND cuenta.cuenta<='6039') AND cuenta.sscta='' AND cuenta.notcta=0
 ORDER BY cuenta.cuenta, cuenta.scta, cuenta.sscta, cuenta.ssscta, cuenta.sssscta ASC]]></query>
