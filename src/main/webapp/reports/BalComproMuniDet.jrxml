	<query language="sql"><![CDATA[SELECT  
   			    COALESCE(TCIM.CLVMUN, 0) AS CLVMUN,
   			    COALESCE(TCIM.NOMBRE_FILE,'') AS IMG_MUN,
   			    COALESCE(TCIM.PATH_FILE,'') AS RUTA_MUN,
   			    COALESCE(TCIEA.ID_ENTIDAD_ADMIN,0) AS ID_ENTIDAD_ADMIN,
   			    COALESCE(TCIEA.NOMBRE_FILE,'') AS IMG_ENT,
   			    COALESCE(TCIEA.PATH_FILE,'') AS RUTA_ENT,
   			    F.L4,COALESCE(F.N4,'') AS N4,
   			    F.L27,COALESCE(F.N27,'') AS N27,
   			    F.L5,COALESCE(F.N5,'') AS N5,
				TU.NOMBRE,
				TU.ID_TIPO_USUARIO,
				CM.CLVMUN,
				CM.NOMMUN,
				TEA.CLAVE,
				TEA.DESCRIPCION,
				F.CAMPO3,
				TCR.ID_REF
		   FROM FIRMAS F
		   LEFT JOIN TC_U_REFERENCIA TCR ON F.ID_REF = TCR.ID_REF 
		   LEFT JOIN CATMUN CM ON  TCR.ID_MUN = CM.CLVMUN
		   LEFT JOIN TC_ENTIDAD_ADMINISTRATIVA TEA ON TCR.ID_UNI_ADMIN = TEA.CLAVE
		   LEFT JOIN LOCALIDADES L ON CM.CLVMUN = L.CVEMUN
		   LEFT JOIN TC_USUARIOS TU ON L.CVELOC = TU.ID_LOCALIDAD
		   LEFT JOIN TC_IMAGENES_MUNI  TCIM ON TCIM.CLVMUN = CM.CLVMUN
		   LEFT JOIN  TC_IMAGENES_ENT_ADMIN TCIEA ON TCR.ID_MUN = CM.CLVMUN AND TCR.ID_UNI_ADMIN = TCIEA.ID_ENTIDAD_ADMIN	       
		   WHERE TU.USUARIO =$P{USUARIO}]]></query>
	<field name="CLVMUN" class="java.lang.Integer"/>
	<field name="IMG_MUN" class="java.lang.String"/>
	<field name="RUTA_MUN" class="java.lang.String"/>
	<field name="ID_ENTIDAD_ADMIN" class="java.lang.Long"/>
	<field name="IMG_ENT" class="java.lang.String"/>
	<field name="RUTA_ENT" class="java.lang.String"/>
	<field name="L4" class="java.lang.String"/>
	<field name="N4" class="java.lang.String"/>
	<field name="L27" class="java.lang.String"/>
	<field name="N27" class="java.lang.String"/>
	<field name="L5" class="java.lang.String"/>
	<field name="N5" class="java.lang.String"/>
	<field name="NOMBRE" class="java.lang.String"/>
	<field name="ID_TIPO_USUARIO" class="java.lang.Long"/>
	<field name="COLUMN_15" class="java.lang.Integer"/>
	<field name="NOMMUN" class="java.lang.String"/>
	<field name="CLAVE" class="java.lang.String"/>
	<field name="DESCRIPCION" class="java.lang.String"/>
	<field name="CAMPO3" class="java.lang.Integer"/>
	<field name="ID_REF" class="java.lang.Long"/>
	<variable name="V_mes" incrementType="Report" class="java.util.List">
		<expression><![CDATA[java.util.Arrays.asList("","ENERO","FEBRERO","MARZO","ABRIL","MAYO","JUNIO","JULIO","AGOSTO","SEPTIEMBRE","OCTUBRE","NOVIEMBRE","DICIEMBRE")]]></expression>
		<initialValueExpression><![CDATA[new java.util.ArrayList()]]></initialValueExpression>
	</variable>
	<variable name="V_dia" incrementType="Report" class="java.util.List">
		<expression><![CDATA[java.util.Arrays.asList(0,31,28,31,30,31,30,31,31,30,31,30,31)]]></expression>
	</variable>
	<variable name="V_get_day" incrementType="Report" class="java.lang.Integer">
		<expression><![CDATA[($P{MES}==2)?(
($F{CAMPO3}%4==0)?
(29)
:($V{V_dia}.get($P{MES}))
):($V{V_dia}.get($P{MES}))]]></expression>
	</variable>
	<background splitType="Stretch"/>
