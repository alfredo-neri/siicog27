		<element kind="staticText" uuid="a44a2b35-cdc8-4841-a1dd-0f39aa880dd8" x="226" y="45" width="310" height="15" stretchType="NoStretch" fontName="Arial" fontSize="12.0" bold="true" hTextAlign="Center" vTextAlign="Middle"
			><text><![CDATA[BLANZA DE COMPROBACION DETALLADA]]></text>
		</element>
		<element kind="textField" uuid="d4619967-fc99-4ab9-9384-5a597c9abae6" x="15" y="60" width="205" height="15" stretchType="NoStretch" fontName="Arial" fontSize="10.0" hTextAlign="Left">
