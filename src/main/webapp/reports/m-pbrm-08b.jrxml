	<variable name="programa" class="java.lang.String">
		<expression><![CDATA[MID($F{CLVFUN},1,8)]]></expression>
	</variable>
	<variable name="proyecto" class="java.lang.String">
		<expression><![CDATA[MID($F{CLVFUN},11,2)]]></expression>
	</variable>
	<variable name="depgral" class="java.lang.String">
		<expression><![CDATA[MID($F{CLVDEP},1,3)]]></expression>
	</variable>
	<variable name="depaux" class="java.lang.String">
		<expression><![CDATA[MID($F{CLVDEP},4,3)]]></expression>
	</variable>
	<variable name="frecuencia" class="java.lang.String">
		<expression><![CDATA[($F{MFREC}.toUpperCase()=="S")?("Semestral"):(
	($F{MFREC}.toUpperCase()=="A")?("Anual"):(
		($F{MFREC}.toUpperCase()=="M")?("Mensual"):(
			($F{MFREC}.toUpperCase()=="T")?("Trimestral"):(
				""
			)
		)
	)
)]]></expression>
	</variable>
	<variable name="metanuale" class="java.math.BigDecimal">
		<expression><![CDATA[($P{p_Trim}==1)?($F{METANUALE1}):(
	($P{p_Trim}==2)?($F{METANUALE2}):(
		($P{p_Trim}==3)?($F{METANUALE3}):(
			($P{p_Trim}==4)?($F{METANUALE4}):(
				0.00
			)
		)
	)
)]]></expression>
	</variable>
	<variable name="progestimado" class="java.math.BigDecimal">
		<expression><![CDATA[($P{p_Trim}==1)?($F{PROG1}):(
	($P{p_Trim}==2)?($F{PROGE2}):(
		($P{p_Trim}==3)?($F{PROGE3}):(
			($P{p_Trim}==4)?($F{PROGE4}):(
				0.00
			)
		)
	)
)]]></expression>
	</variable>
	<variable name="alcanest" class="java.math.BigDecimal">
		<expression><![CDATA[($P{p_Trim}==1)?($F{ALCANE1}):(
	($P{p_Trim}==2)?($F{ALCANE2}):(
		($P{p_Trim}==3)?($F{ALCANE3}):(
			($P{p_Trim}==4)?($F{ALCANE4}):(
				0.00
			)
		)
	)
)]]></expression>
	</variable>
	<variable name="EFavan" class="java.math.BigDecimal">
		<expression><![CDATA[($V{progestimado}==0)?(0.00):(
	($V{alcanest}*100)/$V{progestimado}
)]]></expression>
	</variable>
	<variable name="semaforo1" class="java.lang.String">
		<expression><![CDATA[($P{p_Trim}==1)?($F{SEMAFORO1_1}):(
	($P{p_Trim}==2)?($F{SEMAFORO1_2}):(
		($P{p_Trim}==3)?($F{SEMAFORO1_3}):(
			($P{p_Trim}==4)?($F{SEMAFORO1_4}):(
				0.00
			)
		)
	)
)]]></expression>
	</variable>
	<variable name="progacum" class="java.math.BigDecimal">
		<expression><![CDATA[($P{p_Trim}==1)?($F{PROG1}):(
	($P{p_Trim}==2)?($F{PROGE2}):(
		($P{p_Trim}==3)?($F{PROGE3}):(
			($P{p_Trim}==4)?($F{PROGE4}):(
				0.00
			)
		)
	)
)]]></expression>
	</variable>
	<variable name="alcanacum" class="java.math.BigDecimal">
		<expression><![CDATA[($P{p_Trim}==1)?($F{ALCANE1}):(
	($P{p_Trim}==2)?($F{ALCANE2}):(
		($P{p_Trim}==3)?($F{ALCANE3}):(
			($P{p_Trim}==4)?($F{ALCANE4}):(
				0.00
			)
		)
	)
)]]></expression>
	</variable>
	<variable name="EFacum" class="java.math.BigDecimal">
		<expression><![CDATA[($V{progacum}==0)?(0.00):(
	($V{alcanacum}*100)/$V{progacum}
)]]></expression>
	</variable>
	<variable name="semaforo2" class="java.lang.String">
		<expression><![CDATA[($P{p_Trim}==1)?($F{SEMAFORO2_1}):(
	($P{p_Trim}==2)?($F{SEMAFORO2_2}):(
