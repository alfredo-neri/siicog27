	<dataset name="FIRMAS_LOGOS" uuid="e450e7f8-9d05-4555-9696-b182720a6eed">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="GEMDB-SERVER"/>
		<parameter name="Usuario1" class="java.lang.String"/>
		<query language="sql"><![CDATA[SELECT  
   			    COALESCE(TCIM.CLVMUN, 0) AS CLVMUN,
   			    COALESCE(TCIM.NOMBRE_FILE,'') AS IMG_MUN,
   			    COALESCE(TCIM.PATH_FILE,'') AS RUTA_MUN,
   			    COALESCE(TCIEA.ID_ENTIDAD_ADMIN,0) AS ID_ENTIDAD_ADMIN,
   			    COALESCE(TCIEA.NOMBRE_FILE,'') AS IMG_ENT,
   			    COALESCE(TCIEA.PATH_FILE,'') AS RUTA_ENT,
   			    F.L4,COALESCE(F.N4,'') AS N4,
   			    F.L5,COALESCE(F.N5,'') AS N5,
   			    F.CAMPO3,
				TU.NOMBRE,
				TU.ID_TIPO_USUARIO,
				CM.CLVMUN,
				CM.NOMMUN,
				TEA.CLAVE,
				TEA.DESCRIPCION
		   FROM FIRMAS F
		   LEFT JOIN TC_U_REFERENCIA TCR ON F.ID_REF = TCR.ID_REF 
		   LEFT JOIN CATMUN CM ON  TCR.ID_MUN = CM.CLVMUN
		   LEFT JOIN TC_ENTIDAD_ADMINISTRATIVA TEA ON TCR.ID_UNI_ADMIN = TEA.CLAVE
		   LEFT JOIN LOCALIDADES L ON CM.CLVMUN = L.CVEMUN
		   LEFT JOIN TC_USUARIOS TU ON L.CVELOC = TU.ID_LOCALIDAD
		   LEFT JOIN TC_IMAGENES_MUNI  TCIM ON TCIM.CLVMUN = CM.CLVMUN
		   LEFT JOIN  TC_IMAGENES_ENT_ADMIN TCIEA ON TCR.ID_MUN = CM.CLVMUN AND TCR.ID_UNI_ADMIN = TCIEA.ID_ENTIDAD_ADMIN	       
		   WHERE TCIEA.NOMBRE_FILE NOT LIKE '%edomex%' AND TU.USUARIO = $P{Usuario1}]]></query>
		<field name="CLVMUN" class="java.lang.Integer"/>
		<field name="IMG_MUN" class="java.lang.String"/>
		<field name="RUTA_MUN" class="java.lang.String"/>
		<field name="ID_ENTIDAD_ADMIN" class="java.lang.Long"/>
		<field name="IMG_ENT" class="java.lang.String"/>
		<field name="RUTA_ENT" class="java.lang.String"/>
		<field name="L4" class="java.lang.String"/>
		<field name="N4" class="java.lang.String"/>
		<field name="L5" class="java.lang.String"/>
		<field name="N5" class="java.lang.String"/>
		<field name="CAMPO3" class="java.lang.Integer"/>
		<field name="NOMBRE" class="java.lang.String"/>
		<field name="ID_TIPO_USUARIO" class="java.lang.Long"/>
		<field name="COLUMN_14" class="java.lang.Integer"/>
		<field name="NOMMUN" class="java.lang.String"/>
		<field name="CLAVE" class="java.lang.String"/>
		<field name="DESCRIPCION" class="java.lang.String"/>
	</dataset>
	<dataset name="DETALLE" uuid="28c7fae5-55bc-4b56-bbf0-17d64426676c">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="GEMDB-SERVER"/>
		<parameter name="trimestre_t" class="java.lang.Integer"/>
		<parameter name="cvtemas" class="java.lang.String"/>
		<parameter name="clvdep" class="java.lang.String"/>
		<parameter name="cveind" class="java.lang.String"/>
		<parameter name="clvfun_1_8" class="java.lang.String"/>
		<query language="sql"><![CDATA[SELECT
SUBSTR(FTECNICASD.CLVFUN,1,8) CLVFUN_1_8
, FTECNICASD.CLVDEP
, FTECNICASD.CLVFUN
, FTECNICASD.CODIGO
, FTECNICASD.VARIABLES
, FTECNICASD.UNIMED
, FTECNICASD.OPERACION
, COALESCE(FTECNICASD.METANUAL,0.00) METANUAL
, FTECNICASD.CVETEMAS
,COALESCE(FTECNICASD.PROG_1,0.00) PROG_1
,COALESCE(FTECNICASD.PROG_2,0.00) PROG_2
,COALESCE(FTECNICASD.PROG_3,0.00) PROG_3
,COALESCE(FTECNICASD.PROG_4,0.00) PROG_4
,COALESCE(FTECNICASD.ALCAN_1,0.00) ALCAN_1
,COALESCE(FTECNICASD.ALCAN_2,0.00) ALCAN_2
,COALESCE(FTECNICASD.ALCAN_3,0.00) ALCAN_3
,COALESCE(FTECNICASD.ALCAN_4,0.00) ALCAN_4
, FTECNICASD.CVEVAR
, COALESCE((FTECNICASD.PORCPROG_1+FTECNICASD.PORCPROG_2+FTECNICASD.PORCPROG_3+FTECNICASD.PORCPROG_4),0.00) PORCPROG
, COALESCE((FTECNICASD.PORCALCAN_1+FTECNICASD.PORCALCAN_2+FTECNICASD.PORCALCAN_3+FTECNICASD.PORCALCAN_4),0.00) PORCALCAN,
COALESCE(DECIMAL(PROG_1,24,2),0.00) AS PROG1,
COALESCE(DECIMAL(PROG_2,24,2),0.00) AS PROG2,
COALESCE(DECIMAL(PROG_3,24,2),0.00) AS PROG3,
COALESCE(DECIMAL(PROG_4,24,2),0.00) AS PROG4,
COALESCE(DECIMAL(ALCAN_1,24,2),0.00) AS ALCAN1,
COALESCE(DECIMAL(ALCAN_2,24,2),0.00) AS ALCAN2,
COALESCE(DECIMAL(ALCAN_3,24,2),0.00) AS ALCAN3,
COALESCE(DECIMAL(ALCAN_4,24,2),0.00) AS ALCAN4,
FTECNICASD.CVEIND
FROM
FTECNICASD FTECNICASD
WHERE FTECNICASD.IDSECTOR=1 AND SUBSTR(FTECNICASD.CLVFUN,1,8)= $P{clvfun_1_8}   AND FTECNICASD.CVETEMAS= $P{cvtemas}  AND FTECNICASD.CLVDEP=  $P{clvdep} AND FTECNICASD.CVEIND= $P{cveind}]]></query>
		<field name="CLVFUN_1_8" class="java.lang.String"/>
		<field name="CLVDEP" class="java.lang.String"/>
		<field name="CLVFUN" class="java.lang.String"/>
		<field name="CODIGO" class="java.lang.Integer"/>
		<field name="VARIABLES" class="java.lang.String"/>
		<field name="UNIMED" class="java.lang.String"/>
		<field name="OPERACION" class="java.lang.String"/>
		<field name="METANUAL" class="java.math.BigDecimal"/>
		<field name="CVETEMAS" class="java.lang.String"/>
		<field name="PROG_1" class="java.math.BigDecimal"/>
		<field name="PROG_2" class="java.math.BigDecimal"/>
		<field name="PROG_3" class="java.math.BigDecimal"/>
		<field name="PROG_4" class="java.math.BigDecimal"/>
		<field name="ALCAN_1" class="java.math.BigDecimal"/>
		<field name="ALCAN_2" class="java.math.BigDecimal"/>
		<field name="ALCAN_3" class="java.math.BigDecimal"/>
		<field name="ALCAN_4" class="java.math.BigDecimal"/>
		<field name="CVEVAR" class="java.lang.String"/>
		<field name="PORCPROG" class="java.math.BigDecimal"/>
		<field name="PORCALCAN" class="java.math.BigDecimal"/>
		<field name="PROG1" class="java.math.BigDecimal"/>
		<field name="PROG2" class="java.math.BigDecimal"/>
		<field name="PROG3" class="java.math.BigDecimal"/>
		<field name="PROG4" class="java.math.BigDecimal"/>
		<field name="ALCAN1" class="java.math.BigDecimal"/>
		<field name="ALCAN2" class="java.math.BigDecimal"/>
		<field name="ALCAN3" class="java.math.BigDecimal"/>
		<field name="ALCAN4" class="java.math.BigDecimal"/>
		<field name="CVEIND" class="java.lang.String"/>
		<variable name="prog" class="java.math.BigDecimal">
			<expression><![CDATA[($P{trimestre_t}==1)?($F{PROG_1}):(
	($P{trimestre_t}==2)?($F{PROG_2}):(
		($P{trimestre_t}==3)?($F{PROG_3}):(
			($P{trimestre_t}==4)?($F{PROG_4}):(
				0.00
			)
		)
	)
)]]></expression>
		</variable>
		<variable name="alcan" class="java.math.BigDecimal">
			<expression><![CDATA[($P{trimestre_t}==1)?($F{ALCAN_1}):(
	($P{trimestre_t}==2)?($F{ALCAN_2}):(
		($P{trimestre_t}==3)?($F{ALCAN_3}):(
			($P{trimestre_t}==4)?($F{ALCAN_4}):(
				0.00
			)
		)
	)
)]]></expression>
		</variable>
		<variable name="progracum" class="java.math.BigDecimal">
			<expression><![CDATA[($P{trimestre_t}==1)?($F{PROG1}):(
	($P{trimestre_t}==2)?($F{PROG1}+$F{PROG2}):(
		($P{trimestre_t}==3)?($F{PROG1}+$F{PROG2}+$F{PROG3}):(
			($P{trimestre_t}==4)?($F{PROG1}+$F{PROG2}+$F{PROG3}+$F{PROG4}):(
				0.00
			)
		)
	)
)]]></expression>
		</variable>
		<variable name="porprogacum" class="java.math.BigDecimal">
			<expression><![CDATA[($F{METANUAL}==0)?(0.00):(
	($V{progracum}*100)/$F{METANUAL}
)]]></expression>
		</variable>
		<variable name="alcanacum" class="java.math.BigDecimal">
			<expression><![CDATA[($P{trimestre_t}==1)?($F{ALCAN1}):(
	($P{trimestre_t}==2)?($F{ALCAN1}+$F{ALCAN2}):(
		($P{trimestre_t}==3)?($F{ALCAN1}+$F{ALCAN2}+$F{ALCAN3}):(
			($P{trimestre_t}==4)?($F{ALCAN1}+$F{ALCAN2}+$F{ALCAN3}+$F{ALCAN4}):(
				0.00
			)
		)
	)
)]]></expression>
		</variable>
		<variable name="poravanacum" class="java.math.BigDecimal">
			<expression><![CDATA[($F{METANUAL}==0)?(0.00):(
	($V{alcanacum}*100)/$F{METANUAL}
)]]></expression>
		</variable>
		<variable name="porprogavan" class="java.math.BigDecimal">
			<expression><![CDATA[($F{METANUAL}==0)?(0.00):(
	($V{prog}*100)/$F{METANUAL}	
)]]></expression>
		</variable>
		<variable name="poralcanavan" class="java.math.BigDecimal">
			<expression><![CDATA[($F{METANUAL}==0)?(0.00):(
	($V{alcan}*100)/$F{METANUAL}	
)]]></expression>
		</variable>
	</dataset>
	<parameter name="Usuario" class="java.lang.String"
		><description><![CDATA[]]></description>
		<defaultValueExpression><![CDATA["cruz_m"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_Trim" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[3]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[SELECT
COALESCE((FTECNICASM.CLVDEP || SUBSTR(FTECNICASM.CLVFUN,1,12) || FTECNICASM.CLVFIN || FTECNICASM.CVETEMAS || FTECNICASM.CVEIND), '') AS GRUPO,
SUBSTR(FTECNICASM.CLVFUN,1,8) CLVFUN_1_8
, COALESCE(FTECNICASM.CLVDEP, '') AS CLVDEP
, COALESCE(FTECNICASM.CLVFUN, '') AS CLVFUN 
, COALESCE(FTECNICASM.CLVFIN, '') AS CLVFIN
, COALESCE(FTECNICASM.OBJETIVO, '') AS OBJETIVO 
, COALESCE(FTECNICASM.NOMIND, '') AS NOMIND
, COALESCE(FTECNICASM.FORMULA, '') AS FORMULA
, COALESCE(FTECNICASM.INTERPRETACION, '') AS INTERPRETACION
, COALESCE(FTECNICASM.DIMENSION, '') AS DIMENSION
, COALESCE(FTECNICASM.DESCFAC, '') AS DESCFAC
, COALESCE(FTECNICASM.AMBITO1, '') AS AMBITO1
, COALESCE(FTECNICASM.AMBITO2, '') AS AMBITO2
, COALESCE(FTECNICASM.COBERTURA, '') AS COBERTURA
, COALESCE(FTECNICASM.DESCRIPCION, '') AS DESCRIPCION
, COALESCE(FTECNICASM.EVALUACION, '') AS EVALUACION
, COALESCE(FTECNICASM.CVETEMAS, '') AS CVETEMAS
, COALESCE(FTECNICASM.METANUALE_1,0) AS METANUALE_1
, COALESCE(FTECNICASM.METANUALE_2,0) AS METANUALE_2
, COALESCE(FTECNICASM.METANUALE_3,0) AS METANUALE_3
, COALESCE(FTECNICASM.METANUALE_4,0) AS METANUALE_4
, COALESCE(FTECNICASM.SEMAFORO1_1,'') AS SEMAFORO1_1
, COALESCE(FTECNICASM.SEMAFORO1_2,'') AS SEMAFORO1_2
, COALESCE(FTECNICASM.SEMAFORO1_3,'') AS SEMAFORO1_3
, COALESCE(FTECNICASM.SEMAFORO1_4,'') AS SEMAFORO1_4
, COALESCE(FTECNICASM.SEMAFORO2_1,'') AS SEMAFORO2_1
, COALESCE(FTECNICASM.SEMAFORO2_2,'') AS SEMAFORO2_2
, COALESCE(FTECNICASM.SEMAFORO2_3,'') AS SEMAFORO2_3
, COALESCE(FTECNICASM.SEMAFORO2_4,'') AS SEMAFORO2_4
, COALESCE(DECIMAL(PROGE_1,24,2),0) AS PROG1,
COALESCE(DECIMAL(PROGE_2,24,2),0) AS PROGE2,
COALESCE(DECIMAL(PROGE_3,24,2),0) AS PROGE3,
COALESCE(DECIMAL(PROGE_4,24,2),0) AS PROGE4,
COALESCE(DECIMAL(ALCANE_1,24,2),0) AS ALCANE1,
COALESCE(DECIMAL(ALCANE_2,24,2),0) AS ALCANE2,
COALESCE(DECIMAL(ALCANE_3,24,2),0) AS ALCANE3,
COALESCE(DECIMAL(ALCANE_4,24,2),0) AS ALCANE4,
COALESCE(DECIMAL(METANUALE_1,24,2),0) AS METANUALE1,
COALESCE(DECIMAL(METANUALE_2,24,2),0) AS METANUALE2,
COALESCE(DECIMAL(METANUALE_3,24,2),0) AS METANUALE3,
COALESCE(DECIMAL(METANUALE_4,24,2),0) AS METANUALE4,
CPD1.DESCRIPCION AS NOMPILAR,
CPD2.DESCRIPCION AS NOMTEMA, 
MUNINEP1.CAMPO6 AS NOMPROG,
MUNINEP2.CAMPO6 AS NOMPROY,
CATDGM.NOMBRE AS NOMGRAL,
CATDAA.NOMBRE AS NOMAUX,
MIR.NOMIND AS NOMINDICADOR,
MIR.FRECUENCIA AS MFREC,
MIR.TIPO AS MTIP, 
FTECNICASM.CVEIND
FROM
FTECNICASM FTECNICASM
INNER JOIN CPD CPD1 ON SUBSTR(FTECNICASM.CVETEMAS,1,4) = CPD1.CVETEMAS
INNER JOIN CPD CPD2 ON SUBSTR(FTECNICASM.CVETEMAS,1,6) = CPD2.CVETEMAS
INNER JOIN MUNINEP MUNINEP1 ON SUBSTR(FTECNICASM.CLVFUN,1,8) = MUNINEP1.CAMPO7
INNER JOIN MUNINEP MUNINEP2 ON SUBSTR(FTECNICASM.CLVFUN,1,12) = MUNINEP2.CAMPO7
INNER JOIN CATDGM CATDGM ON SUBSTR(FTECNICASM.CLVDEP,1,3) = CATDGM.CLAVE
INNER JOIN CATDAA CATDAA ON SUBSTR(FTECNICASM.CLVDEP,4,3) = CATDAA.CLAVE
INNER JOIN MIR MIR ON FTECNICASM.CVEIND = MIR.CODIGO
WHERE FTECNICASM.IDSECTOR=1]]></query>
