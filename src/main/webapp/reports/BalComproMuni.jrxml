			<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
			<expression><![CDATA["DEL 1  AL " +  $V{V_get_day} + " DE "+ $V{V_mes}.get($P{MES}) + " DE " + $F{CAMPO3}]]></expression>
