		<variable name="V_S1_Haber_SiHaber" class="java.math.BigDecimal">
			<expression><![CDATA[($F{CUENTA}=="1115" )?(0.00):(
	 ( $F{CUENTA}=="1161" )?(0.00):(
				($F{CUENTA}=="3241" )?(0.0):(
