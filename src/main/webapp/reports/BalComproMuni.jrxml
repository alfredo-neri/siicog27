		<variable name="V_S1_Debe" class="java.math.BigDecimal">
			<expression><![CDATA[($F{NATCTA}=="D" || $F{NATCTA}=="d")?(	
	($P{MES2}==1)?($F{SALINI}+($F{CARGOS_1}-$F{ABONOS_1})):(
		($P{MES2}==2)?($F{SALINI}+( ($F{CARGOS_1}+$F{CARGOS_2} )+( $F{ABONOS_1} + $F{ABONOS_2} ))):(
			($P{MES2}==3)?($F{SALINI}+( ($F{CARGOS_1}+$F{CARGOS_2}+$F{CARGOS_3} )+( $F{ABONOS_1} + $F{ABONOS_2}+ $F{ABONOS_3} ))):(
				($P{MES2}==4)?($F{SALINI}+( ($F{CARGOS_1}+$F{CARGOS_2}+$F{CARGOS_3}+$F{CARGOS_4} )+( $F{ABONOS_1} + $F{ABONOS_2}+ $F{ABONOS_3}+ $F{ABONOS_4}  ))):(
					($P{MES2}==5)?($F{SALINI}+( ($F{CARGOS_1}+$F{CARGOS_2}+$F{CARGOS_3}+$F{CARGOS_4}+$F{CARGOS_5} )+( $F{ABONOS_1} + $F{ABONOS_2}+ $F{ABONOS_3}+ $F{ABONOS_4}+ $F{ABONOS_5}  ))):(
						($P{MES2}==6)?($F{SALINI}+( ($F{CARGOS_1}+$F{CARGOS_2}+$F{CARGOS_3}+$F{CARGOS_4}+$F{CARGOS_5}+$F{CARGOS_6} )+( $F{ABONOS_1} + $F{ABONOS_2}+ $F{ABONOS_3}+ $F{ABONOS_4}+ $F{ABONOS_5}+ $F{ABONOS_6}  ))):(
							($P{MES2}==7)?($F{SALINI}+( ($F{CARGOS_1}+$F{CARGOS_2}+$F{CARGOS_3}+$F{CARGOS_4}+$F{CARGOS_5}+$F{CARGOS_6}+$F{CARGOS_7} )+( $F{ABONOS_1} + $F{ABONOS_2}+ $F{ABONOS_3}+ $F{ABONOS_4}+ $F{ABONOS_5}+ $F{ABONOS_6}+$F{ABONOS_7}  ))):(
								($P{MES2}==8)?($F{SALINI}+( ($F{CARGOS_1}+$F{CARGOS_2}+$F{CARGOS_3}+$F{CARGOS_4}+$F{CARGOS_5}+$F{CARGOS_6}+$F{CARGOS_7}+$F{CARGOS_8} )+( $F{ABONOS_1} + $F{ABONOS_2}+ $F{ABONOS_3}+ $F{ABONOS_4}+ $F{ABONOS_5}+ $F{ABONOS_6}+$F{ABONOS_7}+$F{ABONOS_8}  ))):(
									($P{MES2}==9)?($F{SALINI}+( ($F{CARGOS_1}+$F{CARGOS_2}+$F{CARGOS_3}+$F{CARGOS_4}+$F{CARGOS_5}+$F{CARGOS_6}+$F{CARGOS_7}+$F{CARGOS_8}+$F{CARGOS_9} )+( $F{ABONOS_1} + $F{ABONOS_2}+ $F{ABONOS_3}+ $F{ABONOS_4}+ $F{ABONOS_5}+ $F{ABONOS_6}+$F{ABONOS_7}+$F{ABONOS_8}+$F{ABONOS_9}  ))):(
										($P{MES2}==10)?($F{SALINI}+( ($F{CARGOS_1}+$F{CARGOS_2}+$F{CARGOS_3}+$F{CARGOS_4}+$F{CARGOS_5}+$F{CARGOS_6}+$F{CARGOS_7}+$F{CARGOS_8}+$F{CARGOS_9}+$F{CARGOS_10} )+( $F{ABONOS_1} + $F{ABONOS_2}+ $F{ABONOS_3}+ $F{ABONOS_4}+ $F{ABONOS_5}+ $F{ABONOS_6}+$F{ABONOS_7}+$F{ABONOS_8}+$F{ABONOS_9} +$F{ABONOS_10} ))):(
											($P{MES2}==11)?($F{SALINI}+( ($F{CARGOS_1}+$F{CARGOS_2}+$F{CARGOS_3}+$F{CARGOS_4}+$F{CARGOS_5}+$F{CARGOS_6}+$F{CARGOS_7}+$F{CARGOS_8}+$F{CARGOS_9}+$F{CARGOS_10}+$F{CARGOS_11} )+( $F{ABONOS_1} + $F{ABONOS_2}+ $F{ABONOS_3}+ $F{ABONOS_4}+ $F{ABONOS_5}+ $F{ABONOS_6}+$F{ABONOS_7}+$F{ABONOS_8}+$F{ABONOS_9} +$F{ABONOS_10}+$F{ABONOS_11} ))):(
