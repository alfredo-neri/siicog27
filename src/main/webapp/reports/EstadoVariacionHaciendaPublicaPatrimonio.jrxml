	<variable name="lastDayOfMonth" resetType="None" class="java.lang.Integer">
		<expression><![CDATA[DAYSINMONTH( (new SimpleDateFormat("dd-MM-yyyy")).parse(String.valueOf("01-"+$P{P_MES}+"-"+YEAR(NOW()))))]]></expression>
	</variable>
	<variable name="mes_extenso" resetType="None" class="java.lang.String">
		<expression><![CDATA[UPPER(new java.text.SimpleDateFormat("MMMMM", new Locale("es", "ES")).format(new SimpleDateFormat("yyyy/MM/dd").parse("1970/" + $P{P_MES}.toString() + "/01")) )]]></expression>
	</variable>
	<variable name="saldo_inicial" calculation="System" class="java.math.BigDecimal">
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="mes_anterior" calculation="System" class="java.math.BigDecimal">
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="mes_actual" calculation="System" class="java.math.BigDecimal">
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="mes_actual_ejercicio" calculation="System" class="java.math.BigDecimal">
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="total" calculation="System" class="java.math.BigDecimal">
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="total_saldo_inicial" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{SALINI}]]></expression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="total_mes_anterior" calculation="System" class="java.math.BigDecimal">
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="total_mes_actual" calculation="System" class="java.math.BigDecimal">
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="total_mes_actual_ejercicio" calculation="System" class="java.math.BigDecimal">
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="TOTAL_PAGE" resetType="None" incrementType="Report" class="java.lang.Integer">
		<expression><![CDATA[$V{PAGE_NUMBER}]]></expression>
	</variable>
	<variable name="total_general" calculation="System" class="java.math.BigDecimal">
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<group name="GROUP_PARTIDA">
		<expression><![CDATA[$F{GRUPO}]]></expression>
	</group>
