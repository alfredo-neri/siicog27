<!-- Created with Jaspersoft Studio version 6.20.3.final using JasperReports Library version 6.20.3-415f9428cffdb6805c6f85bbb29ebaf18813a2ab  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="estado_analitico_activo_ctapublica" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="9f2c9316-092d-4016-bc81-35eca18c379b">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="New Data Adapter"/>
	<parameter name="year" class="java.lang.Integer"/>
	<parameter name="img1" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT 1 GRUPO,         
		T2.CUENTA,         
		T2.NOMCTA,         
		T2.SALDO,         
		T2.CARGOS_MES,         
		T2.ABONOS_MES,         
		(T2.SALDO + T2.CARGOS_MES - T2.ABONOS_MES) SALDO_FINAL,         
		(T2.SALDO + T2.CARGOS_MES - T2.ABONOS_MES) - T2.SALDO VARIACION       
	FROM(  
		SELECT 	SUBSTR(T1.CUENTA,1,2) CUENTA,         
				'Efectivo y Equivalentes' NOMCTA,         
				SUM(T1.SALINI + CARGOS - ABONOS)  SALDO,         
				SUM(T1.CARGOS_MES) CARGOS_MES,         
				SUM(T1.ABONOS_MES) ABONOS_MES       
			FROM (  
				SELECT 	CU.CUENTA,  	
						CU.NOMCTA,  	
						CU.STACTA,  	
						CU. SALINI,
						0 CARGOS,
						0 ABONOS,
						CU.CARGOS_1 + CU.CARGOS_2 + CU.CARGOS_3 + CU.CARGOS_4 + CU.CARGOS_5 + CU.CARGOS_6 + CU.CARGOS_7 + CU.CARGOS_8 + CU.CARGOS_9 + CU.CARGOS_10 + CU.CARGOS_11 + CU.CARGOS_12 CARGOS_MES, 
						CU.ABONOS_1 + CU.ABONOS_2 + CU.ABONOS_3 + CU.ABONOS_4 + CU.ABONOS_5 + CU.ABONOS_6 + CU.ABONOS_7 + CU.ABONOS_8 + CU.ABONOS_9 + CU.ABONOS_10 + CU.ABONOS_11 + CU.ABONOS_12 ABONOS_MES  
					FROM  	CUENTA CU  
				WHERE 	CU.CUENTA AND 
						CU.CUENTA IN ('1111', '1112') AND 
						CU.SCTA = ''  
			) T1  
		GROUP BY SUBSTR(T1.CUENTA,1,2)  
	) T2 
UNION ALL 
SELECT 	1 GRUPO, 
		T2.CUENTA,         
		T2.NOMCTA,         
		T2.SALDO,         
		T2.CARGOS_MES,         
		T2.ABONOS_MES,         
		(T2.SALDO + T2.CARGOS_MES - T2.ABONOS_MES) SALDO_FINAL,         
		(T2.SALDO + T2.CARGOS_MES - T2.ABONOS_MES) - T2.SALDO VARIACION       
	FROM(  
		SELECT 	SUBSTR(T1.CUENTA,1,2) CUENTA,         
				'Derechos a Recibir Efectivo o Equivalentes' NOMCTA,         
				SUM(T1.SALINI + CARGOS - ABONOS)  SALDO,         
				SUM(T1.CARGOS_MES) CARGOS_MES,         
				SUM(T1.ABONOS_MES) ABONOS_MES       
			FROM (  
				SELECT 	CU.CUENTA,  	
						CU.NOMCTA,  	
						CU.STACTA,  	
						CU. SALINI,  	
						0 CARGOS,
						0 ABONOS,
						CU.CARGOS_1 + CU.CARGOS_2 + CU.CARGOS_3 + CU.CARGOS_4 + CU.CARGOS_5 + CU.CARGOS_6 + CU.CARGOS_7 + CU.CARGOS_8 + CU.CARGOS_9 + CU.CARGOS_10 + CU.CARGOS_11 + CU.CARGOS_12 CARGOS_MES, 
						CU.ABONOS_1 + CU.ABONOS_2 + CU.ABONOS_3 + CU.ABONOS_4 + CU.ABONOS_5 + CU.ABONOS_6 + CU.ABONOS_7 + CU.ABONOS_8 + CU.ABONOS_9 + CU.ABONOS_10 + CU.ABONOS_11 + CU.ABONOS_12 ABONOS_MES  
					FROM  CUENTA CU  
				WHERE 	CU.CUENTA  = '1123'  AND 
						CU.SCTA = ''  
			) T1  
		GROUP BY SUBSTR(T1.CUENTA,1,2) 
	) T2 
UNION ALL 
SELECT 	1 GRUPO, 
		CU.CUENTA,         
		CU.NOMCTA,          
		0 SALDO,          
		0 CARGOS_MES,          
		0 ABONOS_MES,          
		0 SALDO_FINAL,          
		0 VARIACION        
	FROM CUENTA CU  
WHERE 	CU.CUENTA >= '1130' AND 
		CU.CUENTA <= '1160' AND 
		SUBSTR(CU.CUENTA,4,1) = '0' 
UNION ALL 
SELECT 	1 GRUPO,
		T2.CUENTA,         
		T2.NOMCTA,         
		T2.SALDO,         
		T2.CARGOS_MES,         
		T2.ABONOS_MES,         
		(T2.SALDO + T2.CARGOS_MES - T2.ABONOS_MES) SALDO_FINAL,         
		(T2.SALDO + T2.CARGOS_MES - T2.ABONOS_MES) - T2.SALDO VARIACION       
	FROM(  
		SELECT 	SUBSTR(T1.CUENTA,1,2)||'70' 
				CUENTA,         
				'Otros Activos  Circulantes' NOMCTA,         
				SUM(T1.SALINI + CARGOS - ABONOS)  SALDO,         
				SUM(T1.CARGOS_MES) CARGOS_MES,         
				SUM(T1.ABONOS_MES) ABONOS_MES       
				FROM (  
					SELECT 	CU.CUENTA,  	
							CU.NOMCTA,  	
							CU.STACTA,  	
							CU. SALINI, 
							0 CARGOS,
							0 ABONOS,
							CU.CARGOS_1 + CU.CARGOS_2 + CU.CARGOS_3 + CU.CARGOS_4 + CU.CARGOS_5 + CU.CARGOS_6 + CU.CARGOS_7 + CU.CARGOS_8 + CU.CARGOS_9 + CU.CARGOS_10 + CU.CARGOS_11 + CU.CARGOS_12 CARGOS_MES, 
							CU.ABONOS_1 + CU.ABONOS_2 + CU.ABONOS_3 + CU.ABONOS_4 + CU.ABONOS_5 + CU.ABONOS_6 + CU.ABONOS_7 + CU.ABONOS_8 + CU.ABONOS_9 + CU.ABONOS_10 + CU.ABONOS_11 + CU.ABONOS_12 ABONOS_MES  
						FROM  	CUENTA CU  
					WHERE 	CU.CUENTA  = '1191' AND 
							CU.SCTA = ''  
				) T1  
			GROUP BY SUBSTR(T1.CUENTA,1,2)  
	) T2 
UNION ALL 
SELECT 	2 GRUPO, 
		CU.CUENTA,         
		CU.NOMCTA,          
		0 SALDO,          
		0 CARGOS_MES,          
		0 ABONOS_MES,          
		0 SALDO_FINAL,          
		0 VARIACION        
	FROM CUENTA CU  
WHERE 	CU.CUENTA >= '1210' AND 
		CU.CUENTA <= '1230' AND 
		SUBSTR(CU.CUENTA,4,1) = '0'   
UNION ALL  
SELECT 	2 GRUPO,         
		T2.CUENTA,         
		T2.NOMCTA,         
		T2.SALDO,         
		T2.CARGOS_MES,         
		T2.ABONOS_MES,         
		(T2.SALDO + T2.CARGOS_MES - T2.ABONOS_MES) SALDO_FINAL, 
		(T2.SALDO + T2.CARGOS_MES - T2.ABONOS_MES) - T2.SALDO VARIACION  
	FROM(  
		SELECT 	SUBSTR(T1.CUENTA,1,2)||'40' CUENTA, 
				'Bienes Muebles' NOMCTA,        
				SUM(T1.SALINI + CARGOS - ABONOS)  SALDO,         
				SUM(T1.CARGOS_MES) CARGOS_MES,         
				SUM(T1.ABONOS_MES) ABONOS_MES       
			FROM (  
				SELECT 	CU.CUENTA,  	
						CU.NOMCTA,  	
						CU.STACTA,  	
						CU. SALINI, 
						0 CARGOS,
						0 ABONOS,
						CU.CARGOS_1 + CU.CARGOS_2 + CU.CARGOS_3 + CU.CARGOS_4 + CU.CARGOS_5 + CU.CARGOS_6 + CU.CARGOS_7 + CU.CARGOS_8 + CU.CARGOS_9 + CU.CARGOS_10 + CU.CARGOS_11 + CU.CARGOS_12 CARGOS_MES, 
						CU.ABONOS_1 + CU.ABONOS_2 + CU.ABONOS_3 + CU.ABONOS_4 + CU.ABONOS_5 + CU.ABONOS_6 + CU.ABONOS_7 + CU.ABONOS_8 + CU.ABONOS_9 + CU.ABONOS_10 + CU.ABONOS_11 + CU.ABONOS_12 ABONOS_MES  
					FROM  CUENTA CU  
				WHERE 	CU.CUENTA IN ('1242','1244','1246', '1241') AND 
						CU.SCTA = ''  
			) T1          
		GROUP BY SUBSTR(T1.CUENTA,1,2)  
	) T2 
UNION ALL 
SELECT 	2 GRUPO,         
		CU.CUENTA,         
		CU.NOMCTA,          
		0 SALDO,          
		0 CARGOS_MES,          
		0 ABONOS_MES,          
		0 SALDO_FINAL,          
		0 VARIACION        
	FROM CUENTA CU  
WHERE 	CU.CUENTA = '1250' AND 
		SUBSTR(CU.CUENTA,4,1) = '0' 
UNION ALL 
SELECT 	2 GRUPO,         
		T2.CUENTA,         
		T2.NOMCTA,         
		T2.SALDO,         
		T2.CARGOS_MES,         
		T2.ABONOS_MES,         
		(T2.SALDO + T2.CARGOS_MES - T2.ABONOS_MES) SALDO_FINAL,         
		(T2.SALDO + T2.CARGOS_MES - T2.ABONOS_MES) - T2.SALDO VARIACION       
	FROM(  
		SELECT 	T1.CUENTA CUENTA,         
				'Depreciación, Deterioro y Amortización Acumulada de Bienes' NOMCTA,         
				SUM(T1.SALINI + CARGOS - ABONOS)  SALDO,         
				SUM(T1.CARGOS_MES) CARGOS_MES,         
				SUM(T1.ABONOS_MES) ABONOS_MES       
			FROM (  
				SELECT 	CU.CUENTA,  	
						CU.NOMCTA,  	
						CU.STACTA,  	
						(CU. SALINI*-1) SALINI,  	
						0 CARGOS,
						0 ABONOS,
						CU.CARGOS_1 + CU.CARGOS_2 + CU.CARGOS_3 + CU.CARGOS_4 + CU.CARGOS_5 + CU.CARGOS_6 + CU.CARGOS_7 + CU.CARGOS_8 + CU.CARGOS_9 + CU.CARGOS_10 + CU.CARGOS_11 + CU.CARGOS_12 CARGOS_MES, 
						CU.ABONOS_1 + CU.ABONOS_2 + CU.ABONOS_3 + CU.ABONOS_4 + CU.ABONOS_5 + CU.ABONOS_6 + CU.ABONOS_7 + CU.ABONOS_8 + CU.ABONOS_9 + CU.ABONOS_10 + CU.ABONOS_11 + CU.ABONOS_12 ABONOS_MES  
					FROM  	CUENTA CU  
				WHERE 	CU.CUENTA AND 
						CU.CUENTA ='1263' AND 
						CU.SCTA = ''  
			) T1  
		GROUP BY T1.CUENTA  
	) T2 
UNION ALL 
SELECT 	2 GRUPO,         
		CU.CUENTA,         
		CU.NOMCTA,          
		SALINI SALDO, 
		CU.CARGOS_1 + CU.CARGOS_2 + CU.CARGOS_3 + CU.CARGOS_4 + CU.CARGOS_5 + CU.CARGOS_6 + CU.CARGOS_7 + CU.CARGOS_8 + CU.CARGOS_9 + CU.CARGOS_10 + CU.CARGOS_11 + CU.CARGOS_12 CARGOS_MES, 
		CU.ABONOS_1 + CU.ABONOS_2 + CU.ABONOS_3 + CU.ABONOS_4 + CU.ABONOS_5 + CU.ABONOS_6 + CU.ABONOS_7 + CU.ABONOS_8 + CU.ABONOS_9 + CU.ABONOS_10 + CU.ABONOS_11 + CU.ABONOS_12 ABONOS_MES,            
		SALINI + (CU.CARGOS_1 + CU.CARGOS_2 + CU.CARGOS_3 + CU.CARGOS_4 + CU.CARGOS_5 + CU.CARGOS_6 + CU.CARGOS_7 + CU.CARGOS_8 + CU.CARGOS_9 + CU.CARGOS_10 + CU.CARGOS_11 + CU.CARGOS_12) - (CU.ABONOS_1 + CU.ABONOS_2 + CU.ABONOS_3 + CU.ABONOS_4 + CU.ABONOS_5 + CU.ABONOS_6 + CU.ABONOS_7 + CU.ABONOS_8 + CU.ABONOS_9 + CU.ABONOS_10 + CU.ABONOS_11 + CU.ABONOS_12) SALDO_FINAL,          
		(SALINI + (CU.CARGOS_1 + CU.CARGOS_2 + CU.CARGOS_3 + CU.CARGOS_4 + CU.CARGOS_5 + CU.CARGOS_6 + CU.CARGOS_7 + CU.CARGOS_8 + CU.CARGOS_9 + CU.CARGOS_10 + CU.CARGOS_11 + CU.CARGOS_12) - (CU.ABONOS_1 + CU.ABONOS_2 + CU.ABONOS_3 + CU.ABONOS_4 + CU.ABONOS_5 + CU.ABONOS_6 + CU.ABONOS_7 + CU.ABONOS_8 + CU.ABONOS_9 + CU.ABONOS_10 + CU.ABONOS_11 + CU.ABONOS_12)) - SALINI VARIACION        
	FROM CUENTA CU  
WHERE 	CU.CUENTA IN ('1270', '1280', '1290') AND 
		SUBSTR(CU.CUENTA,4,1) = '0'  
ORDER BY 1, 2 ASC]]>
	</queryString>
