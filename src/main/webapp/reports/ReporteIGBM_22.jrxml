	<query language="sql"><![CDATA[SELECT B.MES,
       B.CONSEC,
       B.CUENTA,
       SUBSTR(B.SCTA,8,3) SCTA,
       B.NOMCTA,
       B.INVENTARIO,
       B.RESGUARDATARIO,
       B.NOMMUEBLE,
       B.MARCA,
       B.MODELO,
       B.SERIE,
       B.FACTURA,
       B.FECFACTURA,
       B.PROVEEDOR,
       B.COSTO,
       B.TIPPOL,
       B.CONPOL,
       B.FECPOL,
       B.FECALTA,
       B.AREA,
       B.TVIDAUTIL,
       B.PORCENTAJE,
       B.DEPREPERIODO,
       B.DEPREACUM,
       B.OBS
       FROM BIENESM B
WHERE B.IDSECTOR=$P{pIdSector}
AND B.MES<= ($P{pSemestre} * 6)
ORDER BY B.CUENTA,
       SUBSTR(B.SCTA,8,3),
       B.FECALTA ASC]]></query>
