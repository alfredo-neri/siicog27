	<parameter name="fecha" class="java.lang.String"/>
	<query language="SQL"><![CDATA[SELECT ING.CUENTA,
       ING.SCTA,
       ING.SSCTA,
       ING.SSSCTA,
       ING.SSSSCTA,
       CU.NOMCTA ,
       ING.AUTOI_1,
       ING.AUTOI_2,
       ING.AUTOI_3,
       ING.AUTOI_4,
       ING.AUTOI_5,
       ING.AUTOI_6,
       ING.AUTOI_7,
       ING.AUTOI_8,
       ING.AUTOI_9,
       ING.AUTOI_10,
       ING.AUTOI_11,
       ING.AUTOI_12,
       ING.AUTOI_13
     FROM INGRESO ING,
          CUENTA CU
WHERE ING.CUENTA   = CU.CUENTA
  AND ING.SCTA     = CU.SCTA
  AND ING.SSCTA    = CU.SSCTA
  AND ING.SSSCTA   = CU.SSSCTA
  AND ING.SSSSCTA  = CU.SSSSCTA
  AND ING.IDSECTOR = CU.IDSECTOR
  AND ING.IDSECTOR = $P{idSector}
ORDER BY ING.CUENTA,
       ING.SCTA,
       ING.SSCTA,
       ING.SSSCTA,
       ING.SSSSCTA ASC]]></query>
