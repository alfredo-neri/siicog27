	<query language="sql"><![CDATA[SELECT 
  B.MES
, B.CONSEC
, B.CUENTA
, SUBSTR(B.SCTA,8,3) SCTA
, B.NOMCTA
, B.NOMMUEBLE
, B.LOCALIDAD
, B.UBICACION
, B.NORTE
, B.SUR
, B.ORIENTE
, B.PONIENTE
, B.SUPERFICIE
, B.SUPCONST
, B.VALORINM
, B.USO
, B.ZONA
, B.ESCRITURA
, B.REGISTRO
, B.CVECATAS
, B.VALORCATAS
, B.JURIDICA
, B.MODADQUI
, B.FECADQ
, B.TIPPOL
, B.CONPOL
, B.FECPOL
, B.FECALTA
, B.FECBAJA
, B.OBS
, B.TVIDAUTIL
, (B.DEPREPERIODO * 12) DEPREPERIODO
, B.DEPREACUM
, B.DOCUMENTO
, B.PORCENTAJE
, B.FECCONTRATO
 FROM BIENESINM B
 WHERE B.IDSECTOR=  $P{sector} 
 AND B.MES BETWEEN  1 AND  12
  ORDER BY B.MES, B.CONSEC]]></query>
