		<expression><![CDATA[$F{SALDO_ACTUAL}]]></expression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="subtotalActivoAnt" resetType="Group" calculation="Sum" resetGroup="GRUPO" class="java.math.BigDecimal">
		<expression><![CDATA[$F{SALDO_ANTERIOR}]]></expression>
	</variable>
