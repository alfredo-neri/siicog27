<jasperReport name="activoDetallado" language="java" columnCount="1" dpi="72" pageWidth="445" pageHeight="612" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="445" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" whenResourceMissingType="Error" uuid="adb6b51c-30dd-49dc-bc70-4989735dd919">
