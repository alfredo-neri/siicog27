	10,
	'h',
	'1280',
	'Estimación por Pérdida o Deterioro de Activos no Circulantes',
	0.00,
	0.00),
	(2,
	10,
	'i',
	'1290',
	'Otros Activos no Circulantes',
	0.00,
	0.00) ) AS TEMP (PRINCIPAL,
	GRUPO,
	LETRA,
	CUENTA,
	NOMCTA,
	SALDO_ACTUAL,
	SALDO_ANTERIOR)
ORDER BY
	4]]></query>
