						<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					</box>
					<expression><![CDATA[$F{GRUPO} == 1? "  a. Efectivo y Equivalentes (a=a1+a2+a3+a4+a5+a6+a7)": $F{GRUPO} ==2 ? "  b. Derechos a Recibir Efectivo o Equivalentes (b=b1+b2+b3+b4+b5+b6+b7)" : $F{GRUPO} == 3 ? "  c. Derechos a Recibir Bienes o Servicios (c=c1+c2+c3+c4+c5)" : $F{GRUPO} == 4 ? "  d. Invenatarios (d=d1+d2+d3+d4+d5)" : $F{GRUPO} == 5 ? "  e. Almacenes": $F{GRUPO} == 6 ? "  f. Estimación por Pérdida o Deterioro de Activos Circulantes (f=f1+f2)":$F{GRUPO}==9 ?"  g. Otros Activos Circulantes (g=g1+g2+g3+g4)": "Activo No Circulante"]]></expression>
				</element>
				<element kind="textField" uuid="9897c3b4-cb06-4841-8c38-5c49ecc07740" x="265" y="0" width="90" height="10" mode="Opaque" stretchType="NoStretch" fontSize="7.0" evaluationTime="Group" pattern="#,##0.00" bold="true" evaluationGroup="GRUPO" hTextAlign="Right">
