	'f',
	'1161',
	'Estimaciones para Cuentas Incobrables por Derechos a Recibir Efectivo o 
	Equivalentes',
	0.00,
	0.00),
	(1,
	6,
	'f',
	'1162',
	'Estimación por Deterioro de Inventarios',
	0.00,
	0.00),
	(1,
	9,
	'g',
	'1192',
	'Bienes en Garantía (excluye depósitos de fondos)',
	0.00,
	0.00),
	(1,
	9,
	'g',
	'1193',
	'Bienes Derivados de Embargos, Decomisos, Aseguramientos y Dación en Pago',
	0.00,
	0.00),
	(1,
	9,
	'g',
	'1194',
	'Adquisición con Fondos de Terceros',
	0.00,
	0.00) ) AS TEMP (PRINCIPAL,
	GRUPO,
	LETRA,
	CUENTA,
	NOMCTA,
	SALDO_ACTUAL,
	SALDO_ANTERIOR)
UNION
SELECT
	2 PRINCIPAL,
	10 GRUPO,
	CASE WHEN CUENTA = '1241' THEN 'd' WHEN CUENTA = '1263' THEN 'f' END LETRA,
	CUENTA,
	NOMCTA,
	SALDO_ACTUAL,
	SALDO_ANTERIOR
FROM
	(
SELECT
	NOMCTA,
	CUENTA,
	SUM(MES_ACT) SALDO_ACTUAL,
	SUM(MES_ANT) SALDO_ANTERIOR
FROM
	(
SELECT
	CASE WHEN CUENTA = '1263' THEN CUENTA ELSE '1241' END CUENTA,
	CASE WHEN CUENTA = '1263' THEN NOMCTA ELSE 'Bienes Muebles' END NOMCTA,
	CASE WHEN CUENTA = '1263' THEN (SALINI-CARGOS_ACT+ABONOS_ACT)*-1 ELSE 
	SALINI+CARGOS_ACT-ABONOS_ACT END MES_ACT,
	CASE WHEN CUENTA = '1263' THEN (SALINI-CARGOS_ANT+ABONOS_ANT)*-1 ELSE 
	SALINI+CARGOS_ANT-ABONOS_ANT END MES_ANT
FROM
	(
SELECT
	C.NOMCTA,
	C.CUENTA,
	C.SALINI,
	C.CARGOS_1 + C.CARGOS_2 + C.CARGOS_3 + C.CARGOS_4 + C.CARGOS_5 + C.CARGOS_6 
	+ C.CARGOS_7 + C.CARGOS_8 + C.CARGOS_9 CARGOS_ANT,
	C.ABONOS_1 + C.ABONOS_2 + C.ABONOS_3 + C.ABONOS_4 + C.ABONOS_5 + C.ABONOS_6 
	+ C.ABONOS_7 + C.ABONOS_8 + C.ABONOS_9 ABONOS_ANT,
	C.ABONOS_1 + C.ABONOS_2 + C.ABONOS_3 + C.ABONOS_4 + C.ABONOS_5 + C.ABONOS_6 
	+ C.ABONOS_7 + C.ABONOS_8 + C.ABONOS_9 + C.ABONOS_10 + C.ABONOS_11 +
	C.ABONOS_12 ABONOS_ACT,
	C.CARGOS_1 + C.CARGOS_2 + C.CARGOS_3 + C.CARGOS_4 + C.CARGOS_5 + C.CARGOS_6 
	+ C.CARGOS_7 + C.CARGOS_8 + C.CARGOS_9 + C.CARGOS_10 + C.CARGOS_11 +
	C.CARGOS_12 CARGOS_ACT
FROM
	MAYCTA MA
		INNER JOIN
		CUENTA C
		ON
		MA.CUENTA = C.CUENTA
WHERE
	C.CUENTA IN ('1241',
	'1242',
	'1243',
	'1244',
	'1245',
	'1246',
	'1263') AND
	C.SCTA = '' AND
	C.IDSECTOR = 2
ORDER BY
	C.CUENTA ))
GROUP BY
	NOMCTA,
	CUENTA)
UNION
	ALL
SELECT
	*
FROM
	(
VALUES
	(2,
	10,
	'a',
	'1210',
	'Inversiones Financieras a Largo Plazo',
	0.00,
