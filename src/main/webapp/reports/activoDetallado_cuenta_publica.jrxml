	<group name="GRUPO">
		<expression><![CDATA[$F{GRUPO}]]></expression>
		<groupHeader>
			<band height="10">
				<element kind="textField" uuid="6f6d9141-4fe6-4402-abcb-aae013e2bb02" x="0" y="0" width="265" height="10" mode="Opaque" stretchType="NoStretch" fontSize="7.0" bold="true">
