	<subDataset name="hacienda" uuid="96f8b0c7-caf1-4683-a269-b5e1494f03b6">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="LENOVO PRUEBAS"/>
		<parameter name="sSqlHacienda" class="java.lang.String"/>
		<parameter name="month" class="java.lang.String"/>
		<parameter name="year" class="java.lang.Integer"/>
		<parameter name="cuenta3211Act" class="java.math.BigDecimal"/>
		<parameter name="cuenta3211Ant" class="java.math.BigDecimal"/>
		<queryString language="SQL">
			<![CDATA[SELECT DECODE(SUBSTR(T1.CUENTA,1,2), '31', 1, '32', 2, 3) GRUPO,        
T1.CUENTA,        MA.NOMMAY NOMCTA,   
DECODE(T1.CUENTA,'3210', FN_GET_CUENTA_3211(9, 'a'),  T1.SALINI_ANTI - T1.CARGOS_ANT + ABONOS_ANT)     SALDO_ANTE,       
DECODE(T1.CUENTA,'3210', FN_GET_CUENTA_3211(12, 'a'), T1.SALINI - T1.CARGOS + ABONOS) SALDOACTUAL      
FROM (SELECT CU.CUENTA,   CU.SALINI SALINI, CA.SALINI SALINI_ANTI,
	CA.CARGOS_1 + CA.CARGOS_2 + CA.CARGOS_3 + CA.CARGOS_4 + CA.CARGOS_5 + 
	CA.CARGOS_6 + CA.CARGOS_7 + CA.CARGOS_8 + CA.CARGOS_9 + CA.CARGOS_10 +
	CA.CARGOS_11 + CA.CARGOS_12 CARGOS_ANT,
	CA.ABONOS_1 + CA.ABONOS_2 + CA.ABONOS_3 + CA.ABONOS_4 + CA.ABONOS_5 + 
	CA.ABONOS_6 + CA.ABONOS_7 + CA.ABONOS_8 + CA.ABONOS_9 + CA.ABONOS_10 +
	CA.ABONOS_11 + CA.ABONOS_12 ABONOS_ANT,
CU.CARGOS_1 + CU.CARGOS_2 + CU.CARGOS_3 + CU.CARGOS_4 + CU.CARGOS_5 + CU.CARGOS_6 + CU.CARGOS_7 + CU.CARGOS_8 + CU.CARGOS_9 + CU.CARGOS_10 + CU.CARGOS_11 + CU.CARGOS_12  CARGOS, 
CU.ABONOS_1 + CU.ABONOS_2 + CU.ABONOS_3 + CU.ABONOS_4 + CU.ABONOS_5 + CU.ABONOS_6 + CU.ABONOS_7 + CU.ABONOS_8 + CU.ABONOS_9 + CU.ABONOS_10 + CU.ABONOS_11 + CU.ABONOS_12  ABONOS                
FROM CUENTA CU, CUENTA_ANTERIOR CA     
 WHERE CU.CUENTA = CA.CUENTA AND
  SUBSTR(CU.CUENTA,4,1) = '0'                             AND SUBSTR(CU.CUENTA,3,1) <> '0'                             AND CU.SCTA = ''                AND SUBSTR(CU.CUENTA,1,2) IN ('31','32', '33')         ) T1,          
 MAYCTA MA  WHERE  MA.CUENTA = T1.CUENTA
 ORDER BY 1, 2]]>
		</queryString>
		<field name="NOMCTA" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="NOMCTA"/>
			<property name="com.jaspersoft.studio.field.label" value="NOMCTA"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="CUENTA"/>
		</field>
		<field name="SALDOACTUAL" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="SALDOACTUAL"/>
			<property name="com.jaspersoft.studio.field.label" value="SALDOACTUAL"/>
		</field>
		<field name="SALDO_ANTE" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="MES6"/>
			<property name="com.jaspersoft.studio.field.label" value="SALDO_ANTE"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="TC_CUENTAANTERIOR"/>
		</field>
		<field name="GRUPO" class="java.lang.Integer">
			<property name="com.jaspersoft.studio.field.name" value="GRUPO"/>
			<property name="com.jaspersoft.studio.field.label" value="GRUPO"/>
		</field>
		<field name="CUENTA" class="java.lang.String"/>
		<variable name="totalActual" class="java.math.BigDecimal" resetType="Group" resetGroup="GRUPO" calculation="Sum">
			<variableExpression><![CDATA[$F{SALDOACTUAL}]]></variableExpression>
			<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
		</variable>
		<variable name="totalAnterior" class="java.math.BigDecimal" resetType="Group" resetGroup="GRUPO" calculation="Sum">
			<variableExpression><![CDATA[$F{SALDO_ANTE}]]></variableExpression>
			<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
		</variable>
		<variable name="totalActualHacienda" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{SALDOACTUAL}]]></variableExpression>
			<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
		</variable>
		<variable name="totalAnteriorHacienda" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{SALDO_ANTE}]]></variableExpression>
			<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
		</variable>
		<group name="GRUPO">
			<groupExpression><![CDATA[$F{GRUPO}]]></groupExpression>
		</group>
	</subDataset>
	<parameter name="ente" class="java.lang.String"/>
