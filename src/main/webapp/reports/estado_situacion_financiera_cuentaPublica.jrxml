			<property name="com.jaspersoft.studio.field.tree.path" value="TC_CUENTAANTERIOR"/>
		</field>
		<variable name="totalMes" class="java.math.BigDecimal" resetType="Group" resetGroup="GRUPO" calculation="Sum">
			<variableExpression><![CDATA[$F{SALDOACTUAL}]]></variableExpression>
			<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
		</variable>
		<variable name="totalEstimado" class="java.math.BigDecimal" resetType="Group" resetGroup="GRUPO" calculation="Sum">
			<variableExpression><![CDATA[$F{SALDO_ANTE}]]></variableExpression>
			<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
		</variable>
		<variable name="sSqlPasivos" class="java.lang.String"/>
		<variable name="totalActualPasivo" class="java.math.BigDecimal" calculation="Sum">
