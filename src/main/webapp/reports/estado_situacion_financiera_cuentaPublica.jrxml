	<variable name="totalAntActivo" class="java.math.BigDecimal"/>
	<variable name="totalActualHacienda" class="java.math.BigDecimal">
		<variableExpression><![CDATA[$F{TOTAL_ACT}]]></variableExpression>
	</variable>
	<variable name="totalAntAHacienda" class="java.math.BigDecimal">
		<variableExpression><![CDATA[$F{TOTAL_ANT}]]></variableExpression>
	</variable>
	<variable name="totalActual" class="java.math.BigDecimal"/>
