	<parameter name="ente" class="java.lang.String"/>
	<parameter name="sSqlActivos" class="java.lang.String"/>
	<parameter name="sSqlPasivos" class="java.lang.String"/>
	<parameter name="img1" class="java.lang.String"/>
	<parameter name="img2" class="java.lang.String"/>
	<parameter name="lastDay" class="java.lang.Integer"/>
	<parameter name="month" class="java.lang.String"/>
	<parameter name="year" class="java.lang.Integer"/>
	<parameter name="sSqlHacienda" class="java.lang.String"/>
	<parameter name="sSqlTotales" class="java.lang.String"/>
	<parameter name="monthAnt" class="java.lang.String"/>
	<parameter name="cuenta3211Act" class="java.math.BigDecimal"/>
	<parameter name="cuenta3211Ant" class="java.math.BigDecimal"/>
	<query language="SQL"><![CDATA[SELECT (SUM(T3.VAN4)-SUM(T3.VAN5)) TOTAL_ANT, (SUM(T3.VACT4)-SUM(T3.VACT5)) TOTAL_ACT FROM
 (SELECT  CASE WHEN T2.GRUPO='4' THEN SUM(T2.VMANT) ELSE 0.00 END VAN4, 
 CASE WHEN T2.GRUPO='5' THEN SUM(T2.VMANT) ELSE 0.00 END VAN5, CASE WHEN T2.GRUPO='4' 
 THEN SUM(T2.VMACT) ELSE 0.00 END VACT4, CASE WHEN T2.GRUPO='5' THEN SUM(T2.VMACT)ELSE 0.00 END VACT5 
 FROM(SELECT  T1.GRUPO,  T1.SALINI, CASE WHEN T1.GRUPO  ='4' THEN (T1.SALINI+ABONOS_ANT-CARGOS_ANT) 
 ELSE (T1.SALINI-ABONOS_ANT+CARGOS_ANT) END VMANT, CASE WHEN T1.GRUPO  ='4' 
 THEN (T1.SALINI+ABONOS_ACT-CARGOS_ACT) ELSE (T1.SALINI-ABONOS_ACT+CARGOS_ACT) END VMACT 
 FROM (SELECT SUBSTR(C.CUENTA,1,1) GRUPO,  C.CUENTA CUENTA , C.SALINI SALINI, 
SUM(CA.CARGOS_1+ CA.CARGOS_2+ CA.CARGOS_3+ CA.CARGOS_4+CA.CARGOS_5+ CA.CARGOS_6+ CA.CARGOS_7+ CA.CARGOS_8+CA.CARGOS_9+ CA.CARGOS_10+ CA.CARGOS_11+ CA.CARGOS_12) CARGOS_ANT, 
 SUM(CA.ABONOS_1+ CA.ABONOS_2+ CA.ABONOS_3+ CA.ABONOS_4+CA.ABONOS_5+ CA.ABONOS_6+ CA.ABONOS_7+ CA.ABONOS_8+CA.ABONOS_9+ CA.ABONOS_10+ CA.ABONOS_11+ CA.ABONOS_12) ABONOS_ANT,
  SUM(C.CARGOS_1+ C.CARGOS_2+ C.CARGOS_3+ C.CARGOS_4+C.CARGOS_5+ C.CARGOS_6+ C.CARGOS_7+ C.CARGOS_8+C.CARGOS_9+ C.CARGOS_10+ C.CARGOS_11+ C.CARGOS_12) CARGOS_ACT, 
 SUM(C.ABONOS_1+ C.ABONOS_2+ C.ABONOS_3+ C.ABONOS_4+C.ABONOS_5+ C.ABONOS_6+ C.ABONOS_7+ C.ABONOS_8+C.ABONOS_9+ C.ABONOS_10+ C.ABONOS_11+ C.ABONOS_12) ABONOS_ACT 
  FROM CUENTA C,CUENTA_ANTERIOR CA
 WHERE  C.CUENTA = CA.CUENTA AND  C.IDSECTOR=2 AND (	(	(SUBSTR(C.CUENTA,1,1) =4 AND 			 SUBSTR(C.CUENTA,4,1)<>'0') 	 	OR 			(SUBSTR(C.CUENTA,1,1) = 5 AND 			 SUBSTR(C.CUENTA,2,1) > 0) 		) AND
	C.SCTA ='') GROUP BY C.CUENTA, C.SALINI ORDER BY C.CUENTA)T1)T2 GROUP BY T2.GRUPO )T3]]></query>
	<field name="TOTAL_ANT" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="TOTAL_ANT"/>
		<property name="com.jaspersoft.studio.field.label" value="TOTAL_ANT"/>
	</field>
	<field name="TOTAL_ACT" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="TOTAL_ACT"/>
