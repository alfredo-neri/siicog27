	<dataset name="activos" uuid="c3c0ecb8-8de7-4129-9a3c-aa8b888b0c0a">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="LENOVO PRUEBAS"/>
		<parameter name="sSqlActivos" class="java.lang.String"/>
		<parameter name="month" class="java.lang.String"/>
		<parameter name="year" class="java.lang.Integer"/>
		<parameter name="monthAnt" class="java.lang.String"/>
		<query language="SQL"><![CDATA[SELECT
	DECODE(SUBSTR(T1.CUENTA, 1,	2),	'11',1,	2) GRUPO,
	T1.CUENTA,
	MA.NOMMAY NOMCTA,
	DECODE(T1.CUENTA, '1260', FN_GET_CUENTA_1263(11),
	T1.SALINI_ANT + T1.CARGOS_ANT - ABONOS_ANT) SALDO_ANTE,
	DECODE(T1.CUENTA, '1260', FN_GET_CUENTA_1263(12),
	T1.SALINI + CARGOS - T1.ABONOS) SALDOACTUAL
FROM
	(
SELECT
	CU.CUENTA,
	CU.SALINI,
	CA.SALINI SALINI_ANT,
	CA.CARGOS_1 + CA.CARGOS_2 + CA.CARGOS_3 + CA.CARGOS_4 + CA.CARGOS_5 + 
	CA.CARGOS_6 + CA.CARGOS_7 + CA.CARGOS_8 + CA.CARGOS_9 + CA.CARGOS_10 +
	CA.CARGOS_11 + CA.CARGOS_12 CARGOS_ANT,
	CA.ABONOS_1 + CA.ABONOS_2 + CA.ABONOS_3 + CA.ABONOS_4 + CA.ABONOS_5 + 
	CA.ABONOS_6 + CA.ABONOS_7 + CA.ABONOS_8 + CA.ABONOS_9 + CA.ABONOS_10 +
	CA.ABONOS_11 + CA.ABONOS_12 ABONOS_ANT,
	CU.CARGOS_1 + CU.CARGOS_2 + CU.CARGOS_3 + CU.CARGOS_4 + CU.CARGOS_5 + 
	CU.CARGOS_6 + CU.CARGOS_7 + CU.CARGOS_8 + CU.CARGOS_9 + CU.CARGOS_10 +
	CU.CARGOS_11 + CU.CARGOS_12 CARGOS,
	CU.ABONOS_1 + CU.ABONOS_2 + CU.ABONOS_3 + CU.ABONOS_4 + CU.ABONOS_5 + 
	CU.ABONOS_6 + CU.ABONOS_7 + CU.ABONOS_8 + CU.ABONOS_9 + CU.ABONOS_10 +
	CU.ABONOS_11 + CU.ABONOS_12 ABONOS
FROM
	CUENTA CU,
	CUENTA_ANTERIOR CA
WHERE
	CU.CUENTA = CA.CUENTA AND
	CU.SCTA = CA.SCTA AND
	SUBSTR(CU.CUENTA,4,	1) = '0' AND
	SUBSTR(CU.CUENTA,3,	1) <> '0' AND
	CU.SCTA = '' AND
	SUBSTR(CU.CUENTA,1,2) IN ('11','12') ) T1,
	MAYCTA MA
WHERE
	MA.CUENTA = T1.CUENTA
ORDER BY
	1,
	2]]></query>
		<field name="GRUPO" class="java.lang.Integer">
			<property name="com.jaspersoft.studio.field.name" value="GRUPO"/>
			<property name="com.jaspersoft.studio.field.label" value="GRUPO"/>
		</field>
