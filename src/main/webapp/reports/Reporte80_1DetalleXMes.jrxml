<jasperReport name="PartidaMesGlobal" language="java" columnCount="1" dpi="72" pageWidth="807" pageHeight="566" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="807" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="0747c808-a938-467a-8ce0-cfd5a0c9a796">
