	<variable name="subEjercido" class="java.math.BigDecimal">
		<expression><![CDATA[$F{MODIFICADO}.subtract($F{DEVENGADO})]]></expression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="total_Ampli_Reduc" resetType="Group" calculation="Sum" resetGroup="Etiquetado" class="java.math.BigDecimal">
		<expression><![CDATA[$F{CLVGAS}.substring(1,4).equals("000")  ? $F{AMPL_REDU} : BigDecimal.ZERO]]></expression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="total_Devengado" resetType="Group" calculation="Sum" resetGroup="Etiquetado" class="java.math.BigDecimal">
		<expression><![CDATA[$F{CLVGAS}.substring(1,4).equals("000")  ? $F{DEVENGADO} : BigDecimal.ZERO]]></expression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="total_Apro_AmplReduc" resetType="Group" calculation="Sum" resetGroup="Etiquetado" class="java.math.BigDecimal">
		<expression><![CDATA[$F{CLVGAS}.substring(1,4).equals("000")  ?$F{APROBADO}.add($F{AMPL_REDU}) : BigDecimal.ZERO]]></expression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="total_Pagado" resetType="Group" calculation="Sum" resetGroup="Etiquetado" class="java.math.BigDecimal">
