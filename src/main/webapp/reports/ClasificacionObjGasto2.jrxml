		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="total_Subejercicio" resetType="Group" calculation="Sum" resetGroup="Etiquetado" class="java.math.BigDecimal">
		<expression><![CDATA[$F{CLVGAS}.substring(1,4).equals("000")  ?$V{subEjercido} : BigDecimal.ZERO]]></expression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="totalAprovado" resetType="Group" calculation="Sum" resetGroup="Etiquetado" class="java.math.BigDecimal">
