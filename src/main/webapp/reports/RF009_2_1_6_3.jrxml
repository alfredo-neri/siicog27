	<parameter name="idSector" class="java.lang.String"/>
	<parameter name="dependencia" class="java.lang.String"/>
	<parameter name="municipio" class="java.lang.String">
		<defaultValueExpression><![CDATA["xona"]]></defaultValueExpression>
	</parameter>
	<parameter name="imagePath" class="java.lang.String"/>
	<parameter name="firmaP1" class="java.lang.String"/>
	<parameter name="firmaP2" class="java.lang.String"/>
	<parameter name="firmaP3" class="java.lang.String"/>
	<parameter name="firmaN1" class="java.lang.String"/>
	<parameter name="firmaN2" class="java.lang.String"/>
	<parameter name="firmaN3" class="java.lang.String"/>
	<query language="sql"><![CDATA[SELECT DISTINCT
	PA.CLAVE,
	PA.PROGRAMA,
	PA.PARTIDA,
	PA.AUTO1_1,
	PA.AUTO1_2,
	PA.AUTO1_3,
	PA.AUTO1_4,
	PA.AUTO1_5,
	PA.AUTO1_6,
	PA.AUTO1_7,
	PA.AUTO1_8,
	PA.AUTO1_9,
	PA.AUTO1_10,
	PA.AUTO1_11,
	PA.AUTO1_12,
	(PA.AUTO1_1 + PA.AUTO1_2 + PA.AUTO1_3 + PA.AUTO1_4 + PA.AUTO1_5 + PA.AUTO1_6 + PA.AUTO1_7 + PA.AUTO1_8 + PA.AUTO1_9 + PA.AUTO1_10 + PA.AUTO1_11 + PA.AUTO1_12) TOTAL,
	CA.CLAVE DEP,
	CA.NOMBRE
	FROM PASO AS PA,
		 CATDAA AS CA
WHERE SUBSTR(PA.CLAVE,4,3) = CA.CLAVE AND 
				PA.IDSECTOR=$P{idSector} AND 
				SUBSTR(PA.CLAVE,4,3) = $P{dependencia}
ORDER BY PA.CLAVE, PA.PROGRAMA, PA.PARTIDA ASC]]></query>
	<field name="CLAVE" class="java.lang.String"/>
	<field name="PROGRAMA" class="java.lang.String"/>
