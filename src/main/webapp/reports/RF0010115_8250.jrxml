<jasperReport name="RF0010115_8250" language="java" columnCount="1" dpi="72" pageWidth="612" pageHeight="792" whenNoDataType="AllSectionsNoDetail" columnWidth="572" leftMargin="20" rightMargin="20" topMargin="0" bottomMargin="0" uuid="d1315b86-add6-4687-aa93-ee123dd48925">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="GEM_ADAPTER"/>
	<property name="com.jaspersoft.studio.unit." value="pixel"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="idSector" class="java.lang.Integer"
		><description><![CDATA[]]></description>
	</parameter>
	<parameter name="mesInicial" class="java.lang.Integer"
		><description><![CDATA[]]></description>
	</parameter>
	<parameter name="mesFinal" class="java.lang.Integer"
		><description><![CDATA[]]></description>
	</parameter>
	<query language="sql"><![CDATA[SELECT
NA.NOMGAS,
NA.CLVGAS,
PO.CUENTA,
PO.SSSCTA,
(SUM(PO.CANPOL) - SUM(PO.CANPOLH)) SALDO
FROM
POLIDE AS PO
LEFT  JOIN
NATGAS AS NA
ON
PO.SSSCTA = NA.CLVGAS AND PO.IDSECTOR=NA.IDSECTOR
WHERE  
PO.IDSECTOR=$P{idSector} AND
SUBSTR(PO.CUENTA,1,3)  = '825' 
AND
PO.MESPOL BETWEEN $P{mesInicial} AND $P{mesFinal}
GROUP BY NOMGAS, CLVGAS, CUENTA, SSSCTA]]></query>
	<field name="NOMGAS" class="java.lang.String"/>
	<field name="SSSCTA" class="java.lang.String"/>
	<field name="SALDO" class="java.math.BigDecimal"/>
	<variable name="sumSaldo" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{SALDO}]]></expression>
	</variable>
