	<parameter name="firmaN5" class="java.lang.String"/>
	<query language="SQL"><![CDATA[SELECT	PMET.CLVDEP, PMET.CLVNEP, PMET.CLVFUEN,
		SUBSTR(PMET.CLVDEP,1,3) DG,
		SUBSTR(PMET.CLVDEP,4,3) DA,
		SUBSTR(PMET.CLVDEP,1,6)||PMET.CLVNEP||PMET.CLVFUEN GRUPO,
		SUBSTR(PMET.CLVNEP,1,10) CVEFUN,
		SUBSTR(PMET.CLVNEP,11,2) CVEPROY,
		PMET.CLVMET,
		PMET.NOM_IND,
		PMET.UNI_MED,
		PMET.CAN_METI,
		PMET.CAN_METIC_1 PTRIM1,
		PMET.CAN_METIC_2 PTRIM2,
		PMET.CAN_METIC_3 PTRIM3,
		PMET.CAN_METIC_4 PTRIM4,
		PMET.CANT_AVAN_1 TRIM1,
		PMET.CANT_AVAN_2 TRIM2,
		PMET.CANT_AVAN_3 TRIM3,
		PMET.CANT_AVAN_4 TRIM4,
		CDGM.NOMBRE NOMDG,
		CDAA.NOMBRE NOMDA,
		MUN4.CAMPO6 SPG,
		MUN5.CAMPO6 PROY,
		SUM(DECODE (PASO.AUTO1_1,NULL,0,PASO.AUTO1_1) + DECODE (PASO.AUTO1_2,NULL,0,PASO.AUTO1_2) + DECODE (PASO.AUTO1_3,NULL,0,PASO.AUTO1_3) ) AUTO_1,
		SUM(DECODE (PASO.AUTO1_4,NULL,0,PASO.AUTO1_4) + DECODE (PASO.AUTO1_5,NULL,0,PASO.AUTO1_5) + DECODE (PASO.AUTO1_6,NULL,0,PASO.AUTO1_6) ) AUTO_2,
		SUM(DECODE (PASO.AUTO1_7,NULL,0,PASO.AUTO1_7) + DECODE (PASO.AUTO1_8,NULL,0,PASO.AUTO1_8) + DECODE (PASO.AUTO1_9,NULL,0,PASO.AUTO1_9) ) AUTO_3,
		SUM(DECODE (PASO.AUTO1_10,NULL,0,PASO.AUTO1_10) + DECODE (PASO.AUTO1_11,NULL,0,PASO.AUTO1_11) + DECODE (PASO.AUTO1_12,NULL,0,PASO.AUTO1_12) ) AUTO_4
	FROM PP_METT PMET 
		INNER JOIN CATDGM CDGM ON SUBSTR(PMET.CLVDEP,1,3) = CDGM.CLAVE 
		INNER JOIN CATDAA CDAA ON SUBSTR(PMET.CLVDEP,4,3) = CDAA.CLAVE
		INNER JOIN MUNINEP MUN4 ON SUBSTR(PMET.CLVNEP,1,10) = MUN4.CAMPO7 AND PMET.IDSECTOR = MUN4.IDSECTOR
		INNER JOIN MUNINEP MUN5 ON SUBSTR(PMET.CLVNEP,1,12) = MUN5.CAMPO7 AND PMET.IDSECTOR = MUN5.IDSECTOR
		LEFT JOIN PASO ON PMET.CLVDEP = PASO.CLAVE AND PMET.CLVNEP = SUBSTR(PASO.PROGRAMA,1,12) AND PMET.IDSECTOR = PASO.IDSECTOR AND SUBSTR(PASO.PARTIDA,4,1) <> '0'
WHERE  PMET.IDSECTOR=$P{sector}
GROUP BY PMET.CLVDEP, PMET.CLVNEP, PMET.CLVFUEN,
		SUBSTR(PMET.CLVDEP,1,3) ,
		SUBSTR(PMET.CLVDEP,4,3) ,
		SUBSTR(PMET.CLVDEP,1,6)||PMET.CLVNEP||PMET.CLVFUEN ,
		SUBSTR(PMET.CLVNEP,1,10) ,
		SUBSTR(PMET.CLVNEP,11,2) ,
		PMET.CLVMET,
		PMET.NOM_IND,
		PMET.UNI_MED,
		PMET.CAN_METI,
		PMET.CAN_METIC_1 ,
		PMET.CAN_METIC_2 ,
		PMET.CAN_METIC_3 ,
		PMET.CAN_METIC_4 ,
		PMET.CANT_AVAN_1 ,
		PMET.CANT_AVAN_2 ,
		PMET.CANT_AVAN_3 ,
		PMET.CANT_AVAN_4 ,
		CDGM.NOMBRE ,
		CDAA.NOMBRE ,
		MUN4.CAMPO6 ,
		MUN5.CAMPO6 
ORDER BY PMET.CLVDEP, PMET.CLVNEP, PMET.CLVFUEN, PMET.CLVMET]]></query>
