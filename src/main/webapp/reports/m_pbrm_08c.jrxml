		<element kind="textField" uuid="01d988eb-aed9-409f-98d5-bc538b323881" x="843" y="50" width="92" height="20" stretchType="NoStretch" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle">
			<property name="com.jaspersoft.studio.unit.width" value="pixel"/>
			<property name="com.jaspersoft.studio.unit.y" value="pixel"/>
			<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
			<printWhenExpression><![CDATA[$P{noFirmas} >= 3]]></printWhenExpression>
			<box>
				<topPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
				<leftPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
				<bottomPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
				<rightPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
			</box>
			<paragraph leftIndent="2"/>
			<expression><![CDATA[$P{noFirmas}==3 ? $P{firmaN3}  : $P{noFirmas}==4 ? $P{firmaN4}  : $P{firmaN5}]]></expression>
		</element>
		<element kind="textField" uuid="7f775904-6a74-40d0-a5dd-85ae2a049cd1" x="621" y="14" width="130" height="36" stretchType="NoStretch" blankWhenNull="true" hTextAlign="Left" vTextAlign="Top">
			<property name="com.jaspersoft.studio.unit.y" value="pixel"/>
			<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
			<property name="com.jaspersoft.studio.unit.width" value="px"/>
			<printWhenExpression><![CDATA[$P{noFirmas}==2 ||  $P{noFirmas} == 4 || $P{noFirmas} == 5]]></printWhenExpression>
			<box>
				<topPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
				<leftPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
				<bottomPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
				<rightPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
			</box>
			<paragraph leftIndent="2"/>
		</element>
		<element kind="textField" uuid="a8eaf42a-a9f6-43c9-97f5-db72bab64212" x="210" y="50" width="99" height="20" stretchType="NoStretch" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle">
			<property name="com.jaspersoft.studio.unit.width" value="pixel"/>
			<property name="com.jaspersoft.studio.unit.y" value="pixel"/>
			<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
			<printWhenExpression><![CDATA[$P{noFirmas}==2 ||  $P{noFirmas} == 4 || $P{noFirmas} == 5]]></printWhenExpression>
			<box>
				<topPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
				<leftPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
				<bottomPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
				<rightPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
			</box>
			<paragraph leftIndent="2"/>
			<expression><![CDATA[$P{noFirmas} == 2 ? $P{firmaN1} :$P{firmaN2}]]></expression>
		</element>
		<element kind="staticText" uuid="ca3a6c2b-1a99-494f-a658-2758e7f926af" x="935" y="50" width="33" height="20" positionType="Float" stretchType="ContainerHeight" fontSize="8.0" hTextAlign="Center" vTextAlign="Middle">
