	<variable name="programadaTrimestral" class="java.math.BigDecimal">
		<expression><![CDATA[($P{trimestre} == 1 ) ? $F{PTRIM1} : 
	($P{trimestre} == 2 ) ? $F{PTRIM2} :
		($P{trimestre} == 3 ) ? $F{PTRIM3} :
			($P{trimestre} == 4 ) ? $F{TRIM4} : BigDecimal.ZERO]]></expression>
	</variable>
	<variable name="porcentajeProgramadaTrimestral" class="java.lang.Double">
		<expression><![CDATA[($F{CAN_METI}.doubleValue() == 0.00 ) ? 0.00 : (($V{programadaTrimestral}.doubleValue() * 100) / $F{CAN_METI}.doubleValue())]]></expression>
	</variable>
	<variable name="alcanzadaTrimestral" class="java.math.BigDecimal">
		<expression><![CDATA[($P{trimestre} == 1 ) ?$F{TRIM1} : 
	($P{trimestre} == 2 ) ? $F{TRIM2} :
		($P{trimestre} == 3 ) ? $F{TRIM3} :
			($P{trimestre} == 4 ) ? $F{TRIM4} : BigDecimal.ZERO]]></expression>
	</variable>
	<variable name="porcentajeAlcanzadaTrimestral" class="java.lang.Double">
		<expression><![CDATA[($F{CAN_METI}.doubleValue() == 0.00 ) ? 0.00 : (($V{alcanzadaTrimestral}.doubleValue() * 100) / $F{CAN_METI}.doubleValue())]]></expression>
	</variable>
	<variable name="variacionTrimestral" class="java.math.BigDecimal">
		<expression><![CDATA[$V{alcanzadaTrimestral}.subtract($V{programadaTrimestral})]]></expression>
	</variable>
	<variable name="porcentajeVariacionTrimestral" class="java.lang.Double">
		<expression><![CDATA[($F{CAN_METI}.doubleValue() == 0.00 ) ? 0.00 : (($V{variacionTrimestral}.doubleValue() * 100) / $F{CAN_METI}.doubleValue())]]></expression>
	</variable>
	<variable name="programadaAcumulada" class="java.math.BigDecimal">
		<expression><![CDATA[($P{trimestre} == 1 ) ? $F{PTRIM1} : 
	($P{trimestre} == 2 ) ? $F{PTRIM1}.add($F{PTRIM2}) :
		($P{trimestre} == 3 ) ? $F{PTRIM1}.add($F{PTRIM2}).add($F{PTRIM3}) :
			($P{trimestre} == 4 ) ? $F{PTRIM1}.add($F{PTRIM2}).add($F{PTRIM3}).add($F{TRIM4}) : BigDecimal.ZERO]]></expression>
	</variable>
	<variable name="porcentajeProgramadaAcumulada" class="java.lang.Double">
		<expression><![CDATA[($F{CAN_METI}.doubleValue() == 0.00 ) ? 0.00 : (($V{programadaAcumulada}.doubleValue() * 100) / $F{CAN_METI}.doubleValue())]]></expression>
	</variable>
	<variable name="alcanzadaAcumulado" class="java.math.BigDecimal">
		<expression><![CDATA[($P{trimestre} == 1 ) ? $F{TRIM1} : 
	($P{trimestre} == 2 ) ? $F{TRIM1}.add( $F{TRIM2}) :
		($P{trimestre} == 3 ) ? $F{TRIM1}.add( $F{TRIM2}).add($F{TRIM3}) :
			($P{trimestre} == 4 ) ? $F{TRIM1}.add( $F{TRIM2}).add($F{TRIM3}).add($F{TRIM4}) : BigDecimal.ZERO]]></expression>
	</variable>
	<variable name="porcentajeAlcanzadaAcumulado" class="java.lang.Double">
		<expression><![CDATA[($F{CAN_METI}.doubleValue() == 0.00 ) ? 0.00 : (($V{alcanzadaAcumulado}.doubleValue() * 100) / $F{CAN_METI}.doubleValue())]]></expression>
	</variable>
	<variable name="variacionAcumulado" class="java.math.BigDecimal">
		<expression><![CDATA[$V{alcanzadaAcumulado}.subtract($V{programadaAcumulada})]]></expression>
	</variable>
	<variable name="porcentajeVariacionAcumulado" class="java.lang.Double">
		<expression><![CDATA[($F{CAN_METI}.doubleValue() == 0.00 ) ? 0.00 : (($V{variacionAcumulado}.doubleValue() * 100) / $F{CAN_METI}.doubleValue())]]></expression>
	</variable>
