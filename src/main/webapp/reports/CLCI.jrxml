	<detail>
		<band height="105">
			<element kind="staticText" uuid="7b213e91-5865-4316-aeb5-7c69d4771906" x="280" y="0" width="472" height="30" stretchType="NoStretch" fontName="Arial" vTextAlign="Middle">
				<box>
