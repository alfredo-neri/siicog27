					<rightPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<text><![CDATA[Remitir fotocopia legible del mismo]]></text>
			</element>
			<element kind="staticText" uuid="07bff066-5c5b-4068-ad76-80b4ce6d2136" x="280" y="30" width="472" height="30" stretchType="NoStretch" fontName="Arial" fontSize="10.0" vTextAlign="Middle">
				<box>
					<topPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<text><![CDATA[Adjuntar a éste formato la documentación que avala la experiencia para ocupar el puesto. (Por ejemplo: Nombramiento en Administraciones Municipales anteriores).]]></text>
			</element>
			<element kind="staticText" uuid="db674432-21c6-425b-9bc2-6d4e021effd7" x="280" y="60" width="472" height="30" stretchType="NoStretch" fontName="Arial" vTextAlign="Middle">
				<box>
					<topPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<text><![CDATA[Remitir fotocopia legible de la misma. Cabe señalar que, conformidad con el articulo 7 del Reglamento de la COCERTEM, la vigencia de la certificación en competencia laboral es de 3 años.]]></text>
			</element>
			<element kind="staticText" uuid="50cf5a65-1482-4548-8da5-7da940a15150" x="0" y="0" width="180" height="30" stretchType="NoStretch" fontName="Arial" fontSize="9.0" vTextAlign="Middle">
