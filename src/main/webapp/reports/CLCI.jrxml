				<box>
					<topPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<text><![CDATA[Titulo Profesional en áreas júridicas, ecónomicas o caontable-administrativas.]]></text>
			</element>
			<element kind="staticText" uuid="e1162ce4-18f9-4a1f-972f-8d761081094b" x="0" y="30" width="180" height="30" stretchType="NoStretch" fontName="Arial" vTextAlign="Middle">
