	<parameter name="sector" class="java.lang.Integer"/>
	<queryString language="SQL">
		<![CDATA[SELECT 	C.CLVDEP, C.CLVNEP, M.CAMPO6, C.DESC_PROY,
		C.CAMPO0, C.CAMPO1, C.CAMPO2, M.CAMPO7,
		C.DIMENSIONC, C.OBJ_PROY, C.CAMPO3, 
		C.CAMPO4, C.EST_PROY, C.CAMPO5
	FROM PP_CAPTURA C
		INNER JOIN MUNINEP M ON M.CAMPO7 = C.CLVNEP AND M.IDSECTOR = C.SECTORID
WHERE C.SECTORID = $P{sector}]]>
	</queryString>
