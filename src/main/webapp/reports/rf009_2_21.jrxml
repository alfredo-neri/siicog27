				</box>
				<paragraph leftIndent="2" rightIndent="2"/>
				<expression><![CDATA[(12 <=$P{mes} )?((($V{T_DICIEMBRE_I}==null ? BigDecimal.ZERO : $V{T_DICIEMBRE_I}).subtract($V{T_DICIEMBRE_E}==null ? BigDecimal.ZERO : $V{T_DICIEMBRE_E}) == BigDecimal.ZERO ) ? BigDecimal.ZERO : ($V{T_DICIEMBRE_I}.subtract($V{T_DICIEMBRE_E}))):(BigDecimal.ZERO)]]></expression>
			</element>
		</band>
