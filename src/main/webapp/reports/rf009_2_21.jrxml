	<dataset name="DETALLE_INGRESOS" uuid="88feb118-190a-48b7-8c1f-646ab348ec98">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="db2"/>
		<parameter name="mes" class="java.lang.Integer">
			<defaultValueExpression><![CDATA[3]]></defaultValueExpression>
		</parameter>
		<parameter name="idSector" class="java.lang.Integer">
			<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
		</parameter>
		<query language="sql"><![CDATA[SELECT CLVFLU, NOMFLU, DECIMAL(SUM(ENERO),15,2) ENERO, DECIMAL(SUM(FEBRERO),15,2) FEBRERO,DECIMAL(SUM(MARZO),15,2) MARZO,DECIMAL(SUM(ABRIL),15,2) ABRIL,
 DECIMAL(SUM(MAYO),15,2) MAYO,DECIMAL(SUM(JUNIO),15,2) JUNIO,DECIMAL(SUM(JULIO),15,2) JULIO,DECIMAL(SUM(JULIO),15,2) JULIO, DECIMAL(SUM(AGOSTO),15,2) AGOSTO,DECIMAL(SUM(SEPTIEMBRE),15,2) SEPTIEMBRE,
 DECIMAL(SUM(OCTUBRE),15,2) OCTUBRE,DECIMAL(SUM(NOVIEMBRE),15,2) NOVIEMBRE,DECIMAL(SUM(DICIEMBRE),15,2) DICIEMBRE
 FROM (
 SELECT POLIFL.CLVFLU , CATFLU.NOMFLU, 
 CASE WHEN POLIFL.MESPOL=1 THEN  POLIFL.CANFLU ELSE 0 END ENERO,
 CASE WHEN POLIFL.MESPOL=2 THEN  POLIFL.CANFLU ELSE 0 END FEBRERO,
 CASE WHEN POLIFL.MESPOL=3 THEN  POLIFL.CANFLU ELSE 0 END MARZO,
 CASE WHEN POLIFL.MESPOL=4 THEN  POLIFL.CANFLU ELSE 0 END ABRIL, 
 CASE WHEN POLIFL.MESPOL=5 THEN  POLIFL.CANFLU ELSE 0 END MAYO,
 CASE WHEN POLIFL.MESPOL=6 THEN  POLIFL.CANFLU ELSE 0 END JUNIO,
 CASE WHEN POLIFL.MESPOL=7 THEN  POLIFL.CANFLU ELSE 0 END JULIO,
 CASE WHEN POLIFL.MESPOL=8 THEN  POLIFL.CANFLU ELSE 0 END AGOSTO,
 CASE WHEN POLIFL.MESPOL=9 THEN  POLIFL.CANFLU ELSE 0 END SEPTIEMBRE,
 CASE WHEN POLIFL.MESPOL=10 THEN POLIFL.CANFLU ELSE 0 END OCTUBRE,
 CASE WHEN POLIFL.MESPOL=11 THEN POLIFL.CANFLU ELSE 0 END NOVIEMBRE,
 CASE WHEN POLIFL.MESPOL=12 THEN POLIFL.CANFLU ELSE 0 END DICIEMBRE
 --,POLIFL.MESPOL 
 FROM   POLIFL POLIFL INNER JOIN CATFLU CATFLU ON POLIFL.CLVFLU=CATFLU.CLVFLU AND POLIFL.IDSECTOR=CATFLU.IDSECTOR
 WHERE CATFLU.IDSECTOR= $P{idSector}  AND POLIFL.CLVFLU<20 AND POLIFL.MESPOL BETWEEN 1 AND $P{mes} )
 GROUP BY CLVFLU,NOMFLU]]></query>
