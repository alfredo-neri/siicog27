<jasperReport name="ServiciosPersonalesAlMes" language="java" columnCount="1" dpi="72" pageWidth="595" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="4ca13698-03c7-447c-bcf6-1447bbca18e9" ignorePagination="true">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="alfredo"/>
	<parameter name="pMes" class="java.lang.Integer"/>
	<parameter name="pMesName" class="java.lang.String"/>
	<parameter name="pYear" class="java.lang.Integer"/>
	<parameter name="pSector" class="java.lang.Integer"/>
	<query language="SQL"><![CDATA[SELECT	SUBSTR(SCTA,1,3) GRUPO, 
		SCTA, 
		SUM((CANPOL) - (CANPOLH)) DIFERENCIA
FROM POLIDE
WHERE	ANOPOL = $P{pYear}
	AND IDSECTOR = $P{pSector}
	AND MESPOL <= $P{pMes} 
	AND (SUBSTR(CUENTA,1,3) = '827' OR
		 SUBSTR(CUENTA,1,3) = '825' OR
		 SUBSTR(CUENTA,1,3) = '824'
		 )
	AND SUBSTR(SSSCTA,1,1) = '1'
GROUP BY SCTA
ORDER BY SCTA]]></query>
	<field name="GRUPO" class="java.lang.String"/>
	<field name="SCTA" class="java.lang.String"/>
	<field name="DIFERENCIA" class="java.math.BigDecimal"/>
	<variable name="vTotal" resetType="Group" calculation="Sum" resetGroup="Group" class="java.math.BigDecimal">
		<expression><![CDATA[$F{DIFERENCIA}]]></expression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<group name="Group">
		<expression><![CDATA[$F{GRUPO}]]></expression>
		<groupFooter>
			<band height="36">
				<element kind="staticText" uuid="6e9251fe-a814-4459-b27a-6fee4a6cc7c6" x="0" y="12" width="70" height="12" stretchType="NoStretch" fontName="Monospaced" fontSize="9.0">
					<property name="com.jaspersoft.studio.unit.y" value="pixel"/>
					<text><![CDATA[TOTAL]]></text>
				</element>
				<element kind="textField" uuid="d0c4bc07-a6f7-4e54-acb3-087808a4f4f8" x="70" y="12" width="110" height="12" stretchType="NoStretch" fontName="Monospaced" fontSize="9.0" pattern="#,##0.00#" hTextAlign="Right">
					<property name="com.jaspersoft.studio.unit.x" value="pixel"/>
					<expression><![CDATA[$V{vTotal}]]></expression>
				</element>
				<element kind="staticText" uuid="8019435f-f00d-4057-9149-29845de14ee3" x="70" y="0" width="110" height="12" stretchType="NoStretch" fontName="Monospaced" fontSize="9.0" hTextAlign="Center"
					><text><![CDATA[------------------------------]]></text>
				</element>
				<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
			</band>
		</groupFooter>
	</group>
	<title height="24" splitType="Stretch">
		<element kind="textField" uuid="3b2ef1dc-56fc-4a6e-bb55-980c5dde7c80" x="0" y="0" width="555" height="12" stretchType="NoStretch" fontName="Monospaced" fontSize="9.0">
			<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
			<expression><![CDATA["SERVICIOS PERSONALES AL MES DE " +$P{pMesName}]]></expression>
		</element>
		<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
	</title>
	<detail>
		<band height="12" splitType="Stretch">
			<element kind="textField" uuid="079a3a3e-9629-4e83-a425-2bb3f10955df" x="70" y="0" width="110" height="12" stretchType="NoStretch" fontName="Monospaced" fontSize="9.0" pattern="#,##0.00#" hTextAlign="Right">
				<property name="com.jaspersoft.studio.unit.x" value="pixel"/>
				<expression><![CDATA[$F{DIFERENCIA}]]></expression>
			</element>
			<element kind="textField" uuid="0622747d-4ec8-49a2-ae94-caee26bfad5d" x="0" y="0" width="70" height="12" stretchType="NoStretch" fontName="Monospaced" fontSize="9.0">
				<expression><![CDATA[$F{SCTA}]]></expression>
			</element>
			<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
		</band>
	</detail>
</jasperReport>
