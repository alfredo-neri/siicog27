		<expression><![CDATA[DAYSINMONTH( (new SimpleDateFormat("dd-MM-yyyy")).parse(String.valueOf("01-"+$P{pMes}+"-"+$P{pAnio})))]]></expression>
	</variable>
	<variable name="mes_extenso" resetType="None" class="java.lang.String">
		<expression><![CDATA[UPPER(new java.text.SimpleDateFormat("MMMMM", new Locale("es", "ES")).format(new SimpleDateFormat("yyyy/MM/dd").parse("1970/" + $P{pMes}.toString() + "/01")) )]]></expression>
	</variable>
	<variable name="total_saldo_final" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[($F{CONCEP}.equals("*-*-*-*"))? $F{SALINI} : $F{STACTA}.equals("D") ? $F{CANPOL}.subtract( $F{CANPOLH}) : $F{CANPOLH}.subtract( $F{CANPOL})]]></expression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
