	<queryString>
		<![CDATA[SELECT B.MES,
       B.CONSEC,
       B.CUENTA,
       SUBSTR(B.SCTA,8,3) SCTA,
       B.NOMCTA,
       B.INVENTARIO,
       B.RESGUARDATARIO,
       B.NOMMUEBLE,
       B.MARCA,
       B.MODELO,
       B.SERIE,
       B.FACTURA,
       B.FECFACTURA,
       B.PROVEEDOR,
       B.COSTO,
       B.TIPPOL,
       B.CONPOL,
       B.FECPOL,
       B.FECALTA,
       B.AREA,
       B.TVIDAUTIL,
       B.PORCENTAJE,
      ( B.DEPREPERIODO * 12)  DEPREPERIODO,
       B.DEPREACUM,
       B.OBS
       FROM BIENESM B
WHERE B.IDSECTOR=$P{sector}
AND B.MES <= 12
ORDER BY B.MES, B.CONSEC ASC]]>
	</queryString>
