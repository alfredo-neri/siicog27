	<parameter name="sector" class="java.lang.Integer"/>
	<query language="SQL"><![CDATA[SELECT 	SUBSTR(P.PROGRAMA,1,2) FUN,
		SUBSTR(P.PROGRAMA,3,2) SFUN,
		SUBSTR(P.PROGRAMA,5,2) PG,
		SUBSTR(P.PROGRAMA,7,2) SPG,
		SUBSTR(P.PROGRAMA,9,2) PY,
		SUBSTR(P.PROGRAMA,11,2)SPY,
		P.PROGRAMA||F.CLVFTE GROUP,
		F.CLVFTE,
		P.PARTIDA,
		N.NOMGAS,
		P.AUTO1_1,
		P.AUTO1_2,
		P.AUTO1_3,
		P.AUTO1_4,
		P.AUTO1_5,
		P.AUTO1_6,
		P.AUTO1_7,
		P.AUTO1_8,
		P.AUTO1_9,
		P.AUTO1_10,
		P.AUTO1_11,
		P.AUTO1_12
	FROM PASO P
		JOIN NATGAS N ON N.CLVGAS = P.PARTIDA AND N.IDSECTOR = P.IDSECTOR
		JOIN FUENTEF F ON  F.LIGA = SUBSTR(P.PROGRAMA,13,3) AND F.IDSECTOR = P.IDSECTOR
WHERE 	P.IDSECTOR=$P{sector}
	AND SUBSTR(P.PARTIDA,1,1) IN ('2','3','5')
ORDER BY P.PROGRAMA, P.CLAVE, P.PARTIDA ASC]]></query>
