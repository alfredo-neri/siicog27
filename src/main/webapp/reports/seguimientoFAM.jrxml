	</field>
	<variable name="totalContratos" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{IMPORTE_ADQUISICION}]]></variableExpression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="disponible" class="java.math.BigDecimal">
		<variableExpression><![CDATA[$F{AUTORIZADO_INICIAL}.subtract($V{totalContratos})]]></variableExpression>
	</variable>
	<variable name="saldoPorEjercer" class="java.math.BigDecimal">
		<variableExpression><![CDATA[$F{IMPORTE_ADQUISICION}.subtract($V{returnTotalFacturado})]]></variableExpression>
	</variable>
