		<parameter name="idContrato" class="java.lang.Long"/>
		<query language="SQL"><![CDATA[SELECT 	CF.NO_FACTURA, CF.FECHA_RECEPCION, CF.IMPORTE_FACTURA,
		P.TIPPOL, P.CONPOL, P.FECPOL, P.CDEBE, P.CHABER, SP.DESCRIPCION,
		CF.FECHA_PAGO, CF.IMPORTE_FACTURA AS IMPORTEFAC
	FROM TW_CONTRATO_FACTURA CF
		INNER JOIN POLIEN P ON CF.ID_POLIZA = P.ID
		INNER JOIN TC_STATUS_PAGO SP ON CF.ID_STATUS_PAGO = SP.ID
WHERE CF.ID_ACCION_CONTRATO =$P{idContrato}]]></query>
