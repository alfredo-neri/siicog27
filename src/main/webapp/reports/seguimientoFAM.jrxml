	<query language="SQL"><![CDATA[/*SELECT 	A.CLAVE, A.NOMBRE, A.DESCRIPCION,  PA.PRESUPUESTO_AUTORIZADO,
		C.NUMERO_CONTRATO, P.NOMBRE_PROVEEDOR, C.FECCHA_CREACION, C.IMPORTE_ADQUISICION,
		AC.ID
	FROM TC_ACCIONES A
		INNER JOIN TR_AREA_ACCION AA ON AA.ID_ACCION = A.ID 
		INNER JOIN TW_ACCION_CONTRATO AC ON AC.ID_AREA_ACCION = AA.ID 
		INNER JOIN TC_CONTRATOS C ON AC.ID_CONTRATO = C.ID
		INNER JOIN TC_PROVEEDORES_NUEVO P ON C.ID_PROVEEDOR = P.ID
		INNER JOIN TR_PRESUPUESTO_AREA PA ON AA.ID_PRESUPUESTO_AREA = PA.ID
WHERE PA.ID_AREA = 2
ORDER BY A.CLAVE*/
SELECT 	A.CLAVE, A.NOMBRE, A.DESCRIPCION, AA.AUTORIZADO_INICIAL,
		C.NUMERO_CONTRATO, P.NOMBRE_PROVEEDOR, C.FECCHA_CREACION, C.IMPORTE_ADQUISICION, AC.ID AS ID
		
	FROM TC_ACCIONES A
		INNER JOIN TR_AREA_ACCION AA ON AA.ID_ACCION = A.ID 
		INNER JOIN TW_ACCION_CONTRATO AC ON AC.ID_AREA_ACCION = AA.ID 
		INNER JOIN TC_CONTRATOS C ON AC.ID_CONTRATO = C.ID
		INNER JOIN TC_PROVEEDORES_NUEVO P ON C.ID_PROVEEDOR = P.ID]]></query>
	<field name="CLAVE" class="java.lang.String">
