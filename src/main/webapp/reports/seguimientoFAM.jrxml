		<property name="com.jaspersoft.studio.field.label" value="ID"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="TW_ACCION_CONTRATO"/>
	</field>
	<variable name="totalContratos" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{IMPORTE_ADQUISICION}]]></expression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="disponible" class="java.math.BigDecimal">
		<expression><![CDATA[$F{AUTORIZADO_INICIAL}.subtract($V{totalContratos})]]></expression>
	</variable>
	<variable name="saldoPorEjercer" class="java.math.BigDecimal">
		<expression><![CDATA[$F{IMPORTE_ADQUISICION}.subtract($V{returnTotalFacturado})]]></expression>
	</variable>
