	<query language="sql"><![CDATA[SELECT PM.ANUAL,
       PM.NPU,
       PM.TPU,
       PM.OBSNPU,
       PM.OBSTPU
     FROM PM2411 PM
    WHERE PM.IDSECTOR = $P{pIdSector}
          AND PM.ANUAL=$P{pAnio}]]></query>
