<jasperReport name="reporte114txt" language="java" columnCount="1" dpi="72" pageWidth="841" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="841" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="545c03b2-b019-4127-8016-4abb62b4e94a">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Proyecto DB2"/>
	<property name="com.jaspersoft.studio.unit." value="pixel"/>
	<property name="net.sf.jasperreports.export.text.character.width" value="4"/>
