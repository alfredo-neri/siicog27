	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="TRIMESTRE" class="java.lang.Integer"/>
	<parameter name="SECTOR" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[2]]></defaultValueExpression>
	</parameter>
	<parameter name="ANO" class="java.lang.Integer"/>
	<parameter name="CLAVE" class="java.lang.String"/>
	<query language="sql"><![CDATA[SELECT I.PERIODO, I.CVEIND, I.CLVFUN, P.CM, P.ACUCM, P.OBSCM, P.ME, P.ACUME, P.OBSME, P.DIAS, P.ACUDIAS, P.OBSDIAS 
	FROM PM1711 P
	JOIN INDICADORES I ON I.IDSECTOR =P.IDSECTOR
	WHERE P.TRIMESTRE = $P{TRIMESTRE}
	AND P.IDSECTOR = $P{SECTOR}
	AND I.CVEIND=32]]></query>
	<field name="PERIODO" class="java.lang.String"/>
	<field name="CVEIND" class="java.lang.Integer"/>
	<field name="CLVFUN" class="java.lang.String"/>
	<field name="CM" class="java.lang.Integer"/>
	<field name="ACUCM" class="java.lang.Integer"/>
	<field name="OBSCM" class="java.lang.String"/>
	<field name="ME" class="java.lang.Integer"/>
	<field name="ACUME" class="java.lang.Integer"/>
	<field name="OBSME" class="java.lang.String"/>
	<field name="DIAS" class="java.lang.Integer"/>
	<field name="ACUDIAS" class="java.lang.Integer"/>
	<field name="OBSDIAS" class="java.lang.String"/>
	<variable name="REPORTE_TXT" resetType="None" class="java.lang.String">
		<expression><![CDATA[(($P{CLAVE}!= null)?"\""+$P{CLAVE}.substring(0,1)+"\"":"\"\"")
+"|"+(($P{CLAVE}!= null)?"\""+$P{CLAVE}.substring(1,4)+"\"":"\"\"")
+"|"+(($P{ANO}!= null)?$P{ANO}:"")
+"|" +(($F{PERIODO}!= null)?$F{PERIODO}:"") 
+"|" +(($P{TRIMESTRE}!= null)?$P{TRIMESTRE}:"") +"|"+
(($P{TRIMESTRE} == 1) ? "31/03/"+$P{ANO}.toString().substring(2) : (
	($P{TRIMESTRE} == 2) ? "30/06/"+$P{ANO}.toString().substring(2)	: (
		($P{TRIMESTRE} == 3) ? "30/09/"+$P{ANO}.toString().substring(2)	: (
			($P{TRIMESTRE} == 4) ? "31/12/"+$P{ANO}.toString().substring(2)	:""

		)
	)
))
+"|\""+(($F{CVEIND}!= null)?$F{CVEIND}: "")+"\"|\""
+(($F{CLVFUN}!= null)?$F{CLVFUN}:"")
+"\"|"+(($F{CM}!= null)?$F{CM}:"")
+"|"+(($F{ACUCM}!= null)?$F{ACUCM}:"")
+"|"+(($F{ME}!= null)?$F{ME}:"")
+"|"+(($F{ACUME}!= null)?$F{ACUME}:"")
+"|"+(($F{DIAS}!= null)?$F{DIAS}:"")
+"|"+(($F{ACUDIAS}!= null)?$F{ACUDIAS}:"")
+"|\""+(($F{OBSCM}!= null)?$F{OBSCM}:"")
+"\"|\""+(($F{OBSME}!= null)?$F{OBSME}:"")
+"\"|\""+(($F{OBSDIAS}!= null)?$F{OBSDIAS}:"")+"\""]]></expression>
