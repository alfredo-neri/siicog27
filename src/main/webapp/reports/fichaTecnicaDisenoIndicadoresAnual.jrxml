	<query language="SQL"><![CDATA[SELECT 	T.CVETEMAS, G.CLAVE DEP_GEN, A.CLAVE DEP_AUX, P.CAMPO7, P.CAMPO8, N.NOMBRE, N.TIPO, 
		N.FORMULA, F.INTERPRETACION, F.DIMENSION, F.FACTOR, F.DESCRIPCION_FACTOR, 
		F.LINEA_BASE, N.FRECUENCIA, TMP.NOMVAR, TMP.UNIDAD_MEDIDA, TMP.OPERACION, 
		TMP.PROGRAMADA_1, TMP.PROGRAMADA_2, TMP.PROGRAMADA_3, TMP.PROGRAMADA_4, 
		TMP.META_ANUAL, N.MEDIOS_VERIFICACION
	FROM TC_FICHA F
		INNER JOIN TR_MATRIZ_NIVEL MN ON F.ID_MATRIZ_NIVEL = MN.ID
		INNER JOIN TC_NIVEL N ON MN.ID_NIVEL = N.ID
		INNER JOIN TC_MATRIZ M ON MN.ID_MATRIZ = M.ID
		INNER JOIN MUNINEP P ON M.ID_PROYECTO = P.ID
		INNER JOIN CATDAA A ON M.ID_DEP_AUX = A.ID
		INNER JOIN CATDGM G ON M.ID_DEPENDENCIA = G.ID
		INNER JOIN CPD T ON M.ID_TEMA = T.ID
		INNER JOIN (SELECT  FV.ID_FICHA, FV.ID ID_FICHA_VARIABLE, 
							NVL(FV.UNIDAD_MEDIDA,'') UNIDAD_MEDIDA, 
							NVL(FV.OPERACION,'') OPERACION,VA.NOMVAR, FV.META_ANUAL,
							SUM(DECODE(PE.PERIODO,1,VT.PROGRAMADA, 0)) PROGRAMADA_1,
							SUM(DECODE(PE.PERIODO,2,VT.PROGRAMADA, 0)) PROGRAMADA_2, 
							SUM(DECODE(PE.PERIODO,3,VT.PROGRAMADA, 0)) PROGRAMADA_3,
							SUM(DECODE(PE.PERIODO,4,VT.PROGRAMADA, 0)) PROGRAMADA_4
					
						FROM TC_FICHA_VARIABLES FV
							INNER JOIN TC_VARIABLES_TRIMESTRES VT ON FV.ID = VT.ID_FICHA_VARIABLE
							INNER JOIN TC_PERIODO PE ON VT.ID_PERIODO = PE.ID
							INNER JOIN VARIABLES VA ON FV.ID_VARIABLE = VA.ID
					GROUP BY FV.ID_FICHA, FV.ID, FV.UNIDAD_MEDIDA, FV.OPERACION, VA.NOMVAR, FV.META_ANUAL
					) TMP ON F.ID = TMP.ID_FICHA]]></query>
