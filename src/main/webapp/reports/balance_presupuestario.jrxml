					<expression><![CDATA[$F{SECCION}<=3?"II. Balance Presupuestario  sin Financiamiento  Neto (II=I - A3)":
$F{SECCION}==9?"VI. Balance Presupuestario de Recursos Disponibles  sin Financiamiento Neto (VI=V - A3.1)":
$F{SECCION}==11?"VIII. Balance Presupuestario de Recursos Etiquetados sin Financiamiento Neto(VIII=VII -A3.2":""]]></expression>
