				<element kind="textField" uuid="98d63c26-6333-44ee-92f9-7a293e8e9c06" x="452" y="15" width="100" height="15" stretchType="NoStretch" fontSize="8.0" evaluationTime="Group" pattern="#,##0.00" evaluationGroup="GRUP" hTextAlign="Right">
