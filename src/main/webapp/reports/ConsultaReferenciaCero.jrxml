						<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					</box>
					<expression><![CDATA[$V{V_SUMA_MES}]]></expression>
				</element>
				<element kind="textField" uuid="42cb688a-6ae6-4cca-8f3b-d9de3d89fa86" x="223" y="48" width="91" height="14" backcolor="#F2F2F2" mode="Transparent" positionType="Float" stretchType="NoStretch" fontName="Consolas" fontSize="7.0" pattern="#,##0.00" bold="true" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle">
