<jasperReport name="REPORT" language="java" columnCount="1" dpi="72" pageWidth="568" pageHeight="612" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="540" leftMargin="14" rightMargin="14" topMargin="14" bottomMargin="14" uuid="94a9e52e-7229-46b2-9151-d67a6d4593c1" floatColumnFooter="true">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="GEM_LOCAL_DB2"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.unit." value="cm"/>
	<property name="net.sf.jasperreports.print.create.bookmarks" value="true"/>
	<import>java.text.SimpleDateFormat</import>
	<parameter name="P_SECTOR" class="java.lang.Integer"
		><description><![CDATA[]]></description>
		<defaultValueExpression><![CDATA[2]]></defaultValueExpression>
	</parameter>
	<parameter name="P_DIRECCION" class="java.lang.String">
		<defaultValueExpression><![CDATA["2059B"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_PARTIDA_INICIAL" class="java.lang.String"
		><description><![CDATA[]]></description>
		<defaultValueExpression><![CDATA["1000"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_PARTIDA_FINAL" class="java.lang.String"
		><description><![CDATA[]]></description>
		<defaultValueExpression><![CDATA["5000"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_AL_MES" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[5]]></defaultValueExpression>
	</parameter>
	<parameter name="P_ANO" class="java.lang.Integer"
		><description><![CDATA[]]></description>
		<defaultValueExpression><![CDATA[2016]]></defaultValueExpression>
	</parameter>
	<parameter name="P_CAMPO1" class="java.lang.String"
		><description><![CDATA[]]></description>
		<defaultValueExpression><![CDATA["JOCOTITLAN"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_L3" class="java.lang.String"
		><description><![CDATA[""]]></description>
	</parameter>
	<parameter name="P_N3" class="java.lang.String"
		><description><![CDATA[""]]></description>
	</parameter>
	<parameter name="P_L5" class="java.lang.String"
		><description><![CDATA[""]]></description>
	</parameter>
	<parameter name="P_N5" class="java.lang.String"
		><description><![CDATA[""]]></description>
	</parameter>
	<parameter name="P_L4" class="java.lang.String"
		><description><![CDATA[""]]></description>
	</parameter>
	<parameter name="P_N4" class="java.lang.String"
		><description><![CDATA[""]]></description>
	</parameter>
	<query language="sql"><![CDATA[SELECT
SUBSTR(POLIDE.CUENTA, 1, 3) CUENTA
,POLIDE.CUENTA || POLIDE.SCTA || POLIDE.SSCTA || POLIDE.SSSCTA GRUPO
,POLIDE.CUENTA CUENTA_PD
,POLIDE.SCTA
,POLIDE.SSCTA
,POLIDE.SSSCTA
,POLIDE.SSSSCTA
,POLIDE.CANPOL
,POLIDE.CANPOLH
--,POLIDE.*

FROM POLIDE

WHERE 1=1

AND SUBSTR(POLIDE.CUENTA, 1, 3)  IN (824, 825, 827)
AND SUBSTR(POLIDE.CUENTA, 4, 1) <> 0
AND POLIDE.SCTA LIKE   $P{P_DIRECCION}  || '%'
AND POLIDE.SSSCTA BETWEEN   $P{P_PARTIDA_INICIAL}  AND   $P{P_PARTIDA_FINAL} 
AND POLIDE.MESPOL <=  $P{P_AL_MES} 
AND POLIDE.ANOPOL =  $P{P_ANO} 
AND POLIDE.IDSECTOR =  $P{P_SECTOR} 

ORDER BY POLIDE.CUENTA || POLIDE.SCTA || POLIDE.SSCTA || POLIDE.SSSCTA]]></query>
	<field name="CUENTA" class="java.lang.String"/>
	<field name="GRUPO" class="java.lang.String"/>
	<field name="CUENTA_PD" class="java.lang.String"/>
	<field name="SCTA" class="java.lang.String"/>
	<field name="SSCTA" class="java.lang.String"/>
	<field name="SSSCTA" class="java.lang.String"/>
	<field name="SSSSCTA" class="java.lang.String"/>
	<field name="CANPOL" class="java.math.BigDecimal"/>
	<field name="CANPOLH" class="java.math.BigDecimal"/>
	<variable name="mes_extenso" resetType="None" class="java.lang.String">
		<expression><![CDATA[UPPER(new java.text.SimpleDateFormat("MMMMM", new Locale("es", "ES")).format(new SimpleDateFormat("yyyy/MM/dd").parse("1970/" + $P{P_AL_MES}.toString() + "/01")) )]]></expression>
	</variable>
	<variable name="V_CARGOS" resetType="Group" calculation="Sum" resetGroup="GROUP" class="java.math.BigDecimal">
		<expression><![CDATA[$F{CANPOL}]]></expression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="V_ABONOS" resetType="Group" calculation="Sum" resetGroup="GROUP" class="java.math.BigDecimal">
		<expression><![CDATA[$F{CANPOLH}]]></expression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="V_SUMA_SECRE" resetType="Group" calculation="Sum" resetGroup="GROUP" class="java.math.BigDecimal">
		<expression><![CDATA[$F{CANPOL}.subtract($F{CANPOLH} )]]></expression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="V_SUMA_SECRE1" resetType="Group" calculation="Sum" resetGroup="GROUP" class="java.math.BigDecimal">
		<expression><![CDATA[$F{CANPOL}.subtract($F{CANPOLH} )]]></expression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="V_SUMA_MES" resetType="Group" calculation="Sum" resetGroup="GROUP" class="java.math.BigDecimal">
		<expression><![CDATA[$F{CANPOL}.subtract($F{CANPOLH} )]]></expression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="V_DIFERENCIA" resetType="Group" calculation="Sum" resetGroup="GROUP" class="java.math.BigDecimal">
		<expression><![CDATA[$F{CANPOL}.subtract($F{CANPOLH} )]]></expression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<group name="GROUP">
		<expression><![CDATA[$F{GRUPO}]]></expression>
		<groupHeader>
			<band height="10"/>
		</groupHeader>
		<groupFooter>
