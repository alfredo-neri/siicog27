				</element>
				<element kind="textField" uuid="60556e59-a703-41df-87e0-89bd3e7b3e92" x="-1" y="20" width="111" height="14" stretchType="NoStretch" fontName="Consolas" fontSize="7.0" hTextAlign="Center">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
					<expression><![CDATA["SUMA POR DEPENDENCIA"]]></expression>
