		<element kind="staticText" uuid="80cd275a-ff2c-45ff-8561-d7ada3f60d71" x="0" y="0" width="750" height="10" stretchType="NoStretch" fontName="Arial" fontSize="8.0" bold="true" vTextAlign="Middle">
