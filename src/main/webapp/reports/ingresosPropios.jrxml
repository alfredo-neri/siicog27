<jasperReport name="ingresosPropios" language="java" columnCount="1" dpi="72" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="3ef58ea6-8873-44a4-bf75-f7f863790923">
