	<variable name="lastDayOfMonth" resetType="None" class="java.lang.Integer">
		<expression><![CDATA[DAYSINMONTH( (new SimpleDateFormat("dd-MM-yyyy")).parse(String.valueOf("01-"+$P{P_MES}+"-"+YEAR(NOW()))))]]></expression>
	</variable>
	<variable name="mes_extenso" resetType="None" class="java.lang.String">
		<expression><![CDATA[UPPER(new java.text.SimpleDateFormat("MMMMM", new Locale("es", "ES")).format(new SimpleDateFormat("yyyy/MM/dd").parse("1970/" + $P{P_MES}.toString() + "/01")) )]]></expression>
