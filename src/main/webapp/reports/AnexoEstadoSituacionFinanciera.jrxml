<jasperReport name="Anexo Situacion Financiera" language="java" columnCount="1" dpi="72" pageWidth="792" pageHeight="612" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="764" leftMargin="14" rightMargin="14" topMargin="14" bottomMargin="14" uuid="94a9e52e-7229-46b2-9151-d67a6d4593c1" floatColumnFooter="true">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="gem21"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.unit.pageHeight" value="cm"/>
	<property name="com.jaspersoft.studio.unit.pageWidth" value="cm"/>
	<property name="com.jaspersoft.studio.unit.topMargin" value="cm"/>
	<property name="com.jaspersoft.studio.unit.bottomMargin" value="cm"/>
	<property name="com.jaspersoft.studio.unit.leftMargin" value="cm"/>
	<property name="com.jaspersoft.studio.unit.rightMargin" value="cm"/>
	<property name="com.jaspersoft.studio.unit.columnWidth" value="cm"/>
	<property name="com.jaspersoft.studio.unit.columnSpacing" value="cm"/>
	<scriptlet name="custom" class="com.gem.sistema.web.scriptlet.AnexoEstadoSituacionFinancieraScriptlet"
		><description><![CDATA[]]></description>
	</scriptlet>
	<parameter name="P_MES" class="java.lang.Integer"
		><description><![CDATA[]]></description>
	</parameter>
	<parameter name="P_SECTOR" class="java.lang.Integer"
		><description><![CDATA[]]></description>
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="P_IMG" class="java.lang.String"/>
	<parameter name="P_CAMPO1" class="java.lang.String"
		><description><![CDATA[""]]></description>
	</parameter>
	<parameter name="P_CAMPO3" class="java.lang.String"
		><description><![CDATA[""]]></description>
	</parameter>
	<parameter name="P_CUENTA_INICIAL" class="java.lang.String">
		<defaultValueExpression><![CDATA["1000"]]></defaultValueExpression>
	</parameter>
	<parameter name="P_CUENTA_FIN" class="java.lang.String"
		><description><![CDATA[]]></description>
		<defaultValueExpression><![CDATA["9130"]]></defaultValueExpression>
	</parameter>
	<parameter name="tipo" class="java.lang.String"/>
	<parameter name="noEntity" class="java.lang.String"/>
	<parameter name="noFirmas" class="java.lang.Integer"/>
	<parameter name="firmaL1" class="java.lang.String"/>
	<parameter name="firmaN1" class="java.lang.String"/>
	<parameter name="firmaL2" class="java.lang.String"/>
	<parameter name="firmaN2" class="java.lang.String"/>
	<parameter name="firmaL3" class="java.lang.String"/>
	<parameter name="firmaN3" class="java.lang.String"/>
	<parameter name="firmaL4" class="java.lang.String"/>
	<parameter name="firmaN4" class="java.lang.String"/>
	<parameter name="firmaL5" class="java.lang.String"/>
	<parameter name="firmaN5" class="java.lang.String"/>
	<query language="sql"><![CDATA[SELECT
CUENTA.NIVCTA
,CUENTA.STACTA AS NATCTA
,CUENTA.CUENTA
,CUENTA.SCTA
,CUENTA.SSCTA
,CUENTA.SSSCTA
,CUENTA.SSSSCTA
,CUENTA.CUENTA || CUENTA.SCTA || CUENTA.SSCTA || CUENTA.SSSCTA || CUENTA.SSSSCTA AS GRUPO
,SUBSTR(CUENTA.NOMCTA,1,100) AS NOMCTA
,CUENTA.SALINI
,CUENTA.CARGOS_1
,CUENTA.CARGOS_2
,CUENTA.CARGOS_3
,CUENTA.CARGOS_4
,CUENTA.CARGOS_5
,CUENTA.CARGOS_6
,CUENTA.CARGOS_7
,CUENTA.CARGOS_8
,CUENTA.CARGOS_9
,CUENTA.CARGOS_10
,CUENTA.CARGOS_11
,CUENTA.CARGOS_12
,CUENTA.ABONOS_1
,CUENTA.ABONOS_2
,CUENTA.ABONOS_3
,CUENTA.ABONOS_4
,CUENTA.ABONOS_5
,CUENTA.ABONOS_6
,CUENTA.ABONOS_7
,CUENTA.ABONOS_8
,CUENTA.ABONOS_9
,CUENTA.ABONOS_10
,CUENTA.ABONOS_11
,CUENTA.ABONOS_12
,POLIEN.FECPOL, POLIDE.TIPPOL, POLIDE.CONPOL, POLIDE.REFPOL, POLIDE.RENPOL,
POLIDE.CONCEP, POLIDE.CANPOL, POLIDE.CANPOLH, POLIDE.MESPOL
FROM CUENTA LEFT OUTER JOIN POLIDE ON
	POLIDE.MESPOL= $P{P_MES}  AND
	NVL(CUENTA.CUENTA,'') = NVL(POLIDE.CUENTA,'') AND
	NVL(CUENTA.SCTA,'') = NVL(POLIDE.SCTA,'')  AND
	NVL(CUENTA.SSCTA,'') = NVL(POLIDE.SSCTA,'')  AND
	NVL(CUENTA.SSSCTA,'') = NVL(POLIDE.SSSCTA,'') AND
	NVL(CUENTA.SSSSCTA,'') = NVL(POLIDE.SSSSCTA,'')  AND
	CUENTA.IDSECTOR = POLIDE.IDSECTOR
LEFT OUTER JOIN POLIEN ON
	POLIDE.TIPPOL=POLIEN.TIPPOL AND
	POLIDE.CONPOL=POLIEN.CONPOL AND
	POLIDE.MESPOL=POLIEN.MESPOL AND
	POLIDE.ANOPOL=POLIEN.ANOPOL AND
	POLIDE.IDSECTOR = POLIEN.IDSECTOR
WHERE ( CUENTA.CUENTA >= $P{P_CUENTA_INICIAL} AND CUENTA.CUENTA <= $P{P_CUENTA_FIN})
AND (CUENTA.NIVCTA = 'S' OR CUENTA.XNICTA = 1) AND CUENTA.NOTCTA =0
AND CUENTA.IDSECTOR = $P{P_SECTOR}
--solo test
--AND CUENTA.CUENTA IN (8110)
--AND CUENTA.SCTA = '0000004173'
--AND CUENTA.SSCTA = '000000000000007'
--AND CUENTA.SSSCTA = '0003'
--AND CUENTA.SSSSCTA = '002'
ORDER BY CUENTA.CUENTA, CUENTA.SCTA, CUENTA.SSCTA, CUENTA.SSSCTA, CUENTA.SSSSCTA, POLIDE.CONPOL]]></query>
