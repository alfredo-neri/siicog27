<jasperReport name="titulo" language="java" columnCount="1" dpi="72" pageWidth="1300" pageHeight="612" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="1300" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="cbcffced-fbaa-4a94-a5b4-ddcbdc3ee560">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="db2"/>
	<property name="com.jaspersoft.studio.unit." value="pixel"/>
	<property name="net.sf.jasperreports.export.text.character.width" value="4"/>
	<property name="net.sf.jasperreports.export.text.character.height" value="12"/>
	<property name="com.jaspersoft.studio.unit.pageHeight" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.pageWidth" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.topMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.bottomMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.leftMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.rightMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.columnWidth" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.columnSpacing" value="pixel"/>
	<parameter name="mes" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<parameter name="clave" class="java.lang.String">
		<defaultValueExpression><![CDATA["1000000000"]]></defaultValueExpression>
	</parameter>
	<parameter name="anio" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[2016]]></defaultValueExpression>
	</parameter>
	<parameter name="sector" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[1]]></defaultValueExpression>
	</parameter>
	<query language="SQL"><![CDATA[SELECT CLVDEP,NOMDEP FROM CATDEP
 where CLVDEP= $P{clave}
AND IDSECTOR= $P{sector}]]></query>
	<field name="CLVDEP" class="java.lang.String"/>
	<field name="NOMDEP" class="java.lang.String"/>
	<variable name="RANGO" class="java.lang.String">
		<expression><![CDATA[($P{mes} == 1) ?  $P{anio}+" AL 31 DE ENERO DE "+$P{anio} : (
	($P{mes} == 2) ?  (($P{anio} % 4==0)?  $P{anio}+" AL 29 DE FEBRERO DE "+$P{anio}:  $P{anio}+" AL 28 DE FEBRERO DE "+ $P{anio}): (
		($P{mes} == 3) ?  $P{anio}+" AL 31 DE MARZO DE "+$P{anio}	: (
			($P{mes} == 4) ?  $P{anio}+" AL 30 DE ABRIL DE "+$P{anio}	: (
				($P{mes} == 5) ?  $P{anio}+" AL 31 DE MAYO DE "+$P{anio} : (
					($P{mes} == 6) ?  $P{anio}+" AL 30 DE JUNIO DE "+$P{anio} : (
						($P{mes} == 7) ?  $P{anio}+" AL 31 DE JULIO DE "+$P{anio} : (
							($P{mes} == 8) ?  $P{anio}+" AL 31DE AGOSTO DE "+$P{anio} : (
								($P{mes} == 9) ?  $P{anio}+" AL 30 DE SEPTIEMBRE DE "+$P{anio} : (
									($P{mes} == 10) ?  $P{anio}+" AL 31 DE OCTUBRE DE "+$P{anio} : (
										($P{mes} == 11) ?  $P{anio}+" AL 30 DE NOVIEMBRE DE "+$P{anio} : (
											($P{mes} == 12) ?  $P{anio}+" AL 31 DE DICIEMBRE DE "+$P{anio} : ""
										)
									)
								)
							)
						)
					)
				)
			)
		)
	)
)]]></expression>
	</variable>
	<variable name="se" class="java.lang.String">
		<expression><![CDATA[$P{clave}+"0000000"]]></expression>
	</variable>
	<variable name="mess" class="java.lang.String">
		<expression><![CDATA[($P{mes} == 1) ?  " ENERO " : (
	($P{mes} == 2) ?  " FEBRERO  ": (
		($P{mes} == 3) ?  "  MARZO  "	: (
			($P{mes} == 4) ?  "  ABRIL ": (
				($P{mes} == 5) ?  " MAYO " : (
					($P{mes} == 6) ?  "  JUNIO  " : (
						($P{mes} == 7) ?  " JULIO  " : (
							($P{mes} == 8) ? " AGOSTO" : (
								($P{mes} == 9) ?  " SEPTIEMBRE " : (
									($P{mes} == 10) ?  "  OCTUBRE " : (
										($P{mes} == 11) ?  "  NOVIEMBRE  " : (
											($P{mes} == 12) ?  "  DICIEMBRE " : ""
										)
									)
								)
							)
						)
					)
				)
			)
		)
	)
)]]></expression>
	</variable>
	<background splitType="Stretch"/>
	<detail>
		<band height="40" splitType="Stretch">
			<element kind="textField" uuid="982b44f4-67f1-4e04-aa82-e4a061f0ebe9" x="0" y="26" width="1300" height="13" stretchType="NoStretch" fontName="Arial" fontSize="9.0" hTextAlign="Center">
				<property name="com.jaspersoft.studio.unit.width" value="pixel"/>
				<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
				<expression><![CDATA["ESTADO DE AVANCE PRESUPUESTAL DE EGRESOS DEL 1 DE ENERO DE  ".concat($V{RANGO})]]></expression>
			</element>
			<element kind="textField" uuid="a7b15d48-fa19-4c0c-bd2b-1ce8f5fb6202" x="0" y="13" width="1300" height="13" stretchType="NoStretch" fontName="Arial" fontSize="9.0" hTextAlign="Center">
				<property name="com.jaspersoft.studio.unit.x" value="pixel"/>
				<property name="com.jaspersoft.studio.unit.width" value="pixel"/>
				<expression><![CDATA[$F{CLVDEP} + " " + $F{NOMDEP}]]></expression>
			</element>
			<element kind="textField" uuid="7baa4d9f-14e5-4bb2-af56-0ba7c705b269" x="0" y="0" width="1300" height="13" stretchType="NoStretch" fontName="Arial" fontSize="9.0" hTextAlign="Center">
				<property name="com.jaspersoft.studio.unit.x" value="pixel"/>
				<property name="com.jaspersoft.studio.unit.width" value="pixel"/>
				<expression><![CDATA["AVANCE PRESUPUESTAL DEL MES".concat( $V{mess})]]></expression>
			</element>
			<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
		</band>
	</detail>
</jasperReport>
