	<dataset name="DatasetVariables" whenResourceMissingType="Empty" uuid="a41eaf5c-4899-43e0-9150-04d2ad13075e">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="gem2020Local"/>
		<parameter name="idFicha" class="java.lang.Long"/>
		<query language="SQL"><![CDATA[SELECT  FV.CODIGO, V.NOMVAR, FV.UNIDAD_MEDIDA, FV.OPERACION, FV.META_ANUAL, 
        SUM(DECODE (P.PERIODO, 1, VT.PROGRAMADA, 0)) PROGRAMADA_1,
        SUM(DECODE (P.PERIODO, 2, VT.PROGRAMADA, 0)) PROGRAMADA_2,
        SUM(DECODE (P.PERIODO, 3, VT.PROGRAMADA, 0)) PROGRAMADA_3,
        SUM(DECODE (P.PERIODO, 4, VT.PROGRAMADA, 0)) PROGRAMADA_4
  FROM TC_FICHA_VARIABLES FV
    INNER JOIN VARIABLES V ON V.ID = FV.ID_VARIABLE
    INNER JOIN TC_VARIABLES_TRIMESTRES VT ON VT.ID_FICHA_VARIABLE = FV.ID
    INNER JOIN TC_PERIODO P ON P.ID = VT.ID_PERIODO
WHERE FV.ID_FICHA=$P{idFicha}
GROUP BY FV.CODIGO, V.NOMVAR, FV.UNIDAD_MEDIDA, FV.OPERACION, FV.META_ANUAL
ORDER BY FV.CODIGO ASC]]></query>
		<field name="CODIGO" class="java.lang.Integer">
			<property name="com.jaspersoft.studio.field.label" value="CODIGO"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="TC_FICHA_VARIABLES"/>
		</field>
		<field name="NOMVAR" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.label" value="NOMVAR"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="VARIABLES"/>
		</field>
		<field name="UNIDAD_MEDIDA" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.label" value="UNIDAD_MEDIDA"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="TC_FICHA_VARIABLES"/>
		</field>
		<field name="OPERACION" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.label" value="OPERACION"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="TC_FICHA_VARIABLES"/>
		</field>
		<field name="META_ANUAL" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.label" value="META_ANUAL"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="TC_FICHA_VARIABLES"/>
		</field>
		<field name="PROGRAMADA_1" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.label" value="PROGRAMADA_1"/>
		</field>
		<field name="PROGRAMADA_2" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.label" value="PROGRAMADA_2"/>
		</field>
		<field name="PROGRAMADA_3" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.label" value="PROGRAMADA_3"/>
		</field>
		<field name="PROGRAMADA_4" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.label" value="PROGRAMADA_4"/>
		</field>
	</dataset>
	<dataset name="DatasetTotalesVariables" uuid="94b5bdf5-3124-4910-a930-d358d6a41c77">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="gem2020Local"/>
		<parameter name="idFicha" class="java.lang.Long"/>
		<query language="SQL"><![CDATA[SELECT  NVL(SUM(DECODE(P.PERIODO, 1, FT.PROGRAMADA,0)),0) PROGRMADA_1,
        NVL(SUM(DECODE(P.PERIODO, 2, FT.PROGRAMADA,0)),0) PROGRMADA_2,
        NVL(SUM(DECODE(P.PERIODO, 3, FT.PROGRAMADA,0)),0) PROGRMADA_3,
        NVL(SUM(DECODE(P.PERIODO, 4, FT.PROGRAMADA,0)),0) PROGRMADA_4
  FROM TC_FICHA_TRIMESTRES FT
  INNER JOIN TC_PERIODO P ON P.ID = FT.ID_PERIODO
WHERE ID_FICHA=$P{idFicha}]]></query>
		<field name="PROGRMADA_1" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.label" value="PROGRMADA_1"/>
		</field>
		<field name="PROGRMADA_2" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.label" value="PROGRMADA_2"/>
		</field>
		<field name="PROGRMADA_3" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.label" value="PROGRMADA_3"/>
		</field>
		<field name="PROGRMADA_4" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.label" value="PROGRMADA_4"/>
		</field>
		<variable name="metaAnual" class="java.math.BigDecimal">
			<expression><![CDATA[$F{PROGRMADA_1}.add($F{PROGRMADA_2}).add($F{PROGRMADA_3}).add($F{PROGRMADA_4})]]></expression>
		</variable>
	</dataset>
	<parameter name="year" class="java.lang.Integer"/>
	<parameter name="sector" class="java.lang.Integer"/>
	<parameter name="imagenPath" class="java.lang.String"/>
	<parameter name="noFirmas" class="java.lang.Integer"/>
	<parameter name="firmaL1" class="java.lang.String"/>
	<parameter name="firmaN1" class="java.lang.String"/>
	<parameter name="firmaL2" class="java.lang.String"/>
	<parameter name="firmaN2" class="java.lang.String"/>
	<parameter name="firmaL3" class="java.lang.String"/>
	<parameter name="firmaN3" class="java.lang.String"/>
	<parameter name="firmaL4" class="java.lang.String"/>
	<parameter name="firmaN4" class="java.lang.String"/>
	<parameter name="firmaL5" class="java.lang.String"/>
	<parameter name="firmaN5" class="java.lang.String"/>
	<query language="SQL"><![CDATA[SELECT F.ID, DG.CLAVE, DG.NOMBRE, DA.CLAVE CLAVE_AUX, DA.NOMBRE NOMBRE_AUX,	MU.CAMPO7 PROGRAMA, MU.CAMPO6 NOMBRE_PROGRAMA, 
		MU.CAMPO8 OBJETIVO_PROGRAMA, CPD.CVETEMAS, CPD.DESCRIPCION SUBTEMA_DESCRIPCION, MIR.CODIGO, MIR.NOMIND, 
		N.FORMULA, N.FRECUENCIA, N.MEDIOS_VERIFICACION, N.TIPO, F.INTERPRETACION, F.DIMENSION, F.AMBITO, 
      	F.COBERTURA, F.FACTOR, F.DESCRIPCION_FACTOR, F.DESCRIPCION_RESULTADOS, F.EVALUACION_INDICADOR, 
        F.LINEA_BASE, F.DESCRIPCION_META_ANUAL, F.METAS_ACCION, MU2.CAMPO6 PROYECTO_DESCRIPCION, 
        CPD1.DESCRIPCION EJE_DESCRIPCION, CPD2.DESCRIPCION TEMA_DESCRIPCION
  FROM TC_FICHA F
  		INNER JOIN TR_MATRIZ_NIVEL MN ON MN.ID = F.ID_MATRIZ_NIVEL
	INNER JOIN TC_NIVEL N ON MN.ID_NIVEL = N.ID
    INNER JOIN TC_MATRIZ M ON M.ID = MN.ID_MATRIZ
    INNER JOIN CATDGM DG ON DG.ID = M.ID_DEPENDENCIA
	INNER JOIN CATDAA DA ON DA.ID = M.ID_DEP_AUX
	INNER JOIN MUNINEP MU ON MU.ID = M.ID_PROYECTO
	INNER JOIN MUNINEP MU2 ON SUBSTR(MU.CAMPO7,1,2) = MU2.CAMPO7
	INNER JOIN CPD ON CPD.ID = M.ID_TEMA
    INNER JOIN CPD CPD1 ON SUBSTR(CPD.CVETEMAS,1,4) = CPD1.CVETEMAS
    INNER JOIN CPD CPD2 ON SUBSTR(CPD.CVETEMAS,1,6) = CPD2.CVETEMAS
	INNER JOIN MIR ON MIR.CODIGO = N.CODIGO_INDICADOR

WHERE M.ID_SECTOR=$P{sector}
ORDER BY DG.CLAVE, DA.CLAVE, MU.CAMPO7, CPD.CVETEMAS, MIR.CODIGO ASC]]></query>
