	<field name="TIPPOL" class="java.lang.String"/>
	<field name="FECHA" class="java.lang.String"/>
	<field name="NOPOLIZA" class="java.lang.String"/>
	<field name="REF" class="java.lang.String"/>
	<variable name="lastDayOfMonth" resetType="None" class="java.lang.Integer">
		<expression><![CDATA[DAYSINMONTH( (new SimpleDateFormat("dd-MM-yyyy")).parse(String.valueOf("01-"+$P{P_MES}+"-"+YEAR(NOW()))))]]></expression>
	</variable>
	<variable name="mes_extenso" resetType="None" class="java.lang.String">
		<expression><![CDATA[UPPER(new java.text.SimpleDateFormat("MMMMM", new Locale("es", "ES")).format(new SimpleDateFormat("yyyy/MM/dd").parse("1970/" + $P{P_MES}.toString() + "/01")) )]]></expression>
	</variable>
	<variable name="total_saldo_final" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{STACTA}.equals("D") ? $F{CANPOL}.subtract( $F{CANPOLH}).add($F{SALINI}) : $F{CANPOLH}.subtract( $F{CANPOL}).add($F{SALINI})]]></expression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="V_CURRENT_PAGE_NUMBER" resetType="Page" class="java.lang.Integer">
		<expression><![CDATA[1]]></expression>
		<initialValueExpression><![CDATA[$V{PAGE_NUMBER}]]></initialValueExpression>
	</variable>
	<variable name="total_cargos" resetType="Group" calculation="Sum" resetGroup="GROUP_CUENTA" class="java.math.BigDecimal">
		<expression><![CDATA[$F{CANPOL}]]></expression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="total_abonos" resetType="Group" calculation="Sum" resetGroup="GROUP_CUENTA" class="java.math.BigDecimal">
		<expression><![CDATA[$F{CANPOLH}]]></expression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="diferencia" resetType="Group" calculation="Sum" resetGroup="GROUP_CUENTA" class="java.math.BigDecimal">
		<expression><![CDATA[$F{CANPOL}.subtract($F{CANPOLH} )]]></expression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<group name="GROUP_CUENTA" startNewPage="true" reprintHeaderOnEachPage="true">
		<expression><![CDATA[$F{CUENTA}+$F{SCTA}+$F{SSCTA}+$F{SSSCTA}+$F{SSSSCTA}]]></expression>
