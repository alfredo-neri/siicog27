		><description><![CDATA[""]]></description>
	</parameter>
	<parameter name="P_CLASIFICACION" class="java.lang.String"
		><description><![CDATA[]]></description>
		<defaultValueExpression><![CDATA["DEL_MES"]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[SELECT 
CUENTA.NOMCTA, CUENTA.XNICTA, CUENTA.CUENTA, CUENTA.SCTA, CUENTA.SSCTA,
CUENTA.SSSCTA, CUENTA.SSSSCTA, CUENTA.SALINI, CUENTA.STACTA,
POLIDE.MESPOL, POLIDE.CONPOL, POLIDE.ANOPOL, POLIDE.RENPOL,
NVL(POLIDE.CANPOL, 0) CANPOL, NVL(POLIDE.CANPOLH, 0) CANPOLH, POLIDE.CONCEP, POLIDE.DN,
POLIDE.REFPOL, POLIDE.TIPPOL
, POLIDE.FECPOL || ' ' || POLIDE.MESPOL FECHA
, NVL(CAST (POLIDE.CONPOL AS VARCHAR(10)), '') || ' ' || NVL(POLIDE.TIPPOL, '') NOPOLIZA
, NVL(CAST (CAST(POLIDE.REFPOL AS INT) as varchar(10)),'') || ' ' || NVL(CAST(POLIDE.DN AS VARCHAR(10)), '') REF
FROM CUENTA
LEFT OUTER JOIN POLIDE ON
(
	(CUENTA.CUENTA  = POLIDE.CUENTA) 
AND (CUENTA.SCTA    = NVL(POLIDE.SCTA,'')) 
AND (CUENTA.SSCTA   = NVL(POLIDE.SSCTA,'')) 
AND (CUENTA.SSSCTA  = NVL(POLIDE.SSSCTA,'')) 
AND (CUENTA.SSSSCTA = NVL(POLIDE.SSSSCTA,''))  
AND CUENTA.IDSECTOR = POLIDE.IDSECTOR
) 

WHERE 1 = 1 
AND CUENTA.CUENTA = $P{P_CUENTA}
AND CUENTA.NIVCTA = 'S' 
AND CUENTA.IDSECTOR =  $P{P_SECTOR} 

AND (POLIDE.MESPOL IS NULL OR ($P{P_CLASIFICACION} = 'DEL_MES' AND POLIDE.MESPOL = $P{P_MES} ) 
	OR ($P{P_CLASIFICACION} = 'AL_MES' AND POLIDE.MESPOL <= $P{P_MES} ) 
)


AND (($P{P_SCTA} IS NULL OR $P{P_SCTA} = '' OR CUENTA.SCTA = $P{P_SCTA} ) 
AND ($P{P_SSCTA} IS NULL OR $P{P_SSCTA} = '' OR CUENTA.SSCTA = $P{P_SSCTA}  ) 
AND ($P{P_SSSCTA} IS NULL OR $P{P_SSSCTA} = '' OR CUENTA.SSSCTA = $P{P_SSSCTA}  ) 
AND ($P{P_SSSSCTA} IS NULL OR $P{P_SSSSCTA} = '' OR CUENTA.SSSSCTA = $P{P_SSSSCTA}))
--AND POLIDE.RENPOL IS NOT NULL

ORDER BY  CUENTA.CUENTA, CUENTA.SCTA, CUENTA.SSCTA, CUENTA.SSSCTA, CUENTA.SSSSCTA, POLIDE.MESPOL]]></query>
	<field name="NOMCTA" class="java.lang.String"/>
	<field name="XNICTA" class="java.lang.Integer"/>
	<field name="CUENTA" class="java.lang.String"/>
	<field name="SCTA" class="java.lang.String"/>
