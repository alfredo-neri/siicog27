	<queryString language="SQL">
		<![CDATA[SELECT CUENTA, SCTA, SSCTA, SSSCTA, SSSSCTA,
 		NOMCTA,
		STACTA,
		SALINI SALINI,
		CARGOS_1 ,
		CARGOS_2 ,
		CARGOS_3 ,
		CARGOS_4 ,
		CARGOS_5 ,
		CARGOS_6 ,
		CARGOS_7 ,
		CARGOS_8 ,
		CARGOS_9 ,
		CARGOS_10 ,
		CARGOS_11 ,
		CARGOS_12 ,
		ABONOS_1 ,
		ABONOS_2 ,
		ABONOS_3 ,
		ABONOS_4 ,
		ABONOS_5 ,
		ABONOS_6 ,
		ABONOS_7 ,
		ABONOS_8 ,
		ABONOS_9 ,
		ABONOS_10 ,
		ABONOS_11 ,
		ABONOS_12 
	 FROM CUENTA
 WHERE  
		$P!{queryWhere}
 		NOTCTA=0 AND 
 		IDSECTOR= $P{sector} AND
 		(SUBSTR(CUENTA,4,1)<>'0' OR SUBSTR(CUENTA,1,1)='5' OR SUBSTR(CUENTA,1,2)='81'  OR CUENTA LIKE '7%0') AND 
		(SALINI <> 0 OR CARGOS_1 <> 0 OR CARGOS_2 <> 0 OR CARGOS_3 <> 0 OR CARGOS_4 <> 0 OR CARGOS_5 <> 0 OR CARGOS_6 <> 0 OR CARGOS_7 <> 0 OR CARGOS_8 <> 0 OR CARGOS_9 <> 0 OR CARGOS_10 <> 0 OR CARGOS_11 <> 0 OR CARGOS_12 <> 0 OR ABONOS_1 <> 0 OR ABONOS_2 <> 0 OR ABONOS_3 <> 0 OR ABONOS_4 <> 0 OR ABONOS_5 <> 0 OR ABONOS_6 <> 0 OR ABONOS_7 <> 0 OR ABONOS_8 <> 0 OR ABONOS_9 <> 0 OR ABONOS_10 <> 0 OR ABONOS_11 <> 0 OR ABONOS_12 <> 0 )
 ORDER BY CUENTA]]>
	</queryString>
