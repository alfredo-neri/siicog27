	<queryString>
		<![CDATA[SELECT
		DECODE(I.SCTA,'',0,1) x,
		DECODE(I.SCTA,'','8110',SUBSTR(I.SCTA,7,4))CUENTA,
		I.NOMBRE, I.AUTOI_2 AUTORIZADO, I.AUTOI_3 RECAUDADO, I.AUTOI_1 PRESUPUESTADO
FROM INGRESOT I
WHERE I.SECTORID= $P{idSector}
ORDER  BY 1]]>
	</queryString>
