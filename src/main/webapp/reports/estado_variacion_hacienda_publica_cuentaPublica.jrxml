	<queryString language="SQL">
		<![CDATA[SELECT 1 PRINCIPAL, 1 GRUPO, 1 ORDEN, 'Aportaciones' NOMCTA, 0.00 CONTRIBUIDO, 0.00 GENERADOANTERIOR, 0.00 GENERADOACTUAL, 0.00 EXCESO, 0.00 TOTAL FROM SYSIBM.SYSDUMMY1 
UNION ALL 
SELECT 1 PRINCIPAL, 1 GRUPO, 2 ORDEN, 'Donaciones de Capital' NOMCTA, 0.00 CONTRIBUIDO, 0.00 GENERADOANTERIOR, 0.00 GENERADOACTUAL, 0.00 EXCESO, 0.00 TOTAL FROM SYSIBM.SYSDUMMY1 
UNION ALL 
SELECT 1 PRINCIPAL, 1 GRUPO, 3 ORDEN, 'Actualización de la Hacienda Pública/Patrimonio' NOMCTA, 0.00 CONTRIBUIDO, 0.00 GENERADOANTERIOR, 0.00 GENERADOACTUAL, 0.00 EXCESO, 0.00 TOTAL FROM SYSIBM.SYSDUMMY1 
UNION ALL 
SELECT 1 PRINCIPAL, 2 GRUPO, 1 ORDEN, 'Resultados del Ejercicio (Ahorro/Desahorro)' NOMCTA, 0.00 CONTRIBUIDO, 0.00 GENERADOANTERIOR, TOTAL_ANT GENERADOACTUAL, 0.00 EXCESO, TOTAL_ANT TOTAL 
FROM ( SELECT (SUM(T3.VAN4)-SUM(T3.VAN5)) TOTAL_ANT, (SUM(T3.VACT4)-SUM(T3.VACT5)) TOTAL_ACT 
FROM ( SELECT CASE WHEN T2.GRUPO='4' THEN SUM(T2.VMANT) ELSE 0.00 END VAN4, CASE WHEN T2.GRUPO='5' THEN SUM(T2.VMANT) ELSE 0.00 END VAN5, CASE WHEN T2.GRUPO='4' THEN SUM(T2.VMACT) ELSE 0.00 END VACT4, CASE WHEN T2.GRUPO='5' THEN SUM(T2.VMACT)ELSE 0.00 END VACT5 
FROM ( SELECT T1.GRUPO, T1.SALINI, CASE WHEN T1.GRUPO ='4' 
THEN (T1.SALINI_ANT+ABONOS_ANT-CARGOS_ANT) ELSE  (T1.SALINI_ANT-ABONOS_ANT+CARGOS_ANT) END VMANT, 
CASE WHEN T1.GRUPO ='4' 
THEN (T1.SALINI+ABONOS_ACT-CARGOS_ACT) ELSE  (T1.SALINI-ABONOS_ACT+CARGOS_ACT) END VMACT 
FROM ( SELECT SUBSTR(C.CUENTA, 1, 1) GRUPO, C.CUENTA CUENTA , C.SALINI SALINI, CA.SALINI SALINI_ANT,
 SUM(CA.CARGOS_1 + CA.CARGOS_2 + CA.CARGOS_3 + CA.CARGOS_4 + CA.CARGOS_5 + CA.CARGOS_6 + CA.CARGOS_7 + CA.CARGOS_8 + CA.CARGOS_9 + CA.CARGOS_10 + CA.CARGOS_11+ CA.CARGOS_12) CARGOS_ANT,
 SUM(CA.ABONOS_1 + CA.ABONOS_2 + CA.ABONOS_3 + CA.ABONOS_4 + CA.ABONOS_5 + CA.ABONOS_6 + CA.ABONOS_7 + CA.ABONOS_8 + CA.ABONOS_9 + CA.ABONOS_10 + CA.ABONOS_11+ CA.ABONOS_12) ABONOS_ANT, 
SUM(C.CARGOS_1 + C.CARGOS_2 + C.CARGOS_3 + C.CARGOS_4 + C.CARGOS_5 + C.CARGOS_6 + C.CARGOS_7 + C.CARGOS_8 + C.CARGOS_9 + C.CARGOS_10 + C.CARGOS_11 + C.CARGOS_12) CARGOS_ACT, SUM(C.ABONOS_1 + C.ABONOS_2 + C.ABONOS_3 + C.ABONOS_4 + C.ABONOS_5 + C.ABONOS_6 + C.ABONOS_7 + C.ABONOS_8 + C.ABONOS_9 + C.ABONOS_10 + C.ABONOS_11 + C.ABONOS_12) ABONOS_ACT 
FROM CUENTA C ,CUENTA_ANTERIOR CA   WHERE C.CUENTA = CA.CUENTA AND C.IDSECTOR= 2 
AND ( ( (SUBSTR(C.CUENTA,1,1) =4 AND SUBSTR(C.CUENTA,4,1)<>'0') OR (SUBSTR(C.CUENTA,1,1) = 5 AND SUBSTR(C.CUENTA,2,1) > 0) ) AND C.SCTA ='') GROUP BY C.CUENTA, C.SALINI,CA.SALINI ORDER BY C.CUENTA)T1)T2 GROUP BY T2.GRUPO )T3 ) 
UNION ALL 
SELECT 1 PRINCIPAL, 2 GRUPO, CASE WHEN C.CUENTA = '3232' 
THEN 3 ELSE 2 END ORDEN, CASE WHEN C.CUENTA = '3232' THEN 'Revalúos' 
ELSE C.NOMCTA END NOMCTA,  0.00 CONTRIBUIDO, C.SALINI GENERADOANTERIOR, 0.00 GENERADOACTUAL, 0.00 EXCESO, C.SALINI TOTAL FROM   CUENTA C WHERE  C.CUENTA IN ('3221','3232') AND C.SCTA ='' AND C.IDSECTOR = 2 
UNION ALL SELECT 1 PRINCIPAL, 2 GRUPO, 4 ORDEN, 'Reservas' NOMCTA, 0.00 CONTRIBUIDO, 0.00 GENERADOANTERIOR, 0.00 GENERADOACTUAL, 0.00 EXCESO, 0.00 TOTAL FROM SYSIBM.SYSDUMMY1 
UNION ALL SELECT 1 PRINCIPAL, 2 GRUPO, 5 ORDEN, 'Rectificaciones de Resultados de Ejercicios Anteriores' NOMCTA, 0.00 CONTRIBUIDO, 0.00 GENERADOANTERIOR, 0.00 GENERADOACTUAL, 0.00 EXCESO, 0.00 TOTAL FROM SYSIBM.SYSDUMMY1 
UNION ALL SELECT 1 PRINCIPAL, 3 GRUPO, 1 ORDEN, 'Resultado por Posición Monetaria' NOMCTA, 0.00 CONTRIBUIDO, 0.00 GENERADOANTERIOR, 0.00 GENERADOACTUAL, 0.00 EXCESO, 0.00 TOTAL FROM SYSIBM.SYSDUMMY1 
UNION ALL SELECT 1 PRINCIPAL, 3 GRUPO, 2 ORDEN, 'Resultado por Tenencia de Activos no Monetarios' NOMCTA, 0.00 CONTRIBUIDO, 0.00 GENERADOANTERIOR, 0.00 GENERADOACTUAL, 0.00 EXCESO, 0.00 TOTAL FROM SYSIBM.SYSDUMMY1 
UNION ALL SELECT 2 PRINCIPAL, 4 GRUPO, 1 ORDEN, 'Aportaciones' NOMCTA, 0.00 CONTRIBUIDO, 0.00 GENERADOANTERIOR, 0.00 GENERADOACTUAL, 0.00 EXCESO, 0.00 TOTAL FROM SYSIBM.SYSDUMMY1
 UNION ALL SELECT 2 PRINCIPAL, 4 GRUPO, 2 ORDEN, 'Donaciones de Capital' NOMCTA, 0.00 CONTRIBUIDO, 0.00 GENERADOANTERIOR, 0.00 GENERADOACTUAL, 0.00 EXCESO, 0.00 TOTAL FROM SYSIBM.SYSDUMMY1 
 UNION ALL SELECT 2 PRINCIPAL, 4 GRUPO, 3 ORDEN, 'Actualización de la Hacienda Pública/Patrimonio' NOMCTA, 0.00 CONTRIBUIDO, 0.00 GENERADOANTERIOR, 0.00 GENERADOACTUAL, 0.00 EXCESO, 0.00 TOTAL FROM SYSIBM.SYSDUMMY1 
 UNION ALL SELECT 2 PRINCIPAL, 5 GRUPO, 1 ORDEN, 'Resultados del Ejercicio (Ahorro/Desahorro)' NOMCTA, 0.00 CONTRIBUIDO, 0.00 GENERADOANTERIOR, TOTAL_ACT GENERADOACTUAL, 0.00 EXCESO, TOTAL_ACT TOTAL 
 FROM ( SELECT (SUM(T3.VAN4)-SUM(T3.VAN5)) TOTAL_ANT, (SUM(T3.VACT4)-SUM(T3.VACT5)) TOTAL_ACT 
 FROM ( SELECT CASE WHEN T2.GRUPO='4' THEN SUM(T2.VMANT) ELSE 0.00 END VAN4, CASE WHEN T2.GRUPO='5' THEN SUM(T2.VMANT) ELSE 0.00 
 END VAN5, CASE WHEN T2.GRUPO='4' THEN SUM(T2.VMACT) ELSE 0.00 END VACT4, CASE WHEN T2.GRUPO='5' THEN SUM(T2.VMACT)ELSE 0.00 END VACT5 
 FROM ( SELECT T1.GRUPO, T1.SALINI, CASE WHEN T1.GRUPO ='4' 
 THEN (T1.SALINI_ANT+ABONOS_ANT-CARGOS_ANT) 
 ELSE  (T1.SALINI_ANT-ABONOS_ANT+CARGOS_ANT) END VMANT, CASE WHEN T1.GRUPO ='4' 
 THEN (T1.SALINI+ABONOS_ACT-CARGOS_ACT) ELSE  (T1.SALINI-ABONOS_ACT+CARGOS_ACT) END VMACT 
 FROM ( SELECT SUBSTR(C.CUENTA, 1, 1) GRUPO, C.CUENTA CUENTA , C.SALINI SALINI,  CA.SALINI SALINI_ANT,
 SUM(CA.CARGOS_1 + CA.CARGOS_2 + CA.CARGOS_3 + CA.CARGOS_4 + CA.CARGOS_5 + CA.CARGOS_6 + CA.CARGOS_7 + CA.CARGOS_8 + CA.CARGOS_9 + CA.CARGOS_10 + CA.CARGOS_11+ CA.CARGOS_12) CARGOS_ANT,
 SUM(CA.ABONOS_1 + CA.ABONOS_2 + CA.ABONOS_3 + CA.ABONOS_4 + CA.ABONOS_5 + CA.ABONOS_6 + CA.ABONOS_7 + CA.ABONOS_8 + CA.ABONOS_9 + CA.ABONOS_10 + CA.ABONOS_11+ CA.ABONOS_12) ABONOS_ANT,
 SUM(C.CARGOS_1 + C.CARGOS_2 + C.CARGOS_3 + C.CARGOS_4 + C.CARGOS_5 + C.CARGOS_6 + C.CARGOS_7 + C.CARGOS_8 + C.CARGOS_9 + C.CARGOS_10 + C.CARGOS_11 + C.CARGOS_12) CARGOS_ACT, 
 SUM(C.ABONOS_1 + C.ABONOS_2 + C.ABONOS_3 + C.ABONOS_4 + C.ABONOS_5 + C.ABONOS_6 + C.ABONOS_7 + C.ABONOS_8 + C.ABONOS_9 + C.ABONOS_10 + C.ABONOS_11 + C.ABONOS_12) ABONOS_ACT 
 FROM CUENTA C ,CUENTA_ANTERIOR CA   WHERE C.CUENTA = CA.CUENTA AND C.IDSECTOR= 2 
 AND ( ( (SUBSTR(C.CUENTA,1,1) =4 AND SUBSTR(C.CUENTA,4,1)<>'0') OR (SUBSTR(C.CUENTA,1,1) = 5 AND SUBSTR(C.CUENTA,2,1) > 0) ) AND C.SCTA ='') GROUP BY C.CUENTA, C.SALINI , CA.SALINI ORDER BY C.CUENTA)T1)T2 GROUP BY T2.GRUPO )T3 ) 
 
 UNION ALL SELECT 2 PRINCIPAL, 5 GRUPO, 2 ORDEN, 'Resultados de Ejercicios Anteriores' NOMCTA, 0.00 CONTRIBUIDO, 0.00 GENERADOANTERIOR, TOTAL_ANT*-1 GENERADOACTUAL, 0.00 EXCESO, TOTAL_ANT*-1 TOTAL 
 FROM ( SELECT (SUM(T3.VAN4)-SUM(T3.VAN5)) TOTAL_ANT, (SUM(T3.VACT4)-SUM(T3.VACT5)) TOTAL_ACT FROM ( SELECT CASE WHEN T2.GRUPO='4' THEN SUM(T2.VMANT) ELSE 0.00 END VAN4, CASE WHEN T2.GRUPO='5' THEN SUM(T2.VMANT) ELSE 0.00 END VAN5, 
 CASE WHEN T2.GRUPO='4' THEN SUM(T2.VMACT) ELSE 0.00 END VACT4, CASE WHEN T2.GRUPO='5' THEN SUM(T2.VMACT)ELSE 0.00 END VACT5 
 FROM ( SELECT T1.GRUPO, T1.SALINI, CASE WHEN T1.GRUPO ='4' THEN (T1.SALINI_ANT+ABONOS_ANT-CARGOS_ANT) ELSE  (T1.SALINI_ANT-ABONOS_ANT+CARGOS_ANT) END VMANT, CASE WHEN T1.GRUPO ='4' THEN (T1.SALINI+ABONOS_ACT-CARGOS_ACT) ELSE  (T1.SALINI-ABONOS_ACT+CARGOS_ACT) END VMACT 
 FROM ( SELECT SUBSTR(C.CUENTA, 1, 1) GRUPO, C.CUENTA CUENTA , C.SALINI SALINI, CA.SALINI SALINI_ANT,
 SUM(CA.CARGOS_1 + CA.CARGOS_2 + CA.CARGOS_3 + CA.CARGOS_4 + CA.CARGOS_5 + CA.CARGOS_6 + CA.CARGOS_7 + CA.CARGOS_8 + CA.CARGOS_9 + CA.CARGOS_10 + CA.CARGOS_11+ CA.CARGOS_12) CARGOS_ANT,
 SUM(CA.ABONOS_1 + CA.ABONOS_2 + CA.ABONOS_3 + CA.ABONOS_4 + CA.ABONOS_5 + CA.ABONOS_6 + CA.ABONOS_7 + CA.ABONOS_8 + CA.ABONOS_9 + CA.ABONOS_10 + CA.ABONOS_11+ CA.ABONOS_12) ABONOS_ANT, 
 SUM(C.CARGOS_1 + C.CARGOS_2 + C.CARGOS_3 + C.CARGOS_4 + C.CARGOS_5 + C.CARGOS_6 + C.CARGOS_7 + C.CARGOS_8 + C.CARGOS_9 + C.CARGOS_10 + C.CARGOS_11 + C.CARGOS_12) CARGOS_ACT, 
 SUM(C.ABONOS_1 + C.ABONOS_2 + C.ABONOS_3 + C.ABONOS_4 + C.ABONOS_5 + C.ABONOS_6 + C.ABONOS_7 + C.ABONOS_8 + C.ABONOS_9 + C.ABONOS_10 + C.ABONOS_11 + C.ABONOS_12) ABONOS_ACT 
 FROM CUENTA C,CUENTA_ANTERIOR CA   WHERE C.CUENTA = CA.CUENTA AND C.IDSECTOR= 2 
 AND ( ( (SUBSTR(C.CUENTA,1,1) =4 AND SUBSTR(C.CUENTA,4,1)<>'0') OR (SUBSTR(C.CUENTA,1,1) = 5 AND SUBSTR(C.CUENTA,2,1) > 0) ) AND C.SCTA ='') GROUP BY C.CUENTA, C.SALINI, CA.SALINI ORDER BY C.CUENTA)T1)T2 GROUP BY T2.GRUPO )T3 ) 
 UNION ALL SELECT 2 PRINCIPAL, 5 GRUPO, 3 ORDEN, 'Revalúos' NOMCTA, 0.00 CONTRIBUIDO, 0.00 GENERADOANTERIOR, 0.00 GENERADOACTUAL, 0.00 EXCESO, 0.00 TOTAL FROM SYSIBM.SYSDUMMY1 
 UNION ALL SELECT 2 PRINCIPAL, 5 GRUPO, 4 ORDEN, 'Reservas' NOMCTA, 0.00 CONTRIBUIDO, 0.00 GENERADOANTERIOR, 0.00 GENERADOACTUAL, 0.00 EXCESO, 0.00 TOTAL FROM SYSIBM.SYSDUMMY1 
 UNION ALL SELECT 2 PRINCIPAL, 5 GRUPO, 5 ORDEN, 'Rectificaciones de Resultados de Ejercicios Anteriores' NOMCTA, 0.00 CONTRIBUIDO, 0.00 GENERADOANTERIOR, 0.00 GENERADOACTUAL, 0.00 EXCESO, 0.00 TOTAL FROM SYSIBM.SYSDUMMY1 
 UNION ALL SELECT 2 PRINCIPAL, 6 GRUPO, 1 ORDEN, 'Resultado por Posición Monetaria' NOMCTA, 0.00 CONTRIBUIDO, 0.00 GENERADOANTERIOR, 0.00 GENERADOACTUAL, 0.00 EXCESO, 0.00 TOTAL FROM SYSIBM.SYSDUMMY1 
 UNION ALL SELECT 2 PRINCIPAL, 6 GRUPO, 2 ORDEN, 'Resultado por Tenencia de Activos no Monetarios' NOMCTA, 0.00 CONTRIBUIDO, 0.00 GENERADOANTERIOR, 0.00 GENERADOACTUAL, 0.00 EXCESO, 0.00 TOTAL FROM SYSIBM.SYSDUMMY1 ORDER BY 1,2,3]]>
	</queryString>
