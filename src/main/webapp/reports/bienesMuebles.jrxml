	<queryString>
		<![CDATA[SELECT  B.MES,
	B.CONSEC,B.CUENTA,
	SUBSTR(B.SCTA,8,3) SCTA,
	B.NOMCTA,
	B.INVENTARIO,
	B.RESGUARDO,
	B.RESGUARDATARIO,
	B.NOMMUEBLE,
	B.MARCA,
	B.MODELO,
	B.MOTOR,
	B.SERIE,
	B.ESTADO,
	B.FACTURA,
	B.FECFACTURA,
	B.PROVEEDOR,
	B.COSTO,
	B.TIPPOL,
	B.CONPOL,
	B.FECPOL,
	B.RECURSO,
	B.FECALTA,
	B.FECBAJA,
	B.AREA,
	B.LOCALIDAD,
	B.OBS,
	B.TVIDAUTIL, 
	B.DEPREPERIODO,
	B.DEPREACUM 
FROM BIENESM B
 WHERE B.IDSECTOR=  $P{pSector} 
 AND MONTH(B.FECALTA) = $P{pMesIni} 
  AND YEAR(B.FECALTA) = $P{pYear}
ORDER BY MES, CONSEC]]>
	</queryString>
