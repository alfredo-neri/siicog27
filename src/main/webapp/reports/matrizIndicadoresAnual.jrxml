<jasperReport name="matrizIndicadoresAnual" language="java" columnCount="1" dpi="72" pageWidth="1500" pageHeight="612" orientation="Landscape" columnWidth="1500" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="90aec4c3-96bd-4c17-90b8-3ac982768476" ignorePagination="true">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="gem22"/>
	<query language="SQL"><![CDATA[SELECT 	M.ID, TN.CLAVE TIP_NIV, G.CLAVE DEP_GEN, A.CLAVE DEP_AUX, P.CAMPO7, P.CAMPO6, P.CAMPO8, T.CVETEMAS, N.NOMBRE, N.OBJETIVO, N.FORMULA, N.FRECUENCIA, N.TIPO, N.MEDIOS_VERIFICACION, N.SUPUESTO, 
				DECODE(TN.CLAVE,'F',N.OBJETIVO,'') OBJ_FINALIDAD, DECODE(TN.CLAVE,'P',N.OBJETIVO,'') OBJ_PROPOSITO, DECODE(TN.CLAVE,'C',N.OBJETIVO,'') OBJ_COMPONENTE, DECODE(TN.CLAVE,'A',N.OBJETIVO,'') OBJ_ACTIVIDAD
			FROM TC_FICHA F
				INNER JOIN TR_MATRIZ_NIVEL MN ON F.ID_MATRIZ_NIVEL = MN.ID
				INNER JOIN TC_NIVEL N ON MN.ID_NIVEL = N.ID
				INNER JOIN TC_MATRIZ M ON MN.ID_MATRIZ = M.ID
				INNER JOIN MUNINEP P ON M.ID_PROYECTO = P.ID
				INNER JOIN CATDAA A ON M.ID_DEP_AUX = A.ID
				INNER JOIN CATDGM G ON M.ID_DEPENDENCIA = G.ID
				INNER JOIN CPD T ON M.ID_TEMA = T.ID
				INNER JOIN TC_TIPO_NIVEL TN ON N.ID_NIVEL = TN.ID]]></query>
