	<subDataset name="grupo1" uuid="fe8882a8-b08d-4ed0-a076-b03fcddcf842">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="LENOVO PRUEBAS"/>
		<queryString language="SQL">
			<![CDATA[SELECT TI.PRINCIPAL,
       TI.GRUPO,
       TI.LETRA,
       TI.SCTA,
       TI.CONCEPTO,
       TI.ESTIMADO,
       TI.DEVENGADO,
       TI.RECAUDADO
    FROM(
SELECT 1 PRINCIPAL,
       1 GRUPO,
       'A' LETRA,
       400||SUBSTR(T3.SCTA,1,1) SCTA, 'Ingresos de Libre Disposición' CONCEPTO, SUM(T3.ESTIMADO) ESTIMADO,  
SUM(T3.DEVENGADO) DEVENGADO, SUM(T3.RECAUDADO) RECAUDADO
FROM
(SELECT T1.CUENTA, T1.SCTA, T1.SSCTA, T1.SSSCTA, T1.SSSSCTA, T1.NOMCTA , (T2.AUTOI_1 + T2.AUTOI_2 + T2.AUTOI_3) ESTIMADO, 
DECODE(T1.CUENTA,'8110',(CARGOS_1 + CARGOS_2 + CARGOS_3 + CARGOS_4 + CARGOS_5 + CARGOS_6 - ABONOS_1 - ABONOS_2 - ABONOS_3 - ABONOS_4 - ABONOS_5 - ABONOS_6),0.0) AMPLIACIONES,
DECODE(T1.CUENTA,'8140',(CARGOS_1 + CARGOS_2 + CARGOS_3 + CARGOS_4 + CARGOS_5 + CARGOS_6 - ABONOS_1 - ABONOS_2 - ABONOS_3 - ABONOS_4 - ABONOS_5 - ABONOS_6),0.0) DEVENGADO,
DECODE(T1.CUENTA,'8150',(ABONOS_1 + ABONOS_2 + ABONOS_3 + ABONOS_4 + ABONOS_5 + ABONOS_6 - CARGOS_1 - CARGOS_2 - CARGOS_3 - CARGOS_4 - CARGOS_5 - CARGOS_6),0.0) RECAUDADO
FROM CUENTA T1 
LEFT JOIN INGRESO T2
ON T1.CUENTA = T2.CUENTA 
AND T1.SCTA = T2.SCTA
AND T1.SSCTA = T2.SSCTA
AND T1.SSSCTA = T2.SSSCTA
AND T1.SSSSCTA = T2.SSSSCTA
WHERE 
T1.CUENTA IN ('8110','8140','8150')
AND 
( ( SUBSTR(T1.SCTA,7,2)='41' AND T1.SSSSCTA = ''
    AND T1.SSSCTA = ''
    AND T1.SCTA <> ''
    AND SUBSTR(T1.SCTA,9,1) <> '0'
    AND SUBSTR(T1.SCTA,10,1) = '0'
   )  OR
   ( (SUBSTR(T1.SCTA,7,4) ='4211' 
     AND T1.SSCTA = ''
     )
     OR (SUBSTR(T1.SCTA,7,4)='4214' AND T1.SSCTA='000000000000003' AND T1.SSSCTA='0001' AND T1.SSSSCTA='001')
     OR (SUBSTR(T1.SCTA,7,4)='4214' AND T1.SSCTA='000000000000001' AND T1.SSSCTA='0001' AND T1.SSSSCTA='001')
     OR (SUBSTR(T1.SCTA,7,4)='4214' AND T1.SSCTA='000000000000001' AND T1.SSSCTA='0003' AND T1.SSSSCTA='')
     OR (SUBSTR(T1.SCTA,7,4)='4214' AND T1.SSCTA='000000000000001' AND T1.SSSCTA='0002' AND T1.SSSSCTA='')
   ) 
   
OR (SUBSTR(T1.SCTA,7,4)='4399' AND T1.SSCTA='000000000000003' AND T1.SSSCTA='0001' AND T1.SSSSCTA='001')
)
) T3
GROUP BY SUBSTR(T3.SCTA,1,1)
UNION ALL
SELECT 1 PRINCIPAL,
       1 GRUPO,
       'A' LETRA,
       '4'||SUBSTR(T3.SCTA,1,1)||'01' SCTA, 'Transferencias Federales Etiquetadas' CONCEPTO,
      SUM(T3.ESTIMADO) ESTIMADO,  
SUM(T3.DEVENGADO) DEVENGADO, SUM(T3.RECAUDADO) RECAUDADO
FROM
(SELECT T1.CUENTA, T1.SCTA, T1.SSCTA, T1.SSSCTA, T1.SSSSCTA, T1.NOMCTA , (T2.AUTOI_1 + T2.AUTOI_2 + T2.AUTOI_3) ESTIMADO, 
DECODE(T1.CUENTA,'8110',(CARGOS_1 + CARGOS_2 + CARGOS_3 + CARGOS_4 + CARGOS_5 + CARGOS_6 - ABONOS_1 - ABONOS_2 - ABONOS_3 - ABONOS_4 - ABONOS_5 - ABONOS_6),0.0) AMPLIACIONES,
DECODE(T1.CUENTA,'8140',(CARGOS_1 + CARGOS_2 + CARGOS_3 + CARGOS_4 + CARGOS_5 + CARGOS_6 - ABONOS_1 - ABONOS_2 - ABONOS_3 - ABONOS_4 - ABONOS_5 - ABONOS_6),0.0) DEVENGADO,
DECODE(T1.CUENTA,'8150',(ABONOS_1 + ABONOS_2 + ABONOS_3 + ABONOS_4 + ABONOS_5 + ABONOS_6 - CARGOS_1 - CARGOS_2 - CARGOS_3 - CARGOS_4 - CARGOS_5 - CARGOS_6),0.0) RECAUDADO
FROM CUENTA T1 
LEFT JOIN INGRESO T2
ON T1.CUENTA = T2.CUENTA 
AND T1.SCTA = T2.SCTA
AND T1.SSCTA = T2.SSCTA
AND T1.SSSCTA = T2.SSSCTA
AND T1.SSSSCTA = T2.SSSSCTA
WHERE 
T1.CUENTA IN ('8110','8140','8150')
AND 
( ( SUBSTR(T1.SCTA,7,4) = '4212' AND T1.SSCTA = '' )  
   OR
   ( SUBSTR(T1.SCTA,7,4) = '4213'  AND T1.SSCTA = '000000000000001' AND T1.SSSCTA = '0001' AND T1.SSSSCTA = '') 
   OR 
(SUBSTR(T1.SCTA,7,4) IN ('4213','4223') 
AND T1.SSCTA <> ''
AND T1.SSSCTA <> ''
AND T1.SSSSCTA <> ''
AND T1.SCTA||T1.SSCTA <> '0000004213000000000000001')
)
) T3
GROUP BY SUBSTR(T3.SCTA,1,1)
UNION ALL
SELECT 1 PRINCIPAL,
       1 GRUPO,
       'A' LETRA,
   '4002' SCTA,
'Financiamiento' CONCEPTO, SUM(T5.ESTIMADO), SUM(T5.DEVENGADO), SUM (T5.RECAUDADO) FROM
(SELECT T3.SCTA,
SUM(T3.ESTIMADO) ESTIMADO,   
SUM(T3.DEVENGADO) DEVENGADO, SUM(T3.RECAUDADO) RECAUDADO
FROM
(SELECT T1.CUENTA, T1.SCTA, T1.SSCTA, T1.SSSCTA, T1.SSSSCTA, T1.NOMCTA , (T2.AUTOI_1 + T2.AUTOI_2 + T2.AUTOI_3) ESTIMADO,
DECODE(T1.CUENTA,'8140',(  ABONOS_1 + ABONOS_2 + ABONOS_3 + ABONOS_4 + ABONOS_5 + ABONOS_6 - CARGOS_1 - CARGOS_2 - CARGOS_3 - CARGOS_4 - CARGOS_5 - CARGOS_6),0.0) DEVENGADO,
DECODE(T1.CUENTA,'8150',(  ABONOS_1 + ABONOS_2 + ABONOS_3 + ABONOS_4 + ABONOS_5 + ABONOS_6 - CARGOS_1 - CARGOS_2 - CARGOS_3 - CARGOS_4 - CARGOS_5 - CARGOS_6),0.0) RECAUDADO

FROM CUENTA T1 
LEFT JOIN INGRESO T2
ON T1.CUENTA = T2.CUENTA 
AND T1.SCTA = T2.SCTA
AND T1.SSCTA = T2.SSCTA
AND T1.SSSCTA = T2.SSSCTA
AND T1.SSSSCTA = T2.SSSSCTA
WHERE 
T1.CUENTA IN ('8110','8140','8150')
AND SUBSTR(T1.SCTA,7,4) = ('4399') 
AND T1.SSCTA = '000000000000003'
AND T1.SSSCTA = '0002'
AND T1.SSSSCTA = '') T3
GROUP BY T3.SCTA
UNION 
SELECT 
-- SE CONVIERTE A NEGATIVO PARA QUE LA UNION SE RESTE -- 

DECODE(SUBSTR(T5.CLVFTE,1,1),'1','ETIQUETADO', 'NO_ETIQUETADO') ,
SUM(- T5.ESTIMADO) ESTIMADO, SUM(- T5.DEVENGADO) DEVENGADO, SUM(- T5.RECAUDADO) RECAUDADO FROM
(SELECT T4.FTE, F.CLVFTE, T4.ESTIMADO, T4.DEVENGADO, T4.RECAUDADO FROM
(SELECT SUBSTR(T3.SSCTA,13,3) FTE, SUM(T3.ESTIMADO) ESTIMADO ,SUM(T3.DEVENGADO) DEVENGADO, SUM(T3.RECAUDADO) RECAUDADO FROM
(SELECT T2.SCTA, T2.SSCTA, SUM(T2.ESTIMADO) ESTIMADO ,SUM(T2.DEVENGADO) DEVENGADO, SUM(T2.RECAUDADO) RECAUDADO FROM
(SELECT T1.CUENTA, T1.SCTA, T1.SSCTA, T1.NOMCTA ,T1.SALINI ESTIMADO, 
DECODE(SUBSTR(T1.CUENTA,1,3),'825',(T1.CARGOS_1 + CARGOS_2 + CARGOS_3 + CARGOS_4 + CARGOS_5 + CARGOS_6 - ABONOS_1 - ABONOS_2 - ABONOS_3 - ABONOS_4 - ABONOS_5 - ABONOS_6),0.0) DEVENGADO,
DECODE(SUBSTR(T1.CUENTA,1,3),'827',(T1.CARGOS_1 + CARGOS_2 + CARGOS_3 + CARGOS_4 + CARGOS_5 + CARGOS_6 - ABONOS_1 - ABONOS_2 - ABONOS_3 - ABONOS_4 - ABONOS_5 - ABONOS_6),0.0) RECAUDADO
FROM CUENTA T1 

WHERE T1.SSCTA<>'' AND T1.SSSCTA <> '' AND 
SUBSTR(T1.CUENTA,1,3) IN ('821','825','827')
AND SUBSTR(T1.SSSCTA,1,2) = '91'
) T2 GROUP BY T2.SCTA, T2.SSCTA ) T3 GROUP BY SUBSTR(T3.SSCTA,13,3)
) T4 LEFT JOIN FUENTEF F ON F.LIGA=T4.FTE WHERE F.NIVFTE=4
) T5 GROUP BY SUBSTR(T5.CLVFTE,1,1)) T5

/*****/
UNION ALL

SELECT 1 PRINCIPAL,
       2 GRUPO,
       'B' LETRA,
       ''SCTA, 
       
DECODE(SUBSTR(T5.CLVFTE,1,1),'1','Gasto Etiquetado(sin Incluir Amortización de la Deuda)', 'Gasto No Etiqueta (Sin Incluir Amortización de la Deuda Pública)') CONCEPTO,
SUM(T5.ESTIMADO) ESTIMADO, SUM(T5.DEVENGADO) DEVENGADO, SUM(T5.RECAUDADO) RECAUDADO FROM
(SELECT T4.FTE, F.CLVFTE, T4.ESTIMADO, T4.DEVENGADO, T4.RECAUDADO FROM
(SELECT SUBSTR(T3.SSCTA,13,3) FTE, SUM(T3.ESTIMADO) ESTIMADO ,SUM(T3.DEVENGADO) DEVENGADO, SUM(T3.RECAUDADO) RECAUDADO FROM
(SELECT T2.SCTA, T2.SSCTA, SUM(T2.ESTIMADO) ESTIMADO ,SUM(T2.DEVENGADO) DEVENGADO, SUM(T2.RECAUDADO) RECAUDADO FROM
(SELECT T1.CUENTA, T1.SCTA, T1.SSCTA, T1.SSSCTA, T1.NOMCTA ,T1.SALINI ESTIMADO, 
DECODE(SUBSTR(T1.CUENTA,1,3),'825',(T1.CARGOS_1 + CARGOS_2 + CARGOS_3 + CARGOS_4 + CARGOS_5 + CARGOS_6 - ABONOS_1 - ABONOS_2 - ABONOS_3 - ABONOS_4 - ABONOS_5 - ABONOS_6),0.0) DEVENGADO,
DECODE(SUBSTR(T1.CUENTA,1,3),'827',(T1.CARGOS_1 + CARGOS_2 + CARGOS_3 + CARGOS_4 + CARGOS_5 + CARGOS_6 - ABONOS_1 - ABONOS_2 - ABONOS_3 - ABONOS_4 - ABONOS_5 - ABONOS_6),0.0) RECAUDADO
FROM CUENTA T1 WHERE T1.SSCTA<>'' AND T1.SSSCTA<>'' AND
SUBSTR(T1.CUENTA,1,3) IN ('821','825','827') AND SUBSTR(T1.SSSCTA,1,2)<>'91'
) T2 GROUP BY T2.SCTA, T2.SSCTA ) T3 GROUP BY SUBSTR(T3.SSCTA,13,3)
) T4 LEFT JOIN FUENTEF F ON F.LIGA=T4.FTE WHERE F.NIVFTE=4
) T5 GROUP BY SUBSTR(T5.CLVFTE,1,1)
UNION ALL
SELECT 1 PRINCIPAL,
       3 GRUPO,
       'C' LETRA,
       '1' SCTA,
       'Remanente de Ingresos de LIbre Disposición aplicado en el Periodo' CONCEPTO,
       0.00 ESTIMADO,
       0.00 DEVEGENADO,
       0.00 RECAUDADO
     FROM SYSIBM.SYSDUMMY1
UNION ALL
SELECT 1 PRINCIPAL,
       4 GRUPO,
       'C' LETRA,
       '2' SCTA,
       'Remanente de Transferencias Federales Etiquetadas Aplicados en el Periodo' CONCEPTO,
       0.00 ESTIMADO,
       0.00 DEVEGENADO,
       0.00 RECAUDADO
     FROM SYSIBM.SYSDUMMY1

    ) TI
ORDER BY TI.PRINCIPAL, TI.GRUPO, TI.SCTA ASC]]>
		</queryString>
		<field name="PRINCIPAL" class="java.lang.Integer">
			<property name="com.jaspersoft.studio.field.name" value="PRINCIPAL"/>
			<property name="com.jaspersoft.studio.field.label" value="PRINCIPAL"/>
		</field>
		<field name="GRUPO" class="java.lang.Integer">
			<property name="com.jaspersoft.studio.field.name" value="GRUPO"/>
			<property name="com.jaspersoft.studio.field.label" value="GRUPO"/>
		</field>
		<field name="LETRA" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="LETRA"/>
			<property name="com.jaspersoft.studio.field.label" value="LETRA"/>
		</field>
		<field name="SCTA" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="SCTA"/>
			<property name="com.jaspersoft.studio.field.label" value="SCTA"/>
		</field>
		<field name="CONCEPTO" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="CONCEPTO"/>
			<property name="com.jaspersoft.studio.field.label" value="CONCEPTO"/>
		</field>
		<field name="ESTIMADO" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="ESTIMADO"/>
			<property name="com.jaspersoft.studio.field.label" value="ESTIMADO"/>
		</field>
		<field name="DEVENGADO" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="DEVENGADO"/>
			<property name="com.jaspersoft.studio.field.label" value="DEVENGADO"/>
		</field>
		<field name="RECAUDADO" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="RECAUDADO"/>
			<property name="com.jaspersoft.studio.field.label" value="RECAUDADO"/>
		</field>
		<variable name="totalEstimado" class="java.math.BigDecimal" resetType="Group" resetGroup="GRUPO" calculation="Sum">
			<variableExpression><![CDATA[$F{ESTIMADO}]]></variableExpression>
			<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
		</variable>
		<variable name="totalDevengado" class="java.math.BigDecimal" resetType="Group" resetGroup="GRUPO" calculation="Sum">
			<variableExpression><![CDATA[$F{DEVENGADO}]]></variableExpression>
			<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
		</variable>
		<variable name="totalPagado" class="java.math.BigDecimal" resetType="Group" resetGroup="GRUPO" calculation="Sum">
			<variableExpression><![CDATA[$F{RECAUDADO}]]></variableExpression>
			<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
		</variable>
		<variable name="contador" class="java.lang.Integer" resetType="Group" resetGroup="GRUPO" calculation="Count"/>
		<group name="PRINCIPAL">
			<groupExpression><![CDATA[$F{PRINCIPAL}]]></groupExpression>
		</group>
		<group name="GRUPO">
			<groupExpression><![CDATA[$F{GRUPO}]]></groupExpression>
		</group>
	</subDataset>
	<subDataset name="gp1" uuid="044d1505-228f-4e72-9cb1-ec0dc6462d11">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="LENOVO PRUEBAS"/>
		<queryString language="SQL">
			<![CDATA[SELECT TI.PRINCIPAL,
       TI.GRUPO,
       TI.LETRA,
       TI.SCTA,
       TI.CONCEPTO,
       TI.ESTIMADO,
       TI.DEVENGADO,
       TI.RECAUDADO
    FROM(
SELECT 1 PRINCIPAL,
       1 GRUPO,
       'A' LETRA,
       400||SUBSTR(T3.SCTA,1,1) SCTA, 'Ingresos de Libre Disposición' CONCEPTO, SUM(T3.ESTIMADO) ESTIMADO,  
SUM(T3.DEVENGADO) DEVENGADO, SUM(T3.RECAUDADO) RECAUDADO
FROM
(SELECT T1.CUENTA, T1.SCTA, T1.SSCTA, T1.SSSCTA, T1.SSSSCTA, T1.NOMCTA , (T2.AUTOI_1 + T2.AUTOI_2 + T2.AUTOI_3) ESTIMADO, 
DECODE(T1.CUENTA,'8110',(CARGOS_1 + CARGOS_2 + CARGOS_3 + CARGOS_4 + CARGOS_5 + CARGOS_6 - ABONOS_1 - ABONOS_2 - ABONOS_3 - ABONOS_4 - ABONOS_5 - ABONOS_6),0.0) AMPLIACIONES,
DECODE(T1.CUENTA,'8140',(CARGOS_1 + CARGOS_2 + CARGOS_3 + CARGOS_4 + CARGOS_5 + CARGOS_6 - ABONOS_1 - ABONOS_2 - ABONOS_3 - ABONOS_4 - ABONOS_5 - ABONOS_6),0.0) DEVENGADO,
DECODE(T1.CUENTA,'8150',(ABONOS_1 + ABONOS_2 + ABONOS_3 + ABONOS_4 + ABONOS_5 + ABONOS_6 - CARGOS_1 - CARGOS_2 - CARGOS_3 - CARGOS_4 - CARGOS_5 - CARGOS_6),0.0) RECAUDADO
FROM CUENTA T1 
LEFT JOIN INGRESO T2
ON T1.CUENTA = T2.CUENTA 
AND T1.SCTA = T2.SCTA
AND T1.SSCTA = T2.SSCTA
AND T1.SSSCTA = T2.SSSCTA
AND T1.SSSSCTA = T2.SSSSCTA
WHERE 
T1.CUENTA IN ('8110','8140','8150')
AND 
( ( SUBSTR(T1.SCTA,7,2)='41' AND T1.SSSSCTA = ''
    AND T1.SSSCTA = ''
    AND T1.SCTA <> ''
    AND SUBSTR(T1.SCTA,9,1) <> '0'
    AND SUBSTR(T1.SCTA,10,1) = '0'
   )  OR
   ( (SUBSTR(T1.SCTA,7,4) ='4211' 
     AND T1.SSCTA = ''
     )
     OR (SUBSTR(T1.SCTA,7,4)='4214' AND T1.SSCTA='000000000000003' AND T1.SSSCTA='0001' AND T1.SSSSCTA='001')
     OR (SUBSTR(T1.SCTA,7,4)='4214' AND T1.SSCTA='000000000000001' AND T1.SSSCTA='0001' AND T1.SSSSCTA='001')
     OR (SUBSTR(T1.SCTA,7,4)='4214' AND T1.SSCTA='000000000000001' AND T1.SSSCTA='0003' AND T1.SSSSCTA='')
     OR (SUBSTR(T1.SCTA,7,4)='4214' AND T1.SSCTA='000000000000001' AND T1.SSSCTA='0002' AND T1.SSSSCTA='')
   ) 
   
OR (SUBSTR(T1.SCTA,7,4)='4399' AND T1.SSCTA='000000000000003' AND T1.SSSCTA='0001' AND T1.SSSSCTA='001')
)
) T3
GROUP BY SUBSTR(T3.SCTA,1,1)
UNION ALL
SELECT 1 PRINCIPAL,
       1 GRUPO,
       'A' LETRA,
       '4'||SUBSTR(T3.SCTA,1,1)||'01' SCTA, 'Transferencias Federales Etiquetadas' CONCEPTO,
      SUM(T3.ESTIMADO) ESTIMADO,  
SUM(T3.DEVENGADO) DEVENGADO, SUM(T3.RECAUDADO) RECAUDADO
FROM
(SELECT T1.CUENTA, T1.SCTA, T1.SSCTA, T1.SSSCTA, T1.SSSSCTA, T1.NOMCTA , (T2.AUTOI_1 + T2.AUTOI_2 + T2.AUTOI_3) ESTIMADO, 
DECODE(T1.CUENTA,'8110',(CARGOS_1 + CARGOS_2 + CARGOS_3 + CARGOS_4 + CARGOS_5 + CARGOS_6 - ABONOS_1 - ABONOS_2 - ABONOS_3 - ABONOS_4 - ABONOS_5 - ABONOS_6),0.0) AMPLIACIONES,
DECODE(T1.CUENTA,'8140',(CARGOS_1 + CARGOS_2 + CARGOS_3 + CARGOS_4 + CARGOS_5 + CARGOS_6 - ABONOS_1 - ABONOS_2 - ABONOS_3 - ABONOS_4 - ABONOS_5 - ABONOS_6),0.0) DEVENGADO,
DECODE(T1.CUENTA,'8150',(ABONOS_1 + ABONOS_2 + ABONOS_3 + ABONOS_4 + ABONOS_5 + ABONOS_6 - CARGOS_1 - CARGOS_2 - CARGOS_3 - CARGOS_4 - CARGOS_5 - CARGOS_6),0.0) RECAUDADO
FROM CUENTA T1 
LEFT JOIN INGRESO T2
ON T1.CUENTA = T2.CUENTA 
AND T1.SCTA = T2.SCTA
AND T1.SSCTA = T2.SSCTA
AND T1.SSSCTA = T2.SSSCTA
AND T1.SSSSCTA = T2.SSSSCTA
WHERE 
T1.CUENTA IN ('8110','8140','8150')
AND 
( ( SUBSTR(T1.SCTA,7,4) = '4212' AND T1.SSCTA = '' )  
   OR
   ( SUBSTR(T1.SCTA,7,4) = '4213'  AND T1.SSCTA = '000000000000001' AND T1.SSSCTA = '0001' AND T1.SSSSCTA = '') 
   OR 
(SUBSTR(T1.SCTA,7,4) IN ('4213','4223') 
AND T1.SSCTA <> ''
AND T1.SSSCTA <> ''
AND T1.SSSSCTA <> ''
AND T1.SCTA||T1.SSCTA <> '0000004213000000000000001')
)
) T3
GROUP BY SUBSTR(T3.SCTA,1,1)
UNION ALL
SELECT 1 PRINCIPAL,
       1 GRUPO,
       'A' LETRA,
   '4002' SCTA,
'Financiamiento' CONCEPTO, SUM(T5.ESTIMADO), SUM(T5.DEVENGADO), SUM (T5.RECAUDADO) FROM
(SELECT T3.SCTA,
SUM(T3.ESTIMADO) ESTIMADO,   
SUM(T3.DEVENGADO) DEVENGADO, SUM(T3.RECAUDADO) RECAUDADO
FROM
(SELECT T1.CUENTA, T1.SCTA, T1.SSCTA, T1.SSSCTA, T1.SSSSCTA, T1.NOMCTA , (T2.AUTOI_1 + T2.AUTOI_2 + T2.AUTOI_3) ESTIMADO,
DECODE(T1.CUENTA,'8140',(  ABONOS_1 + ABONOS_2 + ABONOS_3 + ABONOS_4 + ABONOS_5 + ABONOS_6 - CARGOS_1 - CARGOS_2 - CARGOS_3 - CARGOS_4 - CARGOS_5 - CARGOS_6),0.0) DEVENGADO,
DECODE(T1.CUENTA,'8150',(  ABONOS_1 + ABONOS_2 + ABONOS_3 + ABONOS_4 + ABONOS_5 + ABONOS_6 - CARGOS_1 - CARGOS_2 - CARGOS_3 - CARGOS_4 - CARGOS_5 - CARGOS_6),0.0) RECAUDADO

FROM CUENTA T1 
LEFT JOIN INGRESO T2
ON T1.CUENTA = T2.CUENTA 
AND T1.SCTA = T2.SCTA
AND T1.SSCTA = T2.SSCTA
AND T1.SSSCTA = T2.SSSCTA
AND T1.SSSSCTA = T2.SSSSCTA
WHERE 
T1.CUENTA IN ('8110','8140','8150')
AND SUBSTR(T1.SCTA,7,4) = ('4399') 
AND T1.SSCTA = '000000000000003'
AND T1.SSSCTA = '0002'
AND T1.SSSSCTA = '') T3
GROUP BY T3.SCTA
UNION 
SELECT 
-- SE CONVIERTE A NEGATIVO PARA QUE LA UNION SE RESTE -- 

DECODE(SUBSTR(T5.CLVFTE,1,1),'1','ETIQUETADO', 'NO_ETIQUETADO') ,
SUM(- T5.ESTIMADO) ESTIMADO, SUM(- T5.DEVENGADO) DEVENGADO, SUM(- T5.RECAUDADO) RECAUDADO FROM
(SELECT T4.FTE, F.CLVFTE, T4.ESTIMADO, T4.DEVENGADO, T4.RECAUDADO FROM
(SELECT SUBSTR(T3.SSCTA,13,3) FTE, SUM(T3.ESTIMADO) ESTIMADO ,SUM(T3.DEVENGADO) DEVENGADO, SUM(T3.RECAUDADO) RECAUDADO FROM
(SELECT T2.SCTA, T2.SSCTA, SUM(T2.ESTIMADO) ESTIMADO ,SUM(T2.DEVENGADO) DEVENGADO, SUM(T2.RECAUDADO) RECAUDADO FROM
(SELECT T1.CUENTA, T1.SCTA, T1.SSCTA, T1.NOMCTA ,T1.SALINI ESTIMADO, 
DECODE(SUBSTR(T1.CUENTA,1,3),'825',(T1.CARGOS_1 + CARGOS_2 + CARGOS_3 + CARGOS_4 + CARGOS_5 + CARGOS_6 - ABONOS_1 - ABONOS_2 - ABONOS_3 - ABONOS_4 - ABONOS_5 - ABONOS_6),0.0) DEVENGADO,
DECODE(SUBSTR(T1.CUENTA,1,3),'827',(T1.CARGOS_1 + CARGOS_2 + CARGOS_3 + CARGOS_4 + CARGOS_5 + CARGOS_6 - ABONOS_1 - ABONOS_2 - ABONOS_3 - ABONOS_4 - ABONOS_5 - ABONOS_6),0.0) RECAUDADO
FROM CUENTA T1 

WHERE T1.SSCTA<>'' AND T1.SSSCTA <> '' AND 
SUBSTR(T1.CUENTA,1,3) IN ('821','825','827')
AND SUBSTR(T1.SSSCTA,1,2) = '91'
) T2 GROUP BY T2.SCTA, T2.SSCTA ) T3 GROUP BY SUBSTR(T3.SSCTA,13,3)
) T4 LEFT JOIN FUENTEF F ON F.LIGA=T4.FTE WHERE F.NIVFTE=4
) T5 GROUP BY SUBSTR(T5.CLVFTE,1,1)) T5

/*****/
UNION ALL

SELECT 1 PRINCIPAL,
       2 GRUPO,
       'B' LETRA,
       ''SCTA, 
       
DECODE(SUBSTR(T5.CLVFTE,1,1),'1','Gasto Etiquetado(sin Incluir Amortización de la Deuda)', 'Gasto No Etiqueta (Sin Incluir Amortización de la Deuda Pública)') CONCEPTO,
SUM(T5.ESTIMADO) ESTIMADO, SUM(T5.DEVENGADO) DEVENGADO, SUM(T5.RECAUDADO) RECAUDADO FROM
(SELECT T4.FTE, F.CLVFTE, T4.ESTIMADO, T4.DEVENGADO, T4.RECAUDADO FROM
(SELECT SUBSTR(T3.SSCTA,13,3) FTE, SUM(T3.ESTIMADO) ESTIMADO ,SUM(T3.DEVENGADO) DEVENGADO, SUM(T3.RECAUDADO) RECAUDADO FROM
(SELECT T2.SCTA, T2.SSCTA, SUM(T2.ESTIMADO) ESTIMADO ,SUM(T2.DEVENGADO) DEVENGADO, SUM(T2.RECAUDADO) RECAUDADO FROM
(SELECT T1.CUENTA, T1.SCTA, T1.SSCTA, T1.SSSCTA, T1.NOMCTA ,T1.SALINI ESTIMADO, 
DECODE(SUBSTR(T1.CUENTA,1,3),'825',(T1.CARGOS_1 + CARGOS_2 + CARGOS_3 + CARGOS_4 + CARGOS_5 + CARGOS_6 - ABONOS_1 - ABONOS_2 - ABONOS_3 - ABONOS_4 - ABONOS_5 - ABONOS_6),0.0) DEVENGADO,
DECODE(SUBSTR(T1.CUENTA,1,3),'827',(T1.CARGOS_1 + CARGOS_2 + CARGOS_3 + CARGOS_4 + CARGOS_5 + CARGOS_6 - ABONOS_1 - ABONOS_2 - ABONOS_3 - ABONOS_4 - ABONOS_5 - ABONOS_6),0.0) RECAUDADO
FROM CUENTA T1 WHERE T1.SSCTA<>'' AND T1.SSSCTA<>'' AND
SUBSTR(T1.CUENTA,1,3) IN ('821','825','827') AND SUBSTR(T1.SSSCTA,1,2)<>'91'
) T2 GROUP BY T2.SCTA, T2.SSCTA ) T3 GROUP BY SUBSTR(T3.SSCTA,13,3)
) T4 LEFT JOIN FUENTEF F ON F.LIGA=T4.FTE WHERE F.NIVFTE=4
) T5 GROUP BY SUBSTR(T5.CLVFTE,1,1)
UNION ALL
SELECT 1 PRINCIPAL,
       3 GRUPO,
       'C' LETRA,
       '1' SCTA,
       'Remanente de Ingresos de LIbre Disposición aplicado en el Periodo' CONCEPTO,
       0.00 ESTIMADO,
       0.00 DEVEGENADO,
       0.00 RECAUDADO
     FROM SYSIBM.SYSDUMMY1
UNION ALL
SELECT 1 PRINCIPAL,
       3 GRUPO,
       'C' LETRA,
       '2' SCTA,
       'Remanente de Transferencias Federales Etiquetadas Aplicados en el Periodo' CONCEPTO,
       0.00 ESTIMADO,
       0.00 DEVEGENADO,
       0.00 RECAUDADO
     FROM SYSIBM.SYSDUMMY1

    ) TI
ORDER BY TI.PRINCIPAL, TI.GRUPO, TI.SCTA ASC]]>
		</queryString>
		<field name="PRINCIPAL" class="java.lang.Integer">
			<property name="com.jaspersoft.studio.field.name" value="PRINCIPAL"/>
			<property name="com.jaspersoft.studio.field.label" value="PRINCIPAL"/>
		</field>
		<field name="GRUPO" class="java.lang.Integer">
			<property name="com.jaspersoft.studio.field.name" value="GRUPO"/>
			<property name="com.jaspersoft.studio.field.label" value="GRUPO"/>
		</field>
		<field name="LETRA" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="LETRA"/>
			<property name="com.jaspersoft.studio.field.label" value="LETRA"/>
		</field>
		<field name="SCTA" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="SCTA"/>
			<property name="com.jaspersoft.studio.field.label" value="SCTA"/>
		</field>
		<field name="CONCEPTO" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="CONCEPTO"/>
			<property name="com.jaspersoft.studio.field.label" value="CONCEPTO"/>
		</field>
		<field name="ESTIMADO" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="ESTIMADO"/>
			<property name="com.jaspersoft.studio.field.label" value="ESTIMADO"/>
		</field>
		<field name="DEVENGADO" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="DEVENGADO"/>
			<property name="com.jaspersoft.studio.field.label" value="DEVENGADO"/>
		</field>
		<field name="RECAUDADO" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="RECAUDADO"/>
			<property name="com.jaspersoft.studio.field.label" value="RECAUDADO"/>
		</field>
		<variable name="totalEstimado" class="java.math.BigDecimal" resetType="Group" resetGroup="GRUPO" calculation="Sum">
			<variableExpression><![CDATA[$F{ESTIMADO}]]></variableExpression>
			<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
		</variable>
		<variable name="totalDevengado" class="java.math.BigDecimal" resetType="Group" resetGroup="GRUPO" calculation="Sum">
			<variableExpression><![CDATA[$F{DEVENGADO}]]></variableExpression>
			<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
		</variable>
		<variable name="totalRecaudado" class="java.math.BigDecimal" resetType="Group" resetGroup="GRUPO" calculation="Sum">
			<variableExpression><![CDATA[$F{RECAUDADO}]]></variableExpression>
			<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
		</variable>
		<variable name="contador" class="java.lang.Integer" resetType="Group" resetGroup="GRUPO" calculation="Count">
			<variableExpression><![CDATA[$F{LETRA}]]></variableExpression>
			<initialValueExpression><![CDATA[0]]></initialValueExpression>
		</variable>
		<variable name="totalAEstimado" class="java.math.BigDecimal" resetType="Group" resetGroup="GRUPO" calculation="Sum">
			<variableExpression><![CDATA[$F{GRUPO} == 1? $F{ESTIMADO}: BigDecimal.ZERO]]></variableExpression>
			<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
		</variable>
		<variable name="totalADevengado" class="java.math.BigDecimal" resetType="Group" resetGroup="GRUPO" calculation="Sum">
			<variableExpression><![CDATA[$F{GRUPO} == 1? $F{DEVENGADO}: BigDecimal.ZERO]]></variableExpression>
			<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
		</variable>
		<variable name="totalARecaudado" class="java.math.BigDecimal" resetType="Group" resetGroup="GRUPO" calculation="Sum">
			<variableExpression><![CDATA[$F{GRUPO} == 1? $F{RECAUDADO}: BigDecimal.ZERO]]></variableExpression>
			<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
		</variable>
		<variable name="totalBEstimado" class="java.math.BigDecimal" resetType="Group" resetGroup="GRUPO" calculation="Sum">
			<variableExpression><![CDATA[$F{GRUPO} == 2? $F{ESTIMADO}: BigDecimal.ZERO]]></variableExpression>
			<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
		</variable>
		<variable name="totalBDevengado" class="java.math.BigDecimal" resetType="Group" resetGroup="GRUPO" calculation="Sum">
			<variableExpression><![CDATA[$F{GRUPO} == 2? $F{DEVENGADO}: BigDecimal.ZERO]]></variableExpression>
			<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
		</variable>
		<variable name="totalBRecaudado" class="java.math.BigDecimal" resetType="Group" resetGroup="GRUPO" calculation="Sum">
			<variableExpression><![CDATA[$F{GRUPO} == 2? $F{RECAUDADO}: BigDecimal.ZERO]]></variableExpression>
			<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
		</variable>
		<variable name="totalCEstimado" class="java.math.BigDecimal" resetType="Group" resetGroup="GRUPO" calculation="Sum">
			<variableExpression><![CDATA[$F{GRUPO} == 3? $F{ESTIMADO}: BigDecimal.ZERO]]></variableExpression>
			<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
		</variable>
		<variable name="totalCDevengado" class="java.math.BigDecimal" resetType="Group" resetGroup="GRUPO" calculation="Sum">
			<variableExpression><![CDATA[$F{GRUPO} == 3? $F{DEVENGADO}: BigDecimal.ZERO]]></variableExpression>
			<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
		</variable>
		<variable name="totalCRecaudado" class="java.math.BigDecimal" resetType="Group" resetGroup="GRUPO" calculation="Sum">
			<variableExpression><![CDATA[$F{GRUPO} == 3? $F{RECAUDADO}: BigDecimal.ZERO]]></variableExpression>
			<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
		</variable>
		<variable name="totalA3Estimado" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{LETRA}.equals("A") && $V{contador}==3?$F{ESTIMADO}:BigDecimal.ZERO]]></variableExpression>
			<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
		</variable>
		<variable name="totalCEstimado2" class="java.math.BigDecimal" resetType="Group" resetGroup="GRUPO" calculation="Sum">
			<variableExpression><![CDATA[$F{GRUPO} == 3 ? $F{ESTIMADO} : BigDecimal.ZERO]]></variableExpression>
			<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
		</variable>
		<variable name="totalA3Devengado" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{LETRA}.equals("A") && $V{contador}==3?$F{DEVENGADO}:BigDecimal.ZERO]]></variableExpression>
			<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
		</variable>
		<variable name="totalCDevengado2" class="java.math.BigDecimal" resetType="Group" resetGroup="GRUPO" calculation="Sum">
			<variableExpression><![CDATA[$F{GRUPO} == 3 ?$F{DEVENGADO} : BigDecimal.ZERO]]></variableExpression>
			<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
		</variable>
		<group name="PRINCIPAL">
			<groupExpression><![CDATA[$F{PRINCIPAL}]]></groupExpression>
		</group>
		<group name="GRUPO">
			<groupExpression><![CDATA[$F{GRUPO}]]></groupExpression>
		</group>
