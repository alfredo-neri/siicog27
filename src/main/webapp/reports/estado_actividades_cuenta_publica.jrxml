	<group name="GRUPO">
		<expression><![CDATA[$F{GRUPO}]]></expression>
		<groupHeader>
			<band height="10">
				<element kind="textField" uuid="8cb834a4-9dc8-4545-a1bb-4c637655fa0f" x="0" y="0" width="353" height="10" stretchType="NoStretch" removeLineWhenBlank="true" fontSize="7.0" textAdjust="StretchHeight" evaluationTime="Group" bold="true" evaluationGroup="GRUPO">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
					<box>
						<leftPen lineWidth="1.0" lineStyle="Solid"/>
					</box>
					<expression><![CDATA[$F{GRUPO} == 1? " Ingresos de Gestion":$F{GRUPO} == 2 ? "Participaciones, Aportaciones, Convenios, Incentivos Derivados de la Colaboración Fiscal y Fondos Distintos de Aportaciones, Transferencias, Asignaciones, Subsicidios y Subvenciones, Perisones y Juvilaciones": $F{GRUPO} == 3 ?"Otros Ingresos y Beneficios" :$F{GRUPO} == 4 ? "Gastos de Funcionamiento":$F{GRUPO}==5? "Transferencias, Asignaciones , Subsidios y Otras Ayudas": $F{GRUPO} ==6 ? "Participaciones y Aportaciones": $F{GRUPO} == 7 ? "Intereses, Comisiones y Otros Gastos de la Deuda Pública": $F{GRUPO} == 8 ? "Otros Gastos y Pérdidas Extraordinarias":"Inversión Publica"]]></expression>
				</element>
				<element kind="textField" uuid="8222efed-5127-47d2-86c2-29572b26eeb7" x="353" y="0" width="100" height="10" stretchType="NoStretch" removeLineWhenBlank="true" fontSize="7.0" evaluationTime="Group" pattern="#,##0.0" bold="true" evaluationGroup="GRUPO" hTextAlign="Right">
					<box>
						<leftPen lineWidth="1.0" lineStyle="Solid"/>
						<rightPen lineWidth="1.0" lineStyle="Solid"/>
					</box>
					<expression><![CDATA[$V{subTotalIngreso}.compareTo(BigDecimal.ZERO) == 0 ? "" : $V{subTotalIngreso}]]></expression>
				</element>
				<element kind="textField" uuid="ec55e99b-6c72-4e6d-ac2e-29dafce0914c" x="453" y="0" width="100" height="10" stretchType="NoStretch" removeLineWhenBlank="true" fontSize="7.0" evaluationTime="Group" pattern="#,##0.0" bold="true" evaluationGroup="GRUPO" hTextAlign="Right">
					<box>
						<rightPen lineWidth="1.0" lineStyle="Solid"/>
					</box>
					<expression><![CDATA[$V{subTotalIngresoAnte}.compareTo(BigDecimal.ZERO) == 0 ? "" : $V{subTotalIngresoAnte}]]></expression>
				</element>
			</band>
		</groupHeader>
	</group>
