	<title height="91" splitType="Stretch">
		<element kind="image" uuid="0f7859fd-2686-4a12-9133-ada458761dbc" x="0" y="0" width="280" height="50" stretchType="NoStretch">
			<expression><![CDATA[$P{img1}]]></expression>
		</element>
		<element kind="staticText" uuid="b8d67c54-245a-43e5-9890-ce56ac353ab5" x="0" y="50" width="553" height="10" backcolor="#FFFFFF" mode="Opaque" stretchType="NoStretch" fontName="Arial" fontSize="7.0" bold="true" hTextAlign="Center">
			<property name="com.jaspersoft.studio.unit.height" value="px"/>
