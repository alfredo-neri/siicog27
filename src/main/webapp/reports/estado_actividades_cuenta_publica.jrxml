<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="estado_actividades_conac" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="dc61135e-00f2-49fb-a224-5c2b8538c17e">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="LENOVO PRUEBAS"/>
	<parameter name="img1" class="java.lang.String"/>
	<parameter name="img2" class="java.lang.String"/>
	<parameter name="sSql" class="java.lang.String"/>
	<parameter name="lastDay" class="java.lang.Integer"/>
	<parameter name="month" class="java.lang.String"/>
	<parameter name="year" class="java.lang.Integer"/>
	<parameter name="monthAnt" class="java.lang.String"/>
	<parameter name="monthAct" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT 1 PRINCIPAL,         1 GRUPO,         CU.CUENTA,         
FN_GET_NOMBRE_CUENTA(CU.CUENTA, CU.NOMCTA) NOMCTA,         
 0 SALDO_ANT,         
 0 SALDO_ACT      
 FROM CUENTA CU  WHERE CU.CUENTA IN ('4110', '4122', '4131', '4140', '4160', '4170')  
 UNION ALL  SELECT 1 PRINCIPAL,         DECODE(SUBSTR(T1.CUENTA,1,2), '42', 2, 3) GRUPO,         T1.CUENTA,         T1.NOMCTA,         
 T1.SALINI_ANT + ABONOS_ANT - CARGOS_ANT SALDO_ANT,         
 T1.SALINI + ABONOS - CARGOS SALDO_ACT       
 FROM (  SELECT CU.CUENTA,         FN_GET_NOMBRE_CUENTA(CU.CUENTA, CU.NOMCTA) NOMCTA,         CU.SALINI,CA.SALINI SALINI_ANT,  
 CA.CARGOS_1 + CA.CARGOS_2 + CA.CARGOS_3 + CA.CARGOS_4 + CA.CARGOS_5 + CA.CARGOS_6 + CA.CARGOS_7 + CA.CARGOS_8 + CA.CARGOS_9 + CA.CARGOS_10 + CA.CARGOS_11 + CA.CARGOS_12 CARGOS_ANT,     
 CA.ABONOS_1 + CA.ABONOS_2 + CA.ABONOS_3 + CA.ABONOS_4 + CA.ABONOS_5 + CA.ABONOS_6 + CA.ABONOS_7 + CA.ABONOS_8 + CA.ABONOS_9 + CA.ABONOS_10 + CA.ABONOS_11 + CA.ABONOS_12 ABONOS_ANT,     
 CU.CARGOS_1 + CU.CARGOS_2 + CU.CARGOS_3 + CU.CARGOS_4 + CU.CARGOS_5 + CU.CARGOS_6 + CU.CARGOS_7 + CU.CARGOS_8 + CU.CARGOS_9 + CU.CARGOS_10 + CU.CARGOS_11 + CU.CARGOS_12 CARGOS,     
 CU.ABONOS_1 + CU.ABONOS_2 + CU.ABONOS_3 + CU.ABONOS_4 + CU.ABONOS_5 + CU.ABONOS_6 + CU.ABONOS_7 + CU.ABONOS_8 + CU.ABONOS_9 + CU.ABONOS_10 + CU.ABONOS_11 + CU.ABONOS_12 ABONOS     
 FROM CUENTA CU ,CUENTA_ANTERIOR CA  WHERE CU.CUENTA = CA.CUENTA AND CU.CUENTA IN ('4210', '4220','4310', '4320', '4330', '4340', '4390')  ) T1  
 UNION ALL  SELECT 2 PRINCIPAL,         4 GRUPO,         T1.CUENTA,         T1.NOMCTA,         
 SUM(T1.SALINI_ANT + CARGOS_ANT - ABONOS_ANT) SALDO_ANT,         
 SUM(T1.SALINI + CARGOS - ABONOS) SALDO_ACT       
 FROM (  SELECT NA.CLVGAS CUENTA,         NA.NOMGAS NOMCTA,         CU.SALINI,CA.SALINI SALINI_ANT,  
 CA.CARGOS_1 + CA.CARGOS_2 + CA.CARGOS_3 + CA.CARGOS_4 + CA.CARGOS_5 + CA.CARGOS_6 + CA.CARGOS_7 + CA.CARGOS_8 + CA.CARGOS_9 + CA.CARGOS_10 + CA.CARGOS_11 + CA.CARGOS_12 CARGOS_ANT,     
 CA.ABONOS_1 + CA.ABONOS_2 + CA.ABONOS_3 + CA.ABONOS_4 + CA.ABONOS_5 + CA.ABONOS_6 + CA.ABONOS_7 + CA.ABONOS_8 + CA.ABONOS_9 + CA.ABONOS_10 + CA.ABONOS_11 + CA.ABONOS_12 ABONOS_ANT,    
 CU.CARGOS_1 + CU.CARGOS_2 + CU.CARGOS_3 + CU.CARGOS_4 + CU.CARGOS_5 + CU.CARGOS_6 + CU.CARGOS_7 + CU.CARGOS_8 + CU.CARGOS_9 + CU.CARGOS_10 + CU.CARGOS_11 + CU.CARGOS_12 CARGOS,     
 CU.ABONOS_1 + CU.ABONOS_2 + CU.ABONOS_3 + CU.ABONOS_4 + CU.ABONOS_5 + CU.ABONOS_6 + CU.ABONOS_7 + CU.ABONOS_8 + CU.ABONOS_9 + CU.ABONOS_10 + CU.ABONOS_11 + CU.ABONOS_12 ABONOS       
 FROM CUENTA CU   ,CUENTA_ANTERIOR CA         
 LEFT JOIN NATGAS NA ON NA.CLVGAS = SUBSTR(CU.SSSCTA, 1,	1)||'000'  WHERE CU.CUENTA = CA.CUENTA AND CU.CUENTA   = '5100'   AND SUBSTR(NA.CLVGAS,2,3) = '000'   ) T1   GROUP BY 1, 2, T1.CUENTA, T1.NOMCTA  
 UNION ALL  
 SELECT 2 PRINCIPAL,         5 GRUPO,         NA.CLVGAS CUENTA,         NA.NOMGAS NOMCTA,         0 SALDO_ANT,         0 SALDO_ACT       FROM NATGAS NA  WHERE NA.CLVGAS IN ('4100', '4200', '4300', '4500', '4600', '4700', '4800', '4900')  
 UNION ALL         
 SELECT 2 PRINCIPAL,         5 GRUPO,         T1.CUENTA,         T1.NOMCTA,         
 SUM(T1.SALINI_ANT + CARGOS_ANT - ABONOS_ANT) SALDO_ANT,         
 SUM(T1.SALINI + CARGOS - ABONOS) SALDO_ACT       FROM 
 (  SELECT '4400' CUENTA,         'Ayudas Sociales' NOMCTA,         CU.SALINI, CA.SALINI SALINI_ANT,  
 CA.CARGOS_1 + CA.CARGOS_2 + CA.CARGOS_3 + CA.CARGOS_4 + CA.CARGOS_5 + CA.CARGOS_6 + CA.CARGOS_7 + CA.CARGOS_8 + CA.CARGOS_9 + CA.CARGOS_10 + CA.CARGOS_11 + CA.CARGOS_12 CARGOS_ANT,     
 CA.ABONOS_1 + CA.ABONOS_2 + CA.ABONOS_3 + CA.ABONOS_4 + CA.ABONOS_5 + CA.ABONOS_6 + CA.ABONOS_7 + CA.ABONOS_8 + CA.ABONOS_9 + CA.ABONOS_10 + CA.ABONOS_11 + CA.ABONOS_12 ABONOS_ANT,    
 CU.CARGOS_1 + CU.CARGOS_2 + CU.CARGOS_3 + CU.CARGOS_4 + CU.CARGOS_5 + CU.CARGOS_6 + CU.CARGOS_7 + CU.CARGOS_8 + CU.CARGOS_9 + CU.CARGOS_10 + CU.CARGOS_11 + CU.CARGOS_12 CARGOS,     
 CU.ABONOS_1 + CU.ABONOS_2 + CU.ABONOS_3 + CU.ABONOS_4 + CU.ABONOS_5 + CU.ABONOS_6 + CU.ABONOS_7 + CU.ABONOS_8 + CU.ABONOS_9 + CU.ABONOS_10 + CU.ABONOS_11 + CU.ABONOS_12 ABONOS       
 FROM CUENTA CU,CUENTA_ANTERIOR CA           LEFT JOIN NATGAS NA ON NA.CLVGAS = SUBSTR(CU.SSSCTA, 1,	1)||'000'  
 WHERE CU.CUENTA = CA.CUENTA AND CU.CUENTA   = '5200'   AND SUBSTR(NA.CLVGAS,2,3) = '000'   ) T1   GROUP BY 1, 2, T1.CUENTA, T1.NOMCTA  
 UNION ALL  
 SELECT 2 PRINCIPAL,         6 GRUPO,         NA.CLVGAS CUENTA,         NA.NOMGAS NOMCTA,        
 0 SALDO_ANT,         
 0 SALDO_ACT       FROM NATGAS NA  WHERE NA.CLVGAS IN ('8100', '8300', '8500')  
 UNION ALL  
 SELECT 2 PRINCIPAL,         7 GRUPO,         NA.CLVGAS CUENTA,         NA.NOMGAS NOMCTA,         
 0 SALDO_ANT,         
 0 SALDO_ACT       FROM NATGAS NA  WHERE NA.CLVGAS IN ('9200', '9300', '9400', '9500', '9600')  
 UNION ALL  
 SELECT 2 PRINCIPAL,         8 GRUPO,         T1.CUENTA,         T1.NOMCTA,         
 T1.SALINI_ANT + CARGOS_ANT - ABONOS_ANT SALDO_ANT,         
 T1.SALINI + CARGOS - ABONOS SALDO_ACT       
 FROM (  SELECT CU.CUENTA CUENTA,         'Estimaciones, Depreciaciones, Deterioros, Obsolescencia Y Amortizaciones' NOMCTA,         CU.SALINI,   CA.SALINI SALINI_ANT,  
 CA.CARGOS_1 + CA.CARGOS_2 + CA.CARGOS_3 + CA.CARGOS_4 + CA.CARGOS_5 + CA.CARGOS_6 + CA.CARGOS_7 + CA.CARGOS_8 + CA.CARGOS_9 + CA.CARGOS_10 + CA.CARGOS_11 + CA.CARGOS_12 CARGOS_ANT,     
 CA.ABONOS_1 + CA.ABONOS_2 + CA.ABONOS_3 + CA.ABONOS_4 + CA.ABONOS_5 + CA.ABONOS_6 + CA.ABONOS_7 + CA.ABONOS_8 + CA.ABONOS_9 + CA.ABONOS_10 + CA.ABONOS_11 + CA.ABONOS_12 ABONOS_ANT,     
 CU.CARGOS_1 + CU.CARGOS_2 + CU.CARGOS_3 + CU.CARGOS_4 + CU.CARGOS_5 + CU.CARGOS_6 + CU.CARGOS_7 + CU.CARGOS_8 + CU.CARGOS_9 + CU.CARGOS_10 + CU.CARGOS_11 + CU.CARGOS_12 CARGOS,     
 CU.ABONOS_1 + CU.ABONOS_2 + CU.ABONOS_3 + CU.ABONOS_4 + CU.ABONOS_5 + CU.ABONOS_6 + CU.ABONOS_7 + CU.ABONOS_8 + CU.ABONOS_9 + CU.ABONOS_10 + CU.ABONOS_11 + CU.ABONOS_12 ABONOS       
 FROM CUENTA CU,CUENTA_ANTERIOR CA            WHERE CU.CUENTA = CA.CUENTA AND CU.CUENTA = '5500'    AND CU.SCTA   =''    AND CU.SCTA = CA.SCTA   ) T1  
 UNION ALL  
 SELECT 2 PRINCIPAL,         8 GRUPO,         '5510' CUENTA,         'Provisiones' NOMCTA,         
 0 SALDO_ANT,         
 0 SALDO_ACT       FROM SYSIBM.SYSDUMMY1  
 UNION ALL  
 SELECT 2 PRINCIPAL,         8 GRUPO,         '5520' CUENTA,         'Disminucion de Inventarios' NOMCTA,         0 SALDO_ANT,         0 SALDO_ACT       FROM SYSIBM.SYSDUMMY1  
 UNION ALL  
 SELECT 2 PRINCIPAL,         8 GRUPO,         '5530' CUENTA,         'Otros Gastos' NOMCTA,         0 SALDO_ANT,         0 SALDO_ACT       FROM SYSIBM.SYSDUMMY1  
 UNION ALL  
 SELECT 2 PRINCIPAL,         9 GRUPO,         T1.CUENTA,         T1.NOMCTA,         
 T1.SALINI_ANT + CARGOS_ANT - ABONOS_ANT SALDO_ANT,         
 T1.SALINI + CARGOS - ABONOS SALDO_ACT       
 FROM (  SELECT CU.CUENTA CUENTA,         'Inversion Publica No Capitalizable' NOMCTA,         CU.SALINI,     CA.SALINI SALINI_ANT,
 CA.CARGOS_1 + CA.CARGOS_2 + CA.CARGOS_3 + CA.CARGOS_4 + CA.CARGOS_5 + CA.CARGOS_6 + CA.CARGOS_7 + CA.CARGOS_8 + CA.CARGOS_9 + CA.CARGOS_10 + CA.CARGOS_11 + CA.CARGOS_12 CARGOS_ANT,     
 CA.ABONOS_1 + CA.ABONOS_2 + CA.ABONOS_3 + CA.ABONOS_4 + CA.ABONOS_5 + CA.ABONOS_6 + CA.ABONOS_7 + CA.ABONOS_8 + CA.ABONOS_9 + CA.ABONOS_10 + CA.ABONOS_11 + CA.ABONOS_12 ABONOS_ANT,     
 CU.CARGOS_1 + CU.CARGOS_2 + CU.CARGOS_3 + CU.CARGOS_4 + CU.CARGOS_5 + CU.CARGOS_6 + CU.CARGOS_7 + CU.CARGOS_8 + CU.CARGOS_9 + CU.CARGOS_10 + CU.CARGOS_11 + CU.CARGOS_12 CARGOS,     
 CU.ABONOS_1 + CU.ABONOS_2 + CU.ABONOS_3 + CU.ABONOS_4 + CU.ABONOS_5 + CU.ABONOS_6 + CU.ABONOS_7 + CU.ABONOS_8 + CU.ABONOS_9 + CU.ABONOS_10 + CU.ABONOS_11 + CU.ABONOS_12 ABONOS       
 FROM CUENTA CU,CUENTA_ANTERIOR CA             WHERE  CU.CUENTA = CA.CUENTA AND CU.CUENTA = '5700'    AND CU.SCTA   = ''    AND CU.SCTA = CA.SCTA   ) T1   ORDER BY 1, 2, 3]]>
	</queryString>
	<field name="PRINCIPAL" class="java.lang.Integer">
		<property name="com.jaspersoft.studio.field.name" value="PRINCIPAL"/>
		<property name="com.jaspersoft.studio.field.label" value="PRINCIPAL"/>
	</field>
	<field name="GRUPO" class="java.lang.Integer">
		<property name="com.jaspersoft.studio.field.name" value="GRUPO"/>
		<property name="com.jaspersoft.studio.field.label" value="GRUPO"/>
	</field>
	<field name="CUENTA" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="CUENTA"/>
		<property name="com.jaspersoft.studio.field.label" value="CUENTA"/>
	</field>
	<field name="NOMCTA" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="NOMCTA"/>
		<property name="com.jaspersoft.studio.field.label" value="NOMCTA"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="CUENTA"/>
	</field>
	<field name="SALDO_ACT" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="SALDO_ACT"/>
		<property name="com.jaspersoft.studio.field.label" value="SALDO_ACT"/>
	</field>
	<field name="SALDO_ANT" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="SALDO_ANT"/>
		<property name="com.jaspersoft.studio.field.label" value="SALDO_ANT"/>
	</field>
	<variable name="subTotalIngreso" class="java.math.BigDecimal" resetType="Group" resetGroup="GRUPO" calculation="Sum">
		<variableExpression><![CDATA[$F{SALDO_ACT}]]></variableExpression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="subTotalIngresoAnte" class="java.math.BigDecimal" resetType="Group" resetGroup="GRUPO" calculation="Sum">
		<variableExpression><![CDATA[$F{SALDO_ANT}]]></variableExpression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="subTotalActual" class="java.math.BigDecimal" resetType="Group" resetGroup="principal" calculation="Sum">
		<variableExpression><![CDATA[$F{SALDO_ACT}]]></variableExpression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="suTotalAnterior" class="java.math.BigDecimal" resetType="Group" resetGroup="principal" calculation="Sum">
		<variableExpression><![CDATA[$F{SALDO_ANT}]]></variableExpression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="totalActual" class="java.math.BigDecimal">
		<variableExpression><![CDATA[$V{vTotalIngresosActual}.subtract($V{vTotalPerdidasActual})]]></variableExpression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="totalAnterior" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$V{vTotalIngresosAnt}.subtract($V{vTotalPerdidasAnt})]]></variableExpression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="vTotalIngresosActual" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{GRUPO} <= 3 ?$F{SALDO_ACT} : BigDecimal.ZERO]]></variableExpression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="vTotalPerdidasActual" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{GRUPO} > 3   ?$F{SALDO_ACT} : BigDecimal.ZERO]]></variableExpression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="vTotalIngresosAnt" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{GRUPO} <= 3 ?$F{SALDO_ANT} : BigDecimal.ZERO]]></variableExpression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="vTotalPerdidasAnt" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{GRUPO} >  3 &&  $F{GRUPO} <=9 ?$F{SALDO_ANT} : BigDecimal.ZERO]]></variableExpression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<group name="principal">
		<groupExpression><![CDATA[$F{PRINCIPAL}]]></groupExpression>
