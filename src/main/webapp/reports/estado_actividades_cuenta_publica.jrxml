			<band height="10">
				<element kind="textField" uuid="696f6d0c-0984-49de-a1e2-0db3062acd08" x="0" y="0" width="353" height="10" stretchType="NoStretch" removeLineWhenBlank="true" fontSize="7.0" bold="true" italic="false">
