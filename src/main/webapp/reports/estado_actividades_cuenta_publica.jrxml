					<property name="com.jaspersoft.studio.unit.height" value="px"/>
					<box>
						<leftPen lineWidth="1.0" lineStyle="Solid"/>
						<rightPen lineWidth="1.0" lineStyle="Solid"/>
					</box>
					<expression><![CDATA[$V{subTotalActual}.compareTo(BigDecimal.ZERO) == 0 ? "" : $V{subTotalActual}]]></expression>
				</element>
				<element kind="textField" uuid="5dcdd4aa-0d5c-49fe-b968-604e59adb42b" x="0" y="0" width="353" height="12" stretchType="NoStretch" fontSize="7.0" evaluationTime="Group" bold="true" evaluationGroup="principal">
