	<queryString>
		<![CDATA[SELECT 
PP.DESC_PROY,
PP.OBJ_PROY,
PP.EST_PROY,
PP.CLVDEP,
PP.DIMENSIONC,
SUBSTR(PP.CLVDEP,1,6)DEP,
SUBSTR(PP.CLVNEP,1,10)CLNEP,
(PP.CLVNEP|| PP.CLVDEP) GRUPO,
C.NOMDEP,
C.TITULAR,
C.ELABORO,
C.CARGO_T,
C.CARGO_E,
M.CAMPO6 PROGRAMA,
M1.CAMPO8 OBJETIVO
FROM PP_CAPTURA PP
INNER JOIN CATDEP C ON C.CLVDEP=PP.CLVDEP AND C.IDSECTOR=PP.SECTORID
INNER JOIN MUNINEP M ON SUBSTR(PP.CLVNEP,1,10) = M.CAMPO7 AND PP.SECTORID = M.IDSECTOR
INNER JOIN MUNINEP M1 ON PP.CLVNEP = M1.CAMPO7  AND PP.SECTORID = M1.IDSECTOR
WHERE PP.SECTORID=$P{p_IdSector}
ORDER BY 
PP.CLVDEP ASC,
PP.CLVNEP ASC]]>
	</queryString>
