	<parameter name="year" class="java.lang.Integer"/>
	<parameter name="nameDependencia" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 	T1.NO_ACCION, T1.NOMBRE_OBRA, T1.ASIGNADO, T1.AUTORIZADO, 
		T1.IMPORTE_FACTURA, T1.AFECTACION_PRESUPUESTAL, 
		(T1.IMPORTE_ADQUISICION - T1.AFECTACION_PRESUPUESTAL) SALDO_PENDIENTE
	FROM(
		SELECT 	O.ID ,O.NO_ACCION, O.NOMBRE_OBRA, O.ASIGNADO, O.AUTORIZADO, C.IMPORTE_ADQUISICION,
				SUM(NVL(P.IMPORTE_FACTURA, 0)) IMPORTE_FACTURA,
				SUM(NVL(P.IMPORTE_AFECTACION_PRESUPUESTAL,0)) AFECTACION_PRESUPUESTAL
			FROM TW_OBRAS O
				LEFT JOIN TW_OBRA_PAGOS P ON P.ID_OBRA = O.ID
				INNER JOIN TC_CONTRATOS C ON O.ID_CONTRATO = C.ID
		GROUP BY O.ID ,O.NO_ACCION, O.NOMBRE_OBRA, O.ASIGNADO, O.AUTORIZADO, C.IMPORTE_ADQUISICION
		)T1]]>
	</queryString>
