<jasperReport name="Estado_Situacion_Financiera" language="java" columnCount="1" dpi="72" pageWidth="792" pageHeight="612" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="760" leftMargin="11" rightMargin="21" topMargin="20" bottomMargin="20" uuid="ded9f4a0-e50d-4a9d-b0da-96c7db85aee2">
