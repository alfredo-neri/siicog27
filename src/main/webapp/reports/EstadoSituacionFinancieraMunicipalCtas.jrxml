					WHEN  $P{p_mes}=2  THEN  SUM(DECIMAL (C.ABONOS_1,20,2))
					WHEN  $P{p_mes}=3  THEN  SUM(DECIMAL (C.ABONOS_1,20,2))+SUM(DECIMAL (C.ABONOS_2,20,2))
