					WHEN  $P{p_mes}=6  THEN  SUM(DECIMAL (C.ABONOS_1,20,2))+SUM(DECIMAL (C.ABONOS_2,20,2))+SUM(DECIMAL (C.ABONOS_3,20,2))+SUM(DECIMAL (C.ABONOS_4,20,2))+SUM(DECIMAL (C.ABONOS_5,20,2))+SUM(DECIMAL (C.ABONOS_6,20,2))
