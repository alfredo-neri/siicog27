	<query language="SQL"><![CDATA[SELECT 
	D.TIPPOL, 
	E.FECPOL, 
	D.CONPOL, 
	D.MESPOL, 
	D.CUENTA, 
	D.SCTA, 
	D.SSCTA, 
	D.SSSCTA, 
	D.SSSSCTA, 
	D.CONCEP, 
	D.REFPOL, 
	D.CANPOL, 
	D.CANPOLH
FROM POLIDE D
	INNER JOIN POLIEN E ON 
		E.MESPOL=D.MESPOL AND
		E.CONPOL=D.CONPOL AND
		E.ANOPOL=D.ANOPOL AND
		E.IDSECTOR=D.IDSECTOR AND
		E.TIPPOL=D.TIPPOL 
WHERE E.TIPPOL =$P{tipo}
	AND	E.MESPOL = $P{mes}
	AND E.CONPOL = $P{numero}]]></query>
