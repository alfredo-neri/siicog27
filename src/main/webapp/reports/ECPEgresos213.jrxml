	<variable name="vSAutorizado" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[($F{PARTIDA}.substring(1).equals("000")?$F{AUTORIZADO}:BigDecimal.ZERO)]]></expression>
	</variable>
	<variable name="vSAjuste" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[($F{PARTIDA}.substring(1).equals("000")?$F{AJUSTEPRES}:BigDecimal.ZERO)]]></expression>
	</variable>
	<variable name="vSModificado" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[($F{PARTIDA}.substring(1).equals("000")?$F{MODIFICADO}:BigDecimal.ZERO)]]></expression>
	</variable>
	<variable name="vSEjercido" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[($F{PARTIDA}.substring(1).equals("000")?$F{EJERCIDO}:BigDecimal.ZERO)]]></expression>
	</variable>
	<variable name="vSAbsoluta" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[($F{PARTIDA}.substring(1).equals("000")?$F{ABSOLUTA}:BigDecimal.ZERO)]]></expression>
	</variable>
	<variable name="vSPorcentaje" class="java.lang.Double">
		<expression><![CDATA[(($V{vSModificado}.doubleValue() == 0.00) ? 0.00 : ((($V{vSModificado}.doubleValue() - $V{vSEjercido}.doubleValue()) / $V{vSModificado}.doubleValue()) * 100))]]></expression>
	</variable>
	<variable name="porcentaje" class="java.lang.Double">
		<expression><![CDATA[($F{MODIFICADO}.doubleValue() == 0.00) ? 0.00 : ((($F{MODIFICADO}.doubleValue() - $F{EJERCIDO}.doubleValue()) / $F{MODIFICADO}.doubleValue()) * 100)]]></expression>
	</variable>
