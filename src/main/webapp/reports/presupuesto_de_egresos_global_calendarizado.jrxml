			><description><![CDATA[]]></description>
		</parameter>
		<query language="sql"><![CDATA[SELECT 
PAS.PARTIDA
,NAT.NOMGAS
,PAS.AUTO1_1
,PAS.AUTO1_2
,PAS.AUTO1_3
,PAS.AUTO1_4
,PAS.AUTO1_5
,PAS.AUTO1_6
,PAS.AUTO1_7
,PAS.AUTO1_8
,PAS.AUTO1_9
,PAS.AUTO1_10
,PAS.AUTO1_11
,PAS.AUTO1_12
,PAS.AUTO1_13
 FROM PASO PAS 
INNER JOIN NATGAS NAT 
ON PAS.PARTIDA = NAT.CLVGAS AND PAS.IDSECTOR=NAT.IDSECTOR 
WHERE NAT.IDSECTOR=1]]></query>
