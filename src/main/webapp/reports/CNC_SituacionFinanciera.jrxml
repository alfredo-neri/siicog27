			<property name="com.jaspersoft.studio.field.name" value="ABONOS_ACT"/>
			<property name="com.jaspersoft.studio.field.label" value="ABONOS_ACT"/>
		</field>
		<field name="CARGOS_ACT" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="CARGOS_ACT"/>
			<property name="com.jaspersoft.studio.field.label" value="CARGOS_ACT"/>
		</field>
		<field name="ABONOS_ANT" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="ABONOS_ANT"/>
			<property name="com.jaspersoft.studio.field.label" value="ABONOS_ANT"/>
		</field>
		<field name="CARGOS_ANT" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="CARGOS_ANT"/>
			<property name="com.jaspersoft.studio.field.label" value="CARGOS_ANT"/>
		</field>
		<variable name="periodoAnterior" class="java.math.BigDecimal">
			<expression><![CDATA[$F{STACTA}.toUpperCase().equals("D")?(
	($F{SDO_INICIAL}.add($F{CARGOS_ANT}).subtract($F{ABONOS_ANT}))
)
:
(
	($F{CUENTA}.substring(0,2).equals("12")  || $F{CUENTA}.substring(0,3).equals("116"))  && $F{STACTA}.toUpperCase().equals("A")?
		($F{SDO_INICIAL}.multiply(new BigDecimal (-1)).add($F{CARGOS_ANT}).subtract($F{ABONOS_ANT}))
	:
	
       ($F{CUENTA}.equals("1115")  )?(
 	($F{SDO_INICIAL}.add($F{CARGOS_ANT}).subtract($F{ABONOS_ANT}))
 ):
      ($F{SDO_INICIAL}.subtract($F{CARGOS_ANT}).add($F{ABONOS_ANT})) 

)]]></expression>
		</variable>
		<variable name="periodoActual" class="java.math.BigDecimal">
			<expression><![CDATA[$F{STACTA}.toUpperCase().equals("D")?(
	($F{SALINI}.add($F{CARGOS_ACT}).subtract($F{ABONOS_ACT}))
)
:
(
	($F{CUENTA}.substring(0,2).equals("12")  || $F{CUENTA}.substring(0,3).equals("116"))  && $F{STACTA}.toUpperCase().equals("A")?
		($F{SALINI}.multiply(new BigDecimal (-1)).add($F{CARGOS_ACT}).subtract($F{ABONOS_ACT}))
	:
	
       ($F{CUENTA}.equals("1115")  )?(
 	($F{SALINI}.add($F{CARGOS_ACT}).subtract($F{ABONOS_ACT}))
 ):
      ($F{SALINI}.subtract($F{CARGOS_ACT}).add($F{ABONOS_ACT})) 

)]]></expression>
		</variable>
		<variable name="variacion" class="java.math.BigDecimal">
			<expression><![CDATA[$V{periodoAnterior}.subtract($V{periodoActual})]]></expression>
		</variable>
		<variable name="totalSaldoAnterior" resetType="Group" calculation="Sum" resetGroup="GRUPO" class="java.math.BigDecimal">
			<expression><![CDATA[$V{periodoAnterior}]]></expression>
		</variable>
		<variable name="totalPeriodoActual" resetType="Group" calculation="Sum" resetGroup="GRUPO" class="java.math.BigDecimal">
			<expression><![CDATA[$V{periodoActual}]]></expression>
		</variable>
		<variable name="totalVariacion" resetType="Group" calculation="Sum" resetGroup="GRUPO" class="java.math.BigDecimal">
