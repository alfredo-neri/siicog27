	<dataset name="DatasetMetaAnual" uuid="a74efb81-32aa-4283-a429-e52ea4de9773">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="gem2020Local"/>
		<parameter name="idFicha" class="java.lang.Long"/>
		<parameter name="trimestre" class="java.lang.Integer"/>
		<query language="SQL"><![CDATA[SELECT T1.META_ANUAL, T1.PROGRAMADA, T1.ALCANZADA, T1.EF, T1.SEMAFORO, 
       SUM(T1.PROGRAMADA_ACUM) PROGRAMADA_ACUM, 
       SUM(T1.ALCANZADA_ACUM) ALCANZADA_ACUM, 
       T1.EF_ALC, T1.SEMAFORO_ACUMULADO 
  FROM (
      SELECT  DECODE(P.PERIODO, $P{trimestre}, FT.META_ANUAL, 0) META_ANUAL,
              DECODE(P.PERIODO, $P{trimestre}, FT.PROGRAMADA, 0) PROGRAMADA,
              DECODE(P.PERIODO, $P{trimestre}, FT.ALCANZADA, 0) ALCANZADA,
              DECODE(P.PERIODO, $P{trimestre}, FT.PORCENTAJE, 0) EF,
              DECODE(P.PERIODO, $P{trimestre}, FT.SEMAFORO, '') SEMAFORO,
              FT.PROGRAMADA PROGRAMADA_ACUM,
              FT.ALCANZADA ALCANZADA_ACUM,
              DECODE(P.PERIODO, $P{trimestre}, FT.PORCENTAJE_ALCANZADA, 0) EF_ALC,
              DECODE(P.PERIODO, $P{trimestre}, FT.SEMAFORO_ACUMULADO, '') SEMAFORO_ACUMULADO
        FROM TC_FICHA_TRIMESTRES FT
          INNER JOIN TC_PERIODO P ON P.ID = FT.ID_PERIODO
      WHERE FT.ID_FICHA = $P{idFicha}
        AND P.PERIODO <= $P{trimestre}
  ) T1
GROUP BY T1.META_ANUAL, T1.PROGRAMADA, T1.ALCANZADA, T1.EF, T1.SEMAFORO, T1.EF_ALC, T1.SEMAFORO_ACUMULADO]]></query>
