<jasperReport name="reporte 118_txt" language="java" columnCount="1" dpi="72" pageWidth="2000" pageHeight="612" orientation="Landscape" columnWidth="1960" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="7f863fe1-6ada-463a-9aa5-cf529a741962">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="ReportesFer"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.unit." value="pixel"/>
	<property name="net.sf.jasperreports.export.text.character.width" value="3"/>
	<property name="net.sf.jasperreports.export.text.character.height" value="10"/>
	<parameter name="ANO_EMP" class="java.lang.Integer"/>
	<parameter name="TRIMESTRE" class="java.lang.Integer"/>
	<parameter name="IDSECTOR" class="java.lang.Integer"/>
	<parameter name="CLAVE" class="java.lang.String"/>
	<query language="sql"><![CDATA[SELECT '"' || SUBSTR( $P{CLAVE} ,1,1) || '"|"' || SUBSTR( $P{CLAVE} ,2,3) || '"|' || $P{ANO_EMP} || '|' || IND.PERIODO || '|' ||  $P{TRIMESTRE}  || '|' || LAST_DAY(CONCAT( $P{ANO_EMP} , CONCAT('-', CONCAT( $P{TRIMESTRE}*3 , CONCAT('-','01'))))) || '|' || IND.CVEIND || '|"' || IND.CLVFUN || '"|' || LTRIM(VARCHAR_FORMAT(TE,'999,999,990.99')) || '|' || LTRIM(VARCHAR_FORMAT(ACUTE,'999,999,990.99')) || '|' || LTRIM(VARCHAR_FORMAT(ACUSP,'999,999,990.99')) || '|' || LTRIM(VARCHAR_FORMAT(SPSPA,'999,999,990.99')) || '|' || LTRIM(VARCHAR_FORMAT(ACUSPSPA,'999,999,990.99')) || '|' || LTRIM(VARCHAR_FORMAT(DIF,'999,999,990.99')) || '|' || LTRIM(VARCHAR_FORMAT(AVMA,'999,999,990.99')) || '|' || LTRIM(VARCHAR_FORMAT(SJAF,'999,999,990.99')) || '|' || LTRIM(VARCHAR_FORMAT(PAFD,'999,999,990.99')) || '|' || LTRIM(VARCHAR_FORMAT(OAPF,'999,999,990.99')) || '|' || LTRIM(VARCHAR_FORMAT(SPDC,'999,999,990.99')) || '|' || LTRIM(VARCHAR_FORMAT(ALS,'999,999,990.99')) || '|' || LTRIM(VARCHAR_FORMAT(AMSE,'999,999,990.99')) || '|' || LTRIM(VARCHAR_FORMAT(APE,'999,999,990.99')) || '|' || LTRIM(VARCHAR_FORMAT(APCD,'999,999,990.99')) || '|' || LTRIM(VARCHAR_FORMAT(AAM,'999,999,990.99')) || '|' || LTRIM(VARCHAR_FORMAT(AMPG,'999,999,990.99')) || '|' || LTRIM(VARCHAR_FORMAT(AJ,'999,999,990.99')) || '|' || LTRIM(VARCHAR_FORMAT(OANA,'999,999,990.99')) || '|' || LTRIM(VARCHAR_FORMAT(IED,'999,999,990.99')) || '|' || LTRIM(VARCHAR_FORMAT(AID,'999,999,990.99')) || '|' || LTRIM(VARCHAR_FORMAT(EI,'999,999,990.99')) || '|"' || OBSTE || '"|"' || OBSSPSPA || '"' AS DATO
FROM pm1411 PM
INNER JOIN indicadores IND ON IND.IDSECTOR = PM.IDSECTOR
WHERE MENSUAL =  $P{TRIMESTRE} AND PM.IDSECTOR =  $P{IDSECTOR}  AND IND.CVEIND = 29]]></query>
	<field name="DATO" class="java.lang.String"/>
	<background splitType="Stretch"/>
	<title splitType="Stretch"/>
	<pageHeader splitType="Stretch"/>
	<columnHeader splitType="Stretch"/>
