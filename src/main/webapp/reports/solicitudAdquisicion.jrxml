	<query language="SQL"><![CDATA[SELECT 
	SA.FECHA_ELABORACION ,
  	SA.NUMERO_CONTROL ,
	AA.DESCRIPCION AREA,
	AA.CLAVE ,
	PA.NOMBRE ,
	PA.CARGO ,
	PA.DOMICILIO ,
	PA.TELEFONO ,
	PA.TELFAX ,
	PA.EMAIL ,
	BS.NOMBRE BIEN,
	SA.PROGRAMA_GOBIERNO ,
	SA.PROGRAMADO ,
	AG.CLVGAS ,
	AG.NOMGAS ,
	TS.TRAMITE ,
	SA.OFICIO_JUSTIFICACION ,
	SA.DICTAMEN_UNICO ,
	TG.DESCRIPCION TIPO_GASTO,
	RO.DESCRIPCION RECURSO,
	SA.MONTO_COMPROMETIDO ,
	SA.ANTICIPO ,
	SA.OFICIO_CERTIFICACION ,
	FP.NOMBRE FORMA_PAGO,
	SA.NO_OFICIO_AUTORIZACION ,
	SA.FECHA_SUMINISTRO ,
	SA.NOMBRE_RECEPTOR ,
	SA.CARGO_RECEPTOR ,
	SA.HORARIO_DE ,
	SA.HORARIO_A ,
	SA.LUGAR_ENTREGA ,
	SA.OBS  ,
	SA.USUARIO  ,
	SA.REVISOR  ,
	EC.ESTADO ,
	SA.MARCA_ESPESIFICA,
	(SELECT LISTAGG(CLAVE||' '||DESCRIPCION,', ') 
FROM TC_ADQUISICION_GIRO_SUBGIROS G INNER JOIN TC_SUBGIROS S
	ON G.ID_SUBGIRO=S.ID AND G.ID_ADQUISICION=$P!{idAdquisicion}) SUBGIROS
FROM TC_ADQUISICIONES SA
	LEFT JOIN TC_BIENES_SERVICIOS BS ON SA.ID_BIEN_SERVICIO=BS.ID
	LEFT JOIN TC_TIPOS_PAGO FP ON SA.ID_TIPO_PAGO=FP.ID
	LEFT JOIN TC_ORIGEN_RECURSOS RO ON SA.ID_ORIGEN_RECURSOS=RO.ID
	LEFT JOIN TC_TIPOS_GASTO TG ON SA.ID_TIPO_GASTO=TG.ID
	LEFT JOIN TC_TRAMITES TS ON SA.ID_TRAMITACION=TS.ID
	LEFT JOIN TC_PERSONAL_ADMINISTRATIVO PA ON SA.ID_PERSONAL_ADMINISTRATIVO=PA.ID
	INNER JOIN TC_AREAS_ADMINISTRATIVAS AA ON PA.ID_UNIDAD_ADMINISTRATIVA=AA.ID
	LEFT JOIN TC_ESTADOS_CONTRATO EC ON SA.ID_ESTADO=EC.ID
	LEFT JOIN NATGAS AG ON SA.ID_NATGAS=AG.ID
WHERE SA.ID=$P!{idAdquisicion}]]></query>
