		<groupFooter>
			<band height="45">
				<element kind="staticText" uuid="d9007c2b-635e-4f7b-8616-467b5856a3af" x="0" y="0" width="302" height="15" stretchType="NoStretch" fontName="Arial" fontSize="8.0" bold="true" vTextAlign="Middle">
