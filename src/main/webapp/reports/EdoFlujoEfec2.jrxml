					<box leftPadding="2" rightPadding="1">
						<leftPen lineWidth="1.0"/>
					</box>
					<text><![CDATA[INCREMENTO/DISMINUCIÓN NETA EN EL EFECTIVO Y EQUIVALENTES AL EFECTIVO ]]></text>
				</element>
				<element kind="staticText" uuid="25bac81a-fe1d-4bd1-b9a6-18c15862d1ba" x="0" y="15" width="302" height="15" stretchType="NoStretch" fontName="Arial" fontSize="8.0" bold="true" vTextAlign="Middle">
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
					<box leftPadding="2" rightPadding="1">
						<leftPen lineWidth="1.0"/>
					</box>
					<text><![CDATA[EFECTIVO Y EQUIVALENTES AL EFECTIVO AL INICIO DEL MES]]></text>
				</element>
				<element kind="staticText" uuid="03286211-18ae-4965-8e40-fd1d8e3a5639" x="0" y="30" width="302" height="15" stretchType="NoStretch" fontName="Arial" fontSize="8.0" bold="true" vTextAlign="Middle">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
					<box leftPadding="2" rightPadding="1">
						<leftPen lineWidth="1.0"/>
						<bottomPen lineWidth="1.0"/>
					</box>
					<text><![CDATA[EFECTIVO Y EQUIVALENTES AL EFECTIVO AL FINAL DEL MES]]></text>
				</element>
				<element kind="textField" uuid="32cf1679-0161-4531-b0d5-dcdbf14f5f17" x="302" y="15" width="90" height="15" stretchType="NoStretch" fontName="Arial" fontSize="9.0" pattern="#,##0.00" hTextAlign="Right" vTextAlign="Middle">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
					<property name="com.jaspersoft.studio.unit.x" value="px"/>
					<paragraph rightIndent="3"/>
					<expression><![CDATA[$V{vTotAntOp}.subtract($V{vTotAntInv}).subtract($V{vTotAntDe})]]></expression>
				</element>
				<element kind="textField" uuid="b5a234c0-05aa-4446-ab2a-7e5b00498f17" x="302" y="30" width="90" height="15" stretchType="NoStretch" fontName="Arial" fontSize="9.0" pattern="#,##0.00" hTextAlign="Right" vTextAlign="Middle">
					<property name="com.jaspersoft.studio.unit.height" value="pixel"/>
					<property name="com.jaspersoft.studio.unit.x" value="px"/>
					<box>
						<bottomPen lineWidth="1.0"/>
					</box>
					<paragraph rightIndent="3"/>
					<expression><![CDATA[$V{vTotActOp}.subtract($V{vTotActInv}).subtract($V{vTovActDe}).add($F{SALINI})]]></expression>
				</element>
				<element kind="textField" uuid="6c449ebf-ca45-4ed6-bc66-2bc94ca67ace" x="302" y="0" width="90" height="15" stretchType="NoStretch" fontName="Arial" fontSize="9.0" pattern="#,##0.00" hTextAlign="Right" vTextAlign="Middle">
					<property name="com.jaspersoft.studio.unit.x" value="px"/>
					<paragraph rightIndent="3"/>
					<expression><![CDATA[(($V{vTotAntOp}.doubleValue())-($V{vTotAntInv}.doubleValue())-($V{vTotAntDe}.doubleValue()))==0
?
(($V{vTotAntOp}.doubleValue())-($V{vTotAntInv}.doubleValue())-($V{vTotAntDe}.doubleValue()))+(($V{vTotActOp}.doubleValue())-($V{vTotActInv}.doubleValue())-($V{vTovActDe}.doubleValue()))
:
($V{vTotAntOp}.doubleValue())-($V{vTotAntInv}.doubleValue())-($V{vTotAntDe}.doubleValue())-Math.abs((($V{vTotActOp}.doubleValue())-($V{vTotActInv}.doubleValue())-($V{vTovActDe}.doubleValue())))]]></expression>
				</element>
				<element kind="staticText" uuid="812b521d-6525-4004-b489-887470bbd636" x="392" y="0" width="180" height="45" stretchType="NoStretch">
					<box>
						<bottomPen lineWidth="1.0"/>
						<rightPen lineWidth="1.0"/>
