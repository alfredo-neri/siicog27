					<expression><![CDATA[$F{PRINCIPAL} == 1 ? " Flujos de Efectivo de las Actividades de Operación (7)" : $F{PRINCIPAL} == 2 ?  " Flujos de Efectivo de las Actividades de Inversión (8)" : " Flujos de Efectivo de las Actividades de Financiamiento (9)"]]></expression>
				</element>
				<element kind="staticText" uuid="b59ae8d6-7c64-4d63-b3f5-47569c28a162" x="500" y="0" width="150" height="10" stretchType="NoStretch">
