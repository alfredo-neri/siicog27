					<property name="com.jaspersoft.studio.unit.height" value="px"/>
					<box>
						<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<leftPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
						<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
						<rightPen lineWidth="1.0" lineStyle="Solid" lineColor="#000000"/>
					</box>
					<expression><![CDATA[$F{PRINCIPAL} == 1 ? " Flujos Netos de Efectivo por Actividades de Operación" : $F{PRINCIPAL} ==2 ? " Flujos Netos de Efectivo por Actividades de Inversión" : " Flujos Netos de Efectivo por Actividades de Financiamiento"]]></expression>
				</element>
				<element kind="textField" uuid="897aab6d-9857-438d-aaf0-241d160aff6b" x="500" y="0" width="150" height="10" stretchType="NoStretch" fontSize="7.0" evaluationTime="Group" pattern="#,##0.00" bold="true" evaluationGroup="Group2" hTextAlign="Right">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
					<box>
						<leftPen lineWidth="1.0" lineStyle="Solid"/>
						<rightPen lineWidth="1.0" lineStyle="Solid"/>
					</box>
					<expression><![CDATA[$F{PRINCIPAL} == 1 ? $V{sumGroup1}.subtract($V{sumGroup2}) : $F{PRINCIPAL} == 2 ? $V{sumGroup3}.subtract($V{sumGroup4}) : $V{sumGroup5}.subtract($V{sumGroup6}).compareTo(BigDecimal.ZERO) == 0 ? "" : $F{PRINCIPAL}]]></expression>
				</element>
				<element kind="textField" uuid="34160740-76c6-4579-b66a-46549a9cdc65" x="650" y="0" width="152" height="10" stretchType="NoStretch" fontSize="7.0" pattern="#,##0.00" bold="true" hTextAlign="Right">
