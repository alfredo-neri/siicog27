				</element>
				<element kind="textField" uuid="199d69cd-8f6c-49ec-9ccc-a984e74df1cf" x="650" y="0" width="152" height="10" stretchType="NoStretch" fontSize="7.0" evaluationTime="Group" pattern="#,##0.00" bold="true" evaluationGroup="Group1" hTextAlign="Right">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
