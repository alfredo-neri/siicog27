<jasperReport name="estado_flujo_efectivo_ldf" language="java" columnCount="1" dpi="72" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="0e34b027-20b7-43f0-a1ab-8facc2a61b38" ignorePagination="true">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="data base 24"/>
	<parameter name="img1" class="java.lang.String"/>
	<parameter name="img2" class="java.lang.String"/>
	<parameter name="lastDay" class="java.lang.Integer"/>
	<parameter name="month" class="java.lang.String"/>
	<parameter name="year" class="java.lang.Integer"/>
	<parameter name="sSql" class="java.lang.String"/>
	<parameter name="totalActual1" class="java.math.BigDecimal"/>
	<parameter name="totalActual2" class="java.math.BigDecimal"/>
	<parameter name="totalAnt1" class="java.math.BigDecimal"/>
	<parameter name="totalAnt2" class="java.math.BigDecimal"/>
	<parameter name="monthAct" class="java.lang.String"/>
	<parameter name="monthAnt" class="java.lang.String"/>
	<parameter name="totalEfectivoEqAct1" class="java.math.BigDecimal"/>
	<parameter name="totalEfectivoEqAct2" class="java.math.BigDecimal"/>
	<parameter name="totalEfectivoEqAnt1" class="java.math.BigDecimal"/>
	<parameter name="totalEfectivoEqAnt2" class="java.math.BigDecimal"/>
	<query language="SQL"><![CDATA[SELECT  1 PRINCIPAL,         1 GRUPO,         DECODE(T1.CUENTA, '4110', '1', '4120', '2', '4130', '3', '4140', '4','4170', '5', '4310', '6', '4160', '7',  '4210', '8', '4220', '9', '4390', '99') CUENTA,         FN_GET_NOMBRE_CUENTA(T1.CUENTA, T1.NOMCTA) NOMCTA,         (T1.ABONOS_ANT - T1.CARGOS_ANT) SALDO_ANT,         (T1.ABONOS - T1.CARGOS) SALDO_ACT       
FROM(  SELECT CU.CUENTA,        MA.NOMMAY NOMCTA,  
CA.CARGOS_1 + CA.CARGOS_2 + CA.CARGOS_3 + CA.CARGOS_4 + CA.CARGOS_5 + CA.CARGOS_6 + CA.CARGOS_7 + CA.CARGOS_8 + CA.CARGOS_9 + CA.CARGOS_10 + CA.CARGOS_11 + CA.CARGOS_12 CARGOS_ANT,  
CA.ABONOS_1 + CA.ABONOS_2 + CA.ABONOS_3 + CA.ABONOS_4 + CA.ABONOS_5 + CA.ABONOS_6 + CA.ABONOS_7 + CA.ABONOS_8 + CA.ABONOS_9 + CA.ABONOS_10 + CA.ABONOS_11 + CA.ABONOS_12  ABONOS_ANT,  
CU.CARGOS_1 + CU.CARGOS_2 + CU.CARGOS_3 + CU.CARGOS_4 + CU.CARGOS_5 + CU.CARGOS_6 + CU.CARGOS_7 + CU.CARGOS_8 + CU.CARGOS_9 + CU.CARGOS_10 + CU.CARGOS_11 + CU.CARGOS_12 CARGOS, 
 CU.ABONOS_1 + CU.ABONOS_2 + CU.ABONOS_3 + CU.ABONOS_4 + CU.ABONOS_5 + CU.ABONOS_6 + CU.ABONOS_7 + CU.ABONOS_8 + CU.ABONOS_9 + CU.ABONOS_10 + CU.ABONOS_11 + CU.ABONOS_12 ABONOS    
FROM CUENTA CU, CUENTA_ANTERIOR CA,        MAYCTA MA  WHERE MA.CUENTA = CU.CUENTA AND CU.CUENTA = CA.CUENTA AND SUBSTR(CU.CUENTA,1,1) =  '4'   AND SUBSTR(CU.CUENTA,4,1) =  '0'   AND SUBSTR(CU.CUENTA,3,1) <>  '0'   AND CU.CUENTA NOT IN ('4190', '4150' , '4320', '4330', '4340', '4350')     ) T1 
UNION ALL 
SELECT T2.PRINCIPAL,        T2.GRUPO,        T2.CUENTA,        T2.NOMCTA,        
SUM(T2.SALDO_ANT) SALDO_ANT,        SUM(T2.SALDO_ACT) SALDO_ACT      
FROM (  SELECT  1 PRINCIPAL,         2 GRUPO,         T1.CUENTA,         FN_GET_NOMBRE_CUENTA(T1.CUENTA, T1.NOMCTA) NOMCTA,         (T1.CARGOS_ANT - T1.ABONOS_ANT) SALDO_ANT,         (T1.CARGOS - T1.ABONOS) SALDO_ACT       
FROM( SELECT '5001' CUENTA,        'Servicios Personales' NOMCTA,  
CA.CARGOS_1 + CA.CARGOS_2 + CA.CARGOS_3 + CA.CARGOS_4 + CA.CARGOS_5 + CA.CARGOS_6 + CA.CARGOS_7 + CA.CARGOS_8 + CA.CARGOS_9 + CA.CARGOS_10 + CA.CARGOS_11 + CA.CARGOS_12 CARGOS_ANT,  
CA.ABONOS_1 + CA.ABONOS_2 + CA.ABONOS_3 + CA.ABONOS_4 + CA.ABONOS_5 + CA.ABONOS_6 + CA.ABONOS_7 + CA.ABONOS_8 + CA.ABONOS_9 + CA.ABONOS_10 + CA.ABONOS_11 + CA.ABONOS_12  ABONOS_ANT,  
 CU.CARGOS_1 + CU.CARGOS_2 + CU.CARGOS_3 + CU.CARGOS_4 + CU.CARGOS_5 + CU.CARGOS_6 + CU.CARGOS_7 + CU.CARGOS_8 + CU.CARGOS_9 + CU.CARGOS_10 + CU.CARGOS_11 + CU.CARGOS_12 CARGOS,  
 CU.ABONOS_1 + CU.ABONOS_2 + CU.ABONOS_3 + CU.ABONOS_4 + CU.ABONOS_5 + CU.ABONOS_6 + CU.ABONOS_7 + CU.ABONOS_8 + CU.ABONOS_9 + CU.ABONOS_10 + CU.ABONOS_11 + CU.ABONOS_12 ABONOS    
 FROM CUENTA CU, CUENTA_ANTERIOR CA WHERE CU.CUENTA = CA.CUENTA AND SUBSTR(CU.CUENTA,1,1) =  '5'   AND SUBSTR(CU.CUENTA,3,2) =  '00'   AND SUBSTR(CU.SSSCTA,4,1) <> '0'   AND SUBSTR(CU.SSSCTA,1,1) = '1'  ) T1  ) T2 GROUP BY T2.PRINCIPAL,        T2.GRUPO,        T2.CUENTA,        T2.NOMCTA  
 UNION ALL 
 SELECT T2.PRINCIPAL,        T2.GRUPO,        T2.CUENTA,        T2.NOMCTA,        SUM(T2.SALDO_ANT) SALDO_ANT,        SUM(T2.SALDO_ACT) SALDO_ACT      FROM (  SELECT  1 PRINCIPAL,         2 GRUPO,         T1.CUENTA,         T1.NOMCTA NOMCTA,         (T1.CARGOS_ANT - T1.ABONOS_ANT) SALDO_ANT,         (T1.CARGOS - T1.ABONOS) SALDO_ACT       FROM( SELECT '5002' CUENTA,        'Materiales y Suministros' NOMCTA,  
 CA.CARGOS_1 + CA.CARGOS_2 + CA.CARGOS_3 + CA.CARGOS_4 + CA.CARGOS_5 + CA.CARGOS_6 + CA.CARGOS_7 + CA.CARGOS_8 + CA.CARGOS_9 + CA.CARGOS_10 + CA.CARGOS_11 + CA.CARGOS_12 CARGOS_ANT,  
CA.ABONOS_1 + CA.ABONOS_2 + CA.ABONOS_3 + CA.ABONOS_4 + CA.ABONOS_5 + CA.ABONOS_6 + CA.ABONOS_7 + CA.ABONOS_8 + CA.ABONOS_9 + CA.ABONOS_10 + CA.ABONOS_11 + CA.ABONOS_12  ABONOS_ANT,
 CU.CARGOS_1 + CU.CARGOS_2 + CU.CARGOS_3 + CU.CARGOS_4 + CU.CARGOS_5 + CU.CARGOS_6 + CU.CARGOS_7 + CU.CARGOS_8 + CU.CARGOS_9 + CU.CARGOS_10 + CU.CARGOS_11 + CU.CARGOS_12 CARGOS,  
 CU.ABONOS_1 + CU.ABONOS_2 + CU.ABONOS_3 + CU.ABONOS_4 + CU.ABONOS_5 + CU.ABONOS_6 + CU.ABONOS_7 + CU.ABONOS_8 + CU.ABONOS_9 + CU.ABONOS_10 + CU.ABONOS_11 + CU.ABONOS_12 ABONOS    FROM CUENTA CU,CUENTA_ANTERIOR CA WHERE  CU.CUENTA = CA.CUENTA AND SUBSTR(CU.CUENTA,1,1) =  '5'   AND SUBSTR(CU.CUENTA,3,2) =  '00'   AND SUBSTR(CU.SSSCTA,4,1) <> '0'   AND SUBSTR(CU.SSSCTA,1,1) = '2'  ) T1  ) T2 GROUP BY T2.PRINCIPAL,        T2.GRUPO,        T2.CUENTA,        T2.NOMCTA  UNION ALL SELECT T2.PRINCIPAL,        T2.GRUPO,        T2.CUENTA,        T2.NOMCTA,         SUM(T2.SALDO_ANT) SALDO_ANT,        SUM(T2.SALDO_ACT) SALDO_ACT      FROM (  SELECT  1 PRINCIPAL,         2 GRUPO,         T1.CUENTA,         T1.NOMCTA NOMCTA,         (T1.CARGOS_ANT - T1.ABONOS_ANT) SALDO_ANT,         (T1.CARGOS - T1.ABONOS) SALDO_ACT       
 FROM( SELECT CU.CUENTA,        'Servicios Generales' NOMCTA,  
 CA.CARGOS_1 + CA.CARGOS_2 + CA.CARGOS_3 + CA.CARGOS_4 + CA.CARGOS_5 + CA.CARGOS_6 + CA.CARGOS_7 + CA.CARGOS_8 + CA.CARGOS_9 + CA.CARGOS_10 + CA.CARGOS_11 + CA.CARGOS_12 CARGOS_ANT,  
CA.ABONOS_1 + CA.ABONOS_2 + CA.ABONOS_3 + CA.ABONOS_4 + CA.ABONOS_5 + CA.ABONOS_6 + CA.ABONOS_7 + CA.ABONOS_8 + CA.ABONOS_9 + CA.ABONOS_10 + CA.ABONOS_11 + CA.ABONOS_12  ABONOS_ANT,
 CU.CARGOS_1 + CU.CARGOS_2 + CU.CARGOS_3 + CU.CARGOS_4 + CU.CARGOS_5 + CU.CARGOS_6 + CU.CARGOS_7 + CU.CARGOS_8 + CU.CARGOS_9 + CU.CARGOS_10 + CU.CARGOS_11 + CU.CARGOS_12 CARGOS, 
 CU.ABONOS_1 + CU.ABONOS_2 + CU.ABONOS_3 + CU.ABONOS_4 + CU.ABONOS_5 + CU.ABONOS_6 + CU.ABONOS_7 + CU.ABONOS_8 + CU.ABONOS_9 + CU.ABONOS_10 + CU.ABONOS_11 + CU.ABONOS_12 ABONOS    
 FROM CUENTA CU,CUENTA_ANTERIOR CA WHERE  CU.CUENTA = CA.CUENTA AND SUBSTR(CU.CUENTA,1,1) =  '5'   AND SUBSTR(CU.CUENTA,3,2) =  '00'   AND SUBSTR(CU.SSSCTA,4,1) <> '0'   AND SUBSTR(CU.SSSCTA,1,1) = '3'  ) T1  ) T2 GROUP BY T2.PRINCIPAL,        T2.GRUPO,        T2.CUENTA,        T2.NOMCTA  UNION ALL SELECT 1 PRINCIPAL,        2 GRUPO,        '5110' CUENTA,        'Transferencias Internas y Asignaciones al Sector Publico' NOMCTA,        0 SALDO_ANT,        0 SALDO_ACT      FROM SYSIBM.SYSDUMMY1  
 UNION ALL 
 SELECT 1 PRINCIPAL,        2 GRUPO,        '5120' CUENTA,        'Transferencias al Resto del Sector Publico' NOMCTA,        0 SALDO_ANT,        0 SALDO_ACT      FROM SYSIBM.SYSDUMMY1  UNION ALL SELECT T2.PRINCIPAL,        T2.GRUPO,        T2.CUENTA,        T2.NOMCTA,         SUM(T2.SALDO_ANT) SALDO_ANT,        SUM(T2.SALDO_ACT) SALDO_ACT      FROM (  SELECT  1 PRINCIPAL,         2 GRUPO,         T1.CUENTA,         T1.NOMCTA NOMCTA,         (T1.CARGOS_ANT - T1.ABONOS_ANT) SALDO_ANT,         (T1.CARGOS - T1.ABONOS) SALDO_ACT       FROM( SELECT CU.CUENTA,        'Ayudas Sociales' NOMCTA,  
 CA.CARGOS_1 + CA.CARGOS_2 + CA.CARGOS_3 + CA.CARGOS_4 + CA.CARGOS_5 + CA.CARGOS_6 + CA.CARGOS_7 + CA.CARGOS_8 + CA.CARGOS_9 + CA.CARGOS_10 + CA.CARGOS_11 + CA.CARGOS_12 CARGOS_ANT,  
CA.ABONOS_1 + CA.ABONOS_2 + CA.ABONOS_3 + CA.ABONOS_4 + CA.ABONOS_5 + CA.ABONOS_6 + CA.ABONOS_7 + CA.ABONOS_8 + CA.ABONOS_9 + CA.ABONOS_10 + CA.ABONOS_11 + CA.ABONOS_12  ABONOS_ANT,
 CU.CARGOS_1 + CU.CARGOS_2 + CU.CARGOS_3 + CU.CARGOS_4 + CU.CARGOS_5 + CU.CARGOS_6 + CU.CARGOS_7 + CU.CARGOS_8 + CU.CARGOS_9 + CU.CARGOS_10 + CU.CARGOS_11 + CU.CARGOS_12 CARGOS,  
 CU.ABONOS_1 + CU.ABONOS_2 + CU.ABONOS_3 + CU.ABONOS_4 + CU.ABONOS_5 + CU.ABONOS_6 + CU.ABONOS_7 + CU.ABONOS_8 + CU.ABONOS_9 + CU.ABONOS_10 + CU.ABONOS_11 + CU.ABONOS_12 ABONOS   
 FROM CUENTA CU ,CUENTA_ANTERIOR CA WHERE  CU.CUENTA = CA.CUENTA AND CU.CUENTA =  '5200'   AND SUBSTR(CU.SSSCTA,4,1) <> '0'   AND SUBSTR(CU.SSSCTA,1,2) = '44'  ) T1  ) T2 GROUP BY T2.PRINCIPAL,        T2.GRUPO,        T2.CUENTA,        T2.NOMCTA  UNION ALL SELECT 1 PRINCIPAL,        2 GRUPO,        '5210' CUENTA,        'Pensiones y Jubilaciones' NOMCTA,        0 SALDO_ANT,        0 SALDO_ACT      FROM SYSIBM.SYSDUMMY1  UNION ALL SELECT 1 PRINCIPAL,        2 GRUPO,        '5220' CUENTA,        'Transferencias a Fideicomisos, Mandatos y Contratos Análogos' NOMCTA,        0 SALDO_ANT,        0 SALDO_ACT      FROM SYSIBM.SYSDUMMY1  UNION ALL SELECT 1 PRINCIPAL,        2 GRUPO,        '5230' CUENTA,        'Transferencias a la Seguridad Social' NOMCTA,        0 SALDO_ANT,        0 SALDO_ACT      FROM SYSIBM.SYSDUMMY1  
 UNION ALL 
 SELECT 1 PRINCIPAL,        2 GRUPO,        '5240' CUENTA,        'Donativos' NOMCTA,        0 SALDO_ANT,        0 SALDO_ACT      FROM SYSIBM.SYSDUMMY1  UNION ALL SELECT 1 PRINCIPAL,        2 GRUPO,        '5250' CUENTA,        'Transferencias al Exterior' NOMCTA,        0 SALDO_ANT,        0 SALDO_ACT      FROM SYSIBM.SYSDUMMY1  UNION ALL SELECT 1 PRINCIPAL,        2 GRUPO,        '5260' CUENTA,        'Participaciones' NOMCTA,        0 SALDO_ANT,        0 SALDO_ACT      FROM SYSIBM.SYSDUMMY1  UNION ALL SELECT 1 PRINCIPAL,        2 GRUPO,        '5270' CUENTA,        'Aportaciones' NOMCTA,        0 SALDO_ANT,        0 SALDO_ACT      FROM SYSIBM.SYSDUMMY1  UNION ALL SELECT 1 PRINCIPAL,        2 GRUPO,        '5280' CUENTA,        'Convenios' NOMCTA,        0 SALDO_ANT,        0 SALDO_ACT      FROM SYSIBM.SYSDUMMY1  UNION ALL SELECT T2.PRINCIPAL,         T2.GRUPO,         T2.CUENTA,         T2.NOMCTA,          SUM(T2.SALDO_ANT) SALDO_ANT,         SUM(T2.SALDO_ACT) SALDO_ACT       
 FROM (   SELECT  1 PRINCIPAL,          2 GRUPO,          '5700' CUENTA,          'Otras Aplicaciones de Operación' NOMCTA,          (T1.CARGOS_ANT - T1.ABONOS_ANT) SALDO_ANT,          (T1.CARGOS - T1.ABONOS) SALDO_ACT        
 FROM(  SELECT CU.CUENTA,         'Ayudas Sociales' NOMCTA,  
 CA.CARGOS_1 + CA.CARGOS_2 + CA.CARGOS_3 + CA.CARGOS_4 + CA.CARGOS_5 + CA.CARGOS_6 + CA.CARGOS_7 + CA.CARGOS_8 + CA.CARGOS_9 + CA.CARGOS_10 + CA.CARGOS_11 + CA.CARGOS_12 CARGOS_ANT,  
CA.ABONOS_1 + CA.ABONOS_2 + CA.ABONOS_3 + CA.ABONOS_4 + CA.ABONOS_5 + CA.ABONOS_6 + CA.ABONOS_7 + CA.ABONOS_8 + CA.ABONOS_9 + CA.ABONOS_10 + CA.ABONOS_11 + CA.ABONOS_12  ABONOS_ANT,
 CU.CARGOS_1 + CU.CARGOS_2 + CU.CARGOS_3 + CU.CARGOS_4 + CU.CARGOS_5 + CU.CARGOS_6 + CU.CARGOS_7 + CU.CARGOS_8 + CU.CARGOS_9 + CU.CARGOS_10 + CU.CARGOS_11 + CU.CARGOS_12 CARGOS, 
 CU.ABONOS_1 + CU.ABONOS_2 + CU.ABONOS_3 + CU.ABONOS_4 + CU.ABONOS_5 + CU.ABONOS_6 + CU.ABONOS_7 + CU.ABONOS_8 + CU.ABONOS_9 + CU.ABONOS_10 + CU.ABONOS_11 + CU.ABONOS_12 ABONOS     FROM CUENTA CU  ,CUENTA_ANTERIOR CA 
 WHERE  CU.CUENTA = CA.CUENTA AND CU.CUENTA IN (  '5500', '5700')   AND CU.SCTA = ''   ) T1    ) T2  GROUP BY T2.PRINCIPAL,         T2.GRUPO,         T2.CUENTA,         T2.NOMCTA 
 UNION ALL 
 SELECT 2 PRINCIPAL,        3 GRUPO,        '1199' CUENTA,        'Bienes Inmuebles, Infraestructura y Construcciones en Proceso' NOMCTA,        0 SALDO_ANT,        0 SALDO_ACT       FROM SYSIBM.SYSDUMMY1 UNION ALL SELECT T1.PRINCIPAL,        T1.GRUPO,        T1.CUENTA,        T1.NOMCTA,        SUM((T1.SALINI + CARGOS_ANT - ABONOS_ANT) - (T1.SALINI + CARGOS_ANT1 -ABONOS_ANT1 )) SALDO_ANT,        ABS(SUM((T1.SALINI + CARGOS - ABONOS) - (T1.SALINI + CARGOS1 - ABONOS1))) SALDO_ACT      
 FROM( SELECT 2 PRINCIPAL,        3 GRUPO,        SUBSTR(CU.CUENTA,1,2) || '00' CUENTA,        'Bienes Muebles' NOMCTA,        CU.SALINI,   
 CA.CARGOS_1 + CA.CARGOS_2 + CA.CARGOS_3 + CA.CARGOS_4 + CA.CARGOS_5 + CA.CARGOS_6 + CA.CARGOS_7 + CA.CARGOS_8 + CA.CARGOS_9 + CA.CARGOS_10 + CA.CARGOS_11 + CA.CARGOS_12 CARGOS_ANT,  
CA.ABONOS_1 + CA.ABONOS_2 + CA.ABONOS_3 + CA.ABONOS_4 + CA.ABONOS_5 + CA.ABONOS_6 + CA.ABONOS_7 + CA.ABONOS_8 + CA.ABONOS_9 + CA.ABONOS_10 + CA.ABONOS_11 + CA.ABONOS_12  ABONOS_ANT,  
CA.CARGOS_1 + CA.CARGOS_2 + CA.CARGOS_3 + CA.CARGOS_4 + CA.CARGOS_5 + CA.CARGOS_6 + CA.CARGOS_7 + CA.CARGOS_8 + CA.CARGOS_9 + CA.CARGOS_10 + CA.CARGOS_11 + CA.CARGOS_12   CARGOS_ANT1,  
  CA.ABONOS_1 + CA.ABONOS_2 + CA.ABONOS_3 + CA.ABONOS_4 + CA.ABONOS_5 + CA.ABONOS_6 + CA.ABONOS_7 + CA.ABONOS_8 + CA.ABONOS_9 + CA.ABONOS_10 + CA.ABONOS_11 + CA.ABONOS_12  ABONOS_ANT1, 
   CU.CARGOS_1 + CU.CARGOS_2 + CU.CARGOS_3 + CU.CARGOS_4 + CU.CARGOS_5 + CU.CARGOS_6 + CU.CARGOS_7 + CU.CARGOS_8 + CU.CARGOS_9 + CU.CARGOS_10 + CU.CARGOS_11 + CU.CARGOS_12 CARGOS1,  
    CU.ABONOS_1 + CU.ABONOS_2 + CU.ABONOS_3 + CU.ABONOS_4 + CU.ABONOS_5 + CU.ABONOS_6 + CU.ABONOS_7 + CU.ABONOS_8 + CU.ABONOS_9 + CU.ABONOS_10 + CU.ABONOS_11 + CU.ABONOS_12 ABONOS1,  
     CU.CARGOS_1 + CU.CARGOS_2 + CU.CARGOS_3 + CU.CARGOS_4 + CU.CARGOS_5 + CU.CARGOS_6 + CU.CARGOS_7 + CU.CARGOS_8 + CU.CARGOS_9 + CU.CARGOS_10 + CU.CARGOS_11 + CU.CARGOS_12 CARGOS,   
     CU.ABONOS_1 + CU.ABONOS_2 + CU.ABONOS_3 + CU.ABONOS_4 + CU.ABONOS_5 + CU.ABONOS_6 + CU.ABONOS_7 + CU.ABONOS_8 + CU.ABONOS_9 + CU.ABONOS_10 + CU.ABONOS_11 + CU.ABONOS_12 ABONOS      FROM CUENTA_ANTERIOR CA,  CUENTA CU,        MAYCTA MA WHERE CU.CUENTA = CA.CUENTA AND CU.CUENTA = MA.CUENTA   AND SUBSTR(CU.CUENTA, 1,2) = '12'   AND SUBSTR(CU.CUENTA, 4,1) <> '0'   AND CU.SCTA = ''   AND MA.NATCTA = 'D' ) T1 GROUP BY T1.PRINCIPAL, T1.GRUPO, T1.CUENTA, T1.NOMCTA UNION ALL SELECT 2 PRINCIPAL,        3 GRUPO,        '1210' CUENTA,        'Otros Orígenes de Inversión' NOMCTA,        0 SALDO_ANT,        0 SALDO_ACT      FROM SYSIBM.SYSDUMMY1 UNION ALL SELECT 2 PRINCIPAL,        4 GRUPO,        '1100' CUENTA,        'Bienes Inmuebles, Infraestructura y Construcciones en Proceso' NOMCTA,        0 SALDO_ANT,        0 SALDO_ACT      FROM SYSIBM.SYSDUMMY1 
 UNION ALL 
 SELECT 2 PRINCIPAL,        4 GRUPO,        '1110' CUENTA,        'Bienes Muebles' NOMCTA,        0 SALDO_ANT,        0 SALDO_ACT      FROM SYSIBM.SYSDUMMY1 
 
 UNION ALL 
 SELECT T1.PRINCIPAL,        T1.GRUPO,        T1.CUENTA,        T1.NOMCTA,        ABS(SUM((T1.SALINI + CARGOS_ANT - ABONOS_ANT) - (T1.SALINI + CARGOS_ANT1 -ABONOS_ANT1 ))) SALDO_ANT,        ABS(SUM((T1.SALINI + CARGOS - ABONOS) - (T1.SALINI + CARGOS1 - ABONOS1))) SALDO_ACT       FROM(  SELECT 2 PRINCIPAL,        4 GRUPO,       '1120' CUENTA,        'Otras Aplicaciones de Inversion' NOMCTA,        CU.SALINI,   
 CA.CARGOS_1 + CA.CARGOS_2 + CA.CARGOS_3 + CA.CARGOS_4 + CA.CARGOS_5 + CA.CARGOS_6 + CA.CARGOS_7 + CA.CARGOS_8 + CA.CARGOS_9 + CA.CARGOS_10 + CA.CARGOS_11 + CA.CARGOS_12 CARGOS_ANT,  
CA.ABONOS_1 + CA.ABONOS_2 + CA.ABONOS_3 + CA.ABONOS_4 + CA.ABONOS_5 + CA.ABONOS_6 + CA.ABONOS_7 + CA.ABONOS_8 + CA.ABONOS_9 + CA.ABONOS_10 + CA.ABONOS_11 + CA.ABONOS_12  ABONOS_ANT, 
  CA.CARGOS_1 + CA.CARGOS_2 + CA.CARGOS_3 + CA.CARGOS_4 + CA.CARGOS_5 + CA.CARGOS_6 + CA.CARGOS_7 + CA.CARGOS_8 + CA.CARGOS_9 + CA.CARGOS_10 + CA.CARGOS_11 + CA.CARGOS_12   CARGOS_ANT1,  
 CA.ABONOS_1 + CA.ABONOS_2 + CA.ABONOS_3 + CA.ABONOS_4 + CA.ABONOS_5 + CA.ABONOS_6 + CA.ABONOS_7 + CA.ABONOS_8 + CA.ABONOS_9 + CA.ABONOS_10 + CA.ABONOS_11 + CA.ABONOS_12    ABONOS_ANT1,  
 CU.CARGOS_1 + CU.CARGOS_2 + CU.CARGOS_3 + CU.CARGOS_4 + CU.CARGOS_5 + CU.CARGOS_6 + CU.CARGOS_7 + CU.CARGOS_8 + CU.CARGOS_9 + CU.CARGOS_10 + CU.CARGOS_11+ CU.CARGOS_12  CARGOS1,   
 CU.ABONOS_1 + CU.ABONOS_2 + CU.ABONOS_3 + CU.ABONOS_4 + CU.ABONOS_5 + CU.ABONOS_6 + CU.ABONOS_7 + CU.ABONOS_8 + CU.ABONOS_9 + CU.ABONOS_10 + CU.ABONOS_11 + CU.ABONOS_12   ABONOS1,   
 CU.CARGOS_1 + CU.CARGOS_2 + CU.CARGOS_3 + CU.CARGOS_4 + CU.CARGOS_5 + CU.CARGOS_6 + CU.CARGOS_7 + CU.CARGOS_8 + CU.CARGOS_9 + CU.CARGOS_10 + CU.CARGOS_11 + CU.CARGOS_12 CARGOS,   
 CU.ABONOS_1 + CU.ABONOS_2 + CU.ABONOS_3 + CU.ABONOS_4 + CU.ABONOS_5 + CU.ABONOS_6 + CU.ABONOS_7 + CU.ABONOS_8 + CU.ABONOS_9 + CU.ABONOS_10 + CU.ABONOS_11 + CU.ABONOS_12 ABONOS      
 FROM CUENTA_ANTERIOR CA, CUENTA CU,        MAYCTA MA  WHERE CU.CUENTA = CA.CUENTA AND  CU.CUENTA = MA.CUENTA   AND CU.CUENTA IN( '1123' , '1263')   AND CU.SCTA = '' ) T1 GROUP BY  T1.PRINCIPAL,        T1.GRUPO,        T1.CUENTA,        T1.NOMCTA 
 UNION ALL 
 SELECT 3 PRINCIPAL,        5 GRUPO,        '2000' CUENTA,        'Endeudamiento Neto' NOMCTA,        0 SALDO_ANT,        0 SALDO_ACT      FROM SYSIBM.SYSDUMMY1 
 UNION ALL 
 SELECT 3 PRINCIPAL,        5 GRUPO,        '2100' CUENTA,        '    Interno' NOMCTA,        0 SALDO_ANT,        0 SALDO_ACT      FROM SYSIBM.SYSDUMMY1 
 
 UNION ALL 
 SELECT 3 PRINCIPAL,        5 GRUPO,        '2110' CUENTA,        '    Externo' NOMCTA,        0 SALDO_ANT,        0 SALDO_ACT      FROM SYSIBM.SYSDUMMY1 

 UNION ALL
  SELECT T1.PRINCIPAL,        T1.GRUPO,        T1.CUENTA,        T1.NOMCTA,        
  ABS(SUM((T1.SALINIANT + CARGOS_ANT - ABONOS_ANT) - (T1.SALINIANT + CARGOS_ANT1 -ABONOS_ANT1 ))) SALDO_ANT,       
   ABS(SUM((T1.SALINI + CARGOS - ABONOS) - (T1.SALINI + CARGOS1 - ABONOS1))) SALDO_ACT       
 FROM(  SELECT 3 PRINCIPAL,        5 GRUPO,        CU.CUENTA,        'Otros Orígenes de Financiamiento' NOMCTA,        CU.SALINI,  CA.SALINIANT ,
CA.CARGOS_1 + CA.CARGOS_2 + CA.CARGOS_3 + CA.CARGOS_4 + CA.CARGOS_5 + CA.CARGOS_6 + CA.CARGOS_7 + CA.CARGOS_8 + CA.CARGOS_9 + CA.CARGOS_10 + CA.CARGOS_11 + CA.CARGOS_12   CARGOS_ANT,  
 CA.ABONOS_1 + CA.ABONOS_2 + CA.ABONOS_3 + CA.ABONOS_4 + CA.ABONOS_5 + CA.ABONOS_6 + CA.ABONOS_7 + CA.ABONOS_8 + CA.ABONOS_9 + CA.ABONOS_10 + CA.ABONOS_11 + CA.ABONOS_12    ABONOS_ANT,    
CA.CARGOS_1 + CA.CARGOS_2 + CA.CARGOS_3 + CA.CARGOS_4 + CA.CARGOS_5 + CA.CARGOS_6 + CA.CARGOS_7 + CA.CARGOS_8 + CA.CARGOS_9 + CA.CARGOS_10 + CA.CARGOS_11 + CA.CARGOS_12  CARGOS_ANT1,   
 CA.ABONOS_1 + CA.ABONOS_2 + CA.ABONOS_3 + CA.ABONOS_4 + CA.ABONOS_5 + CA.ABONOS_6 + CA.ABONOS_7 + CA.ABONOS_8 + CA.ABONOS_9 + CA.ABONOS_10 + CA.ABONOS_11 + CA.ABONOS_12   ABONOS_ANT1,   
 CU.CARGOS_1 + CU.CARGOS_2 + CU.CARGOS_3 + CU.CARGOS_4 + CU.CARGOS_5 + CU.CARGOS_6 + CU.CARGOS_7 + CU.CARGOS_8 + CU.CARGOS_9 + CU.CARGOS_10 + CU.CARGOS_11 + CU.CARGOS_12  CARGOS1,   
 CU.ABONOS_1 + CU.ABONOS_2 + CU.ABONOS_3 + CU.ABONOS_4 + CU.ABONOS_5 + CU.ABONOS_6 + CU.ABONOS_7 + CU.ABONOS_8 + CU.ABONOS_9 + CU.ABONOS_10 + CU.ABONOS_11  ABONOS1,   
 CU.CARGOS_1 + CU.CARGOS_2 + CU.CARGOS_3 + CU.CARGOS_4 + CU.CARGOS_5 + CU.CARGOS_6 + CU.CARGOS_7 + CU.CARGOS_8 + CU.CARGOS_9 + CU.CARGOS_10 + CU.CARGOS_11 + CU.CARGOS_12 CARGOS,   
 CU.ABONOS_1 + CU.ABONOS_2 + CU.ABONOS_3 + CU.ABONOS_4 + CU.ABONOS_5 + CU.ABONOS_6 + CU.ABONOS_7 + CU.ABONOS_8 + CU.ABONOS_9 + CU.ABONOS_10 + CU.ABONOS_11 + CU.ABONOS_12 ABONOS      
 FROM  CUENTA_ANTERIOR CA,CUENTA CU, MAYCTA MA  WHERE 
 CU.CUENTA = CA.CUENTA AND  
 CU.CUENTA = MA.CUENTA   AND 
 CU.CUENTA = '2117'   AND 
 CU.SCTA = ''  ) T1  GROUP BY  T1.PRINCIPAL,        T1.GRUPO,        T1.CUENTA,        T1.NOMCTA 

 UNION ALL 
 SELECT 3 PRINCIPAL,        6 GRUPO,        '3000' CUENTA,        'Servicios de la Deuda' NOMCTA,        
 0 SALDO_ANT,        0 SALDO_ACT      FROM SYSIBM.SYSDUMMY1 
 UNION ALL 
 SELECT 3 PRINCIPAL,        6 GRUPO,        '3100' CUENTA,        '    Interno' NOMCTA,        0 SALDO_ANT,        0 SALDO_ACT      FROM SYSIBM.SYSDUMMY1 
 UNION ALL 
 SELECT 3 PRINCIPAL,        6 GRUPO,        '3110' CUENTA,        '    Externo' NOMCTA,        0 SALDO_ANT,        0 SALDO_ACT      FROM SYSIBM.SYSDUMMY1 
 UNION ALL 
 SELECT 3 PRINCIPAL,        6 GRUPO,        '3211' CUENTA,        'Otras Aplicaciones de Financiamiento' NOMCTA,        FN_GET_3211(9, 'a') SALDO_ANT,        FN_GET_3211(12, 'a') SALDO_ACT      FROM SYSIBM.SYSDUMMY1 ORDER BY 1, 2, 3 ASC]]></query>
	<field name="PRINCIPAL" class="java.lang.Integer">
		<property name="com.jaspersoft.studio.field.name" value="PRINCIPAL"/>
		<property name="com.jaspersoft.studio.field.label" value="PRINCIPAL"/>
	</field>
	<field name="GRUPO" class="java.lang.Integer">
		<property name="com.jaspersoft.studio.field.name" value="GRUPO"/>
		<property name="com.jaspersoft.studio.field.label" value="GRUPO"/>
	</field>
	<field name="CUENTA" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="CUENTA"/>
		<property name="com.jaspersoft.studio.field.label" value="CUENTA"/>
	</field>
	<field name="NOMCTA" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="NOMCTA"/>
		<property name="com.jaspersoft.studio.field.label" value="NOMCTA"/>
	</field>
	<field name="SALDO_ANT" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="SALDO_ANT"/>
		<property name="com.jaspersoft.studio.field.label" value="SALDO_ANT"/>
	</field>
	<field name="SALDO_ACT" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="SALDO_ACT"/>
		<property name="com.jaspersoft.studio.field.label" value="SALDO_ACT"/>
	</field>
	<variable name="subTotalAct" resetType="Group" calculation="Sum" resetGroup="Group1" class="java.math.BigDecimal">
		<expression><![CDATA[$F{SALDO_ACT}]]></expression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="sumGroup1" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{GRUPO}  ==  1 ? $F{SALDO_ACT} : BigDecimal.ZERO]]></expression>
	</variable>
	<variable name="sumGroup2" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{GRUPO} ==2? $F{SALDO_ACT} : BigDecimal.ZERO]]></expression>
	</variable>
	<variable name="sumGroup3" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{GRUPO} == 3 ? $F{SALDO_ACT} : BigDecimal.ZERO]]></expression>
	</variable>
	<variable name="sumGroup4" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{GRUPO} == 4 ? $F{SALDO_ACT} : BigDecimal.ZERO]]></expression>
	</variable>
	<variable name="sumGroup5" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{GRUPO} == 5 ? $F{SALDO_ACT} : BigDecimal.ZERO]]></expression>
	</variable>
	<variable name="sumGroup6" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{GRUPO} == 6 ? $F{SALDO_ACT} : BigDecimal.ZERO]]></expression>
	</variable>
	<variable name="subTotalAnt" resetType="Group" calculation="Sum" resetGroup="Group1" class="java.math.BigDecimal">
		<expression><![CDATA[$F{SALDO_ANT}]]></expression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="sumGroupAnt1" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{GRUPO}  ==  1 ? $F{SALDO_ANT} : BigDecimal.ZERO]]></expression>
	</variable>
	<variable name="sumGroupAnt2" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{GRUPO} ==2? $F{SALDO_ANT} : BigDecimal.ZERO]]></expression>
	</variable>
	<variable name="sumGroupAnt3" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{GRUPO} == 3 ? $F{SALDO_ANT} : BigDecimal.ZERO]]></expression>
	</variable>
	<variable name="sumGroupAnt4" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{GRUPO} == 4 ? $F{SALDO_ANT} : BigDecimal.ZERO]]></expression>
	</variable>
	<variable name="sumGroupAnt5" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{GRUPO} == 5 ? $F{SALDO_ANT} : BigDecimal.ZERO]]></expression>
	</variable>
	<variable name="sumGroupAnt6" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{GRUPO} == 6 ? $F{SALDO_ANT} : BigDecimal.ZERO]]></expression>
	</variable>
	<variable name="sumEfecEqiAct1" class="java.math.BigDecimal">
		<expression><![CDATA[$V{sumGroup1}.subtract($V{sumGroup2})]]></expression>
	</variable>
	<variable name="sumEfecEqiAct2" class="java.math.BigDecimal">
		<expression><![CDATA[$V{sumGroup3}.subtract($V{sumGroup4})]]></expression>
	</variable>
	<variable name="sumEfecEqiAct3" class="java.math.BigDecimal">
		<expression><![CDATA[$V{sumGroup5}.subtract($V{sumGroup6})]]></expression>
	</variable>
	<variable name="sumEfecEqiAnt1" class="java.math.BigDecimal">
		<expression><![CDATA[$V{sumGroupAnt1}.subtract($V{sumGroupAnt2})]]></expression>
	</variable>
	<variable name="sumEfecEqiAnt2" class="java.math.BigDecimal">
		<expression><![CDATA[$V{sumGroupAnt3}.subtract($V{sumGroupAnt4})]]></expression>
	</variable>
	<variable name="sumEfecEqiAnt3" class="java.math.BigDecimal">
		<expression><![CDATA[$V{sumGroupAnt5}.subtract($V{sumGroupAnt6})]]></expression>
	</variable>
	<group name="Group2">
		<expression><![CDATA[$F{PRINCIPAL}]]></expression>
		<groupHeader>
			<band height="10">
