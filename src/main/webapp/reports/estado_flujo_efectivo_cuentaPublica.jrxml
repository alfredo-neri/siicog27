					<box>
						<leftPen lineWidth="1.0" lineStyle="Solid"/>
						<rightPen lineWidth="1.0" lineStyle="Solid"/>
					</box>
					<expression><![CDATA[$F{PRINCIPAL} == 1 ? $V{sumGroupAnt1}.subtract($V{sumGroupAnt2}) : $F{PRINCIPAL} == 2 ? $V{sumGroupAnt3}.subtract($V{sumGroupAnt4} ) : $V{sumGroupAnt5}.subtract($V{sumGroupAnt6}).compareTo(BigDecimal.ZERO) == 0 ? "" : $F{PRINCIPAL}]]></expression>
				</element>
			</band>
		</groupFooter>
	</group>
