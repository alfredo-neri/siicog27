		<element kind="textField" uuid="c96bfd1b-0cf5-4fea-82a0-68c2386d76bc" x="650" y="0" width="152" height="10" stretchType="NoStretch" fontSize="7.0" bold="true" hTextAlign="Center">
			<property name="com.jaspersoft.studio.spreadsheet.connectionID" value="035b955e-79eb-4455-a23e-e1e81af323f6"/>
			<property name="com.jaspersoft.studio.unit.height" value="px"/>
			<property name="com.jaspersoft.studio.unit.width" value="px"/>
