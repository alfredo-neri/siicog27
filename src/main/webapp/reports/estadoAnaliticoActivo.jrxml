	<variable name="saldoFinal" class="java.math.BigDecimal">
		<expression><![CDATA[$F{SALINIANT}.add($F{CARGOS}).subtract($F{ABONOS})]]></expression>
	</variable>
	<variable name="variacion" class="java.math.BigDecimal">
		<expression><![CDATA[$V{saldoFinal}.subtract($F{SALINIANT})]]></expression>
	</variable>
	<variable name="sumSaldoInicial" calculation="Sum" class="java.math.BigDecimal">
