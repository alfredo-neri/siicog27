			<element kind="textField" uuid="4787fc18-cc10-4a52-a27a-28c346d2fa12" x="0" y="0" width="800" height="30" stretchType="NoStretch" fontName="Arial" vTextAlign="Middle">
				<expression><![CDATA[$V{REPORTE_TXT}]]></expression>
