	<query language="sql"><![CDATA[SELECT PM.ANUAL,
       PM.IPM,
       PM.TDR,
       PM.OBSIPM,
       PM.OBSTDR
     FROM PM1011 PM
WHERE PM.IDSECTOR=$P{pIdSector}
    AND ANUAL =$P{pAnio}]]></query>
	<field name="ANUAL" class="java.lang.Integer"/>
	<field name="IPM" class="java.lang.Integer"/>
