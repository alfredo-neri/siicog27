	<columnFooter height="115" splitType="Stretch">
		<element kind="staticText" uuid="97004abc-a545-43cb-a396-a1abe097c0af" x="80" y="12" width="722" height="10" stretchType="NoStretch" fontName="Arial" fontSize="8.0" bold="false" hTextAlign="Left" vTextAlign="Middle"
			><text><![CDATA[A efecto de que puede llevarse a cabo la entrega de los recursos de los Fondos a las Entidades Federativas, éstas deberan contar, a mas tardar el último día hábil]]></text>
		</element>
		<element kind="staticText" uuid="edec4c2d-9bd9-424e-87df-631e757222d6" x="80" y="22" width="722" height="10" stretchType="NoStretch" fontName="Arial" fontSize="8.0" hTextAlign="Left" vTextAlign="Middle"
			><text><![CDATA[del mes de enero del 2011, con cuentas bancarias productivas específicas para cada uno de los Fondos, debidamente registradas ante la Tesorería del GEM.]]></text>
		</element>
		<element kind="staticText" uuid="cae910fb-8377-459f-b667-754d5c910582" x="40" y="2" width="40" height="10" stretchType="NoStretch" fontName="Arial" fontSize="8.0" bold="true" hTextAlign="Left" vTextAlign="Middle"
