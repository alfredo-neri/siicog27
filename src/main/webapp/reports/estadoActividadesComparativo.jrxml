				<textField pattern="#,##0.00">
					<reportElement x="502" y="0" width="70" height="15" uuid="62370bbe-e830-464c-ac58-e765120750a4">
						<property name="com.jaspersoft.studio.spreadsheet.connectionID" value="bad26e06-6c6f-4a79-9805-a7690ecae4dd"/>
