	<subDataset name="DatasetDetalle" uuid="641123b3-eadc-465d-a9a3-8feb56c00d4e">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Local2021"/>
		<parameter name="cuenta" class="java.lang.String"/>
		<parameter name="sector" class="java.lang.Integer"/>
		<parameter name="decimalFormat" class="java.lang.String"/>
		<parameter name="pesos" class="java.lang.Integer"/>
		<parameter name="query" class="java.lang.String"/>
		<queryString language="SQL">
			<![CDATA[$P!{query}]]>
		</queryString>
		<field name="NOMCTA" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="NOMCTA"/>
			<property name="com.jaspersoft.studio.field.label" value="NOMCTA"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="CUENTA"/>
		</field>
		<field name="STACTA" class="java.lang.String"/>
		<field name="CARGOS" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="CARGOS"/>
			<property name="com.jaspersoft.studio.field.label" value="CARGOS"/>
		</field>
		<field name="ABONOS" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="ABONOS"/>
			<property name="com.jaspersoft.studio.field.label" value="ABONOS"/>
		</field>
		<field name="SALINIANT" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="SALINIANT"/>
			<property name="com.jaspersoft.studio.field.label" value="SALINIANT"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="CUENTA"/>
		</field>
		<variable name="importe" class="java.math.BigDecimal">
			<variableExpression><![CDATA[$P{pesos} ==1 ? 
		$F{STACTA}.equals("D") ? $F{CARGOS}.subtract($F{ABONOS}) : $F{ABONOS}.subtract($F{CARGOS}) 
		: 
		$F{STACTA}.equals("D") ? $F{CARGOS}.subtract($F{ABONOS}).divide(new BigDecimal("1000.0")) :$F{ABONOS}.subtract($F{CARGOS}).divide(new BigDecimal("1000.0"))]]></variableExpression>
		</variable>
		<variable name="variacion" class="java.math.BigDecimal">
			<variableExpression><![CDATA[$P{pesos} ==1 ? $V{importe}.subtract($F{SALINIANT}) : $V{importe}.subtract($F{SALINIANT}).divide(new BigDecimal("1000.0"))]]></variableExpression>
		</variable>
		<variable name="porcentaje" class="java.lang.Double">
			<variableExpression><![CDATA[$V{importe}.compareTo(BigDecimal.ZERO) == 0 ? 0.0 : ($V{variacion}.floatValue()  / $V{importe}.floatValue() ) * 100.0]]></variableExpression>
		</variable>
	</subDataset>
	<subDataset name="DatasetTotales" uuid="bae61f4c-364e-4a29-8932-63eba7175b6e">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="gem2020Local"/>
		<parameter name="sector" class="java.lang.Integer"/>
		<parameter name="decimalFormat" class="java.lang.String"/>
		<parameter name="pesos" class="java.lang.Integer"/>
		<queryString language="SQL">
			<![CDATA[SELECT (SUM(DECODE(CUENTA, '4000', ABONOS - CARGOS, 0)) - SUM(DECODE(CUENTA, '5000', CARGOS- ABONOS, 0)) ) IMPORTE,
	   (SUM(DECODE(CUENTA, '4000', SALINIANT, 0)) - SUM(DECODE(CUENTA, '5000', SALINIANT, 0)) ) SALANT 
	FROM (
SELECT CUENTA, SUM(CARGOS_1 + CARGOS_2 + CARGOS_3 + CARGOS_4 + CARGOS_5 + CARGOS_6 + CARGOS_7 + CARGOS_8 + CARGOS_9 + CARGOS_10 + CARGOS_11 + CARGOS_12) CARGOS,
               SUM(ABONOS_1 + ABONOS_2 + ABONOS_3 + ABONOS_4 + ABONOS_5 + ABONOS_6 + ABONOS_7 + ABONOS_8 + ABONOS_9 + ABONOS_10 + ABONOS_11 + ABONOS_12) ABONOS,
               SUM(SALINIANT) SALINIANT
                       
  FROM CUENTA
WHERE IDSECTOR = $P{sector}
  AND SUBSTR(CUENTA, 2, 3 ) = '000'
  AND SUBSTR(CUENTA, 1, 1) IN ('4','5')
  AND SCTA = ''
GROUP BY CUENTA
)T1]]>
		</queryString>
		<field name="IMPORTE" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="IMPORTE"/>
			<property name="com.jaspersoft.studio.field.label" value="IMPORTE"/>
		</field>
		<field name="SALANT" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="SALANT"/>
			<property name="com.jaspersoft.studio.field.label" value="SALANT"/>
		</field>
		<variable name="variacion" class="java.math.BigDecimal">
			<variableExpression><![CDATA[$F{IMPORTE}.subtract($F{SALANT})]]></variableExpression>
		</variable>
		<variable name="porcentaje" class="java.math.BigDecimal">
			<variableExpression><![CDATA[$F{IMPORTE}.compareTo(BigDecimal.ZERO) == 0 ? BigDecimal.ZERO : $V{variacion}.divide($F{IMPORTE},5).multiply(new BigDecimal("100.0"))]]></variableExpression>
		</variable>
	</subDataset>
	<parameter name="year" class="java.lang.Integer"/>
	<parameter name="sector" class="java.lang.Integer"/>
	<parameter name="imagenPathLeft" class="java.lang.String">
		<parameterDescription><![CDATA[]]></parameterDescription>
	</parameter>
