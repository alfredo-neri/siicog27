	</parameter>
	<parameter name="nombreEntidad" class="java.lang.String">
		<parameterDescription><![CDATA[]]></parameterDescription>
		<defaultValueExpression><![CDATA["XONA"]]></defaultValueExpression>
	</parameter>
	<parameter name="decimalFormat" class="java.lang.String"/>
	<parameter name="pesos" class="java.lang.Integer"/>
	<parameter name="noFirmas" class="java.lang.Integer"/>
	<parameter name="firmaL1" class="java.lang.String"/>
	<parameter name="firmaN1" class="java.lang.String"/>
	<parameter name="firmaL2" class="java.lang.String"/>
	<parameter name="firmaN2" class="java.lang.String"/>
	<parameter name="firmaL3" class="java.lang.String"/>
	<parameter name="firmaN3" class="java.lang.String"/>
	<parameter name="firmaL4" class="java.lang.String"/>
	<parameter name="firmaN4" class="java.lang.String"/>
	<parameter name="firmaL5" class="java.lang.String"/>
	<parameter name="firmaN5" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT CUENTA, NOMCTA, UPPER(STACTA) STACTA, (CARGOS_1 + CARGOS_2 + CARGOS_3 + CARGOS_4 + CARGOS_5 + CARGOS_6 + CARGOS_7 + CARGOS_8 + CARGOS_9 + CARGOS_10 + CARGOS_11 + CARGOS_12) CARGOS,
                       (ABONOS_1 + ABONOS_2 + ABONOS_3 + ABONOS_4 + ABONOS_5 + ABONOS_6 + ABONOS_7 + ABONOS_8 + ABONOS_9 + ABONOS_10 + ABONOS_11 + ABONOS_12) ABONOS,
                       SALINIANT
                       
  FROM CUENTA
WHERE IDSECTOR = $P{sector}
  AND SUBSTR(CUENTA, 3, 2 ) = '00'
  AND SUBSTR(CUENTA, 1, 1) IN ('4','5')
  AND SCTA = ''
ORDER BY CUENTA, SCTA, SSCTA, SSSCTA, SSSSCTA]]>
	</queryString>
	<field name="CUENTA" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="CUENTA"/>
		<property name="com.jaspersoft.studio.field.label" value="CUENTA"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="CUENTA"/>
	</field>
	<field name="NOMCTA" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="NOMCTA"/>
		<property name="com.jaspersoft.studio.field.label" value="NOMCTA"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="CUENTA"/>
	</field>
	<field name="STACTA" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="STACTA"/>
		<property name="com.jaspersoft.studio.field.label" value="STACTA"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="CUENTA"/>
	</field>
	<field name="CARGOS" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="CARGOS"/>
		<property name="com.jaspersoft.studio.field.label" value="CARGOS"/>
	</field>
	<field name="ABONOS" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="ABONOS"/>
		<property name="com.jaspersoft.studio.field.label" value="ABONOS"/>
	</field>
	<field name="SALINIANT" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="SALINIANT"/>
		<property name="com.jaspersoft.studio.field.label" value="SALINIANT"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="CUENTA"/>
	</field>
	<variable name="importeActual" class="java.math.BigDecimal">
		<variableExpression><![CDATA[$P{pesos} ==1 ? 
		$F{CUENTA}.substring(0,1).equals("5") ? $F{CARGOS}.subtract($F{ABONOS}) : $F{ABONOS}.subtract($F{CARGOS}) 
		:
		$F{CUENTA}.substring(0,1).equals("5") ?
 				$F{CARGOS}.subtract($F{ABONOS}).divide(new BigDecimal("1000.0")) : $F{ABONOS}.subtract($F{CARGOS}).divide(new BigDecimal("1000.0"))]]></variableExpression>
	</variable>
	<variable name="variacion" class="java.math.BigDecimal">
		<variableExpression><![CDATA[$P{pesos} ==1 ? $V{importeActual}.subtract($F{SALINIANT}) : $V{importeActual}.subtract($F{SALINIANT}).divide(new BigDecimal("1000.0"))]]></variableExpression>
	</variable>
	<variable name="query" class="java.lang.String">
		<variableExpression><![CDATA[$F{CUENTA}.substring(0,1).equals("4")? 
		"SELECT CUENTA, UPPER(STACTA) STACTA, NOMCTA, (CARGOS_1 + CARGOS_2 + CARGOS_3 + CARGOS_4 + CARGOS_5 + CARGOS_6 + CARGOS_7 + CARGOS_8 + CARGOS_9 + CARGOS_10 + CARGOS_11 + CARGOS_12) CARGOS,  (ABONOS_1 + ABONOS_2 + ABONOS_3 + ABONOS_4 + ABONOS_5 + ABONOS_6 + ABONOS_7 + ABONOS_8 + ABONOS_9 + ABONOS_10 + ABONOS_11 + ABONOS_12) ABONOS, SALINIANT   FROM CUENTA WHERE IDSECTOR = "+ $P{sector} +"  AND SUBSTR(CUENTA, 4, 1 ) = '0'   AND SUBSTR (CUENTA, 3, 1) <> '0'   AND SUBSTR(CUENTA, 1, 2) = '" + $F{CUENTA}.substring(0,2) + "'  AND SCTA = '' ORDER BY CUENTA, SCTA, SSCTA, SSSCTA, SSSSCTA" : 
		$F{CUENTA}.substring(0,2).equals("51") ? "SELECT CUENTA, UPPER(STACTA) STACTA, SUBSTR(SSSCTA,1,1)||'000' SCTA, NATGAS.NOMGAS NOMCTA, SUM(CARGOS_1 + CARGOS_2 + CARGOS_3 + CARGOS_4 + CARGOS_5 + CARGOS_6 + CARGOS_7 + CARGOS_8 + CARGOS_9 + CARGOS_10 + CARGOS_11 + CARGOS_12) CARGOS, SUM(ABONOS_1 + ABONOS_2 + ABONOS_3 + ABONOS_4 + ABONOS_5 + ABONOS_6 + ABONOS_7 + ABONOS_8 + ABONOS_9 + ABONOS_10 + ABONOS_11 + ABONOS_12) ABONOS,  SUM(SALINIANT) SALINIANT  FROM CUENTA	INNER JOIN NATGAS ON CUENTA.IDSECTOR = NATGAS.IDSECTOR AND SUBSTR(CUENTA.SSSCTA,1,1)||'000' = NATGAS.CLVGAS WHERE CUENTA.IDSECTOR = " + $P{sector} + 				"  AND SUBSTR(CUENTA, 1, 2) = '51'  AND SSSCTA <> '' GROUP BY CUENTA, UPPER(STACTA), SUBSTR(SSSCTA,1,1)||'000', NATGAS.NOMGAS ORDER BY CUENTA, SCTA" : 
		$F{CUENTA}.substring(0,2).equals("55") ? "SELECT CUENTA, UPPER(STACTA) STACTA, SCTA, NOMCTA, SUM(CARGOS_1 + CARGOS_2 + CARGOS_3 + CARGOS_4 + CARGOS_5 + CARGOS_6 + CARGOS_7 + CARGOS_8 + CARGOS_9 + CARGOS_10 + CARGOS_11 + CARGOS_12) CARGOS, SUM(ABONOS_1 + ABONOS_2 + ABONOS_3 + ABONOS_4 + ABONOS_5 + ABONOS_6 + ABONOS_7 + ABONOS_8 + ABONOS_9 + ABONOS_10 + ABONOS_11 + ABONOS_12) ABONOS,  SUM(SALINIANT) SALINIANT  FROM CUENTA WHERE CUENTA.IDSECTOR = " + $P{sector} + "  AND SUBSTR(CUENTA, 1, 2) = '55'  AND SSCTA = '' AND SCTA <> '' GROUP BY CUENTA, UPPER(STACTA), SCTA, NOMCTA ORDER BY CUENTA, SCTA":
		"SELECT CUENTA, UPPER(STACTA) STACTA, SUBSTR(SSSCTA,1,2)||'00' SCTA, NATGAS.NOMGAS NOMCTA, SUM(CARGOS_1 + CARGOS_2 + CARGOS_3 + CARGOS_4 + CARGOS_5 + CARGOS_6 + CARGOS_7 + CARGOS_8 + CARGOS_9 + CARGOS_10 + CARGOS_11 + CARGOS_12) CARGOS, SUM(ABONOS_1 + ABONOS_2 + ABONOS_3 + ABONOS_4 + ABONOS_5 + ABONOS_6 + ABONOS_7 + ABONOS_8 + ABONOS_9 + ABONOS_10 + ABONOS_11 + ABONOS_12) ABONOS,  SUM(SALINIANT) SALINIANT  FROM CUENTA	 	INNER JOIN NATGAS ON CUENTA.IDSECTOR = NATGAS.IDSECTOR AND SUBSTR(CUENTA.SSSCTA,1,2)||'00' = NATGAS.CLVGAS WHERE CUENTA.IDSECTOR = " + $P{sector} + "  AND SUBSTR(CUENTA, 1, 2) = '" + $F{CUENTA}.substring(0,2) + "' GROUP BY CUENTA, UPPER(STACTA), SUBSTR(SSSCTA,1,2)||'00', NATGAS.NOMGAS ORDER BY CUENTA, SCTA"]]></variableExpression>
	</variable>
	<variable name="porcentaje" class="java.lang.Double">
		<variableExpression><![CDATA[IF($V{importeActual}.compareTo( BigDecimal.ZERO ) == 0,0.0, ($V{variacion}.floatValue() / $V{importeActual}.floatValue() ) * 100.0)]]></variableExpression>
	</variable>
	<variable name="sumImporte" class="java.math.BigDecimal" resetType="Group" resetGroup="GroupCuenta" calculation="Sum">
		<variableExpression><![CDATA[$F{CUENTA}.substring(1,2).equals("0") ? BigDecimal.ZERO: $V{importeActual}]]></variableExpression>
	</variable>
	<variable name="sumImporteLast" class="java.math.BigDecimal" resetType="Group" resetGroup="GroupCuenta" calculation="Sum">
		<variableExpression><![CDATA[$F{CUENTA}.substring(1,2).equals("0") ? BigDecimal.ZERO: $F{SALINIANT}]]></variableExpression>
	</variable>
	<variable name="sumVariacion" class="java.math.BigDecimal" resetType="Group" resetGroup="GroupCuenta" calculation="Sum">
		<variableExpression><![CDATA[$F{CUENTA}.substring(1,2).equals("0") ? BigDecimal.ZERO: $V{variacion}]]></variableExpression>
	</variable>
	<variable name="sumPorcentaje" class="java.math.BigDecimal" resetType="Group" resetGroup="GroupCuenta">
		<variableExpression><![CDATA[$V{sumImporte}.compareTo( BigDecimal.ZERO ) ==0 ? BigDecimal.ZERO :$V{sumVariacion}.divide($V{sumImporte}, 5).multiply(new BigDecimal("100.0"))]]></variableExpression>
	</variable>
