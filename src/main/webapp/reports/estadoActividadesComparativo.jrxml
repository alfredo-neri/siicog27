	<dataset name="DatasetDetalle" uuid="641123b3-eadc-465d-a9a3-8feb56c00d4e">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Local2021"/>
		<parameter name="cuenta" class="java.lang.String"/>
		<parameter name="sector" class="java.lang.Integer"/>
		<parameter name="decimalFormat" class="java.lang.String"/>
		<parameter name="pesos" class="java.lang.Integer"/>
		<parameter name="query" class="java.lang.String"/>
		<query language="SQL"><![CDATA[$P!{query}]]></query>
		<field name="NOMCTA" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="NOMCTA"/>
			<property name="com.jaspersoft.studio.field.label" value="NOMCTA"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="CUENTA"/>
		</field>
		<field name="STACTA" class="java.lang.String"/>
		<field name="CARGOS" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="CARGOS"/>
			<property name="com.jaspersoft.studio.field.label" value="CARGOS"/>
		</field>
		<field name="ABONOS" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="ABONOS"/>
			<property name="com.jaspersoft.studio.field.label" value="ABONOS"/>
		</field>
		<field name="SALINIANT" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="SALINIANT"/>
			<property name="com.jaspersoft.studio.field.label" value="SALINIANT"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="CUENTA"/>
		</field>
		<variable name="importe" class="java.math.BigDecimal">
			<expression><![CDATA[$P{pesos} ==1 ? 
		$F{STACTA}.equals("D") ? $F{CARGOS}.subtract($F{ABONOS}) : $F{ABONOS}.subtract($F{CARGOS}) 
		: 
		$F{STACTA}.equals("D") ? $F{CARGOS}.subtract($F{ABONOS}).divide(new BigDecimal("1000.0")) :$F{ABONOS}.subtract($F{CARGOS}).divide(new BigDecimal("1000.0"))]]></expression>
		</variable>
		<variable name="variacion" class="java.math.BigDecimal">
			<expression><![CDATA[$P{pesos} ==1 ? $V{importe}.subtract($F{SALINIANT}) : $V{importe}.subtract($F{SALINIANT}).divide(new BigDecimal("1000.0"))]]></expression>
		</variable>
		<variable name="porcentaje" class="java.lang.Double">
			<expression><![CDATA[$V{importe}.compareTo(BigDecimal.ZERO) == 0 ? 0.0 : ($V{variacion}.floatValue()  / $V{importe}.floatValue() ) * 100.0]]></expression>
		</variable>
	</dataset>
	<dataset name="DatasetTotales" uuid="bae61f4c-364e-4a29-8932-63eba7175b6e">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="gem2020Local"/>
		<parameter name="sector" class="java.lang.Integer"/>
		<parameter name="decimalFormat" class="java.lang.String"/>
		<parameter name="pesos" class="java.lang.Integer"/>
		<query language="SQL"><![CDATA[SELECT (SUM(DECODE(CUENTA, '4000', ABONOS - CARGOS, 0)) - SUM(DECODE(CUENTA, '5000', CARGOS- ABONOS, 0)) ) IMPORTE,
	   (SUM(DECODE(CUENTA, '4000', SALINIANT, 0)) - SUM(DECODE(CUENTA, '5000', SALINIANT, 0)) ) SALANT 
	FROM (
SELECT CUENTA, SUM(CARGOS_1 + CARGOS_2 + CARGOS_3 + CARGOS_4 + CARGOS_5 + CARGOS_6 + CARGOS_7 + CARGOS_8 + CARGOS_9 + CARGOS_10 + CARGOS_11 + CARGOS_12) CARGOS,
               SUM(ABONOS_1 + ABONOS_2 + ABONOS_3 + ABONOS_4 + ABONOS_5 + ABONOS_6 + ABONOS_7 + ABONOS_8 + ABONOS_9 + ABONOS_10 + ABONOS_11 + ABONOS_12) ABONOS,
               SUM(SALINIANT) SALINIANT
                       
  FROM CUENTA
WHERE IDSECTOR = $P{sector}
  AND SUBSTR(CUENTA, 2, 3 ) = '000'
  AND SUBSTR(CUENTA, 1, 1) IN ('4','5')
  AND SCTA = ''
GROUP BY CUENTA
)T1]]></query>
		<field name="IMPORTE" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="IMPORTE"/>
			<property name="com.jaspersoft.studio.field.label" value="IMPORTE"/>
		</field>
		<field name="SALANT" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="SALANT"/>
			<property name="com.jaspersoft.studio.field.label" value="SALANT"/>
		</field>
		<variable name="variacion" class="java.math.BigDecimal">
			<expression><![CDATA[$F{IMPORTE}.subtract($F{SALANT})]]></expression>
		</variable>
		<variable name="porcentaje" class="java.math.BigDecimal">
			<expression><![CDATA[$F{IMPORTE}.compareTo(BigDecimal.ZERO) == 0 ? BigDecimal.ZERO : $V{variacion}.divide($F{IMPORTE},5).multiply(new BigDecimal("100.0"))]]></expression>
		</variable>
	</dataset>
	<parameter name="year" class="java.lang.Integer"/>
	<parameter name="sector" class="java.lang.Integer"/>
	<parameter name="imagenPathLeft" class="java.lang.String"
		><description><![CDATA[]]></description>
	</parameter>
	<parameter name="claveEntidad" class="java.lang.String"
		><description><![CDATA[]]></description>
		<defaultValueExpression><![CDATA["XONA"]]></defaultValueExpression>
	</parameter>
	<parameter name="nombreEntidad" class="java.lang.String"
		><description><![CDATA[]]></description>
		<defaultValueExpression><![CDATA["XONA"]]></defaultValueExpression>
	</parameter>
	<parameter name="decimalFormat" class="java.lang.String"/>
	<parameter name="pesos" class="java.lang.Integer"/>
	<parameter name="noFirmas" class="java.lang.Integer"/>
	<parameter name="firmaL1" class="java.lang.String"/>
	<parameter name="firmaN1" class="java.lang.String"/>
	<parameter name="firmaL2" class="java.lang.String"/>
	<parameter name="firmaN2" class="java.lang.String"/>
	<parameter name="firmaL3" class="java.lang.String"/>
	<parameter name="firmaN3" class="java.lang.String"/>
	<parameter name="firmaL4" class="java.lang.String"/>
	<parameter name="firmaN4" class="java.lang.String"/>
	<parameter name="firmaL5" class="java.lang.String"/>
	<parameter name="firmaN5" class="java.lang.String"/>
	<query language="SQL"><![CDATA[SELECT CUENTA, NOMCTA, UPPER(STACTA) STACTA, (CARGOS_1 + CARGOS_2 + CARGOS_3 + CARGOS_4 + CARGOS_5 + CARGOS_6 + CARGOS_7 + CARGOS_8 + CARGOS_9 + CARGOS_10 + CARGOS_11 + CARGOS_12) CARGOS,
                       (ABONOS_1 + ABONOS_2 + ABONOS_3 + ABONOS_4 + ABONOS_5 + ABONOS_6 + ABONOS_7 + ABONOS_8 + ABONOS_9 + ABONOS_10 + ABONOS_11 + ABONOS_12) ABONOS,
                       SALINIANT
                       
  FROM CUENTA
WHERE IDSECTOR = $P{sector}
  AND SUBSTR(CUENTA, 3, 2 ) = '00'
  AND SUBSTR(CUENTA, 1, 1) IN ('4','5')
  AND SCTA = ''
ORDER BY CUENTA, SCTA, SSCTA, SSSCTA, SSSSCTA]]></query>
	<field name="CUENTA" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="CUENTA"/>
		<property name="com.jaspersoft.studio.field.label" value="CUENTA"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="CUENTA"/>
	</field>
	<field name="NOMCTA" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="NOMCTA"/>
		<property name="com.jaspersoft.studio.field.label" value="NOMCTA"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="CUENTA"/>
	</field>
	<field name="STACTA" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="STACTA"/>
		<property name="com.jaspersoft.studio.field.label" value="STACTA"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="CUENTA"/>
	</field>
	<field name="CARGOS" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="CARGOS"/>
		<property name="com.jaspersoft.studio.field.label" value="CARGOS"/>
	</field>
	<field name="ABONOS" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="ABONOS"/>
		<property name="com.jaspersoft.studio.field.label" value="ABONOS"/>
	</field>
	<field name="SALINIANT" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="SALINIANT"/>
		<property name="com.jaspersoft.studio.field.label" value="SALINIANT"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="CUENTA"/>
	</field>
	<variable name="importeActual" class="java.math.BigDecimal">
		<expression><![CDATA[$P{pesos} ==1 ? 
		$F{CUENTA}.substring(0,1).equals("5") ? $F{CARGOS}.subtract($F{ABONOS}) : $F{ABONOS}.subtract($F{CARGOS}) 
		:
		$F{CUENTA}.substring(0,1).equals("5") ?
 				$F{CARGOS}.subtract($F{ABONOS}).divide(new BigDecimal("1000.0")) : $F{ABONOS}.subtract($F{CARGOS}).divide(new BigDecimal("1000.0"))]]></expression>
	</variable>
	<variable name="variacion" class="java.math.BigDecimal">
		<expression><![CDATA[$P{pesos} ==1 ? $V{importeActual}.subtract($F{SALINIANT}) : $V{importeActual}.subtract($F{SALINIANT}).divide(new BigDecimal("1000.0"))]]></expression>
	</variable>
	<variable name="query" class="java.lang.String">
		<expression><![CDATA[$F{CUENTA}.substring(0,1).equals("4")? 
		"SELECT CUENTA, UPPER(STACTA) STACTA, NOMCTA, (CARGOS_1 + CARGOS_2 + CARGOS_3 + CARGOS_4 + CARGOS_5 + CARGOS_6 + CARGOS_7 + CARGOS_8 + CARGOS_9 + CARGOS_10 + CARGOS_11 + CARGOS_12) CARGOS,  (ABONOS_1 + ABONOS_2 + ABONOS_3 + ABONOS_4 + ABONOS_5 + ABONOS_6 + ABONOS_7 + ABONOS_8 + ABONOS_9 + ABONOS_10 + ABONOS_11 + ABONOS_12) ABONOS, SALINIANT   FROM CUENTA WHERE IDSECTOR = "+ $P{sector} +"  AND SUBSTR(CUENTA, 4, 1 ) = '0'   AND SUBSTR (CUENTA, 3, 1) <> '0'   AND SUBSTR(CUENTA, 1, 2) = '" + $F{CUENTA}.substring(0,2) + "'  AND SCTA = '' ORDER BY CUENTA, SCTA, SSCTA, SSSCTA, SSSSCTA" : 
		$F{CUENTA}.substring(0,2).equals("51") ? "SELECT CUENTA, UPPER(STACTA) STACTA, SUBSTR(SSSCTA,1,1)||'000' SCTA, NATGAS.NOMGAS NOMCTA, SUM(CARGOS_1 + CARGOS_2 + CARGOS_3 + CARGOS_4 + CARGOS_5 + CARGOS_6 + CARGOS_7 + CARGOS_8 + CARGOS_9 + CARGOS_10 + CARGOS_11 + CARGOS_12) CARGOS, SUM(ABONOS_1 + ABONOS_2 + ABONOS_3 + ABONOS_4 + ABONOS_5 + ABONOS_6 + ABONOS_7 + ABONOS_8 + ABONOS_9 + ABONOS_10 + ABONOS_11 + ABONOS_12) ABONOS,  SUM(SALINIANT) SALINIANT  FROM CUENTA	INNER JOIN NATGAS ON CUENTA.IDSECTOR = NATGAS.IDSECTOR AND SUBSTR(CUENTA.SSSCTA,1,1)||'000' = NATGAS.CLVGAS WHERE CUENTA.IDSECTOR = " + $P{sector} + 				"  AND SUBSTR(CUENTA, 1, 2) = '51'  AND SSSCTA <> '' GROUP BY CUENTA, UPPER(STACTA), SUBSTR(SSSCTA,1,1)||'000', NATGAS.NOMGAS ORDER BY CUENTA, SCTA" : 
		$F{CUENTA}.substring(0,2).equals("55") ? "SELECT CUENTA, UPPER(STACTA) STACTA, SCTA, NOMCTA, SUM(CARGOS_1 + CARGOS_2 + CARGOS_3 + CARGOS_4 + CARGOS_5 + CARGOS_6 + CARGOS_7 + CARGOS_8 + CARGOS_9 + CARGOS_10 + CARGOS_11 + CARGOS_12) CARGOS, SUM(ABONOS_1 + ABONOS_2 + ABONOS_3 + ABONOS_4 + ABONOS_5 + ABONOS_6 + ABONOS_7 + ABONOS_8 + ABONOS_9 + ABONOS_10 + ABONOS_11 + ABONOS_12) ABONOS,  SUM(SALINIANT) SALINIANT  FROM CUENTA WHERE CUENTA.IDSECTOR = " + $P{sector} + "  AND SUBSTR(CUENTA, 1, 2) = '55'  AND SSCTA = '' AND SCTA <> '' GROUP BY CUENTA, UPPER(STACTA), SCTA, NOMCTA ORDER BY CUENTA, SCTA":
		"SELECT CUENTA, UPPER(STACTA) STACTA, SUBSTR(SSSCTA,1,2)||'00' SCTA, NATGAS.NOMGAS NOMCTA, SUM(CARGOS_1 + CARGOS_2 + CARGOS_3 + CARGOS_4 + CARGOS_5 + CARGOS_6 + CARGOS_7 + CARGOS_8 + CARGOS_9 + CARGOS_10 + CARGOS_11 + CARGOS_12) CARGOS, SUM(ABONOS_1 + ABONOS_2 + ABONOS_3 + ABONOS_4 + ABONOS_5 + ABONOS_6 + ABONOS_7 + ABONOS_8 + ABONOS_9 + ABONOS_10 + ABONOS_11 + ABONOS_12) ABONOS,  SUM(SALINIANT) SALINIANT  FROM CUENTA	 	INNER JOIN NATGAS ON CUENTA.IDSECTOR = NATGAS.IDSECTOR AND SUBSTR(CUENTA.SSSCTA,1,2)||'00' = NATGAS.CLVGAS WHERE CUENTA.IDSECTOR = " + $P{sector} + "  AND SUBSTR(CUENTA, 1, 2) = '" + $F{CUENTA}.substring(0,2) + "' GROUP BY CUENTA, UPPER(STACTA), SUBSTR(SSSCTA,1,2)||'00', NATGAS.NOMGAS ORDER BY CUENTA, SCTA"]]></expression>
	</variable>
	<variable name="porcentaje" class="java.lang.Double">
		<expression><![CDATA[IF($V{importeActual}.compareTo( BigDecimal.ZERO ) == 0,0.0, ($V{variacion}.floatValue() / $V{importeActual}.floatValue() ) * 100.0)]]></expression>
	</variable>
	<variable name="sumImporte" resetType="Group" calculation="Sum" resetGroup="GroupCuenta" class="java.math.BigDecimal">
		<expression><![CDATA[$F{CUENTA}.substring(1,2).equals("0") ? BigDecimal.ZERO: $V{importeActual}]]></expression>
	</variable>
	<variable name="sumImporteLast" resetType="Group" calculation="Sum" resetGroup="GroupCuenta" class="java.math.BigDecimal">
		<expression><![CDATA[$F{CUENTA}.substring(1,2).equals("0") ? BigDecimal.ZERO: $F{SALINIANT}]]></expression>
	</variable>
	<variable name="sumVariacion" resetType="Group" calculation="Sum" resetGroup="GroupCuenta" class="java.math.BigDecimal">
		<expression><![CDATA[$F{CUENTA}.substring(1,2).equals("0") ? BigDecimal.ZERO: $V{variacion}]]></expression>
	</variable>
	<variable name="sumPorcentaje" resetType="Group" resetGroup="GroupCuenta" class="java.math.BigDecimal">
		<expression><![CDATA[$V{sumImporte}.compareTo( BigDecimal.ZERO ) ==0 ? BigDecimal.ZERO :$V{sumVariacion}.divide($V{sumImporte}, 5).multiply(new BigDecimal("100.0"))]]></expression>
	</variable>
	<group name="GroupCuenta">
		<expression><![CDATA[$F{CUENTA}.substring(0,1)]]></expression>
		<groupFooter>
			<band height="15">
				<element kind="textField" uuid="2d2b4057-754d-4c04-8f36-d68ca7394e66" x="342" y="0" width="90" height="15" stretchType="NoStretch" fontName="Arial" fontSize="8.0" pattern="#,##0.00" hTextAlign="Right" vTextAlign="Middle">
					<property name="com.jaspersoft.studio.spreadsheet.connectionID" value="c104bfc0-f3e0-4fb9-9e28-2f92f4203ed5"/>
