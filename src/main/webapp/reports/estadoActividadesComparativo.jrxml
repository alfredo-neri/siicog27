				<element kind="textField" uuid="62370bbe-e830-464c-ac58-e765120750a4" x="502" y="0" width="70" height="15" stretchType="NoStretch" fontName="Arial" fontSize="8.0" pattern="#,##0.00" hTextAlign="Right" vTextAlign="Middle">
