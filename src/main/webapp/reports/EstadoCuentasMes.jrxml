		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="total_haber" resetType="None" calculation="System" class="java.math.BigDecimal">
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="total_saldo_final" calculation="System" class="java.math.BigDecimal">
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="V_CURRENT_PAGE_NUMBER" resetType="Page" class="java.lang.Integer">
		<expression><![CDATA[1]]></expression>
		<initialValueExpression><![CDATA[$V{PAGE_NUMBER}]]></initialValueExpression>
	</variable>
	<variable name="V_OPCION_EXTENSO" class="java.lang.String">
		<initialValueExpression><![CDATA[$P{P_ORDER_BY}.equals("FECPOL") ? "FECHA" : ($P{P_ORDER_BY}.equals("REFPOL") ? "REFERENCIA" : ($P{P_ORDER_BY}.equals("CONCEP") ? "CONCEPTO" : "MES"))]]></initialValueExpression>
	</variable>
	<variable name="total_cargos" resetType="Group" calculation="Sum" resetGroup="GROUP_CUENTA" class="java.math.BigDecimal">
		<expression><![CDATA[$F{CANPOL}]]></expression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="total_abonos" resetType="Group" calculation="Sum" resetGroup="GROUP_CUENTA" class="java.math.BigDecimal">
		<expression><![CDATA[$F{CANPOLH}]]></expression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="total_saldo_inicial" resetType="Group" calculation="Sum" resetGroup="GROUP_CUENTA" class="java.math.BigDecimal">
		<expression><![CDATA[$F{SALINI}]]></expression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="var" resetType="Group" calculation="Sum" resetGroup="GROUP_CUENTA" class="java.math.BigDecimal">
		<expression><![CDATA[$F{STACTA}.equals("D") ? $F{CANPOL}.subtract( $F{CANPOLH}).add($F{SALINI}) : $F{CANPOLH}.subtract( $F{CANPOL}).add($F{SALINI})]]></expression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
