			</element>
			<element kind="textField" uuid="0dcde737-37c6-4fec-a1b0-8485e27749fb" x="66" y="0" width="214" height="10" stretchType="ContainerHeight" printWhenGroupChanges="CUENTA" fontName="Arial" fontSize="6.0" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle">
