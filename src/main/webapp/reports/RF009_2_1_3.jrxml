	<dataset name="Body" uuid="8cb2a334-8ef5-4d96-9635-1e34a1b6093c">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="DB2_LOCAL"/>
		<query language="sql"><![CDATA[SELECT	SUBSTR(PA.CLAVE,4,3) DEP,
		PA.PARTIDA,
		(PA.AUTO1_1 + PA.AUTO1_2 + PA.AUTO1_3 + PA.AUTO1_4 + PA.AUTO1_5 + PA.AUTO1_6 + PA.AUTO1_7 + PA.AUTO1_8 + PA.AUTO1_9 + PA.AUTO1_10 + PA.AUTO1_11 + PA.AUTO1_12) AUTO1,
		PA.AMPLI1_1 AMPLI1, 
		PA.REDU1_1 REDU1, 
		PA.EJPA1_1 EJPA1, 
		PA.EJXPA1_1 EJXPA1, 
		PA.TOEJE1_1 TOEJE,
		PA.COMPRO1_1 COMPRO1,
		NA.NOMGAS,
		DA.NOMBRE
	FROM PASO AS PA,
		 NATGAS AS NA,
		 CATDAA AS DA
WHERE	PA.IDSECTOR = NA.IDSECTOR AND
		PA.PARTIDA	= NA.CLVGAS AND
		SUBSTR(PA.CLAVE,4,3) = DA.CLAVE AND 
		PA.IDSECTOR=1]]></query>
		<field name="DEP" class="java.lang.String"/>
		<field name="PARTIDA" class="java.lang.String"/>
		<field name="AUTO1" class="java.math.BigDecimal"/>
		<field name="AMPLI1" class="java.math.BigDecimal"/>
		<field name="REDU1" class="java.math.BigDecimal"/>
		<field name="EJPA1" class="java.math.BigDecimal"/>
		<field name="EJXPA1" class="java.math.BigDecimal"/>
		<field name="TOEJE" class="java.math.BigDecimal"/>
		<field name="COMPRO1" class="java.math.BigDecimal"/>
		<field name="NOMGAS" class="java.lang.String"/>
		<field name="NOMBRE" class="java.lang.String"/>
		<group name="Group1">
			<expression><![CDATA[$F{DEP}]]></expression>
		</group>
	</dataset>
