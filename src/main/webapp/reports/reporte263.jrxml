	</parameter>
	<parameter name="pL2" class="java.lang.String">
		<defaultValueExpression><![CDATA["SECRETARIO"]]></defaultValueExpression>
	</parameter>
	<parameter name="pL3" class="java.lang.String">
		<defaultValueExpression><![CDATA["ELABORO"]]></defaultValueExpression>
	</parameter>
	<parameter name="pL4" class="java.lang.String">
		<defaultValueExpression><![CDATA["REVISO"]]></defaultValueExpression>
	</parameter>
	<parameter name="pN1" class="java.lang.String"/>
	<parameter name="pN2" class="java.lang.String"/>
	<parameter name="pN3" class="java.lang.String"/>
	<parameter name="pN4" class="java.lang.String"/>
	<parameter name="pNumFirmas" class="java.lang.Integer"/>
	<parameter name="pCuentasCeros" class="java.lang.String">
		<defaultValueExpression><![CDATA["S"]]></defaultValueExpression>
	</parameter>
	<query language="SQL"><![CDATA[SELECT 
SUBSTR(paso.clave,1,6) as clave,
SUBSTR(paso.clave,1,3) as depgen, 
SUBSTR(paso.clave,4,3) as depaux, 
SUBSTR(paso.programa,1,2) as fin, 
SUBSTR(paso.programa,3,2) as fun, 
SUBSTR(paso.programa,5,2) as sfun, 
SUBSTR(paso.programa,7,2) as prog, 
SUBSTR(paso.programa,9,2) as sprog, 
SUBSTR(paso.programa,11,2) as proy, 
SUBSTR(paso.programa, 13,3) as ffin,
paso.partida, 
(auto1_1+auto1_2+auto1_3+auto1_4+auto1_5+auto1_6+auto1_7+auto1_8+auto1_9+auto1_10+auto1_11+auto1_12) auto13
, (auto1_$P!{pMes} + ampli1_$P!{pMes} - redu1_$P!{pMes}) automes2
, toeje1_$P!{pMes}  impmes
, programamun.fecini
, programamun.fecter
, ( $P!{pAuto1} ) + ( $P!{pAmpli1} ) - ( $P!{pRedu1} )  autoacu2
, ( $P!{pToeje1} ) + ( $P!{pAmpli1} ) - ( $P!{pRedu1} ) impacum
, NVL(catdgm.nombre,'') as nombreg 
, NVL(catdaa.nombre,'') as nombrea
, NVL(programamun.LocBen,'') LocBen
, NVL(programamun.PobBen,'') PobBen

FROM
PASO PASO
INNER JOIN catdgm catdgm ON SUBSTR(catdgm.clave,1,3)  = SUBSTR(paso.clave,1,3) 
INNER JOIN catdaa catdaa ON SUBSTR(catdaa.clave,1,3)  = SUBSTR(paso.clave,4,3) 
INNER JOIN programamun programamun ON SUBSTR(paso.clave,1,3) = programamun.cvedepg and SUBSTR(paso.clave,4,3) = programamun.cvedepa and SUBSTR(paso.programa,1,12) = programamun.programa and paso.IDSECTOR= programamun.IDSECTOR
where paso.IDSECTOR= $P{pSector} 
order by clave,depgen,depaux,fin,fun,sfun,prog,sprog,proy,ffin,partida]]></query>
