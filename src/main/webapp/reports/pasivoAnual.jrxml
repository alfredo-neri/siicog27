					<expression><![CDATA["TOTAL HACIENDA PUBLICA / PATRIMONIO "]]></expression>
				</element>
				<element kind="textField" uuid="8a3df42a-f987-49e2-90d5-2d9837906ffa" x="244" y="0" width="65" height="20" stretchType="ContainerHeight" fontName="Arial" fontSize="9.0" pattern="#,##0.00" bold="true" hTextAlign="Right" vTextAlign="Middle">
