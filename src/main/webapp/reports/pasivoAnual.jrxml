<jasperReport name="pasivo" language="java" columnCount="1" dpi="72" pageWidth="792" pageHeight="612" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="779" leftMargin="13" rightMargin="0" topMargin="0" bottomMargin="0" whenResourceMissingType="Empty" uuid="0e8ae7b0-9a13-46d8-be73-0dc4be28c7d4">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Zayra"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="p_Idsector" class="java.lang.Integer"/>
	<parameter name="pTotalAnt3211" class="java.math.BigDecimal"/>
	<parameter name="pTotalAct3211" class="java.math.BigDecimal"/>
	<parameter name="decimalFormat" class="java.lang.String"/>
	<parameter name="pesos" class="java.lang.Integer"/>
	<parameter name="year" class="java.lang.Integer"/>
	<query language="sql"><![CDATA[SELECT
	SUBSTR(C.CUENTA,1,2) GRUPO, C.STACTA NATCTA, C.NOMCTA, 
	C.CUENTA, C.SALINIANT, C.SALINI, 
	SUM(C.CARGOS_1 + C.CARGOS_2 + C.CARGOS_3 + C.CARGOS_4 +
		C.CARGOS_5 + C.CARGOS_6 + C.CARGOS_7 + C.CARGOS_8 + 
		C.CARGOS_9 + C.CARGOS_10 + C.CARGOS_11) CARGOS_ANT, 
	SUM(C.ABONOS_1 + C.ABONOS_2 + C.ABONOS_3 + C.ABONOS_4 + 
		C.ABONOS_5 + C.ABONOS_6 + C.ABONOS_7 + C.ABONOS_8 + 
		C.ABONOS_9 + C.ABONOS_10 + C.ABONOS_11) ABONOS_ANT, 
	SUM(C.ABONOS_1 + C.ABONOS_2 + C.ABONOS_3 + C.ABONOS_4 + 
		C.ABONOS_5 + C.ABONOS_6 + C.ABONOS_7 + C.ABONOS_8 + 
		C.ABONOS_9 + C.ABONOS_10 + C.ABONOS_11 + C.ABONOS_12) ABONOS_ACT, 
	SUM(C.CARGOS_1 + C.CARGOS_2 + C.CARGOS_3 + C.CARGOS_4 + 
		C.CARGOS_5 + C.CARGOS_6 + C.CARGOS_7 + C.CARGOS_8 + 
		C.CARGOS_9 + C.CARGOS_10 + C.CARGOS_11 + C.CARGOS_12) CARGOS_ACT
FROM
	CUENTA C
WHERE C.IDSECTOR = $P{p_Idsector}
	AND	C.CUENTA >= '2000' 
	AND C.CUENTA <= '3321' 
	AND C.SCTA =''
GROUP BY
	C.STACTA, C.NOMCTA, C.CUENTA, C.SALINIANT, C.SALINI, SUBSTR(C.CUENTA,1,2)
ORDER BY
	C.CUENTA]]></query>
	<field name="GRUPO" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="GRUPO"/>
		<property name="com.jaspersoft.studio.field.label" value="GRUPO"/>
	</field>
	<field name="NATCTA" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="NATCTA"/>
		<property name="com.jaspersoft.studio.field.label" value="NATCTA"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="MAYCTA"/>
	</field>
	<field name="NOMCTA" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="NOMCTA"/>
		<property name="com.jaspersoft.studio.field.label" value="NOMCTA"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="CUENTA"/>
	</field>
	<field name="CUENTA" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="CUENTA"/>
		<property name="com.jaspersoft.studio.field.label" value="CUENTA"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="CUENTA"/>
	</field>
	<field name="SALINIANT" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="SALINIANT"/>
		<property name="com.jaspersoft.studio.field.label" value="SALINIANT"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="CUENTA"/>
	</field>
	<field name="SALINI" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="SALINI"/>
		<property name="com.jaspersoft.studio.field.label" value="SALINI"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="CUENTA"/>
	</field>
	<field name="CARGOS_ANT" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="CARGOS_ANT"/>
		<property name="com.jaspersoft.studio.field.label" value="CARGOS_ANT"/>
	</field>
	<field name="ABONOS_ANT" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="ABONOS_ANT"/>
		<property name="com.jaspersoft.studio.field.label" value="ABONOS_ANT"/>
	</field>
	<field name="ABONOS_ACT" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="ABONOS_ACT"/>
		<property name="com.jaspersoft.studio.field.label" value="ABONOS_ACT"/>
	</field>
	<field name="CARGOS_ACT" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="CARGOS_ACT"/>
		<property name="com.jaspersoft.studio.field.label" value="CARGOS_ACT"/>
	</field>
	<variable name="v_total" incrementType="Report" class="java.lang.String">
		<expression><![CDATA[$P{p_Idsector}.equals(1)?
$F{GRUPO}.equals("21") ? ("TOTAL PASIVO CIRCULANTE"): 
($F{GRUPO}.equals("22")? ("TOTAL PASIVO NO CIRCULANTE"):
	($F{GRUPO}.equals("23")? ("TOTAL OTROS PASIVOS"):
		($F{GRUPO}.equals("30")?("TOTAL HACIENDA PUB./PATRIMONIO"):
			($F{GRUPO}.equals("31")?("TOTAL PATRIMONIO CONTRIBUIDO"):
				($F{GRUPO}.equals("32") ?("TOTAL PATRIMONIO GENERADO"):
					($F{GRUPO}.equals("33")?("TOTAL ACTUALIZACIÓN DEL PATRIMONIO"):
						("")
						))))))
			:
$F{GRUPO}.equals("21") ? ("TOTAL PASIVO CIRCULANTE"): 
($F{GRUPO}.equals("22")? ("TOTAL PASIVO NO CIRCULANTE"):
	($F{GRUPO}.equals("23")? ("TOTAL OTROS PASIVOS"):
		($F{GRUPO}.substring(0,1).equals("3")?("TOTAL  PATRIMONIO"):
						("")
				)))]]></expression>
	</variable>
	<variable name="etiqueta" class="java.lang.String">
		<expression><![CDATA[$F{GRUPO}.equals("21") ? ("PASIVO CIRCULANTE"): 
($F{GRUPO}.equals("22")? ("PASIVO NO CIRCULANTE"):
	($F{GRUPO}.equals("23")? (" OTROS PASIVOS"):
		($F{GRUPO}.equals("30")?("HACIENDA PUB./PATRIMONIO"):
			($F{GRUPO}.equals("31")?(" PATRIMONIO CONTRIBUIDO"):
				($F{GRUPO}.equals("32") ?("PATIMONIO GENERADO"):
					($F{GRUPO}.equals("33")?("ACTUALIZACIÓN DEL PAT"):
						("PASIVO CIRCULANTE")
						))))))]]></expression>
	</variable>
	<variable name="v_mesAnt" class="java.math.BigDecimal">
		<expression><![CDATA[$F{SALINIANT}]]></expression>
	</variable>
	<variable name="v_mesAct" class="java.math.BigDecimal">
		<expression><![CDATA[$F{NATCTA}.equals("D")?
($F{SALINI}.add($F{CARGOS_ACT}).subtract($F{ABONOS_ACT}))
:($F{SALINI}.subtract($F{CARGOS_ACT}).add($F{ABONOS_ACT}))]]></expression>
	</variable>
	<variable name="v_mesAnt2" class="java.math.BigDecimal">
		<expression><![CDATA[IF($F{CUENTA}.equals("3241")&& $F{NATCTA}.equals("D"),($F{SALINIANT}.subtract($F{CARGOS_ANT}).add($F{ABONOS_ANT})),($V{v_mesAnt}))]]></expression>
	</variable>
	<variable name="v_mesAct2" class="java.math.BigDecimal">
		<expression><![CDATA[IF($F{CUENTA}.equals("3241")&& $F{NATCTA}.equals("D"),($F{SALINIANT}.subtract($F{CARGOS_ACT}).add($F{ABONOS_ACT})),($V{v_mesAct}))]]></expression>
	</variable>
	<variable name="v_mesAntT" class="java.math.BigDecimal">
		<expression><![CDATA[$P{pesos} == 1 ?
			$F{CUENTA}.equals("3211") ? $P{pTotalAnt3211} : $V{v_mesAnt2}
:
			$F{CUENTA}.equals("3211") ? $P{pTotalAnt3211}.divide(new BigDecimal("1000.0"))  : $V{v_mesAnt2}.divide(new BigDecimal("1000.0"))]]></expression>
	</variable>
	<variable name="v_mesActT" class="java.math.BigDecimal">
		<expression><![CDATA[$P{pesos} == 1 ?
		$F{CUENTA}.equals("3211") ? $P{pTotalAct3211} : $V{v_mesAct2}
:
		$F{CUENTA}.equals("3211") ? $P{pTotalAct3211}.divide(new BigDecimal("1000.0")) : $V{v_mesAct2}.divide(new BigDecimal("1000.0"))]]></expression>
	</variable>
	<variable name="vGrupo" class="java.lang.String">
		<expression><![CDATA[$P{p_Idsector}.equals(1)?
     ($F{GRUPO}+"00")
  :
   $F{GRUPO}.substring(0,1).equals("3")?
   ($F{GRUPO}.substring(0,1)+"000"):
    ($F{GRUPO}+"00")]]></expression>
	</variable>
	<variable name="V_SumaMant" resetType="Group" calculation="Sum" resetGroup="Group1" class="java.math.BigDecimal">
		<expression><![CDATA[$F{CUENTA}.substring(3).equals("0") ? BigDecimal.ZERO :  $V{v_mesAntT}]]></expression>
	</variable>
	<variable name="V_SumaMact" resetType="Group" calculation="Sum" resetGroup="Group1" class="java.math.BigDecimal">
		<expression><![CDATA[$F{CUENTA}.substring(3).equals("0") ? BigDecimal.ZERO :  $V{v_mesActT}]]></expression>
	</variable>
	<variable name="v_Variacion" class="java.math.BigDecimal">
		<expression><![CDATA[$V{v_mesActT}.subtract($V{v_mesAntT})]]></expression>
	</variable>
	<variable name="v_SumVar" resetType="Group" calculation="Sum" resetGroup="Group1" class="java.math.BigDecimal">
		<expression><![CDATA[$F{CUENTA}.substring(3).equals("0") ? BigDecimal.ZERO :  $V{v_Variacion}]]></expression>
	</variable>
	<variable name="V_SumaTotalMAn" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{CUENTA}.substring(3).equals("0") ? BigDecimal.ZERO :  $V{v_mesAntT}]]></expression>
	</variable>
	<variable name="V_SumaTotalMact" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{CUENTA}.substring(3).equals("0") ? BigDecimal.ZERO :  $V{v_mesActT}]]></expression>
	</variable>
	<variable name="V_SumTotalVar" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{CUENTA}.substring(3).equals("0") ? BigDecimal.ZERO :  $V{v_Variacion}]]></expression>
	</variable>
	<variable name="totalPatrimonioMesAnterior" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{GRUPO}.equals("30") ? $V{v_mesAntT} : BigDecimal.ZERO]]></expression>
	</variable>
	<variable name="totalPatrimonioMesActual" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{GRUPO}.equals("30") ? $V{v_mesActT} : BigDecimal.ZERO]]></expression>
	</variable>
	<variable name="totalPatrimonioVariacion" class="java.math.BigDecimal">
		<expression><![CDATA[$V{totalPatrimonioMesActual}.subtract($V{totalPatrimonioMesAnterior})]]></expression>
	</variable>
