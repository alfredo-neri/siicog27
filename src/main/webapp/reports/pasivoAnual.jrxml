					<expression><![CDATA[String.format($P{decimalFormat},$V{totalPatrimonioVariacion})]]></expression>
				</element>
			</band>
		</groupFooter>
	</group>
	<group name="Group3">
		<expression><![CDATA[$V{vGrupo}]]></expression>
		<groupFooter>
			<band height="20">
				<printWhenExpression><![CDATA[$F{GRUPO}.substring(0,2).equals("22")]]></printWhenExpression>
				<element kind="staticText" uuid="016a8cda-744c-48f7-9e30-afa72ff7fbf4" x="0" y="0" width="179" height="20" stretchType="NoStretch" fontName="Arial" fontSize="9.0" bold="true" hTextAlign="Right" vTextAlign="Middle"
