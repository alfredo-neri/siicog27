		<groupFooter>
			<band height="20">
				<element kind="staticText" uuid="bcc6ce3b-2c4c-4a73-9fa5-fd5478823ad5" x="0" y="0" width="179" height="20" stretchType="NoStretch" fontName="Arial" fontSize="9.0" bold="true" hTextAlign="Right" vTextAlign="Middle"
					><text><![CDATA[TOTAL PASIVO Y PATRIMONIO]]></text>
				</element>
