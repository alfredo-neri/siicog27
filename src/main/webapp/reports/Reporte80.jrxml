				<property name="com.jaspersoft.studio.unit.width" value="pixel"/>
				<parameter name="xmes">
					<expression><![CDATA[$F{MESPOL}]]></expression>
				</parameter>
				<parameter name="xssscta">
					<expression><![CDATA[$P{xssscta}]]></expression>
				</parameter>
				<parameter name="IDSECTOR">
					<expression><![CDATA[$P{IDSECTOR}]]></expression>
