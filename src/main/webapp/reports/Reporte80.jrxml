<jasperReport name="Reporte80" language="java" columnCount="1" dpi="72" pageWidth="807" pageHeight="566" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="751" leftMargin="28" rightMargin="28" topMargin="28" bottomMargin="28" uuid="38a6ac06-7489-4b82-8dad-c92e4556eed2">
