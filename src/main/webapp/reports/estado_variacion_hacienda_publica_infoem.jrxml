					<expression><![CDATA[$F{GRUPO}  == 1 ? "Hacienda Pública / Patrimonio Contribuido Neto "+ $P{monthBefore} +" "+($P{month}.equals("Enero") ? ($P{year}-1):$P{year}) : $F{GRUPO}  == 2 ? "Hacienda Pública / Patrimonio Generado Neto de " + $P{monthBefore} + " " +($P{month}.equals("Enero") ? ($P{year}-1):$P{year}): $F{GRUPO} == 3 ?  "Exceso o Insuficiencia en la Actualización de la Hacienda Pública / Patrimonio Neto de " + $P{monthBefore}+" " +($P{month}.equals("Enero") ? ($P{year}-1):$P{year}):$F{GRUPO} == 4 ? "Cambios en la Hacienda Pública/Patrimonio Contribuido Neto de "+ $P{month} + " "+ $P{year}  :$F{GRUPO}==5? "Variación de la Hacienda Pública/Patrimonio Generado Neto de " + $P{month} + " " + $P{year} : "Cambios en el Exceso o Insuficiencia en la Actualización de la Hacienda Pública/Patrimonio Neto de " + $P{month} + " " + $P{year}]]></expression>
				</element>
