<jasperReport name="RF0092162" language="java" columnCount="1" dpi="72" pageWidth="792" pageHeight="612" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="752" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="198f65a2-8231-4072-a6ff-a4209259ff8c">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="LOCAL_GEM"/>
	<parameter name="anio" class="java.lang.Integer"
		><description><![CDATA[]]></description>
	</parameter>
	<parameter name="municipio" class="java.lang.String"/>
	<parameter name="pathImg" class="java.lang.String"/>
	<parameter name="idSector" class="java.lang.Integer"/>
	<parameter name="Dependencia" class="java.lang.String"
		><description><![CDATA[]]></description>
	</parameter>
	<parameter name="DependenciaName" class="java.lang.String"/>
	<parameter name="firmaP1" class="java.lang.String"/>
	<parameter name="firmaP2" class="java.lang.String"/>
	<parameter name="firmaP3" class="java.lang.String"/>
	<parameter name="firmaN1" class="java.lang.String"/>
	<parameter name="firmaN2" class="java.lang.String"/>
	<parameter name="firmaN3" class="java.lang.String"/>
	<query language="SQL"><![CDATA[SELECT
	CLAVE,
	PROGRAMA,
	PARTIDA,
	AUTO1_1,
	AUTO1_2,
	AUTO1_3,
	AUTO1_4,
	AUTO1_5,
	AUTO1_6,
	AUTO1_7,
	AUTO1_8,
	AUTO1_9,
	AUTO1_10,
	AUTO1_11,
	AUTO1_12,
	(AUTO1_1 + AUTO1_2 + AUTO1_3 + AUTO1_4 + AUTO1_5 + AUTO1_6 + AUTO1_7 + AUTO1_8 + AUTO1_9 + AUTO1_10 + AUTO1_11 + AUTO1_12) TOTAL
	FROM PASO
WHERE  IDSECTOR 					= $P{idSector}  AND 
				SUBSTR(CLAVE,1,3)  = $P{Dependencia}
ORDER BY CLAVE, PROGRAMA, PARTIDA]]></query>
	<field name="CLAVE" class="java.lang.String"/>
	<field name="PROGRAMA" class="java.lang.String"/>
	<field name="PARTIDA" class="java.lang.String"/>
	<field name="AUTO1_1" class="java.math.BigDecimal"/>
	<field name="AUTO1_2" class="java.math.BigDecimal"/>
	<field name="AUTO1_3" class="java.math.BigDecimal"/>
	<field name="AUTO1_4" class="java.math.BigDecimal"/>
	<field name="AUTO1_5" class="java.math.BigDecimal"/>
	<field name="AUTO1_6" class="java.math.BigDecimal"/>
	<field name="AUTO1_7" class="java.math.BigDecimal"/>
	<field name="AUTO1_8" class="java.math.BigDecimal"/>
	<field name="AUTO1_9" class="java.math.BigDecimal"/>
	<field name="AUTO1_10" class="java.math.BigDecimal"/>
	<field name="AUTO1_11" class="java.math.BigDecimal"/>
	<field name="AUTO1_12" class="java.math.BigDecimal"/>
	<field name="TOTAL" class="java.math.BigDecimal"/>
	<variable name="sumEnero" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[($F{PARTIDA}.substring(1).equals("000")?$F{AUTO1_1}:BigDecimal.ZERO)]]></expression>
	</variable>
	<variable name="sumFebrero" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[($F{PARTIDA}.substring(1).equals("000")?$F{AUTO1_2}:BigDecimal.ZERO)]]></expression>
	</variable>
	<variable name="sumMarzo" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[($F{PARTIDA}.substring(1).equals("000")?$F{AUTO1_3}:BigDecimal.ZERO)]]></expression>
	</variable>
	<variable name="sumAbril" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[($F{PARTIDA}.substring(1).equals("000")?$F{AUTO1_4}:BigDecimal.ZERO)]]></expression>
	</variable>
	<variable name="sumMayo" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[($F{PARTIDA}.substring(1).equals("000")?$F{AUTO1_5}:BigDecimal.ZERO)]]></expression>
	</variable>
	<variable name="sumJunio" calculation="Sum" class="java.math.BigDecimal">
