		<expression><![CDATA[($F{PARTIDA}.substring(1).equals("000")?$F{AUTO1_12}:BigDecimal.ZERO)]]></expression>
	</variable>
	<variable name="sumTotal" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[($F{PARTIDA}.substring(1).equals("000")?$F{TOTAL}:BigDecimal.ZERO)]]></expression>
	</variable>
