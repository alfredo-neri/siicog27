	<query language="sql"><![CDATA[SELECT	ANUAL,
				ITEV, 
				NATEV, 
				ACUITEV, 
				ACUNATEV,
				OBSITEV, 
				OBSNATEV
		FROM PM1111
WHERE	ANUAL= $P{year}
	AND IDSECTOR = $P{idSector}]]></query>
	<field name="ANUAL" class="java.lang.Integer"/>
	<field name="ITEV" class="java.math.BigDecimal"/>
