	WHEN $P{mes} = 4 THEN (SUM(P.EJXPA1_1) + SUM(P.EJXPA1_2) + SUM(P.EJXPA1_3) + SUM(P.EJXPA1_4))
	WHEN $P{mes} = 5 THEN (SUM(P.EJXPA1_1) + SUM(P.EJXPA1_2) + SUM(P.EJXPA1_3) + SUM(P.EJXPA1_4) + SUM(P.EJXPA1_5))
	WHEN $P{mes} = 6 THEN (SUM(P.EJXPA1_1) + SUM(P.EJXPA1_2) + SUM(P.EJXPA1_3) + SUM(P.EJXPA1_4) + SUM(P.EJXPA1_5) + SUM(P.EJXPA1_6))
	WHEN $P{mes} = 7 THEN (SUM(P.EJXPA1_1) + SUM(P.EJXPA1_2) + SUM(P.EJXPA1_3) + SUM(P.EJXPA1_4) + SUM(P.EJXPA1_5) + SUM(P.EJXPA1_6) +  SUM(P.EJXPA1_7))
	WHEN $P{mes} = 8 THEN (SUM(P.EJXPA1_1) + SUM(P.EJXPA1_2) + SUM(P.EJXPA1_3) + SUM(P.EJXPA1_4) + SUM(P.EJXPA1_5) + SUM(P.EJXPA1_6) +  SUM(P.EJXPA1_7) + SUM(P.EJXPA1_8))
	WHEN $P{mes} = 9 THEN (SUM(P.EJXPA1_1) + SUM(P.EJXPA1_2) + SUM(P.EJXPA1_3) + SUM(P.EJXPA1_4) + SUM(P.EJXPA1_5) + SUM(P.EJXPA1_6) +  SUM(P.EJXPA1_7) + SUM(P.EJXPA1_8) + SUM(P.EJXPA1_9))
	WHEN $P{mes} = 10 THEN (SUM(P.EJXPA1_1) + SUM(P.EJXPA1_2) + SUM(P.EJXPA1_3) + SUM(P.EJXPA1_4) + SUM(P.EJXPA1_5) + SUM(P.EJXPA1_6) +  SUM(P.EJXPA1_7) + SUM(P.EJXPA1_8) + SUM(P.EJXPA1_9) + SUM(P.EJXPA1_10))
	WHEN $P{mes} = 11 THEN (SUM(P.EJXPA1_1) + SUM(P.EJXPA1_2) + SUM(P.EJXPA1_3) + SUM(P.EJXPA1_4) + SUM(P.EJXPA1_5) + SUM(P.EJXPA1_6) +  SUM(P.EJXPA1_7) + SUM(P.EJXPA1_8) + SUM(P.EJXPA1_9) + SUM(P.EJXPA1_10) + SUM(P.EJXPA1_11))
	WHEN $P{mes} = 12 THEN (SUM(P.EJXPA1_1) + SUM(P.EJXPA1_2) + SUM(P.EJXPA1_3) + SUM(P.EJXPA1_4) + SUM(P.EJXPA1_5) + SUM(P.EJXPA1_6) +  SUM(P.EJXPA1_7) + SUM(P.EJXPA1_8) + SUM(P.EJXPA1_9) + SUM(P.EJXPA1_10) + SUM(P.EJXPA1_11) + SUM(P.EJXPA1_12))
END AS DEVENGADO,
CASE WHEN $P{mes} = 1 THEN (SUM(P.EJPA1_1))
	WHEN $P{mes} = 2 THEN (SUM(P.EJPA1_1) + SUM(P.EJPA1_2))
	WHEN $P{mes} = 3 THEN (SUM(P.EJPA1_1) + SUM(P.EJPA1_2) + SUM(P.EJPA1_3))
	WHEN $P{mes} = 4 THEN (SUM(P.EJPA1_1) + SUM(P.EJPA1_2) + SUM(P.EJPA1_3) + SUM(P.EJPA1_4))
	WHEN $P{mes} = 5 THEN (SUM(P.EJPA1_1) + SUM(P.EJPA1_2) + SUM(P.EJPA1_3) + SUM(P.EJPA1_4) + SUM(P.EJPA1_5))
	WHEN $P{mes} = 6 THEN (SUM(P.EJPA1_1) + SUM(P.EJPA1_2) + SUM(P.EJPA1_3) + SUM(P.EJPA1_4) + SUM(P.EJPA1_5) + SUM(P.EJPA1_6))
	WHEN $P{mes} = 7 THEN (SUM(P.EJPA1_1) + SUM(P.EJPA1_2) + SUM(P.EJPA1_3) + SUM(P.EJPA1_4) + SUM(P.EJPA1_5) + SUM(P.EJPA1_6) +  SUM(P.EJPA1_7))
	WHEN $P{mes} = 8 THEN (SUM(P.EJPA1_1) + SUM(P.EJPA1_2) + SUM(P.EJPA1_3) + SUM(P.EJPA1_4) + SUM(P.EJPA1_5) + SUM(P.EJPA1_6) +  SUM(P.EJPA1_7) + SUM(P.EJPA1_8))
	WHEN $P{mes} = 9 THEN (SUM(P.EJPA1_1) + SUM(P.EJPA1_2) + SUM(P.EJPA1_3) + SUM(P.EJPA1_4) + SUM(P.EJPA1_5) + SUM(P.EJPA1_6) +  SUM(P.EJPA1_7) + SUM(P.EJPA1_8) + SUM(P.EJPA1_9))
	WHEN $P{mes} = 10 THEN (SUM(P.EJPA1_1) + SUM(P.EJPA1_2) + SUM(P.EJPA1_3) + SUM(P.EJPA1_4) + SUM(P.EJPA1_5) + SUM(P.EJPA1_6) +  SUM(P.EJPA1_7) + SUM(P.EJPA1_8) + SUM(P.EJPA1_9) + SUM(P.EJPA1_10))
	WHEN $P{mes} = 11 THEN (SUM(P.EJPA1_1) + SUM(P.EJPA1_2) + SUM(P.EJPA1_3) + SUM(P.EJPA1_4) + SUM(P.EJPA1_5) + SUM(P.EJPA1_6) +  SUM(P.EJPA1_7) + SUM(P.EJPA1_8) + SUM(P.EJPA1_9) + SUM(P.EJPA1_10) + SUM(P.EJPA1_11))
	WHEN $P{mes} = 12 THEN (SUM(P.EJPA1_1) + SUM(P.EJPA1_2) + SUM(P.EJPA1_3) + SUM(P.EJPA1_4) + SUM(P.EJPA1_5) + SUM(P.EJPA1_6) +  SUM(P.EJPA1_7) + SUM(P.EJPA1_8) + SUM(P.EJPA1_9) + SUM(P.EJPA1_10) + SUM(P.EJPA1_11) + SUM(P.EJPA1_12))
END AS PAGADO,
CASE WHEN $P{mes} = 1 THEN (SUM(P.TOEJE1_1))
	WHEN $P{mes} = 2 THEN (SUM(P.TOEJE1_1) + SUM(P.TOEJE1_2))
	WHEN $P{mes} = 3 THEN (SUM(P.TOEJE1_1) + SUM(P.TOEJE1_2) + SUM(P.TOEJE1_3))
	WHEN $P{mes} = 4 THEN (SUM(P.TOEJE1_1) + SUM(P.TOEJE1_2) + SUM(P.TOEJE1_3) + SUM(P.TOEJE1_4))
	WHEN $P{mes} = 5 THEN (SUM(P.TOEJE1_1) + SUM(P.TOEJE1_2) + SUM(P.TOEJE1_3) + SUM(P.TOEJE1_4) + SUM(P.TOEJE1_5))
	WHEN $P{mes} = 6 THEN (SUM(P.TOEJE1_1) + SUM(P.TOEJE1_2) + SUM(P.TOEJE1_3) + SUM(P.TOEJE1_4) + SUM(P.TOEJE1_5) + SUM(P.TOEJE1_6))
	WHEN $P{mes} = 7 THEN (SUM(P.TOEJE1_1) + SUM(P.TOEJE1_2) + SUM(P.TOEJE1_3) + SUM(P.TOEJE1_4) + SUM(P.TOEJE1_5) + SUM(P.TOEJE1_6) +  SUM(P.TOEJE1_7))
	WHEN $P{mes} = 8 THEN (SUM(P.TOEJE1_1) + SUM(P.TOEJE1_2) + SUM(P.TOEJE1_3) + SUM(P.TOEJE1_4) + SUM(P.TOEJE1_5) + SUM(P.TOEJE1_6) +  SUM(P.TOEJE1_7) + SUM(P.TOEJE1_8))
	WHEN $P{mes} = 9 THEN (SUM(P.TOEJE1_1) + SUM(P.TOEJE1_2) + SUM(P.TOEJE1_3) + SUM(P.TOEJE1_4) + SUM(P.TOEJE1_5) + SUM(P.TOEJE1_6) +  SUM(P.TOEJE1_7) + SUM(P.TOEJE1_8) + SUM(P.TOEJE1_9))
	WHEN $P{mes} = 10 THEN (SUM(P.TOEJE1_1) + SUM(P.TOEJE1_2) + SUM(P.TOEJE1_3) + SUM(P.TOEJE1_4) + SUM(P.TOEJE1_5) + SUM(P.TOEJE1_6) +  SUM(P.TOEJE1_7) + SUM(P.TOEJE1_8) + SUM(P.TOEJE1_9) + SUM(P.TOEJE1_10))
	WHEN $P{mes} = 11 THEN (SUM(P.TOEJE1_1) + SUM(P.TOEJE1_2) + SUM(P.TOEJE1_3) + SUM(P.TOEJE1_4) + SUM(P.TOEJE1_5) + SUM(P.TOEJE1_6) +  SUM(P.TOEJE1_7) + SUM(P.TOEJE1_8) + SUM(P.TOEJE1_9) + SUM(P.TOEJE1_10) + SUM(P.TOEJE1_11))
	WHEN $P{mes} = 12 THEN (SUM(P.TOEJE1_1) + SUM(P.TOEJE1_2) + SUM(P.TOEJE1_3) + SUM(P.TOEJE1_4) + SUM(P.TOEJE1_5) + SUM(P.TOEJE1_6) +  SUM(P.TOEJE1_7) + SUM(P.TOEJE1_8) + SUM(P.TOEJE1_9) + SUM(P.TOEJE1_10) + SUM(P.TOEJE1_11) + SUM(P.TOEJE1_12))
END AS TOTALEJERCIDO,
(	((CASE WHEN $P{mes} = 1 THEN (SUM(P.AUTO1_1))
		WHEN $P{mes} = 2 THEN (SUM(P.AUTO1_1) + SUM(P.AUTO1_2))
		WHEN $P{mes} = 3 THEN (SUM(P.AUTO1_1) + SUM(P.AUTO1_2) + SUM(P.AUTO1_3))
		WHEN $P{mes} = 4 THEN (SUM(P.AUTO1_1) + SUM(P.AUTO1_2) + SUM(P.AUTO1_3) + SUM(P.AUTO1_4))
		WHEN $P{mes} = 5 THEN (SUM(P.AUTO1_1) + SUM(P.AUTO1_2) + SUM(P.AUTO1_3) + SUM(P.AUTO1_4) + SUM(P.AUTO1_5))
		WHEN $P{mes} = 6 THEN (SUM(P.AUTO1_1) + SUM(P.AUTO1_2) + SUM(P.AUTO1_3) + SUM(P.AUTO1_4) + SUM(P.AUTO1_5) + SUM(P.AUTO1_6))
		WHEN $P{mes} = 7 THEN (SUM(P.AUTO1_1) + SUM(P.AUTO1_2) + SUM(P.AUTO1_3) + SUM(P.AUTO1_4) + SUM(P.AUTO1_5) + SUM(P.AUTO1_6) +  SUM(P.AUTO1_7))
		WHEN $P{mes} = 8 THEN (SUM(P.AUTO1_1) + SUM(P.AUTO1_2) + SUM(P.AUTO1_3) + SUM(P.AUTO1_4) + SUM(P.AUTO1_5) + SUM(P.AUTO1_6) +  SUM(P.AUTO1_7) + SUM(P.AUTO1_8))
		WHEN $P{mes} = 9 THEN (SUM(P.AUTO1_1) + SUM(P.AUTO1_2) + SUM(P.AUTO1_3) + SUM(P.AUTO1_4) + SUM(P.AUTO1_5) + SUM(P.AUTO1_6) +  SUM(P.AUTO1_7) + SUM(P.AUTO1_8) + SUM(P.AUTO1_9))
		WHEN $P{mes} = 10 THEN (SUM(P.AUTO1_1) + SUM(P.AUTO1_2) + SUM(P.AUTO1_3) + SUM(P.AUTO1_4) + SUM(P.AUTO1_5) + SUM(P.AUTO1_6) +  SUM(P.AUTO1_7) + SUM(P.AUTO1_8) + SUM(P.AUTO1_9) + SUM(P.AUTO1_10))
		WHEN $P{mes} = 11 THEN (SUM(P.AUTO1_1) + SUM(P.AUTO1_2) + SUM(P.AUTO1_3) + SUM(P.AUTO1_4) + SUM(P.AUTO1_5) + SUM(P.AUTO1_6) +  SUM(P.AUTO1_7) + SUM(P.AUTO1_8) + SUM(P.AUTO1_9) + SUM(P.AUTO1_10) + SUM(P.AUTO1_11))
		WHEN $P{mes} = 12 THEN (SUM(P.AUTO1_1) + SUM(P.AUTO1_2) + SUM(P.AUTO1_3) + SUM(P.AUTO1_4) + SUM(P.AUTO1_5) + SUM(P.AUTO1_6) +  SUM(P.AUTO1_7) + SUM(P.AUTO1_8) + SUM(P.AUTO1_9) + SUM(P.AUTO1_10) + SUM(P.AUTO1_11) + SUM(P.AUTO1_12))
	END) +
	(CASE WHEN $P{mes} = 1 THEN (SUM(P.AMPLI1_1))
		WHEN $P{mes} = 2 THEN (SUM(P.AMPLI1_1) + SUM(P.AMPLI1_2))
		WHEN $P{mes} = 3 THEN (SUM(P.AMPLI1_1) + SUM(P.AMPLI1_2) + SUM(P.AMPLI1_3))
		WHEN $P{mes} = 4 THEN (SUM(P.AMPLI1_1) + SUM(P.AMPLI1_2) + SUM(P.AMPLI1_3) + SUM(P.AMPLI1_4))
		WHEN $P{mes}= 5 THEN (SUM(P.AMPLI1_1) + SUM(P.AMPLI1_2) + SUM(P.AMPLI1_3) + SUM(P.AMPLI1_4) + SUM(P.AMPLI1_5))
		WHEN $P{mes} = 6 THEN (SUM(P.AMPLI1_1) + SUM(P.AMPLI1_2) + SUM(P.AMPLI1_3) + SUM(P.AMPLI1_4) + SUM(P.AMPLI1_5) + SUM(P.AMPLI1_6))
		WHEN $P{mes} = 7 THEN (SUM(P.AMPLI1_1) + SUM(P.AMPLI1_2) + SUM(P.AMPLI1_3) + SUM(P.AMPLI1_4) + SUM(P.AMPLI1_5) + SUM(P.AMPLI1_6) +  SUM(P.AMPLI1_7))
		WHEN $P{mes} = 8 THEN (SUM(P.AMPLI1_1) + SUM(P.AMPLI1_2) + SUM(P.AMPLI1_3) + SUM(P.AMPLI1_4) + SUM(P.AMPLI1_5) + SUM(P.AMPLI1_6) +  SUM(P.AMPLI1_7) + SUM(P.AMPLI1_8))
		WHEN $P{mes} = 9 THEN (SUM(P.AMPLI1_1) + SUM(P.AMPLI1_2) + SUM(P.AMPLI1_3) + SUM(P.AMPLI1_4) + SUM(P.AMPLI1_5) + SUM(P.AMPLI1_6) +  SUM(P.AMPLI1_7) + SUM(P.AMPLI1_8) + SUM(P.AMPLI1_9))
		WHEN $P{mes} = 10 THEN (SUM(P.AMPLI1_1) + SUM(P.AMPLI1_2) + SUM(P.AMPLI1_3) + SUM(P.AMPLI1_4) + SUM(P.AMPLI1_5) + SUM(P.AMPLI1_6) +  SUM(P.AMPLI1_7) + SUM(P.AMPLI1_8) + SUM(P.AMPLI1_9) + SUM(P.AMPLI1_10))
		WHEN $P{mes} = 11 THEN (SUM(P.AMPLI1_1) + SUM(P.AMPLI1_2) + SUM(P.AMPLI1_3) + SUM(P.AMPLI1_4) + SUM(P.AMPLI1_5) + SUM(P.AMPLI1_6) +  SUM(P.AMPLI1_7) + SUM(P.AMPLI1_8) + SUM(P.AMPLI1_9) + SUM(P.AMPLI1_10) + SUM(P.AMPLI1_11))
		WHEN $P{mes} = 12 THEN (SUM(P.AMPLI1_1) + SUM(P.AMPLI1_2) + SUM(P.AMPLI1_3) + SUM(P.AMPLI1_4) + SUM(P.AMPLI1_5) + SUM(P.AMPLI1_6) +  SUM(P.AMPLI1_7) + SUM(P.AMPLI1_8) + SUM(P.AMPLI1_9) + SUM(P.AMPLI1_10) + SUM(P.AMPLI1_11) + SUM(P.AMPLI1_12))
	END) -
	(CASE WHEN $P{mes} = 1 THEN (SUM(P.REDU1_1))
		WHEN $P{mes} = 2 THEN (SUM(P.REDU1_1) + SUM(P.REDU1_2))
		WHEN $P{mes} = 3 THEN (SUM(P.REDU1_1) + SUM(P.REDU1_2) + SUM(P.REDU1_3))
		WHEN $P{mes} = 4 THEN (SUM(P.REDU1_1) + SUM(P.REDU1_2) + SUM(P.REDU1_3) + SUM(P.REDU1_4))
		WHEN $P{mes} = 5 THEN (SUM(P.REDU1_1) + SUM(P.REDU1_2) + SUM(P.REDU1_3) + SUM(P.REDU1_4) + SUM(P.REDU1_5))
		WHEN $P{mes} = 6 THEN (SUM(P.REDU1_1) + SUM(P.REDU1_2) + SUM(P.REDU1_3) + SUM(P.REDU1_4) + SUM(P.REDU1_5) + SUM(P.REDU1_6))
		WHEN $P{mes} = 7 THEN (SUM(P.REDU1_1) + SUM(P.REDU1_2) + SUM(P.REDU1_3) + SUM(P.REDU1_4) + SUM(P.REDU1_5) + SUM(P.REDU1_6) +  SUM(P.REDU1_7))
		WHEN $P{mes} = 8 THEN (SUM(P.REDU1_1) + SUM(P.REDU1_2) + SUM(P.REDU1_3) + SUM(P.REDU1_4) + SUM(P.REDU1_5) + SUM(P.REDU1_6) +  SUM(P.REDU1_7) + SUM(P.REDU1_8))
		WHEN $P{mes} = 9 THEN (SUM(P.REDU1_1) + SUM(P.REDU1_2) + SUM(P.REDU1_3) + SUM(P.REDU1_4) + SUM(P.REDU1_5) + SUM(P.REDU1_6) +  SUM(P.REDU1_7) + SUM(P.REDU1_8) + SUM(P.REDU1_9))
		WHEN $P{mes} = 10 THEN (SUM(P.REDU1_1) + SUM(P.REDU1_2) + SUM(P.REDU1_3) + SUM(P.REDU1_4) + SUM(P.REDU1_5) + SUM(P.REDU1_6) +  SUM(P.REDU1_7) + SUM(P.REDU1_8) + SUM(P.REDU1_9) + SUM(P.REDU1_10))
		WHEN $P{mes} = 11 THEN (SUM(P.REDU1_1) + SUM(P.REDU1_2) + SUM(P.REDU1_3) + SUM(P.REDU1_4) + SUM(P.REDU1_5) + SUM(P.REDU1_6) +  SUM(P.REDU1_7) + SUM(P.REDU1_8) + SUM(P.REDU1_9) + SUM(P.REDU1_10) + SUM(P.REDU1_11))
		WHEN $P{mes} = 12 THEN (SUM(P.REDU1_1) + SUM(P.REDU1_2) + SUM(P.REDU1_3) + SUM(P.REDU1_4) + SUM(P.REDU1_5) + SUM(P.REDU1_6) +  SUM(P.REDU1_7) + SUM(P.REDU1_8) + SUM(P.REDU1_9) + SUM(P.REDU1_10) + SUM(P.REDU1_11) + SUM(P.REDU1_12))
	END))  -
	(CASE WHEN $P{mes} = 1 THEN (SUM(P.TOEJE1_1))
		WHEN $P{mes} = 2 THEN (SUM(P.TOEJE1_1) + SUM(P.TOEJE1_2))
		WHEN $P{mes} = 3 THEN (SUM(P.TOEJE1_1) + SUM(P.TOEJE1_2) + SUM(P.TOEJE1_3))
		WHEN $P{mes} = 4 THEN (SUM(P.TOEJE1_1) + SUM(P.TOEJE1_2) + SUM(P.TOEJE1_3) + SUM(P.TOEJE1_4))
		WHEN $P{mes} = 5 THEN (SUM(P.TOEJE1_1) + SUM(P.TOEJE1_2) + SUM(P.TOEJE1_3) + SUM(P.TOEJE1_4) + SUM(P.TOEJE1_5))
		WHEN $P{mes} = 6 THEN (SUM(P.TOEJE1_1) + SUM(P.TOEJE1_2) + SUM(P.TOEJE1_3) + SUM(P.TOEJE1_4) + SUM(P.TOEJE1_5) + SUM(P.TOEJE1_6))
		WHEN $P{mes} = 7 THEN (SUM(P.TOEJE1_1) + SUM(P.TOEJE1_2) + SUM(P.TOEJE1_3) + SUM(P.TOEJE1_4) + SUM(P.TOEJE1_5) + SUM(P.TOEJE1_6) +  SUM(P.TOEJE1_7))
		WHEN $P{mes} = 8 THEN (SUM(P.TOEJE1_1) + SUM(P.TOEJE1_2) + SUM(P.TOEJE1_3) + SUM(P.TOEJE1_4) + SUM(P.TOEJE1_5) + SUM(P.TOEJE1_6) +  SUM(P.TOEJE1_7) + SUM(P.TOEJE1_8))
		WHEN $P{mes} = 9 THEN (SUM(P.TOEJE1_1) + SUM(P.TOEJE1_2) + SUM(P.TOEJE1_3) + SUM(P.TOEJE1_4) + SUM(P.TOEJE1_5) + SUM(P.TOEJE1_6) +  SUM(P.TOEJE1_7) + SUM(P.TOEJE1_8) + SUM(P.TOEJE1_9))
		WHEN $P{mes} = 10 THEN (SUM(P.TOEJE1_1) + SUM(P.TOEJE1_2) + SUM(P.TOEJE1_3) + SUM(P.TOEJE1_4) + SUM(P.TOEJE1_5) + SUM(P.TOEJE1_6) +  SUM(P.TOEJE1_7) + SUM(P.TOEJE1_8) + SUM(P.TOEJE1_9) + SUM(P.TOEJE1_10))
		WHEN $P{mes} = 11 THEN (SUM(P.TOEJE1_1) + SUM(P.TOEJE1_2) + SUM(P.TOEJE1_3) + SUM(P.TOEJE1_4) + SUM(P.TOEJE1_5) + SUM(P.TOEJE1_6) +  SUM(P.TOEJE1_7) + SUM(P.TOEJE1_8) + SUM(P.TOEJE1_9) + SUM(P.TOEJE1_10) + SUM(P.TOEJE1_11))
		WHEN $P{mes} = 12 THEN (SUM(P.TOEJE1_1) + SUM(P.TOEJE1_2) + + SUM(P.TOEJE1_3) + SUM(P.TOEJE1_4) + SUM(P.TOEJE1_5) + SUM(P.TOEJE1_6) +  SUM(P.TOEJE1_7) + SUM(P.TOEJE1_8) + SUM(P.TOEJE1_9) + SUM(P.TOEJE1_10) + SUM(P.TOEJE1_11) + SUM(P.TOEJE1_12))
	END)
) AS POREJERCER
FROM PASO P INNER JOIN NATGAS N
	ON P.PARTIDA = N.CLVGAS
	 AND P.IDSECTOR = N.IDSECTOR
WHERE P.IDSECTOR = $P{sector}
GROUP BY P.PARTIDA, N.NOMGAS]]></query>
	<field name="PARTIDA" class="java.lang.String"/>
	<field name="NOMGAS" class="java.lang.String"/>
	<field name="APROBADO" class="java.math.BigDecimal"/>
	<field name="AMPLIACION" class="java.math.BigDecimal"/>
	<field name="REDUCCION" class="java.math.BigDecimal"/>
	<field name="MODIFICADO" class="java.math.BigDecimal"/>
	<field name="COMPROMETIDO" class="java.math.BigDecimal"/>
	<field name="DEVENGADO" class="java.math.BigDecimal"/>
	<field name="PAGADO" class="java.math.BigDecimal"/>
	<field name="TOTALEJERCIDO" class="java.math.BigDecimal"/>
	<field name="POREJERCER" class="java.math.BigDecimal"/>
	<variable name="fechaIni" resetType="None" class="java.lang.String">
		<expression><![CDATA[($P{mes} == 1) ? "1 DE ENERO" : (
	($P{mes} == 2) ? "1 DE FEBRERO"	: (
		($P{mes} == 3) ? "1 DE MARZO"	: (
			($P{mes} == 4) ? "1 DE ABRIL"	: (
				($P{mes} == 5) ? "1 DE MAYO" : (
					($P{mes} == 6) ? "1 DE JUNIO" : (
						($P{mes} == 7) ? "1 DE JULIO" : (
							($P{mes} == 8) ? "1 DE AGOSTO" : (
								($P{mes} == 9) ? "1 DE SEPTIEMBRE" : (
									($P{mes} == 10) ? "1 DE OCTUBRE" : (
										($P{mes} == 11) ? "1 DE NOVIEMBRE" : (
											($P{mes} == 12) ? "1 DE DICIEMBRE" : ""
										)
									)
								)
							)
						)
					)
				)
			)
		)
	)
)]]></expression>
	</variable>
	<variable name="totalAprobado" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[($F{PARTIDA}.contains( "000" )) ? $F{APROBADO} : 0]]></expression>
	</variable>
	<variable name="totalAmpliacion" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[($F{PARTIDA}.contains( "000" )) ? $F{AMPLIACION} : 0]]></expression>
	</variable>
	<variable name="totalReduccion" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[($F{PARTIDA}.contains( "000" )) ? $F{REDUCCION} : 0]]></expression>
	</variable>
	<variable name="totalModificado" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[($F{PARTIDA}.contains( "000" )) ?$F{MODIFICADO}: 0]]></expression>
	</variable>
	<variable name="totalComprometido" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[($F{PARTIDA}.contains( "000" )) ?$F{COMPROMETIDO}: 0]]></expression>
	</variable>
	<variable name="totalDevengado" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[($F{PARTIDA}.contains( "000" )) ?$F{DEVENGADO}: 0]]></expression>
	</variable>
	<variable name="totalPagado" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[($F{PARTIDA}.contains( "000" )) ?$F{PAGADO}: 0]]></expression>
	</variable>
	<variable name="totalTotEjercido" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[($F{PARTIDA}.contains( "000" )) ?$F{TOTALEJERCIDO}: 0]]></expression>
	</variable>
	<variable name="totalPorEjercer" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[($F{PARTIDA}.contains( "000" )) ?$F{POREJERCER}: 0]]></expression>
	</variable>
	<variable name="ANIO" resetType="None" class="java.lang.String">
		<expression><![CDATA[(new SimpleDateFormat("yyyy")).format(new Date())]]></expression>
	</variable>
	<variable name="fechaFin" resetType="None" class="java.lang.String">
		<expression><![CDATA[($P{mes} == 1) ? "ESTADO DE AVANCE PRESUPUESTAL DE EGRESOS DEL 1 DE ENERO DE "+$P{anio}+" AL 31 DE ENERO DE "+$P{anio}: (
	($P{mes} == 2) ? "ESTADO DE AVANCE PRESUPUESTAL DE EGRESOS DEL 1 DE ENERO DE "+$P{anio}+" AL 28 DE FEBRERO DE "+$P{anio}  	: (
		($P{mes} == 3) ? "ESTADO DE AVANCE PRESUPUESTAL DE EGRESOS DEL 1 DE ENERO DE "+$P{anio}+" AL 31 DE MARZO DE "+$P{anio}	: (
			($P{mes} == 4) ? "ESTADO DE AVANCE PRESUPUESTAL DE EGRESOS DEL 1 DE ENERO DE "+$P{anio}+" AL 30 DE ABRIL DE "+$P{anio}	: (
				($P{mes} == 5) ? "ESTADO DE AVANCE PRESUPUESTAL DE EGRESOS DEL 1 DE ENERO DE "+$P{anio}+" AL 31 DE MAYO DE "+$P{anio} : (
					($P{mes} == 6) ? "ESTADO DE AVANCE PRESUPUESTAL DE EGRESOS DEL 1 DE ENERO DE "+$P{anio}+" AL 30 DE JUNIO DE "+$P{anio} : (
						($P{mes} == 7) ? "ESTADO DE AVANCE PRESUPUESTAL DE EGRESOS DEL 1 DE ENERO DE "+$P{anio}+" AL 31 DE JULIO DE "+$P{anio} : (
							($P{mes} == 8) ? "ESTADO DE AVANCE PRESUPUESTAL DE EGRESOS DEL 1 DE ENERO DE "+$P{anio}+" AL 31 DE AGOSTO DE "+$P{anio} : (
								($P{mes} == 9) ? "ESTADO DE AVANCE PRESUPUESTAL DE EGRESOS DEL 1 DE ENERO DE "+$P{anio}+" AL 30 DE SEPTIEMBRE DE "+$P{anio} : (
									($P{mes} == 10) ? "ESTADO DE AVANCE PRESUPUESTAL DE EGRESOS DEL 1 DE ENERO DE "+$P{anio}+" AL 31 DE OCTUBRE DE "+$P{anio} : (
										($P{mes} == 11) ? "ESTADO DE AVANCE PRESUPUESTAL DE EGRESOS DEL 1 DE ENERO DE "+$P{anio}+" AL 30 DE NOVIEMBRE DE "+$P{anio} : (
											($P{mes} == 12) ? "ESTADO DE AVANCE PRESUPUESTAL DE EGRESOS DEL 1 DE ENERO DE "+$P{anio}+" AL 31 DE DICIEMBRE DE "+$P{anio} : ""
										)
									)
								)
							)
						)
					)
				)
			)
		)
	)
)]]></expression>
	</variable>
