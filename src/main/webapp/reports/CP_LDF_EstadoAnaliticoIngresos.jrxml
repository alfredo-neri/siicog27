	<query language="SQL"><![CDATA[SELECT EAID.CONCEPTO,
       EAID.ESTIMADO,
       EAID.AMPLIACION_REDUCCION,
       EAID.MODIFICADO,
       EAID.DEVENGADO,
       EAID.RECAUDADO,
       EAID.DIFERENCIA
	 FROM GEMUSER.EAID EAID 
WHERE EAID.ID_SECTOR= $P{sector}]]></query>
