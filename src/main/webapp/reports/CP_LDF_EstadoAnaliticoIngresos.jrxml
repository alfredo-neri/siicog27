	<lastPageFooter height="60">
		<element kind="textField" uuid="4d2235a2-6fb3-46bc-889c-9d9f81c1a1e7" x="627" y="0" width="125" height="30" stretchType="NoStretch" fontName="Arial" fontSize="8.0" evaluationTime="Report" bold="false" blankWhenNull="true" hTextAlign="Center">
			<property name="com.jaspersoft.studio.unit.height" value="px"/>
			<property name="com.jaspersoft.studio.unit.width" value="px"/>
			<printWhenExpression><![CDATA[$P{noFirmas} >= 3]]></printWhenExpression>
			<box>
				<bottomPen lineWidth="1.0"/>
			</box>
			<expression><![CDATA[$P{noFirmas}==3 ? $P{firmaL3}  : $P{noFirmas}==4 ? $P{firmaL4}  : $P{firmaL5}]]></expression>
		</element>
		<element kind="textField" uuid="7d5d9832-7dd0-4bc7-99f7-7bf0ba587689" x="314" y="0" width="125" height="30" stretchType="NoStretch" fontName="Arial" fontSize="8.0" evaluationTime="Report" bold="false" blankWhenNull="true" hTextAlign="Center">
			<property name="com.jaspersoft.studio.unit.height" value="px"/>
			<printWhenExpression><![CDATA[$P{noFirmas} ==1 || $P{noFirmas} == 3 ||  $P{noFirmas} == 5]]></printWhenExpression>
			<box>
				<bottomPen lineWidth="1.0"/>
			</box>
			<expression><![CDATA[$P{noFirmas}==1 ? $P{firmaL1} : $P{noFirmas}==3 ? $P{firmaL2} :   $P{noFirmas}==5 ? $P{firmaL3} : ""]]></expression>
		</element>
		<element kind="textField" uuid="b949a861-4e44-4d66-b0f1-835a2c2cf393" x="470" y="30" width="125" height="30" stretchType="NoStretch" fontName="Arial" fontSize="8.0" evaluationTime="Report" bold="false" blankWhenNull="true" hTextAlign="Center">
			<property name="com.jaspersoft.studio.unit.height" value="px"/>
			<property name="com.jaspersoft.studio.unit.y" value="px"/>
			<printWhenExpression><![CDATA[$P{noFirmas}==2 ||  $P{noFirmas} == 4 || $P{noFirmas} == 5]]></printWhenExpression>
			<expression><![CDATA[$P{noFirmas}==2 ? $P{firmaN2}  : $P{noFirmas}==4 ? $P{firmaN3}  : $P{firmaN4}]]></expression>
		</element>
		<element kind="textField" uuid="055afd0b-22ea-4f42-86b7-c069899f4261" x="0" y="30" width="125" height="30" stretchType="NoStretch" fontName="Arial" fontSize="8.0" evaluationTime="Report" bold="false" blankWhenNull="true" hTextAlign="Center">
			<property name="com.jaspersoft.studio.unit.height" value="px"/>
			<property name="com.jaspersoft.studio.unit.y" value="px"/>
			<printWhenExpression><![CDATA[$P{noFirmas} >= 3]]></printWhenExpression>
			<expression><![CDATA[$P{firmaN1}]]></expression>
		</element>
		<element kind="textField" uuid="5828fb64-0c53-44b9-aa8c-cf31cb03396e" x="155" y="30" width="125" height="30" stretchType="NoStretch" fontName="Arial" fontSize="8.0" evaluationTime="Report" bold="false" blankWhenNull="true" hTextAlign="Center">
			<property name="com.jaspersoft.studio.unit.height" value="px"/>
			<property name="com.jaspersoft.studio.unit.y" value="px"/>
			<printWhenExpression><![CDATA[$P{noFirmas}==2 ||  $P{noFirmas} == 4 || $P{noFirmas} == 5]]></printWhenExpression>
			<expression><![CDATA[$P{noFirmas} == 2 ? $P{firmaN1} :$P{firmaN2}]]></expression>
		</element>
		<element kind="textField" uuid="5426f90e-54ea-42d8-91e4-c4e45eca7113" x="314" y="30" width="125" height="30" stretchType="NoStretch" fontName="Arial" fontSize="8.0" evaluationTime="Report" bold="false" blankWhenNull="true" hTextAlign="Center">
			<property name="com.jaspersoft.studio.unit.height" value="px"/>
			<property name="com.jaspersoft.studio.unit.y" value="px"/>
			<printWhenExpression><![CDATA[$P{noFirmas} ==1 || $P{noFirmas} == 3 ||  $P{noFirmas} == 5]]></printWhenExpression>
			<expression><![CDATA[$P{noFirmas}==1 ? $P{firmaN1} : $P{noFirmas}==3 ? $P{firmaN2} :   $P{noFirmas}==5 ? $P{firmaN3} : ""]]></expression>
