<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="IndicadoresPosturaFiscal" pageWidth="612" pageHeight="792" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="285ca15a-b4d9-4f10-a11d-6c1b1fb0c96e">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="New Data Adapter"/>
	<parameter name="imagePathLeft" class="java.lang.String"/>
	<parameter name="imagePathRigth" class="java.lang.String"/>
	<parameter name="year" class="java.lang.Integer"/>
	<parameter name="dependencia" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT 
* FROM ( 
	VALUES
		(1,2,'2. Ingresos del Sector Paraestatal', 0, 0, 0),
		(2,2,'4. Egresos del Sector Paraestatal', 0, 0, 0)
) AS TEMP (TIPO, ORDEN, CONCEPTO, ESTIMADO, DEVENGADO, PAGADO) 
UNION ALL
SELECT 	1, 1, '1. Ingresos del Gobierno de la Entidad Federativa', 
		(T1.SALINI + T1.DI_CARGOS - T1.DI_ABONOS) ESTIMADO,
		(T1.CI_ABONOS - CI_CARGOS) DEVENGADO,
		(T1.CI_ABONOS - CI_CARGOS) PAGADO
	FROM (
			SELECT DI.CUENTA, DI.NOMCTA, DI.SALINI,
			(DI.CARGOS_1 + DI.CARGOS_2 + DI.CARGOS_3 + DI.CARGOS_4 + DI.CARGOS_5 + DI.CARGOS_6 + DI.CARGOS_7 + DI.CARGOS_8 + DI.CARGOS_9 + DI.CARGOS_10 + DI.CARGOS_11 + DI.CARGOS_12) DI_CARGOS, 
			(DI.ABONOS_1 + DI.ABONOS_2 + DI.ABONOS_3 + DI.ABONOS_4 + DI.ABONOS_5 + DI.ABONOS_6 + DI.ABONOS_7 + DI.ABONOS_8 + DI.ABONOS_9 + DI.ABONOS_10 + DI.ABONOS_11 + DI.ABONOS_12) DI_ABONOS,
			(CI.CARGOS_1 + CI.CARGOS_2 + CI.CARGOS_3 + CI.CARGOS_4 + CI.CARGOS_5 + CI.CARGOS_6 + CI.CARGOS_7 + CI.CARGOS_8 + CI.CARGOS_9 + CI.CARGOS_10 + CI.CARGOS_11 + CI.CARGOS_12) CI_CARGOS, 
			(CI.ABONOS_1 + CI.ABONOS_2 + CI.ABONOS_3 + CI.ABONOS_4 + CI.ABONOS_5 + CI.ABONOS_6 + CI.ABONOS_7 + CI.ABONOS_8 + CI.ABONOS_9 + CI.ABONOS_10 + CI.ABONOS_11 + CI.ABONOS_12) CI_ABONOS
			FROM CUENTA AS DI
				INNER JOIN CUENTA AS CI ON CI.CUENTA='8150' AND 
									 CI.SCTA=DI.SCTA AND 
									 CI.SSCTA=DI.SSCTA AND 
									 CI.SSSCTA=DI.SSSCTA AND 
									 CI.SSSSCTA=DI.SSSSCTA AND 
									 CI.IDSECTOR = DI.IDSECTOR
			WHERE 	(DI.CUENTA='8110') AND 
					DI.NOTCTA=0 AND 
					DI.SCTA='' AND 
					DI.IDSECTOR=2
) T1
UNION ALL
SELECT 	2,1, '3. Egresos del Gobierno de la Entidad Federativa',
		SUM(T1.AUTORIZADO + T1.AMPLIACION - T1.REDUCCION) ESTIMADO,
		SUM(T1.COMPROMETIDO + T1.DEVENGADO + T1.PAGADO) DEVENGADO,
		SUM(T1.PAGADO) PAGADO
	FROM(
SELECT PA.PARTIDA,
	   SUM(PA.AUTO1_1 + PA.AUTO1_2 + PA.AUTO1_3 + PA.AUTO1_4 + PA.AUTO1_5 + PA.AUTO1_6 + PA.AUTO1_7 + PA.AUTO1_8 + PA.AUTO1_9 + PA.AUTO1_10 + PA.AUTO1_11 + PA.AUTO1_12) AUTORIZADO,
	   SUM(PA.AMPLI1_1 + PA.AMPLI1_2 + PA.AMPLI1_3 + PA.AMPLI1_4 + PA.AMPLI1_5 + PA.AMPLI1_6 + PA.AMPLI1_7 + PA.AMPLI1_8 + PA.AMPLI1_9 + PA.AMPLI1_10 + PA.AMPLI1_11 + PA.AMPLI1_12) AMPLIACION,
	   SUM(PA.REDU1_1 + PA.REDU1_2 + PA.REDU1_3 + PA.REDU1_4 + PA.REDU1_5 + PA.REDU1_6 + PA.REDU1_7 + PA.REDU1_8 + PA.REDU1_9 + PA.REDU1_10 + PA.REDU1_11 + PA.REDU1_12) REDUCCION,
	   SUM(PA.COMPRO1_1 + PA.COMPRO1_2 + PA.COMPRO1_3 + PA.COMPRO1_4 + PA.COMPRO1_5 + PA.COMPRO1_6 + PA.COMPRO1_7 + PA.COMPRO1_8 + PA.COMPRO1_9 + PA.COMPRO1_10 + PA.COMPRO1_11 + PA.COMPRO1_12) COMPROMETIDO,
	   SUM(PA.EJXPA1_1 + PA.EJXPA1_2 + PA.EJXPA1_3 + PA.EJXPA1_4 + PA.EJXPA1_5 + PA.EJXPA1_6 + PA.EJXPA1_7 + PA.EJXPA1_8 + PA.EJXPA1_9 + PA.EJXPA1_10 + PA.EJXPA1_11 + PA.EJXPA1_12)DEVENGADO,
	   SUM(PA.EJPA1_1 + PA.EJPA1_2 + PA.EJPA1_3 + PA.EJPA1_4 + PA.EJPA1_5 + PA.EJPA1_6 + PA.EJPA1_7 + PA.EJPA1_8 + PA.EJPA1_9 + PA.EJPA1_10 + PA.EJPA1_11 + PA.EJPA1_12) PAGADO
	  FROM PASO AS PA,
		 NATGAS AS NA
WHERE PA.IDSECTOR = NA.IDSECTOR AND
	SUBSTR(PA.PARTIDA,4) <> '0' AND
   PA.PARTIDA = NA.CLVGAS AND
   PA.IDSECTOR = 2
   GROUP BY PA.PARTIDA
)T1
ORDER BY TIPO, ORDEN]]>
	</queryString>
