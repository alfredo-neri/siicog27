	<query language="sql"><![CDATA[SELECT  SEMES, 
				ZONAS, 
				OBSZONAS, 
				TOTZONAS, 
				OBSTOTZON
		FROM PM0911
WHERE  SEMES = $P{semestre}
	AND IDSECTOR=$P{idSector}]]></query>
	<field name="SEMES" class="java.lang.Integer"/>
	<field name="ZONAS" class="java.lang.Integer"/>
