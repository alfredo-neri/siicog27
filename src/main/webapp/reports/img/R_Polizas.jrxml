	<detail>
		<band height="10">
			<element kind="textField" uuid="a2e4add3-e26a-49c9-a340-b2226c57fa97" x="600" y="0" width="60" height="10" stretchType="NoStretch" fontName="Arial Unicode MS" fontSize="7.0" pattern="#,##0.00#" hTextAlign="Center">
