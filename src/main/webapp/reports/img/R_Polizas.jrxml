		<expression><![CDATA[$F{CANPOL}]]></expression>
	</variable>
	<filterExpression><![CDATA[AND( $F{CANPOL}!=BigDecimal.valueOf(0),   $F{CANPOLH}!=BigDecimal.valueOf(0))]]></filterExpression>
