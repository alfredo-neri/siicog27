				<expression><![CDATA[$V{CANPOL1}]]></expression>
			</element>
			<element kind="textField" uuid="35e1edbf-371b-402b-953e-e86116bcfede" x="660" y="0" width="80" height="10" stretchType="NoStretch" fontName="Arial Unicode MS" fontSize="7.0" pattern="#,##0.00#" hTextAlign="Center">
