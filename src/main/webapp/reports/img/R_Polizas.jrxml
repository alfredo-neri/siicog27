			<element kind="textField" uuid="470dc2ad-d60d-43d0-bbf1-3f4f9a3171d3" x="0" y="0" width="20" height="10" stretchType="NoStretch" fontName="Arial Unicode MS" fontSize="7.0" hTextAlign="Center">
