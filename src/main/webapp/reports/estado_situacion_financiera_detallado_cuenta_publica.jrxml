	<dataset name="hacienda" uuid="d5d0c884-0727-43d4-be63-a830faaa14dd">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="LENOVO PRUEBAS"/>
		<query language="SQL"><![CDATA[SELECT 1 PRINCIPAL, SUBSTR(T3.CUENTA, 3,2) GRUPO, 
      DECODE(SUBSTR(T3.CUENTA, 3,2), 10, 'a', 20, 'b', 30, 'c', 40, 'd', 'e')LETRA,
       T3.CUENTA, T3.NOMCTA, T3.SALDO_ACTUAL, T3.SALDO_ANTERIOR FROM
(SELECT T2.CUENTA, T2.NOMCTA, T2.NAT, 
	DECODE(T2.CUENTA,'3210',-FN_400500(2),(T2.SALINI + T2.ABONOS - T2.CARGOS)) SALDO_ACTUAL,
    
     DECODE(T2.CUENTA,'3210',(SELECT (T6.S4000 - T6.S5000) RESULTADO FROM (SELECT SUM(T4.MES12) S4000, (SELECT SUM(T5.MES12) FROM TC_CUENTAANTERIOR T5 WHERE SUBSTR(T5.CUENTA,1,1)='5') S5000
		FROM TC_CUENTAANTERIOR T4 
		WHERE SUBSTR(T4.CUENTA,1,1)='4') T6),MES12) SALDO_ANTERIOR
    FROM (       
		SELECT T1.CUENTA, T1.NOMCTA, T1.STACTA NAT, T1.SALINI ,
		T1.CARGOS_1 + T1.CARGOS_2 + T1.CARGOS_3 + T1.CARGOS_4 + T1.CARGOS_5 + T1.CARGOS_6 CARGOS,
		T1.ABONOS_1 + T1.ABONOS_2 + T1.ABONOS_3 + T1.ABONOS_4 + T1.ABONOS_5 + T1.ABONOS_6 ABONOS
		FROM CUENTA T1 
		WHERE SUBSTR(T1.CUENTA,1,2) = '32' 
		AND SUBSTR(T1.CUENTA,4,1)='0' 
		AND SUBSTR(T1.CUENTA,3,1)<>'0'
		AND T1.SCTA = ''  )T2 LEFT JOIN TC_CUENTAANTERIOR TA ON
		T2.CUENTA = TA.CUENTA ) T3 ORDER BY T3.CUENTA]]></query>
		<field name="PRINCIPAL" class="java.lang.Integer">
			<property name="com.jaspersoft.studio.field.name" value="PRINCIPAL"/>
			<property name="com.jaspersoft.studio.field.label" value="PRINCIPAL"/>
		</field>
		<field name="GRUPO" class="java.lang.Integer">
			<property name="com.jaspersoft.studio.field.name" value="GRUPO"/>
			<property name="com.jaspersoft.studio.field.label" value="GRUPO"/>
		</field>
		<field name="LETRA" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="LETRA"/>
			<property name="com.jaspersoft.studio.field.label" value="LETRA"/>
		</field>
		<field name="CUENTA" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="CUENTA"/>
			<property name="com.jaspersoft.studio.field.label" value="CUENTA"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="CUENTA"/>
		</field>
		<field name="NOMCTA" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="NOMCTA"/>
			<property name="com.jaspersoft.studio.field.label" value="NOMCTA"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="CUENTA"/>
		</field>
		<field name="SALDO_ACTUAL" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="SALDO_ACTUAL"/>
			<property name="com.jaspersoft.studio.field.label" value="SALDO_ACTUAL"/>
		</field>
		<field name="SALDO_ANTERIOR" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="SALDO_ANTERIOR"/>
			<property name="com.jaspersoft.studio.field.label" value="SALDO_ANTERIOR"/>
		</field>
	</dataset>
	<dataset name="haciendar" uuid="2a27e1e6-bc18-4ba2-9dce-c315b71b67fc">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="LENOVO PRUEBAS"/>
		<parameter name="sSqlHacienda" class="java.lang.String"/>
		<query language="SQL"><![CDATA[SELECT
	1 PRINCIPAL,
	2 GRUPO,
	'a' LETRA,
	'3211' CUENTA,
	'Resultados del Ejercicio (Ahorro/ Desahorro)' NOMCTA,
	(SUM(T3.VACT4)-SUM(T3.VACT5)) SALDO_ACTUAL,
	(SUM(T3.VAN4)-SUM(T3.VAN5)) SALDO_ANTERIOR
FROM
	(
SELECT
	CASE WHEN T2.GRUPO='4' THEN SUM(T2.VMANT) ELSE 0.00 END VAN4,
	CASE WHEN T2.GRUPO='5' THEN SUM(T2.VMANT) ELSE 0.00 END VAN5,
	CASE WHEN T2.GRUPO='4' THEN SUM(T2.VMACT) ELSE 0.00 END VACT4,
	CASE WHEN T2.GRUPO='5' THEN SUM(T2.VMACT)ELSE 0.00 END VACT5
FROM
	(
SELECT
	T1.GRUPO,
	T1.SALINI,
	CASE WHEN T1.GRUPO ='4' THEN (T1.SALINI+ABONOS_ANT-CARGOS_ANT) ELSE 
	(T1.SALINI-ABONOS_ANT+CARGOS_ANT) END VMANT,
	CASE WHEN T1.GRUPO ='4' THEN (T1.SALINI+ABONOS_ACT-CARGOS_ACT) ELSE 
	(T1.SALINI-ABONOS_ACT+CARGOS_ACT) END VMACT
FROM
	(
SELECT
	SUBSTR(C.CUENTA,
	1,
	1) GRUPO,
	C.CUENTA,
	C.SALINI,
	SUM(C.CARGOS_1 + C.CARGOS_2 + C.CARGOS_3 + C.CARGOS_4 + C.CARGOS_5 + 
	C.CARGOS_6 + C.CARGOS_7 + C.CARGOS_8 + C.CARGOS_9) CARGOS_ANT,
	SUM(C.ABONOS_1 + C.ABONOS_2 + C.ABONOS_3 + C.ABONOS_4 + C.ABONOS_5 + 
	C.ABONOS_6 + C.ABONOS_7 + C.ABONOS_8 + C.ABONOS_9) ABONOS_ANT,
	SUM(C.ABONOS_1 + C.ABONOS_2 + C.ABONOS_3 + C.ABONOS_4 + C.ABONOS_5 + 
	C.ABONOS_6 + C.ABONOS_7 + C.ABONOS_8 + C.ABONOS_9 + C.ABONOS_10 + C.ABONOS_11 +
	C.ABONOS_12) ABONOS_ACT,
	SUM(C.CARGOS_1 + C.CARGOS_2 + C.CARGOS_3 + C.CARGOS_4 + C.CARGOS_5 + 
	C.CARGOS_6 + C.CARGOS_7 + C.CARGOS_8 + C.CARGOS_9 + C.CARGOS_10 + C.CARGOS_11 +
	C.CARGOS_12) CARGOS_ACT
FROM
	CUENTA C
WHERE
	C.IDSECTOR = 2 AND
	( ( (SUBSTR(C.CUENTA,
	1,
	1) =4 AND
	SUBSTR(C.CUENTA,
	4,
	1)<>'0') OR
	(SUBSTR(C.CUENTA,
	1,
	1) = 5 AND
	SUBSTR(C.CUENTA,
	2,
	1) > 0) ) AND
	C.SCTA ='')
GROUP BY
	C.CUENTA,
	C.SALINI
ORDER BY
	C.CUENTA)T1)T2
GROUP BY
	T2.GRUPO )T3
UNION
	ALL
SELECT
	1 PRINCIPAL,
	2 GRUPO,
	CASE WHEN CUENTA = '3232' THEN 'c' ELSE 'b' END LETRA,
	CUENTA,
	CASE WHEN CUENTA = '3232' THEN 'Revalúos' ELSE NOMCTA END NOMCTA,
	SALINI-CARGOS_ACT+ABONOS_ACT SALDO_ACTUAL,
	SALINI-CARGOS_ANT+ABONOS_ANT SALDO_ANTERIOR
FROM
	(
SELECT
	C.NOMCTA,
	C.CUENTA,
	C.SALINI,
	C.CARGOS_1 + C.CARGOS_2 + C.CARGOS_3 + C.CARGOS_4 + C.CARGOS_5 + C.CARGOS_6 
	+ C.CARGOS_7 + C.CARGOS_8 + C.CARGOS_9 + C.CARGOS_10 + C.CARGOS_11 + C.CARGOS_12 CARGOS_ANT,
	C.ABONOS_1 + C.ABONOS_2 + C.ABONOS_3 + C.ABONOS_4 + C.ABONOS_5 + C.ABONOS_6 
	+ C.ABONOS_7 + C.ABONOS_8 + C.ABONOS_9 + C.ABONOS_10 + C.ABONOS_11 + C.ABONOS_12 ABONOS_ANT,
	C.ABONOS_1 + C.ABONOS_2 + C.ABONOS_3 + C.ABONOS_4 + C.ABONOS_5 + C.ABONOS_6 
	+ C.ABONOS_7 + C.ABONOS_8 + C.ABONOS_9 + C.ABONOS_10 + C.ABONOS_11 +
	C.ABONOS_12 ABONOS_ACT,
	C.CARGOS_1 + C.CARGOS_2 + C.CARGOS_3 + C.CARGOS_4 + C.CARGOS_5 + C.CARGOS_6 
	+ C.CARGOS_7 + C.CARGOS_8 + C.CARGOS_9 + C.CARGOS_10 + C.CARGOS_11 +
	C.CARGOS_12 CARGOS_ACT
FROM MAYCTA MA,
	 CUENTA C,
	 CUENTA_ANTERIOR CA
		
WHERE MA.CUENTA = C.CUENTA
  AND C.CUENTA  = CA.CUENTA
  AND C.SCTA    = CA.SCTA
  AND 
	C.CUENTA IN ('3221',
	'3232') AND
	C.SCTA = '' AND
	C.IDSECTOR = 2 )
UNION
	ALL
SELECT
	*
FROM
	(
VALUES
	(1,
	1,
	'a',
	'3111',
	'Aportaciones',
	0.00,
	0.00),
	(1,
	1,
	'b',
	'3112',
	'Donaciones de Capital',
	0.00,
	0.00),
	(1,
	1,
	'c',
	'3113',
	'Actualización de la Hacienda Pública/Patrimonio',
	0.00,
	0.00),
	(1,
	2,
	'd',
	'3233',
	'Reservas',
	0.00,
	0.00),
	(1,
	2,
	'e',
	'3234',
	'Rectificaciones de Resultados de Ejercicios Anteriores',
	0.00,
	0.00),
	(1,
	3,
	'a',
	'3311',
	'Resultado por Posición Monetaria',
	0.00,
	0.00),
	(1,
	3,
	'b',
	'3312',
	'Resultado por Tenencia de Activos no Monetarios',
	0.00,
	0.00) ) AS TEMP (PRINCIPAL,
	GRUPO,
	LETRA,
	CUENTA,
	NOMCTA,
	SALDO_ACTUAL,
	SALDO_ANTERIOR)
ORDER BY
	CUENTA]]></query>
		<field name="GRUPO" class="java.lang.Integer">
			<property name="com.jaspersoft.studio.field.name" value="GRUPO"/>
			<property name="com.jaspersoft.studio.field.label" value="GRUPO"/>
		</field>
