		<parameter name="mesB" class="java.lang.String"/>
		<query language="SQL"><![CDATA[SELECT
	1 PRINCIPAL,
	1 GRUPO,
	'a' LETRA,
	CUENTA,
	NOMCTA,
	SALINI-CARGOS_ACT+ABONOS_ACT SALDO_ACTUAL,
	SALINI-CARGOS_ANT+ABONOS_ANT SALDO_ANTERIOR
FROM
	(
SELECT
	C.NOMCTA,
	C.CUENTA,
	C.SALINI,
	CA.CARGOS_1 + CA.CARGOS_2 + CA.CARGOS_3 + CA.CARGOS_4 + CA.CARGOS_5 + CA.CARGOS_6 
	+ CA.CARGOS_7 + CA.CARGOS_8 + CA.CARGOS_9  + CA.CARGOS_10 + CA.CARGOS_11 + CA.CARGOS_12 CARGOS_ANT,
	CA.ABONOS_1 + CA.ABONOS_2 + CA.ABONOS_3 + CA.ABONOS_4 + CA.ABONOS_5 + CA.ABONOS_6 
	+ CA.ABONOS_7 + CA.ABONOS_8 + CA.ABONOS_9 + CA.ABONOS_10 + CA.ABONOS_11 + CA.ABONOS_12 ABONOS_ANT,
	C.ABONOS_1 + C.ABONOS_2 + C.ABONOS_3 + C.ABONOS_4 + C.ABONOS_5 + C.ABONOS_6 
	+ C.ABONOS_7 + C.ABONOS_8 + C.ABONOS_9 + C.ABONOS_10 + C.ABONOS_11 +
	C.ABONOS_12 ABONOS_ACT,
	C.CARGOS_1 + C.CARGOS_2 + C.CARGOS_3 + C.CARGOS_4 + C.CARGOS_5 + C.CARGOS_6 
	+ C.CARGOS_7 + C.CARGOS_8 + C.CARGOS_9 + C.CARGOS_10 + C.CARGOS_11 +
	C.CARGOS_12 CARGOS_ACT
FROM MAYCTA MA,
  	 CUENTA C,
  	 CUENTA_ANTERIOR CA
WHERE MA.CUENTA = C.CUENTA
  AND C.CUENTA  = CA.CUENTA
  AND C.SCTA    = CA.SCTA
  AND C.CUENTA IN ('2117',	'2119') 
  AND C.SCTA = '' 
  AND C.IDSECTOR = 2 
 )
UNION
	ALL
SELECT
