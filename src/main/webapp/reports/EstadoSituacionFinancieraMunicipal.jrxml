					WHEN  $P{p_mes}=4  THEN  SUM(DECIMAL (C.CARGOS_1,20,2))+SUM(DECIMAL (C.CARGOS_2,20,2))+SUM(DECIMAL (C.CARGOS_3,20,2))+SUM(DECIMAL (C.CARGOS_4,20,2))
					WHEN  $P{p_mes}=5  THEN  SUM(DECIMAL (C.CARGOS_1,20,2))+SUM(DECIMAL (C.CARGOS_2,20,2))+SUM(DECIMAL (C.CARGOS_3,20,2))+SUM(DECIMAL (C.CARGOS_4,20,2))+SUM(DECIMAL (C.CARGOS_5,20,2))
					WHEN  $P{p_mes}=6  THEN  SUM(DECIMAL (C.CARGOS_1,20,2))+SUM(DECIMAL (C.CARGOS_2,20,2))+SUM(DECIMAL (C.CARGOS_3,20,2))+SUM(DECIMAL (C.CARGOS_4,20,2))+SUM(DECIMAL (C.CARGOS_5,20,2))+SUM(DECIMAL (C.CARGOS_6,20,2))
					WHEN  $P{p_mes}=7  THEN  SUM(DECIMAL (C.CARGOS_1,20,2))+SUM(DECIMAL (C.CARGOS_2,20,2))+SUM(DECIMAL (C.CARGOS_3,20,2))+SUM(DECIMAL (C.CARGOS_4,20,2))+SUM(DECIMAL (C.CARGOS_5,20,2))+SUM(DECIMAL (C.CARGOS_6,20,2))+SUM(DECIMAL (C.CARGOS_7,20,2))
					WHEN  $P{p_mes}=8  THEN  SUM(DECIMAL (C.CARGOS_1,20,2))+SUM(DECIMAL (C.CARGOS_2,20,2))+SUM(DECIMAL (C.CARGOS_3,20,2))+SUM(DECIMAL (C.CARGOS_4,20,2))+SUM(DECIMAL (C.CARGOS_5,20,2))+SUM(DECIMAL (C.CARGOS_6,20,2))+SUM(DECIMAL (C.CARGOS_7,20,2))+SUM(DECIMAL (C.CARGOS_8,20,2))
					WHEN  $P{p_mes}=9  THEN  SUM(DECIMAL (C.CARGOS_1,20,2))+SUM(DECIMAL (C.CARGOS_2,20,2))+SUM(DECIMAL (C.CARGOS_3,20,2))+SUM(DECIMAL (C.CARGOS_4,20,2))+SUM(DECIMAL (C.CARGOS_5,20,2))+SUM(DECIMAL (C.CARGOS_6,20,2))+SUM(DECIMAL (C.CARGOS_7,20,2)) +SUM(DECIMAL (C.CARGOS_8,20,2))+SUM(DECIMAL (C.CARGOS_9,20,2))
					WHEN  $P{p_mes}=10 THEN  SUM(DECIMAL (C.CARGOS_1,20,2))+SUM(DECIMAL (C.CARGOS_2,20,2))+SUM(DECIMAL (C.CARGOS_3,20,2))+SUM(DECIMAL (C.CARGOS_4,20,2))+SUM(DECIMAL (C.CARGOS_5,20,2))+SUM(DECIMAL (C.CARGOS_6,20,2))+SUM(DECIMAL (C.CARGOS_7,20,2)) +SUM(DECIMAL (C.CARGOS_8,20,2)) +SUM(DECIMAL (C.CARGOS_9,20,2))+SUM(DECIMAL (C.CARGOS_10,20,2))
					WHEN  $P{p_mes}=11 THEN  SUM(DECIMAL (C.CARGOS_1,20,2))+SUM(DECIMAL (C.CARGOS_2,20,2))+SUM(DECIMAL (C.CARGOS_3,20,2))+SUM(DECIMAL (C.CARGOS_4,20,2))+SUM(DECIMAL (C.CARGOS_5,20,2))+SUM(DECIMAL (C.CARGOS_6,20,2))+SUM(DECIMAL (C.CARGOS_7,20,2)) +SUM(DECIMAL (C.CARGOS_8,20,2)) +SUM(DECIMAL (C.CARGOS_9,20,2))+SUM(DECIMAL (C.CARGOS_10,20,2))+SUM(DECIMAL (C.CARGOS_11,20,2))
					WHEN  $P{p_mes}=12 THEN  SUM(DECIMAL (C.CARGOS_1,20,2))+SUM(DECIMAL (C.CARGOS_2,20,2))+SUM(DECIMAL (C.CARGOS_3,20,2))+SUM(DECIMAL (C.CARGOS_4,20,2))+SUM(DECIMAL (C.CARGOS_5,20,2))+SUM(DECIMAL (C.CARGOS_6,20,2))+SUM(DECIMAL (C.CARGOS_7,20,2)) +SUM(DECIMAL (C.CARGOS_8,20,2)) +SUM(DECIMAL (C.CARGOS_9,20,2))+SUM(DECIMAL (C.CARGOS_10,20,2))+SUM(DECIMAL (C.CARGOS_11,20,2))+SUM(DECIMAL (C.CARGOS_12,20,2))
					ELSE 0
				 END CARGOS_ACT
        FROM   MAYCTA MA
            INNER JOIN CUENTA C ON MA.CUENTA = C.CUENTA 
               WHERE  C.CUENTA >= '2000' 
                    AND C.CUENTA <= '3321' 
                    AND C.SCTA ='' 
                   --AND SUBSTR(C.CUENTA,3)<>'00'
			       --AND C.NOTCTA = 0
                    AND C.IDSECTOR = $P{p_Idsector}
                   GROUP BY 
                    MA.NATCTA,
			             C.NOMCTA, 
			             C.CUENTA,  
                   C.SALINI, 
                   SUBSTR(C.CUENTA,1,2) 
                  ORDER BY C.CUENTA]]>
		</queryString>
		<field name="GRUPO" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="GRUPO"/>
			<property name="com.jaspersoft.studio.field.label" value="GRUPO"/>
		</field>
		<field name="NATCTA" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="NATCTA"/>
			<property name="com.jaspersoft.studio.field.label" value="NATCTA"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="MAYCTA"/>
		</field>
		<field name="NOMCTA" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="NOMCTA"/>
			<property name="com.jaspersoft.studio.field.label" value="NOMCTA"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="CUENTA"/>
		</field>
		<field name="CUENTA" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="CUENTA"/>
			<property name="com.jaspersoft.studio.field.label" value="CUENTA"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="CUENTA"/>
		</field>
		<field name="SALINI" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="SALINI"/>
			<property name="com.jaspersoft.studio.field.label" value="SALINI"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="CUENTA"/>
		</field>
		<field name="CARGOS_ANT" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="CARGOS_ANT"/>
			<property name="com.jaspersoft.studio.field.label" value="CARGOS_ANT"/>
		</field>
		<field name="ABONOS_ANT" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="ABONOS_ANT"/>
			<property name="com.jaspersoft.studio.field.label" value="ABONOS_ANT"/>
		</field>
		<field name="ABONOS_ACT" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="ABONOS_ACT"/>
			<property name="com.jaspersoft.studio.field.label" value="ABONOS_ACT"/>
		</field>
		<field name="CARGOS_ACT" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="CARGOS_ACT"/>
			<property name="com.jaspersoft.studio.field.label" value="CARGOS_ACT"/>
		</field>
		<variable name="v_total" class="java.lang.String" incrementType="Report">
			<variableExpression><![CDATA[$P{p_Idsector}.equals(1)?
$F{GRUPO}.equals("21") ? ("TOTAL PASIVO CIRCULANTE"): 
($F{GRUPO}.equals("22")? ("TOTAL PASIVO NO CIRCULANTE"):
	($F{GRUPO}.equals("23")? ("TOTAL OTROS PASIVOS"):
		($F{GRUPO}.equals("30")?("TOTAL HACIENDA PUB./PATRIMONIO"):
			($F{GRUPO}.equals("31")?("TOTAL PATRIMONIO CONTRIBUIDO"):
				($F{GRUPO}.equals("32") ?("TOTAL PATRIMONIO GENERADO"):
					($F{GRUPO}.equals("33")?("TOTAL ACTUALIZACIÓN DEL PATRIMONIO"):
						("")
						))))))
			:
$F{GRUPO}.equals("21") ? ("TOTAL PASIVO CIRCULANTE"): 
($F{GRUPO}.equals("22")? ("TOTAL PASIVO NO CIRCULANTE"):
	($F{GRUPO}.equals("23")? ("TOTAL OTROS PASIVOS"):
		($F{GRUPO}.substring(0,1).equals("3")?("TOTAL  PATRIMONIO"):
						("")
				)))]]></variableExpression>
		</variable>
		<variable name="etiqueta" class="java.lang.String">
			<variableExpression><![CDATA[$F{GRUPO}.equals("21") ? ("PASIVO CIRCULANTE"): 
($F{GRUPO}.equals("22")? ("PASIVO NO CIRCULANTE"):
	($F{GRUPO}.equals("23")? (" OTROS PASIVOS"):
		($F{GRUPO}.equals("30")?("HACIENDA PUB./PATRIMONIO"):
			($F{GRUPO}.equals("31")?(" PATRIMONIO CONTRIBUIDO"):
				($F{GRUPO}.equals("32") ?("PATIMONIO GENERADO"):
					($F{GRUPO}.equals("33")?("ACTUALIZACIÓN DEL PAT"):
						("PASIVO CIRCULANTE")
						))))))]]></variableExpression>
		</variable>
		<variable name="v_mesAnt" class="java.math.BigDecimal">
			<variableExpression><![CDATA[$F{NATCTA}.equals("D")?
($F{SALINI}.add($F{CARGOS_ANT}).subtract($F{ABONOS_ANT}))
:($F{SALINI}.subtract($F{CARGOS_ANT}).add($F{ABONOS_ANT}))]]></variableExpression>
		</variable>
		<variable name="v_mesAct" class="java.math.BigDecimal">
			<variableExpression><![CDATA[$F{NATCTA}.equals("A") || $F{NATCTA}.equals("")?
($F{SALINI}.subtract($F{CARGOS_ACT}).add($F{ABONOS_ACT}))
:
($F{SALINI}.add($F{CARGOS_ACT}).subtract($F{ABONOS_ACT}))]]></variableExpression>
		</variable>
		<variable name="v_mesAnt2" class="java.math.BigDecimal">
			<variableExpression><![CDATA[IF($F{CUENTA}.equals("3241")&& $F{NATCTA}.equals("D"),($F{SALINI}.subtract($F{CARGOS_ANT}).add($F{ABONOS_ANT})),($V{v_mesAnt}))]]></variableExpression>
		</variable>
		<variable name="v_mesAct2" class="java.math.BigDecimal">
			<variableExpression><![CDATA[IF($F{CUENTA}.equals("3241")&& $F{NATCTA}.equals("D"),($F{SALINI}.subtract($F{CARGOS_ACT}).add($F{ABONOS_ACT})),($V{v_mesAct}))]]></variableExpression>
		</variable>
		<variable name="v_mesAntT" class="java.math.BigDecimal">
			<variableExpression><![CDATA[$F{CUENTA}.substring(0,3).equals("321") ? ($P{p_mes} == 1 ? $F{SALINI}:$P{pTotalAnt3211}) : $V{v_mesAnt2}]]></variableExpression>
		</variable>
		<variable name="v_mesActT" class="java.math.BigDecimal">
			<variableExpression><![CDATA[IF($F{CUENTA}.substring(0,3).equals("321"),$P{pTotalAct3211},$V{v_mesAct2})]]></variableExpression>
		</variable>
		<variable name="vGrupo" class="java.lang.String">
			<variableExpression><![CDATA[$P{p_Idsector}.equals(1)?
     ($F{GRUPO}+"00")
  :
   $F{GRUPO}.substring(0,1).equals("3")?
   ($F{GRUPO}.substring(0,1)+"000"):
    ($F{GRUPO}+"00")]]></variableExpression>
		</variable>
		<variable name="V_SumaMant" class="java.math.BigDecimal" resetType="Group" resetGroup="GRUPO" calculation="Sum">
			<variableExpression><![CDATA[$F{CUENTA}.substring(3).equals("0") ? BigDecimal.ZERO :  $V{v_mesAntT}]]></variableExpression>
		</variable>
		<variable name="V_SumaMact" class="java.math.BigDecimal" resetType="Group" resetGroup="GRUPO" calculation="Sum">
			<variableExpression><![CDATA[$F{CUENTA}.substring(3).equals("0") ? BigDecimal.ZERO :  $V{v_mesActT}]]></variableExpression>
		</variable>
		<variable name="v_Variacion" class="java.math.BigDecimal">
			<variableExpression><![CDATA[$V{v_mesActT}.subtract($V{v_mesAntT})]]></variableExpression>
		</variable>
		<variable name="v_SumVar" class="java.math.BigDecimal" resetType="Group" resetGroup="GRUPO" calculation="Sum">
			<variableExpression><![CDATA[$F{CUENTA}.substring(3).equals("0") ? BigDecimal.ZERO :  $V{v_Variacion}]]></variableExpression>
		</variable>
		<variable name="V_SumaTotalMAn" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{CUENTA}.substring(3).equals("0") ? BigDecimal.ZERO :  $V{v_mesAntT}]]></variableExpression>
		</variable>
		<variable name="V_SumaTotalMact" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{CUENTA}.substring(3).equals("0") ? BigDecimal.ZERO :  $V{v_mesActT}]]></variableExpression>
		</variable>
		<variable name="V_SumTotalVar" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{CUENTA}.substring(3).equals("0") ? BigDecimal.ZERO :  $V{v_Variacion}]]></variableExpression>
		</variable>
		<variable name="totalPatrimonioMesAnterior" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{CUENTA}.substring(0,1).equals("3") && !$F{CUENTA}.substring(3).equals("0")  ? $V{v_mesAntT} : BigDecimal.ZERO]]></variableExpression>
		</variable>
		<variable name="totalPatrimonioMesActual" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{CUENTA}.substring(0,1).equals("3") && !$F{CUENTA}.substring(3).equals("0")  ? $V{v_mesActT} : BigDecimal.ZERO]]></variableExpression>
		</variable>
		<variable name="totalPatrimonioVariacion" class="java.math.BigDecimal">
			<variableExpression><![CDATA[$V{totalPatrimonioMesActual}.subtract($V{totalPatrimonioMesAnterior})]]></variableExpression>
		</variable>
		<variable name="sumaPasivoActual" class="java.math.BigDecimal" resetType="Group" resetGroup="Grupo1" calculation="Sum">
			<variableExpression><![CDATA[$F{CUENTA}.substring(3).equals("0") ? BigDecimal.ZERO :  $V{v_mesActT}]]></variableExpression>
		</variable>
		<variable name="sumaPasivoAnterior" class="java.math.BigDecimal" resetType="Group" resetGroup="Grupo1" calculation="Sum">
			<variableExpression><![CDATA[$F{CUENTA}.substring(3).equals("0") ? BigDecimal.ZERO :  $V{v_mesAntT}]]></variableExpression>
		</variable>
		<group name="Grupo1">
			<groupExpression><![CDATA[$F{CUENTA}.substring(0,1)]]></groupExpression>
		</group>
		<group name="GRUPO">
			<groupExpression><![CDATA[$F{GRUPO}]]></groupExpression>
		</group>
	</subDataset>
	<subDataset name="DatasetOrden" uuid="ac231cf6-831d-48e1-9fa3-bd51bc83e898">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="gem21"/>
		<parameter name="pMes" class="java.lang.Integer"/>
		<parameter name="pSector" class="java.lang.Integer"/>
		<queryString language="SQL">
			<![CDATA[SELECT  SUBSTR(C.CUENTA,1,2)  GRUPO, 
               MA.NATCTA, 
               C.NOMCTA, 
               C.CUENTA,  
               C.SALINI, 
            CASE   
                WHEN  $P{pMes}=1  THEN    0
                WHEN  $P{pMes}=2  THEN  SUM(DECIMAL (C.CARGOS_1,20,2))
                WHEN  $P{pMes}=3  THEN  SUM(DECIMAL (C.CARGOS_1,20,2))+SUM(DECIMAL (C.CARGOS_2,20,2))
                WHEN  $P{pMes}=4  THEN  SUM(DECIMAL (C.CARGOS_1,20,2))+SUM(DECIMAL (C.CARGOS_2,20,2))+SUM(DECIMAL (C.CARGOS_3,20,2))
                WHEN  $P{pMes}=5  THEN  SUM(DECIMAL (C.CARGOS_1,20,2))+SUM(DECIMAL (C.CARGOS_2,20,2))+SUM(DECIMAL (C.CARGOS_3,20,2))+SUM(DECIMAL (C.CARGOS_4,20,2))
                WHEN  $P{pMes}=6  THEN  SUM(DECIMAL (C.CARGOS_1,20,2))+SUM(DECIMAL (C.CARGOS_2,20,2))+SUM(DECIMAL (C.CARGOS_3,20,2))+SUM(DECIMAL (C.CARGOS_4,20,2))+SUM(DECIMAL (C.CARGOS_5,20,2))
                WHEN  $P{pMes}=7  THEN  SUM(DECIMAL (C.CARGOS_1,20,2))+SUM(DECIMAL (C.CARGOS_2,20,2))+SUM(DECIMAL (C.CARGOS_3,20,2))+SUM(DECIMAL (C.CARGOS_4,20,2))+SUM(DECIMAL (C.CARGOS_5,20,2))+SUM(DECIMAL (C.CARGOS_6,20,2))
                WHEN  $P{pMes}=8  THEN  SUM(DECIMAL (C.CARGOS_1,20,2))+SUM(DECIMAL (C.CARGOS_2,20,2))+SUM(DECIMAL (C.CARGOS_3,20,2))+SUM(DECIMAL (C.CARGOS_4,20,2))+SUM(DECIMAL (C.CARGOS_5,20,2))+SUM(DECIMAL (C.CARGOS_6,20,2))+SUM(DECIMAL (C.CARGOS_7,20,2))
                WHEN  $P{pMes}=9  THEN  SUM(DECIMAL (C.CARGOS_1,20,2))+SUM(DECIMAL (C.CARGOS_2,20,2))+SUM(DECIMAL (C.CARGOS_3,20,2))+SUM(DECIMAL (C.CARGOS_4,20,2))+SUM(DECIMAL (C.CARGOS_5,20,2))+SUM(DECIMAL (C.CARGOS_6,20,2))+SUM(DECIMAL (C.CARGOS_7,20,2)) +SUM(DECIMAL (C.CARGOS_8,20,2))
                WHEN  $P{pMes}=10 THEN  SUM(DECIMAL (C.CARGOS_1,20,2))+SUM(DECIMAL (C.CARGOS_2,20,2))+SUM(DECIMAL (C.CARGOS_3,20,2))+SUM(DECIMAL (C.CARGOS_4,20,2))+SUM(DECIMAL (C.CARGOS_5,20,2))+SUM(DECIMAL (C.CARGOS_6,20,2))+SUM(DECIMAL (C.CARGOS_7,20,2)) +SUM(DECIMAL (C.CARGOS_8,20,2)) +SUM(DECIMAL (C.CARGOS_9,20,2))
                WHEN  $P{pMes}=11 THEN  SUM(DECIMAL (C.CARGOS_1,20,2))+SUM(DECIMAL (C.CARGOS_2,20,2))+SUM(DECIMAL (C.CARGOS_3,20,2))+SUM(DECIMAL (C.CARGOS_4,20,2))+SUM(DECIMAL (C.CARGOS_5,20,2))+SUM(DECIMAL (C.CARGOS_6,20,2))+SUM(DECIMAL (C.CARGOS_7,20,2)) +SUM(DECIMAL (C.CARGOS_8,20,2)) +SUM(DECIMAL (C.CARGOS_9,20,2))+SUM(DECIMAL (C.CARGOS_10,20,2))
                WHEN  $P{pMes}=12 THEN  SUM(DECIMAL (C.CARGOS_1,20,2))+SUM(DECIMAL (C.CARGOS_2,20,2))+SUM(DECIMAL (C.CARGOS_3,20,2))+SUM(DECIMAL (C.CARGOS_4,20,2))+SUM(DECIMAL (C.CARGOS_5,20,2))+SUM(DECIMAL (C.CARGOS_6,20,2))+SUM(DECIMAL (C.CARGOS_7,20,2)) +SUM(DECIMAL (C.CARGOS_8,20,2)) +SUM(DECIMAL (C.CARGOS_9,20,2))+SUM(DECIMAL (C.CARGOS_10,20,2))+SUM(DECIMAL (C.CARGOS_11,20,2))
            ELSE 0
            END CARGOS_ANT,	
            CASE   
                WHEN  $P{pMes}=1  THEN  0
                WHEN  $P{pMes}=2  THEN  SUM(DECIMAL (C.ABONOS_1,20,2))
                WHEN  $P{pMes}=3  THEN  SUM(DECIMAL (C.ABONOS_1,20,2))+SUM(DECIMAL (C.ABONOS_2,20,2))
                WHEN  $P{pMes}=4  THEN  SUM(DECIMAL (C.ABONOS_1,20,2))+SUM(DECIMAL (C.ABONOS_2,20,2))+SUM(DECIMAL (C.ABONOS_3,20,2))
                WHEN  $P{pMes}=5  THEN  SUM(DECIMAL (C.ABONOS_1,20,2))+SUM(DECIMAL (C.ABONOS_2,20,2))+SUM(DECIMAL (C.ABONOS_3,20,2))+SUM(DECIMAL (C.ABONOS_4,20,2))
                WHEN  $P{pMes}=6  THEN  SUM(DECIMAL (C.ABONOS_1,20,2))+SUM(DECIMAL (C.ABONOS_2,20,2))+SUM(DECIMAL (C.ABONOS_3,20,2))+SUM(DECIMAL (C.ABONOS_4,20,2))+SUM(DECIMAL (C.ABONOS_5,20,2))
                WHEN  $P{pMes}=7  THEN  SUM(DECIMAL (C.ABONOS_1,20,2))+SUM(DECIMAL (C.ABONOS_2,20,2))+SUM(DECIMAL (C.ABONOS_3,20,2))+SUM(DECIMAL (C.ABONOS_4,20,2))+SUM(DECIMAL (C.ABONOS_5,20,2))+SUM(DECIMAL (C.ABONOS_6,20,2))
                WHEN  $P{pMes}=8  THEN  SUM(DECIMAL (C.ABONOS_1,20,2))+SUM(DECIMAL (C.ABONOS_2,20,2))+SUM(DECIMAL (C.ABONOS_3,20,2))+SUM(DECIMAL (C.ABONOS_4,20,2))+SUM(DECIMAL (C.ABONOS_5,20,2))+SUM(DECIMAL (C.ABONOS_6,20,2))+SUM(DECIMAL (C.ABONOS_7,20,2))
                WHEN  $P{pMes}=9  THEN  SUM(DECIMAL (C.ABONOS_1,20,2))+SUM(DECIMAL (C.ABONOS_2,20,2))+SUM(DECIMAL (C.ABONOS_3,20,2))+SUM(DECIMAL (C.ABONOS_4,20,2))+SUM(DECIMAL (C.ABONOS_5,20,2))+SUM(DECIMAL (C.ABONOS_6,20,2))+SUM(DECIMAL (C.ABONOS_7,20,2)) +SUM(DECIMAL (C.ABONOS_8,20,2))
                WHEN  $P{pMes}=10 THEN  SUM(DECIMAL (C.ABONOS_1,20,2))+SUM(DECIMAL (C.ABONOS_2,20,2))+SUM(DECIMAL (C.ABONOS_3,20,2))+SUM(DECIMAL (C.ABONOS_4,20,2))+SUM(DECIMAL (C.ABONOS_5,20,2))+SUM(DECIMAL (C.ABONOS_6,20,2))+SUM(DECIMAL (C.ABONOS_7,20,2)) +SUM(DECIMAL (C.ABONOS_8,20,2)) +SUM(DECIMAL (C.ABONOS_9,20,2))
                WHEN  $P{pMes}=11 THEN  SUM(DECIMAL (C.ABONOS_1,20,2))+SUM(DECIMAL (C.ABONOS_2,20,2))+SUM(DECIMAL (C.ABONOS_3,20,2))+SUM(DECIMAL (C.ABONOS_4,20,2))+SUM(DECIMAL (C.ABONOS_5,20,2))+SUM(DECIMAL (C.ABONOS_6,20,2))+SUM(DECIMAL (C.ABONOS_7,20,2)) +SUM(DECIMAL (C.ABONOS_8,20,2)) +SUM(DECIMAL (C.ABONOS_9,20,2))+SUM(DECIMAL (C.ABONOS_10,20,2))
                WHEN  $P{pMes}=12 THEN  SUM(DECIMAL (C.ABONOS_1,20,2))+SUM(DECIMAL (C.ABONOS_2,20,2))+SUM(DECIMAL (C.ABONOS_3,20,2))+SUM(DECIMAL (C.ABONOS_4,20,2))+SUM(DECIMAL (C.ABONOS_5,20,2))+SUM(DECIMAL (C.ABONOS_6,20,2))+SUM(DECIMAL (C.ABONOS_7,20,2)) +SUM(DECIMAL (C.ABONOS_8,20,2)) +SUM(DECIMAL (C.ABONOS_9,20,2))+SUM(DECIMAL (C.ABONOS_10,20,2))+SUM(DECIMAL (C.ABONOS_11,20,2))
            ELSE 0
            END ABONOS_ANT,
            CASE   
              	WHEN  $P{pMes}=1  THEN  SUM(DECIMAL (C.ABONOS_1,20,2))
                WHEN  $P{pMes}=2  THEN  SUM(DECIMAL (C.ABONOS_1,20,2))+SUM(DECIMAL (C.ABONOS_2,20,2))
                WHEN  $P{pMes}=3  THEN  SUM(DECIMAL (C.ABONOS_1,20,2))+SUM(DECIMAL (C.ABONOS_2,20,2))+SUM(DECIMAL (C.ABONOS_3,20,2))
                WHEN  $P{pMes}=4  THEN  SUM(DECIMAL (C.ABONOS_1,20,2))+SUM(DECIMAL (C.ABONOS_2,20,2))+SUM(DECIMAL (C.ABONOS_3,20,2))+SUM(DECIMAL (C.ABONOS_4,20,2))
                WHEN  $P{pMes}=5  THEN  SUM(DECIMAL (C.ABONOS_1,20,2))+SUM(DECIMAL (C.ABONOS_2,20,2))+SUM(DECIMAL (C.ABONOS_3,20,2))+SUM(DECIMAL (C.ABONOS_4,20,2))+SUM(DECIMAL (C.ABONOS_5,20,2))
                WHEN  $P{pMes}=6  THEN  SUM(DECIMAL (C.ABONOS_1,20,2))+SUM(DECIMAL (C.ABONOS_2,20,2))+SUM(DECIMAL (C.ABONOS_3,20,2))+SUM(DECIMAL (C.ABONOS_4,20,2))+SUM(DECIMAL (C.ABONOS_5,20,2))+SUM(DECIMAL (C.ABONOS_6,20,2))
                WHEN  $P{pMes}=7  THEN  SUM(DECIMAL (C.ABONOS_1,20,2))+SUM(DECIMAL (C.ABONOS_2,20,2))+SUM(DECIMAL (C.ABONOS_3,20,2))+SUM(DECIMAL (C.ABONOS_4,20,2))+SUM(DECIMAL (C.ABONOS_5,20,2))+SUM(DECIMAL (C.ABONOS_6,20,2))+SUM(DECIMAL (C.ABONOS_7,20,2))
                WHEN  $P{pMes}=8  THEN  SUM(DECIMAL (C.ABONOS_1,20,2))+SUM(DECIMAL (C.ABONOS_2,20,2))+SUM(DECIMAL (C.ABONOS_3,20,2))+SUM(DECIMAL (C.ABONOS_4,20,2))+SUM(DECIMAL (C.ABONOS_5,20,2))+SUM(DECIMAL (C.ABONOS_6,20,2))+SUM(DECIMAL (C.ABONOS_7,20,2))+SUM(DECIMAL (C.ABONOS_8,20,2))
                WHEN  $P{pMes}=9  THEN  SUM(DECIMAL (C.ABONOS_1,20,2))+SUM(DECIMAL (C.ABONOS_2,20,2))+SUM(DECIMAL (C.ABONOS_3,20,2))+SUM(DECIMAL (C.ABONOS_4,20,2))+SUM(DECIMAL (C.ABONOS_5,20,2))+SUM(DECIMAL (C.ABONOS_6,20,2))+SUM(DECIMAL (C.ABONOS_7,20,2)) +SUM(DECIMAL (C.ABONOS_8,20,2))+SUM(DECIMAL (C.ABONOS_9,20,2))
                WHEN  $P{pMes}=10 THEN  SUM(DECIMAL (C.ABONOS_1,20,2))+SUM(DECIMAL (C.ABONOS_2,20,2))+SUM(DECIMAL (C.ABONOS_3,20,2))+SUM(DECIMAL (C.ABONOS_4,20,2))+SUM(DECIMAL (C.ABONOS_5,20,2))+SUM(DECIMAL (C.ABONOS_6,20,2))+SUM(DECIMAL (C.ABONOS_7,20,2)) +SUM(DECIMAL (C.ABONOS_8,20,2)) +SUM(DECIMAL (C.ABONOS_9,20,2))+SUM(DECIMAL (C.ABONOS_10,20,2))
                WHEN  $P{pMes}=11 THEN  SUM(DECIMAL (C.ABONOS_1,20,2))+SUM(DECIMAL (C.ABONOS_2,20,2))+SUM(DECIMAL (C.ABONOS_3,20,2))+SUM(DECIMAL (C.ABONOS_4,20,2))+SUM(DECIMAL (C.ABONOS_5,20,2))+SUM(DECIMAL (C.ABONOS_6,20,2))+SUM(DECIMAL (C.ABONOS_7,20,2)) +SUM(DECIMAL (C.ABONOS_8,20,2)) +SUM(DECIMAL (C.ABONOS_9,20,2))+SUM(DECIMAL (C.ABONOS_10,20,2))+SUM(DECIMAL (C.ABONOS_11,20,2))
                WHEN  $P{pMes}=12 THEN  SUM(DECIMAL (C.ABONOS_1,20,2))+SUM(DECIMAL (C.ABONOS_2,20,2))+SUM(DECIMAL (C.ABONOS_3,20,2))+SUM(DECIMAL (C.ABONOS_4,20,2))+SUM(DECIMAL (C.ABONOS_5,20,2))+SUM(DECIMAL (C.ABONOS_6,20,2))+SUM(DECIMAL (C.ABONOS_7,20,2)) +SUM(DECIMAL (C.ABONOS_8,20,2)) +SUM(DECIMAL (C.ABONOS_9,20,2))+SUM(DECIMAL (C.ABONOS_10,20,2))+SUM(DECIMAL (C.ABONOS_11,20,2))+SUM(DECIMAL (C.ABONOS_12,20,2))
            ELSE 0
            END ABONOS_ACT,
            CASE   
                WHEN  $P{pMes}=1  THEN  SUM(DECIMAL (C.CARGOS_1,20,2))
                WHEN  $P{pMes}=2  THEN  SUM(DECIMAL (C.CARGOS_1,20,2))+SUM(DECIMAL (C.CARGOS_2,20,2))
                WHEN  $P{pMes}=3  THEN  SUM(DECIMAL (C.CARGOS_1,20,2))+SUM(DECIMAL (C.CARGOS_2,20,2))+SUM(DECIMAL (C.CARGOS_3,20,2))
                WHEN  $P{pMes}=4  THEN  SUM(DECIMAL (C.CARGOS_1,20,2))+SUM(DECIMAL (C.CARGOS_2,20,2))+SUM(DECIMAL (C.CARGOS_3,20,2))+SUM(DECIMAL (C.CARGOS_4,20,2))
                WHEN  $P{pMes}=5  THEN  SUM(DECIMAL (C.CARGOS_1,20,2))+SUM(DECIMAL (C.CARGOS_2,20,2))+SUM(DECIMAL (C.CARGOS_3,20,2))+SUM(DECIMAL (C.CARGOS_4,20,2))+SUM(DECIMAL (C.CARGOS_5,20,2))
                WHEN  $P{pMes}=6  THEN  SUM(DECIMAL (C.CARGOS_1,20,2))+SUM(DECIMAL (C.CARGOS_2,20,2))+SUM(DECIMAL (C.CARGOS_3,20,2))+SUM(DECIMAL (C.CARGOS_4,20,2))+SUM(DECIMAL (C.CARGOS_5,20,2))+SUM(DECIMAL (C.CARGOS_6,20,2))
                WHEN  $P{pMes}=7  THEN  SUM(DECIMAL (C.CARGOS_1,20,2))+SUM(DECIMAL (C.CARGOS_2,20,2))+SUM(DECIMAL (C.CARGOS_3,20,2))+SUM(DECIMAL (C.CARGOS_4,20,2))+SUM(DECIMAL (C.CARGOS_5,20,2))+SUM(DECIMAL (C.CARGOS_6,20,2))+SUM(DECIMAL (C.CARGOS_7,20,2))
                WHEN  $P{pMes}=8  THEN  SUM(DECIMAL (C.CARGOS_1,20,2))+SUM(DECIMAL (C.CARGOS_2,20,2))+SUM(DECIMAL (C.CARGOS_3,20,2))+SUM(DECIMAL (C.CARGOS_4,20,2))+SUM(DECIMAL (C.CARGOS_5,20,2))+SUM(DECIMAL (C.CARGOS_6,20,2))+SUM(DECIMAL (C.CARGOS_7,20,2))+SUM(DECIMAL (C.CARGOS_8,20,2))
                WHEN  $P{pMes}=9  THEN  SUM(DECIMAL (C.CARGOS_1,20,2))+SUM(DECIMAL (C.CARGOS_2,20,2))+SUM(DECIMAL (C.CARGOS_3,20,2))+SUM(DECIMAL (C.CARGOS_4,20,2))+SUM(DECIMAL (C.CARGOS_5,20,2))+SUM(DECIMAL (C.CARGOS_6,20,2))+SUM(DECIMAL (C.CARGOS_7,20,2)) +SUM(DECIMAL (C.CARGOS_8,20,2))+SUM(DECIMAL (C.CARGOS_9,20,2))
                WHEN  $P{pMes}=10 THEN  SUM(DECIMAL (C.CARGOS_1,20,2))+SUM(DECIMAL (C.CARGOS_2,20,2))+SUM(DECIMAL (C.CARGOS_3,20,2))+SUM(DECIMAL (C.CARGOS_4,20,2))+SUM(DECIMAL (C.CARGOS_5,20,2))+SUM(DECIMAL (C.CARGOS_6,20,2))+SUM(DECIMAL (C.CARGOS_7,20,2)) +SUM(DECIMAL (C.CARGOS_8,20,2)) +SUM(DECIMAL (C.CARGOS_9,20,2))+SUM(DECIMAL (C.CARGOS_10,20,2))
                WHEN  $P{pMes}=11 THEN  SUM(DECIMAL (C.CARGOS_1,20,2))+SUM(DECIMAL (C.CARGOS_2,20,2))+SUM(DECIMAL (C.CARGOS_3,20,2))+SUM(DECIMAL (C.CARGOS_4,20,2))+SUM(DECIMAL (C.CARGOS_5,20,2))+SUM(DECIMAL (C.CARGOS_6,20,2))+SUM(DECIMAL (C.CARGOS_7,20,2)) +SUM(DECIMAL (C.CARGOS_8,20,2)) +SUM(DECIMAL (C.CARGOS_9,20,2))+SUM(DECIMAL (C.CARGOS_10,20,2))+SUM(DECIMAL (C.CARGOS_11,20,2))
                WHEN  $P{pMes}=12 THEN  SUM(DECIMAL (C.CARGOS_1,20,2))+SUM(DECIMAL (C.CARGOS_2,20,2))+SUM(DECIMAL (C.CARGOS_3,20,2))+SUM(DECIMAL (C.CARGOS_4,20,2))+SUM(DECIMAL (C.CARGOS_5,20,2))+SUM(DECIMAL (C.CARGOS_6,20,2))+SUM(DECIMAL (C.CARGOS_7,20,2)) +SUM(DECIMAL (C.CARGOS_8,20,2)) +SUM(DECIMAL (C.CARGOS_9,20,2))+SUM(DECIMAL (C.CARGOS_10,20,2))+SUM(DECIMAL (C.CARGOS_11,20,2))+SUM(DECIMAL (C.CARGOS_12,20,2))
            ELSE 0
            END CARGOS_ACT
              FROM   MAYCTA MA
              INNER JOIN CUENTA C ON MA.CUENTA = C.CUENTA 
              WHERE   C.CUENTA BETWEEN '7600' AND '8999'

              AND C.SCTA = '' 
             AND C.NOTCTA = 0
              AND C.IDSECTOR = $P{pSector}
              GROUP BY 
                  MA.NATCTA,
                  C.NOMCTA, 
                  C.CUENTA,  
                  C.SALINI, 
                  SUBSTR(C.CUENTA,1,2) 
              ORDER BY C.CUENTA]]>
		</queryString>
