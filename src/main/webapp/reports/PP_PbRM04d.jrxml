	<parameter name="nombreMunicipio" class="java.lang.String"/>
	<parameter name="imagenPathLeft" class="java.lang.String"/>
	<parameter name="imagenPathRigth" class="java.lang.String"/>
	<parameter name="sector" class="java.lang.Integer"/>
	<parameter name="claveMunicipio" class="java.lang.String"/>
	<parameter name="noFirmas" class="java.lang.Integer"/>
	<parameter name="firmaL1" class="java.lang.String"/>
	<parameter name="firmaN1" class="java.lang.String"/>
	<parameter name="firmaL2" class="java.lang.String"/>
	<parameter name="firmaN2" class="java.lang.String"/>
	<parameter name="firmaL3" class="java.lang.String"/>
	<parameter name="firmaN3" class="java.lang.String"/>
	<parameter name="firmaL4" class="java.lang.String"/>
	<parameter name="firmaN4" class="java.lang.String"/>
	<parameter name="firmaL5" class="java.lang.String"/>
	<parameter name="firmaN5" class="java.lang.String"/>
	<query language="sql"><![CDATA[SELECT CLVGAS, NOMGAS, NVL(AUTORIZADO,0) AUTORIZADO, NVL(EJERCIDO,0) EJERCIDO, NVL(PRESUPUESTADO,0) PRESUPUESTADO
	FROM (
				SELECT  T1.CLVGAS, T1.NOMGAS, 
								(SELECT SUM(AUTO1_13) FROM PASO WHERE PARTIDA = T1.CLVGAS AND IDSECTOR = $P{sector})  AUTORIZADO,
						 		(SELECT SUM(P.TOEJE1_1 + P.TOEJE1_2 + P.TOEJE1_3 + P.TOEJE1_4 + 
											P.TOEJE1_5 + P.TOEJE1_6 + P.TOEJE1_7 + P.TOEJE1_8 + 
											P.TOEJE1_9 + P.TOEJE1_10 + P.TOEJE1_11 + P.TOEJE1_12) 
						 				FROM PASO P WHERE PARTIDA = T1.CLVGAS  AND IDSECTOR = $P{sector} ) EJERCIDO,
								(SELECT SUM(AUTORIZADO_13) FROM TW_ANTEPROYECTO WHERE PARTIDA = T1.CLVGAS AND IDSECTOR = $P{sector} ) PRESUPUESTADO
						FROM (
									SELECT 	N.CLVGAS, N.NOMGAS 
											FROM NATGAS N
									WHERE 	SUBSTR(N.CLVGAS,2) = '000'
										AND N.IDSECTOR = $P{sector}
									ORDER BY N.CLVGAS
						) T1
		UNION ALL
		SELECT 	C.CUENTA, C.NOMCTA,
				(SELECT SALINI 
						FROM CUENTA 
				 WHERE CUENTA = '8210' AND SCTA='' AND IDSECTOR = $P{sector})AS AUTORIZADO,
				(SELECT SUM(P.TOEJE1_1 + P.TOEJE1_2 + P.TOEJE1_3 + P.TOEJE1_4 + 
							P.TOEJE1_5 + P.TOEJE1_6 + P.TOEJE1_7 + P.TOEJE1_8 + 
							P.TOEJE1_9 + P.TOEJE1_10 + P.TOEJE1_11 + P.TOEJE1_12) 
						FROM PASO P  
				 WHERE SUBSTR(P.PARTIDA,4) <> '0' AND P.IDSECTOR = $P{sector} ) AS EJERCIDO,
				(SELECT SUM(A.AUTORIZADO_13) 
						FROM TW_ANTEPROYECTO A 
				 WHERE SUBSTR(A.PARTIDA,4) <> '0' AND A.IDSECTOR = $P{sector})AS PRESUPUESTADO
			FROM CUENTA  C
		WHERE 	C.CUENTA ='8200'
			AND C.IDSECTOR =  $P{sector}
) T2]]></query>
