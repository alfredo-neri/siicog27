		</parameter>
		<parameter name="p_clvdep" class="java.lang.String"/>
		<parameter name="p_sector" class="java.lang.Integer"/>
		<query language="sql"><![CDATA[SELECT C.CLVDEP, C.NOMDEP FROM CATDEP C WHERE C.CLVDEP=  $P{p_clvdep} AND C.IDSECTOR= $P{p_sector}]]></query>
		<field name="CLVDEP" class="java.lang.String"/>
		<field name="NOMDEP" class="java.lang.String"/>
		<variable name="v_mes" class="java.util.List">
