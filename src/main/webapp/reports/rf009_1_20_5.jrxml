(29)
:($V{v_dia}.get($P{mes}))
):($V{v_dia}.get($P{mes}))]]></expression>
	</variable>
	<variable name="modificado" class="java.lang.Double">
		<expression><![CDATA[($F{A} + $F{F} - $F{G})]]></expression>
	</variable>
	<variable name="ejercido" class="java.lang.Double">
		<expression><![CDATA[$F{CPT} + $F{C} + $F{B}]]></expression>
	</variable>
	<variable name="porEjercer" class="java.lang.Double">
		<expression><![CDATA[$V{modificado} - $V{ejercido}]]></expression>
	</variable>
	<variable name="sumModificado" class="java.lang.Double">
		<expression><![CDATA[$V{v_a1}+$V{v_f1}-$V{v_g1}]]></expression>
	</variable>
	<variable name="sumEjercido" class="java.lang.Double">
		<expression><![CDATA[$V{v_cpt1} +$V{v_c1} + $V{v_b1}]]></expression>
	</variable>
	<variable name="sumPorEjercer" class="java.lang.Double">
		<expression><![CDATA[$V{sumModificado}-$V{sumEjercido}]]></expression>
	</variable>
