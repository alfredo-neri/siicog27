	<dataset name="DATOS" uuid="cb58cbec-920a-4548-8c95-b42791a44720">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="GEMDB-SERVER"/>
		<parameter name="CVETEMAS" class="java.lang.String"/>
		<parameter name="CLVDEP" class="java.lang.String"/>
		<parameter name="CLVFUN" class="java.lang.String"
			><description><![CDATA[]]></description>
		</parameter>
		<parameter name="CVEIND" class="java.lang.String"
			><description><![CDATA[]]></description>
		</parameter>
		<query language="sql"><![CDATA[SELECT
FTECNICADD.CLVDEP, FTECNICADD.CLVFUN, FTECNICADD.CODIGO, FTECNICADD.VARIABLES, FTECNICADD.UNIMED, FTECNICADD.TIPOPER, DECIMAL(FTECNICADD.TRIM1,20,2) AS TRIM1, DECIMAL(FTECNICADD.TRIM2,20,2) AS TRIM2, DECIMAL(FTECNICADD.TRIM3,20,2) AS TRIM3, DECIMAL(FTECNICADD.TRIM4,20,2) AS TRIM4, DECIMAL(FTECNICADD.METANUAL,20,2) AS METANUAL, FTECNICADD.CVETEMAS, FTECNICADD.CVEVAR,
SUBSTR(FTECNICADD.CVEIND,1,8) AS CODPROG,
SUBSTR(FTECNICADD.CVEIND,9,2) AS CODNIV,
SUBSTR(FTECNICADD.CVEIND,11,3) AS CODCONSEC
FROM
FTECNICADD FTECNICADD
WHERE FTECNICADD.CVETEMAS=$P{CVETEMAS} 
AND FTECNICADD.CLVDEP=$P{CLVDEP}
AND FTECNICADD.CLVFUN=$P{CLVFUN}
AND FTECNICADD.CVEIND=$P{CVEIND}]]></query>
		<field name="CLVDEP" class="java.lang.String"/>
		<field name="CLVFUN" class="java.lang.String"/>
		<field name="CODIGO" class="java.lang.Integer"/>
		<field name="VARIABLES" class="java.lang.String"/>
		<field name="UNIMED" class="java.lang.String"/>
		<field name="TIPOPER" class="java.lang.String"/>
		<field name="TRIM1" class="java.math.BigDecimal"/>
		<field name="TRIM2" class="java.math.BigDecimal"/>
		<field name="TRIM3" class="java.math.BigDecimal"/>
		<field name="TRIM4" class="java.math.BigDecimal"/>
		<field name="METANUAL" class="java.math.BigDecimal"/>
		<field name="CVETEMAS" class="java.lang.String"/>
		<field name="CVEVAR" class="java.lang.String"/>
		<field name="CODPROG" class="java.lang.String"/>
		<field name="CODNIV" class="java.lang.String"/>
		<field name="CODCONSEC" class="java.lang.String"/>
	</dataset>
	<parameter name="anio" class="java.lang.Integer"/>
	<parameter name="imagen" class="java.lang.String"/>
	<parameter name="firmaCargo1" class="java.lang.String"/>
	<parameter name="firmaCargo2" class="java.lang.String"/>
	<parameter name="firmaNombre1" class="java.lang.String"/>
	<parameter name="firmaNombre2" class="java.lang.String"/>
	<query language="sql"><![CDATA[SELECT  
--(FT.CLVDEP || FT.CLVFUN || FT.CLVFIN || FT.CVETEMAS || FT.CVEIND ) AS GRUPO,
FT.ID GRUPO, 
CD3.CVETEMAS, FT.CLVFUN,FT.OBJETIVO, 
        CD1.DESCRIPCION  NOMPILAR,
        CD2.DESCRIPCION  NOMTEMA, 
        CD3.DESCRIPCION  NOMSUBTEMA, 
        MN1.CAMPO6       NOMPROG,
        MN2.CAMPO6       NOMPROY,
FT.CLVDEP, 
        CGM.NOMBRE       NOMBREGEN,
        CAA.NOMBRE       NOMBREAUX,
        MIR.NOMIND       NOMINDICADOR,
        FT.FORMULA,FT.INTERPRETACION,FT.DIMENSION,NVL(FT.FACTOR,0)  FACTOR,FT.DESCFAC, FT.FRECUENCIA, FT.TIPO, FT.DESCANUAL, FT.MEDIOS, FT.METASACT, 
        FT.CVEIND, FT.LINEA_BASE,
FT.TRIM1E ,
FT.TRIM2E ,
FT.TRIM3E , 
FT.TRIM4E , 
FT.METANUALE 
FROM 
FTECNICADM FT
INNER JOIN CPD CD1     ON SUBSTR(FT.CVETEMAS,1,4) = CD1.CVETEMAS
INNER JOIN CPD CD2     ON SUBSTR(FT.CVETEMAS,1,6) = CD2.CVETEMAS
INNER JOIN CPD CD3	   ON FT.CVETEMAS = CD3.CVETEMAS
INNER JOIN MUNINEP MN1 ON SUBSTR(FT.CLVFUN,1,8) = MN1.CAMPO7  AND FT.IDSECTOR=MN1.IDSECTOR
INNER JOIN MUNINEP MN2 ON SUBSTR(FT.CLVFUN,1,12) = MN2.CAMPO7 AND FT.IDSECTOR=MN2.IDSECTOR
INNER JOIN CATDGM CGM  ON SUBSTR(FT.CLVDEP,1,3) = CGM.CLAVE
INNER JOIN CATDAA CAA  ON SUBSTR(FT.CLVDEP,4,3) = CAA.CLAVE
INNER JOIN MIR MIR     ON SUBSTR(FT.CVEIND,1,8) = MIR.PROGRAMA AND SUBSTR(FT.CVEIND,9,2) = MIR.NIVEL AND SUBSTR(FT.CVEIND,11,4 ) = LPAD(MIR.CONSEC,4,'0')
WHERE FT.IDSECTOR=1
ORDER BY FT.CLVDEP, FT.CLVFUN , FT.CLVFIN, FT.CVETEMAS , FT.CVEIND]]></query>
