	<query language="SQL"><![CDATA[SELECT PA.CLAVE,
                        PA.PROGRAMA,
                        PA.PARTIDA,
                        PA.AUTO1_1 AUTO1,
                        PA.AUTO1_2 AUTO2,
                        PA.AUTO1_3 AUTO3,
				        PA.AUTO1_4 AUTO4,
				        PA.AUTO1_5 AUTO5,
				        PA.AUTO1_6 AUTO6,
				        PA.AUTO1_7 AUTO7,
				        PA.AUTO1_8 AUTO8,
				        PA.AUTO1_9 AUTO9,
				        PA.AUTO1_10 AUTO10,
				        PA.AUTO1_11 AUTO11,
				        PA.AUTO1_12 AUTO12,
				        PA.AUTO1_13 AUTO13
				      FROM PASO PA
				 WHERE PA.IDSECTOR                 = $P{idSector}
				    AND SUBSTR(PA.PROGRAMA, 13, 3) = SUBSTR($P{programa}, 1,3)
				 ORDER BY PA.CLAVE,
				          PA.PROGRAMA,
                          PA.PARTIDA]]></query>
