	<field name="REFPOL" class="java.lang.String"/>
	<field name="CONCEP" class="java.lang.String"/>
	<field name="CANPOL" class="java.math.BigDecimal"/>
	<field name="CANPOLH" class="java.math.BigDecimal"/>
	<field name="GRUPO" class="java.lang.String"/>
	<variable name="v_Mes" class="java.util.List">
		<expression><![CDATA[java.util.Arrays.asList("","ENERO","FEBRERO","MARZO","ABRIL","MAYO","JUNIO","JULIO","AGOSTO","SEPTIEMBRE","OCTUBRE","NOVIEMBRE","DICIEMBRE")]]></expression>
		<initialValueExpression><![CDATA[new java.util.ArrayList()]]></initialValueExpression>
	</variable>
	<variable name="v_SumDebe" resetType="Group" calculation="Sum" resetGroup="g_Encabezado" class="java.math.BigDecimal">
