	<dataset name="declaracioines" uuid="db8ac6ee-60e9-4978-9dd1-03a617295b37">
		<query language="sql"><![CDATA[]]></query>
	</dataset>
	<parameter name="idAdquisicion" class="java.lang.Long"/>
	<parameter name="firma3" forPrompting="false" class="java.awt.Image"/>
	<parameter name="nombreFirma3" class="java.lang.String"/>
	<parameter name="footerGem" class="java.lang.String"/>
	<query language="SQL"><![CDATA[SELECT MN.CAMPO7 AS PROGRAMA,
       CD.CLVDEP AS CLAVE,
       NG.CLVGAS AS PARTIDA,
       R.MONTO   AS AUTO1_1
  FROM TC_ADQUISICION_PROGRAMAS R
       LEFT JOIN MUNINEP MN ON R.ID_MUNINEP = MN.ID
       LEFT JOIN CATDEP  CD ON R.ID_CATDEP  = CD.ID
       LEFT JOIN NATGAS  NG ON R.ID_NATGAS  = NG.ID
 WHERE R.ID_ADQUISICION = $P!{idAdquisicion}
 ORDER BY CD.CLVDEP, MN.CAMPO7]]></query>
	<field name="PROGRAMA" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="PROGRAMA"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="PASO"/>
