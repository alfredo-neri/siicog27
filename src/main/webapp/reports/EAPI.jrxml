CI.CARGOS_3 CI_CARGO_3, 
CI.CARGOS_4 CI_CARGO_4, 
CI.CARGOS_5 CI_CARGO_5, 
CI.CARGOS_6 CI_CARGO_6, 
CI.CARGOS_7 CI_CARGO_7, 
CI.CARGOS_8 CI_CARGO_8, 
CI.CARGOS_9 CI_CARGO_9, 
CI.CARGOS_10 CI_CARGO_10, 
CI.CARGOS_11 CI_CARGO_11, 
CI.CARGOS_12 CI_CARGO_12, 
CI.ABONOS_1 CI_ABONO_1, 
CI.ABONOS_2 CI_ABONO_2, 
CI.ABONOS_3 CI_ABONO_3, 
CI.ABONOS_4 CI_ABONO_4, 
CI.ABONOS_5 CI_ABONO_5, 
CI.ABONOS_6 CI_ABONO_6, 
