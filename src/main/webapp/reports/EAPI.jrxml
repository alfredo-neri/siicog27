:($P{mes}==6)?
	$F{CU_ABONO_1}.add($F{CU_ABONO_2}).add($F{CU_ABONO_3}).add($F{CU_ABONO_4}).add($F{CU_ABONO_5}).add($F{CU_ABONO_6}).subtract($F{CU_CARGO_1}).subtract($F{CU_CARGO_2}).subtract($F{CU_CARGO_3}).subtract($F{CU_CARGO_4}).subtract($F{CU_CARGO_5}).subtract($F{CU_CARGO_6})
:($P{mes}==7)?
	$F{CU_ABONO_1}.add($F{CU_ABONO_2}).add($F{CU_ABONO_3}).add($F{CU_ABONO_4}).add($F{CU_ABONO_5}).add($F{CU_ABONO_6}).add($F{CU_ABONO_7}).subtract($F{CU_CARGO_1}).subtract($F{CU_CARGO_2}).subtract($F{CU_CARGO_3}).subtract($F{CU_CARGO_4}).subtract($F{CU_CARGO_5}).subtract($F{CU_CARGO_6}).subtract($F{CU_CARGO_7})
:($P{mes}==8)?
	$F{CU_ABONO_1}.add($F{CU_ABONO_2}).add($F{CU_ABONO_3}).add($F{CU_ABONO_4}).add($F{CU_ABONO_5}).add($F{CU_ABONO_6}).add($F{CU_ABONO_7}).add($F{CU_ABONO_8}).subtract($F{CU_CARGO_1}).subtract($F{CU_CARGO_2}).subtract($F{CU_CARGO_3}).subtract($F{CU_CARGO_4}).subtract($F{CU_CARGO_5}).subtract($F{CU_CARGO_6}).subtract($F{CU_CARGO_7}).subtract($F{CU_CARGO_8})
:($P{mes}==9)?
	$F{CU_ABONO_1}.add($F{CU_ABONO_2}).add($F{CU_ABONO_3}).add($F{CU_ABONO_4}).add($F{CU_ABONO_5}).add($F{CU_ABONO_6}).add($F{CU_ABONO_7}).add($F{CU_ABONO_8}).add($F{CU_ABONO_9}).subtract($F{CU_CARGO_1}).subtract($F{CU_CARGO_2}).subtract($F{CU_CARGO_3}).subtract($F{CU_CARGO_4}).subtract($F{CU_CARGO_5}).subtract($F{CU_CARGO_6}).subtract($F{CU_CARGO_7}).subtract($F{CU_CARGO_8}).subtract($F{CU_CARGO_9})
:($P{mes}==10)?
	$F{CU_ABONO_1}.add($F{CU_ABONO_2}).add($F{CU_ABONO_3}).add($F{CU_ABONO_4}).add($F{CU_ABONO_5}).add($F{CU_ABONO_6}).add($F{CU_ABONO_7}).add($F{CU_ABONO_8}).add($F{CU_ABONO_9}).add($F{CU_ABONO_10}).subtract($F{CU_CARGO_1}).subtract($F{CU_CARGO_2}).subtract($F{CU_CARGO_3}).subtract($F{CU_CARGO_4}).subtract($F{CU_CARGO_5}).subtract($F{CU_CARGO_6}).subtract($F{CU_CARGO_7}).subtract($F{CU_CARGO_8}).subtract($F{CU_CARGO_9}).subtract($F{CU_CARGO_10})
:($P{mes}==11)?
	$F{CU_ABONO_1}.add($F{CU_ABONO_2}).add($F{CU_ABONO_3}).add($F{CU_ABONO_4}).add($F{CU_ABONO_5}).add($F{CU_ABONO_6}).add($F{CU_ABONO_7}).add($F{CU_ABONO_8}).add($F{CU_ABONO_9}).add($F{CU_ABONO_10}).add($F{CU_ABONO_11}).subtract($F{CU_CARGO_1}).subtract($F{CU_CARGO_2}).subtract($F{CU_CARGO_3}).subtract($F{CU_CARGO_4}).subtract($F{CU_CARGO_5}).subtract($F{CU_CARGO_6}).subtract($F{CU_CARGO_7}).subtract($F{CU_CARGO_8}).subtract($F{CU_CARGO_9}).subtract($F{CU_CARGO_10}).subtract($F{CU_CARGO_11})
:($P{mes}==12)?
	$F{CU_ABONO_1}.add($F{CU_ABONO_2}).add($F{CU_ABONO_3}).add($F{CU_ABONO_4}).add($F{CU_ABONO_5}).add($F{CU_ABONO_6}).add($F{CU_ABONO_7}).add($F{CU_ABONO_8}).add($F{CU_ABONO_9}).add($F{CU_ABONO_10}).add($F{CU_ABONO_11}).add($F{CU_ABONO_12}).subtract($F{CU_CARGO_1}).subtract($F{CU_CARGO_2}).subtract($F{CU_CARGO_3}).subtract($F{CU_CARGO_4}).subtract($F{CU_CARGO_5}).subtract($F{CU_CARGO_6}).subtract($F{CU_CARGO_7}).subtract($F{CU_CARGO_8}).subtract($F{CU_CARGO_9}).subtract($F{CU_CARGO_10}).subtract($F{CU_CARGO_11}).subtract($F{CU_CARGO_12})
:BigDecimal.ZERO]]></expression>
	</variable>
	<variable name="V_PorEjec" class="java.math.BigDecimal">
		<expression><![CDATA[$V{V_Modificado}.subtract(($V{V_Recaudado}.add($V{V_Devengado})))]]></expression>
	</variable>
