CU.CARGOS_1 CU_CARGO_1, 
CU.CARGOS_2 CU_CARGO_2, 
CU.CARGOS_3 CU_CARGO_3, 
CU.CARGOS_4 CU_CARGO_4, 
CU.CARGOS_5 CU_CARGO_5, 
CU.CARGOS_6 CU_CARGO_6, 
CU.CARGOS_7 CU_CARGO_7, 
CU.CARGOS_8 CU_CARGO_8, 
CU.CARGOS_9 CU_CARGO_9, 
CU.CARGOS_10 CU_CARGO_10, 
CU.CARGOS_11 CU_CARGO_11, 
CU.CARGOS_12 CU_CARGO_12, 
CU.ABONOS_1 CU_ABONO_1, 
CU.ABONOS_2 CU_ABONO_2, 
CU.ABONOS_3 CU_ABONO_3, 
CU.ABONOS_4 CU_ABONO_4, 
CU.ABONOS_5 CU_ABONO_5, 
CU.ABONOS_6 CU_ABONO_6, 
CU.ABONOS_7 CU_ABONO_7, 
CU.ABONOS_8 CU_ABONO_8, 
CU.ABONOS_9 CU_ABONO_9, 
CU.ABONOS_10 CU_ABONO_10, 
CU.ABONOS_11 CU_ABONO_11, 
CU.ABONOS_12 CU_ABONO_12
FROM 
CUENTA AS DI
INNER JOIN CUENTA AS CI ON CI.CUENTA='8150' AND CI.SCTA=DI.SCTA AND CI.SSCTA=DI.SSCTA AND CI.SSSCTA=DI.SSSCTA AND CI.SSSSCTA=DI.SSSSCTA AND CI.IDSECTOR = DI.IDSECTOR
INNER JOIN CUENTA AS CU ON CU.CUENTA='8140' AND CU.SCTA=DI.SCTA AND CU.SSCTA=DI.SSCTA AND CU.SSSCTA=DI.SSSCTA AND CU.SSSSCTA=DI.SSSSCTA AND CU.IDSECTOR = DI.IDSECTOR
WHERE (DI.CUENTA='8110') AND DI.NOTCTA=0 AND DI.IDSECTOR= $P{sector} $P!{where}
ORDER BY DI.CUENTA,DI.SCTA, DI.SSCTA, DI.SSSCTA, DI.SSSSCTA]]></query>
