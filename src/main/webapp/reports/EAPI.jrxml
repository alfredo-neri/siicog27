	<variable name="V_Reduccion" class="java.math.BigDecimal">
		<expression><![CDATA[($P{mes}==1)?
	$F{DI_ABONO_1}
:($P{mes}==2)?
	($F{DI_ABONO_1}.add($F{DI_ABONO_2}))
:($P{mes}==3)?
	($F{DI_ABONO_1}.add($F{DI_ABONO_2}).add($F{DI_ABONO_3}))
:($P{mes}==4)?
	($F{DI_ABONO_1}.add($F{DI_ABONO_2}).add($F{DI_ABONO_3}).add($F{DI_ABONO_4}))
:($P{mes}==5)?
	($F{DI_ABONO_1}.add($F{DI_ABONO_2}).add($F{DI_ABONO_3}).add($F{DI_ABONO_4}).add($F{DI_ABONO_5}))
:($P{mes}==6)?
	($F{DI_ABONO_1}.add($F{DI_ABONO_2}).add($F{DI_ABONO_3}).add($F{DI_ABONO_4}).add($F{DI_ABONO_5}).add($F{DI_ABONO_6}))
:($P{mes}==7)?
	($F{DI_ABONO_1}.add($F{DI_ABONO_2}).add($F{DI_ABONO_3}).add($F{DI_ABONO_4}).add($F{DI_ABONO_5}).add($F{DI_ABONO_6}).add($F{DI_ABONO_7}))
:($P{mes}==8)?
	($F{DI_ABONO_1}.add($F{DI_ABONO_2}).add($F{DI_ABONO_3}).add($F{DI_ABONO_4}).add($F{DI_ABONO_5}).add($F{DI_ABONO_6}).add($F{DI_ABONO_7}).add($F{DI_ABONO_8}))
:($P{mes}==9)?
	($F{DI_ABONO_1}.add($F{DI_ABONO_2}).add($F{DI_ABONO_3}).add($F{DI_ABONO_4}).add($F{DI_ABONO_5}).add($F{DI_ABONO_6}).add($F{DI_ABONO_7}).add($F{DI_ABONO_8}).add($F{DI_ABONO_9}))
:($P{mes}==10)?
	($F{DI_ABONO_1}.add($F{DI_ABONO_2}).add($F{DI_ABONO_3}).add($F{DI_ABONO_4}).add($F{DI_ABONO_5}).add($F{DI_ABONO_6}).add($F{DI_ABONO_7}).add($F{DI_ABONO_8}).add($F{DI_ABONO_9}).add($F{DI_ABONO_10}))
:($P{mes}==11)?
	($F{DI_ABONO_1}.add($F{DI_ABONO_2}).add($F{DI_ABONO_3}).add($F{DI_ABONO_4}).add($F{DI_ABONO_5}).add($F{DI_ABONO_6}).add($F{DI_ABONO_7}).add($F{DI_ABONO_8}).add($F{DI_ABONO_9}).add($F{DI_ABONO_10}).add($F{DI_ABONO_11}))
:($P{mes}==12)?
	($F{DI_ABONO_1}.add($F{DI_ABONO_2}).add($F{DI_ABONO_3}).add($F{DI_ABONO_4}).add($F{DI_ABONO_5}).add($F{DI_ABONO_6}).add($F{DI_ABONO_7}).add($F{DI_ABONO_8}).add($F{DI_ABONO_9}).add($F{DI_ABONO_10}).add($F{DI_ABONO_11}).add($F{DI_ABONO_12}))
:BigDecimal.ZERO]]></expression>
	</variable>
	<variable name="V_Ampliacion" class="java.math.BigDecimal">
		<expression><![CDATA[($P{mes}==1)?
	$F{DI_CARGO_1}
:($P{mes}==2)?
	($F{DI_CARGO_1}.add($F{DI_CARGO_2}))
:($P{mes}==3)?
	($F{DI_CARGO_1}.add($F{DI_CARGO_2}).add($F{DI_CARGO_3}))
:($P{mes}==4)?
	($F{DI_CARGO_1}.add($F{DI_CARGO_2}).add($F{DI_CARGO_3}).add($F{DI_CARGO_4}))
:($P{mes}==5)?
	($F{DI_CARGO_1}.add($F{DI_CARGO_2}).add($F{DI_CARGO_3}).add($F{DI_CARGO_4}).add($F{DI_CARGO_5}))
:($P{mes}==6)?
	($F{DI_CARGO_1}.add($F{DI_CARGO_2}).add($F{DI_CARGO_3}).add($F{DI_CARGO_4}).add($F{DI_CARGO_5}).add($F{DI_CARGO_6}))
:($P{mes}==7)?
	($F{DI_CARGO_1}.add($F{DI_CARGO_2}).add($F{DI_CARGO_3}).add($F{DI_CARGO_4}).add($F{DI_CARGO_5}).add($F{DI_CARGO_6}).add($F{DI_CARGO_7}))
:($P{mes}==8)?
	($F{DI_CARGO_1}.add($F{DI_CARGO_2}).add($F{DI_CARGO_3}).add($F{DI_CARGO_4}).add($F{DI_CARGO_5}).add($F{DI_CARGO_6}).add($F{DI_CARGO_7}).add($F{DI_CARGO_8}))
:($P{mes}==9)?
	($F{DI_CARGO_1}.add($F{DI_CARGO_2}).add($F{DI_CARGO_3}).add($F{DI_CARGO_4}).add($F{DI_CARGO_5}).add($F{DI_CARGO_6}).add($F{DI_CARGO_7}).add($F{DI_CARGO_8}).add($F{DI_CARGO_9}))
:($P{mes}==10)?
	($F{DI_CARGO_1}.add($F{DI_CARGO_2}).add($F{DI_CARGO_3}).add($F{DI_CARGO_4}).add($F{DI_CARGO_5}).add($F{DI_CARGO_6}).add($F{DI_CARGO_7}).add($F{DI_CARGO_8}).add($F{DI_CARGO_9}).add($F{DI_CARGO_10}))
:($P{mes}==11)?
	($F{DI_CARGO_1}.add($F{DI_CARGO_2}).add($F{DI_CARGO_3}).add($F{DI_CARGO_4}).add($F{DI_CARGO_5}).add($F{DI_CARGO_6}).add($F{DI_CARGO_7}).add($F{DI_CARGO_8}).add($F{DI_CARGO_9}).add($F{DI_CARGO_10}).add($F{DI_CARGO_11}))
:($P{mes}==12)?
	($F{DI_CARGO_1}.add($F{DI_CARGO_2}).add($F{DI_CARGO_3}).add($F{DI_CARGO_4}).add($F{DI_CARGO_5}).add($F{DI_CARGO_6}).add($F{DI_CARGO_7}).add($F{DI_CARGO_8}).add($F{DI_CARGO_9}).add($F{DI_CARGO_10}).add($F{DI_CARGO_11}).add($F{DI_CARGO_12}))
:BigDecimal.ZERO]]></expression>
	</variable>
	<variable name="V_Modificado" class="java.math.BigDecimal">
		<expression><![CDATA[$F{DI_SALINI}.add($V{V_Ampliacion}).subtract($V{V_Reduccion})]]></expression>
	</variable>
	<variable name="V_Recaudado" class="java.math.BigDecimal">
		<expression><![CDATA[($P{mes}==1)?
	$F{CI_ABONO_1}.subtract($F{CI_CARGO_1})
:($P{mes}==2)?
	$F{CI_ABONO_1}.add($F{CI_ABONO_2}).subtract($F{CI_CARGO_1}).subtract($F{CI_CARGO_2})
:($P{mes}==3)?
	$F{CI_ABONO_1}.add($F{CI_ABONO_2}).add($F{CI_ABONO_3}).subtract($F{CI_CARGO_1}).subtract($F{CI_CARGO_2}).subtract($F{CI_CARGO_3})
:($P{mes}==4)?
	$F{CI_ABONO_1}.add($F{CI_ABONO_2}).add($F{CI_ABONO_3}).add($F{CI_ABONO_4}).subtract($F{CI_CARGO_1}).subtract($F{CI_CARGO_2}).subtract($F{CI_CARGO_3}).subtract($F{CI_CARGO_4})
:($P{mes}==5)?
	$F{CI_ABONO_1}.add($F{CI_ABONO_2}).add($F{CI_ABONO_3}).add($F{CI_ABONO_4}).add($F{CI_ABONO_5}).subtract($F{CI_CARGO_1}).subtract($F{CI_CARGO_2}).subtract($F{CI_CARGO_3}).subtract($F{CI_CARGO_4}).subtract($F{CI_CARGO_5})
:($P{mes}==6)?
	$F{CI_ABONO_1}.add($F{CI_ABONO_2}).add($F{CI_ABONO_3}).add($F{CI_ABONO_4}).add($F{CI_ABONO_5}).add($F{CI_ABONO_6}).subtract($F{CI_CARGO_1}).subtract($F{CI_CARGO_2}).subtract($F{CI_CARGO_3}).subtract($F{CI_CARGO_4}).subtract($F{CI_CARGO_5}).subtract($F{CI_CARGO_6})
:($P{mes}==7)?
	$F{CI_ABONO_1}.add($F{CI_ABONO_2}).add($F{CI_ABONO_3}).add($F{CI_ABONO_4}).add($F{CI_ABONO_5}).add($F{CI_ABONO_6}).add($F{CI_ABONO_7}).subtract($F{CI_CARGO_1}).subtract($F{CI_CARGO_2}).subtract($F{CI_CARGO_3}).subtract($F{CI_CARGO_4}).subtract($F{CI_CARGO_5}).subtract($F{CI_CARGO_6}).subtract($F{CI_CARGO_7})
:($P{mes}==8)?
	$F{CI_ABONO_1}.add($F{CI_ABONO_2}).add($F{CI_ABONO_3}).add($F{CI_ABONO_4}).add($F{CI_ABONO_5}).add($F{CI_ABONO_6}).add($F{CI_ABONO_7}).add($F{CI_ABONO_8}).subtract($F{CI_CARGO_1}).subtract($F{CI_CARGO_2}).subtract($F{CI_CARGO_3}).subtract($F{CI_CARGO_4}).subtract($F{CI_CARGO_5}).subtract($F{CI_CARGO_6}).subtract($F{CI_CARGO_7}).subtract($F{CI_CARGO_8})
:($P{mes}==9)?
	$F{CI_ABONO_1}.add($F{CI_ABONO_2}).add($F{CI_ABONO_3}).add($F{CI_ABONO_4}).add($F{CI_ABONO_5}).add($F{CI_ABONO_6}).add($F{CI_ABONO_7}).add($F{CI_ABONO_8}).add($F{CI_ABONO_9}).subtract($F{CI_CARGO_1}).subtract($F{CI_CARGO_2}).subtract($F{CI_CARGO_3}).subtract($F{CI_CARGO_4}).subtract($F{CI_CARGO_5}).subtract($F{CI_CARGO_6}).subtract($F{CI_CARGO_7}).subtract($F{CI_CARGO_8}).subtract($F{CI_CARGO_9})
:($P{mes}==10)?
	$F{CI_ABONO_1}.add($F{CI_ABONO_2}).add($F{CI_ABONO_3}).add($F{CI_ABONO_4}).add($F{CI_ABONO_5}).add($F{CI_ABONO_6}).add($F{CI_ABONO_7}).add($F{CI_ABONO_8}).add($F{CI_ABONO_9}).add($F{CI_ABONO_10}).subtract($F{CI_CARGO_1}).subtract($F{CI_CARGO_2}).subtract($F{CI_CARGO_3}).subtract($F{CI_CARGO_4}).subtract($F{CI_CARGO_5}).subtract($F{CI_CARGO_6}).subtract($F{CI_CARGO_7}).subtract($F{CI_CARGO_8}).subtract($F{CI_CARGO_9}).subtract($F{CI_CARGO_10})
:($P{mes}==11)?
	$F{CI_ABONO_1}.add($F{CI_ABONO_2}).add($F{CI_ABONO_3}).add($F{CI_ABONO_4}).add($F{CI_ABONO_5}).add($F{CI_ABONO_6}).add($F{CI_ABONO_7}).add($F{CI_ABONO_8}).add($F{CI_ABONO_9}).add($F{CI_ABONO_10}).add($F{CI_ABONO_11}).subtract($F{CI_CARGO_1}).subtract($F{CI_CARGO_2}).subtract($F{CI_CARGO_3}).subtract($F{CI_CARGO_4}).subtract($F{CI_CARGO_5}).subtract($F{CI_CARGO_6}).subtract($F{CI_CARGO_7}).subtract($F{CI_CARGO_8}).subtract($F{CI_CARGO_9}).subtract($F{CI_CARGO_10}).subtract($F{CI_CARGO_11})
:($P{mes}==12)?
	$F{CI_ABONO_1}.add($F{CI_ABONO_2}).add($F{CI_ABONO_3}).add($F{CI_ABONO_4}).add($F{CI_ABONO_5}).add($F{CI_ABONO_6}).add($F{CI_ABONO_7}).add($F{CI_ABONO_8}).add($F{CI_ABONO_9}).add($F{CI_ABONO_10}).add($F{CI_ABONO_11}).add($F{CI_ABONO_12}).subtract($F{CI_CARGO_1}).subtract($F{CI_CARGO_2}).subtract($F{CI_CARGO_3}).subtract($F{CI_CARGO_4}).subtract($F{CI_CARGO_5}).subtract($F{CI_CARGO_6}).subtract($F{CI_CARGO_7}).subtract($F{CI_CARGO_8}).subtract($F{CI_CARGO_9}).subtract($F{CI_CARGO_10}).subtract($F{CI_CARGO_11}).subtract($F{CI_CARGO_12})
:BigDecimal.ZERO]]></expression>
	</variable>
	<variable name="V_Devengado" class="java.math.BigDecimal">
		<expression><![CDATA[($P{mes}==1)?
	$F{CU_ABONO_1}.subtract($F{CU_CARGO_1})
:($P{mes}==2)?
	$F{CU_ABONO_1}.add($F{CU_ABONO_2}).subtract($F{CU_CARGO_1}).subtract($F{CU_CARGO_2})
:($P{mes}==3)?
	$F{CU_ABONO_1}.add($F{CU_ABONO_2}).add($F{CU_ABONO_3}).subtract($F{CU_CARGO_1}).subtract($F{CU_CARGO_2}).subtract($F{CU_CARGO_3})
:($P{mes}==4)?
	$F{CU_ABONO_1}.add($F{CU_ABONO_2}).add($F{CU_ABONO_3}).add($F{CU_ABONO_4}).subtract($F{CU_CARGO_1}).subtract($F{CU_CARGO_2}).subtract($F{CU_CARGO_3}).subtract($F{CU_CARGO_4})
:($P{mes}==5)?
