	<query language="sql"><![CDATA[SELECT 
DECODE(DI.IDSECTOR,1,CI.CUENTA,DI.CUENTA) DI_CUENTA, 
SUBSTR(DI.SCTA,10) DI_SCTA, 
SUBSTR(DI.SSCTA,17) DI_SSCTA,
SUBSTR(DI.SSSCTA,3) DI_SSSCTA,
SUBSTR(DI.SSSSCTA,2) DI_SSSSCTA,
SUBSTR(DI.NOMCTA,1,100) DI_NOMCTA, 
DI.SALINI DI_SALINI,
DI.CARGOS_1 DI_CARGO_1, 
