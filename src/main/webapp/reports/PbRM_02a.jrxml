		<element kind="textField" uuid="d22eb31c-61de-4c75-b903-7a391421e20f" x="700" y="60" width="52" height="10" stretchType="NoStretch" fontName="Arial" fontSize="8.0" evaluationTime="Report" hTextAlign="Left">
			<expression><![CDATA[" de " + $V{PAGE_NUMBER}]]></expression>
		</element>
		<element kind="textField" uuid="d9230b12-745b-4beb-b668-bfa8f16cbb15" x="627" y="30" width="125" height="30" stretchType="NoStretch" fontName="Arial" fontSize="8.0" evaluationTime="Report" bold="false" blankWhenNull="true" hTextAlign="Center">
			<property name="com.jaspersoft.studio.unit.height" value="px"/>
			<property name="com.jaspersoft.studio.unit.y" value="px"/>
			<printWhenExpression><![CDATA[$P{noFirmas} >= 3]]></printWhenExpression>
			<expression><![CDATA[$P{noFirmas}==3 ? $P{firmaN3}  : $P{noFirmas}==4 ? $P{firmaN4}  : $P{firmaN5}]]></expression>
		</element>
		<element kind="textField" uuid="06fb48f0-7722-4aeb-b683-59b230f0eeee" x="475" y="30" width="125" height="30" stretchType="NoStretch" fontName="Arial" fontSize="8.0" evaluationTime="Report" bold="false" blankWhenNull="true" hTextAlign="Center">
			<property name="com.jaspersoft.studio.unit.height" value="px"/>
			<property name="com.jaspersoft.studio.unit.y" value="px"/>
			<printWhenExpression><![CDATA[$P{noFirmas}==2 ||  $P{noFirmas} == 4 || $P{noFirmas} == 5]]></printWhenExpression>
			<expression><![CDATA[$P{noFirmas}==2 ? $P{firmaN2}  : $P{noFirmas}==4 ? $P{firmaN3}  : $P{firmaN4}]]></expression>
		</element>
		<element kind="textField" uuid="d59ff13d-6f8d-4ea1-9e49-9fc5d6ad398a" x="627" y="0" width="125" height="30" stretchType="NoStretch" fontName="Arial" fontSize="8.0" evaluationTime="Report" bold="false" blankWhenNull="true" hTextAlign="Center">
			<property name="com.jaspersoft.studio.unit.height" value="px"/>
			<property name="com.jaspersoft.studio.unit.width" value="px"/>
			<printWhenExpression><![CDATA[$P{noFirmas} >= 3]]></printWhenExpression>
			<box>
				<bottomPen lineWidth="1.0"/>
			</box>
			<expression><![CDATA[$P{noFirmas}==3 ? $P{firmaL3}  : $P{noFirmas}==4 ? $P{firmaL4}  : $P{firmaL5}]]></expression>
		</element>
		<element kind="textField" uuid="6a144d4c-5048-49f2-b480-a7afab182777" x="475" y="0" width="125" height="30" stretchType="NoStretch" fontName="Arial" fontSize="8.0" evaluationTime="Report" bold="false" blankWhenNull="true" hTextAlign="Center">
			<property name="com.jaspersoft.studio.unit.height" value="px"/>
			<printWhenExpression><![CDATA[$P{noFirmas}==2 ||  $P{noFirmas} == 4 || $P{noFirmas} == 5]]></printWhenExpression>
			<box>
				<bottomPen lineWidth="1.0"/>
			</box>
			<expression><![CDATA[$P{noFirmas}==2 ? $P{firmaL2}  : $P{noFirmas}==4 ? $P{firmaL3}  : $P{firmaL4}]]></expression>
		</element>
		<element kind="textField" uuid="8ac685f8-91c4-4afd-a2d0-be4339d3a135" x="325" y="0" width="125" height="30" stretchType="NoStretch" fontName="Arial" fontSize="8.0" evaluationTime="Report" bold="false" blankWhenNull="true" hTextAlign="Center">
			<property name="com.jaspersoft.studio.unit.height" value="px"/>
			<printWhenExpression><![CDATA[$P{noFirmas} ==1 || $P{noFirmas} == 3 ||  $P{noFirmas} == 5]]></printWhenExpression>
			<box>
				<bottomPen lineWidth="1.0"/>
			</box>
			<expression><![CDATA[$P{noFirmas}==1 ? $P{firmaL1} : $P{noFirmas}==3 ? $P{firmaL2} :   $P{noFirmas}==5 ? $P{firmaL3} : ""]]></expression>
		</element>
		<element kind="textField" uuid="581c69d1-0891-4524-b5c5-c814305b1537" x="0" y="30" width="125" height="30" stretchType="NoStretch" fontName="Arial" fontSize="8.0" evaluationTime="Report" bold="false" blankWhenNull="true" hTextAlign="Center">
			<property name="com.jaspersoft.studio.unit.height" value="px"/>
			<property name="com.jaspersoft.studio.unit.y" value="px"/>
			<printWhenExpression><![CDATA[$P{noFirmas} >= 3]]></printWhenExpression>
			<expression><![CDATA[$P{firmaN1}]]></expression>
		</element>
		<element kind="textField" uuid="eb04b380-35a9-4797-81a8-a9d119ad25c3" x="155" y="0" width="125" height="30" stretchType="NoStretch" fontName="Arial" fontSize="8.0" evaluationTime="Report" bold="false" blankWhenNull="true" hTextAlign="Center">
			<property name="com.jaspersoft.studio.unit.height" value="px"/>
			<printWhenExpression><![CDATA[$P{noFirmas}==2 ||  $P{noFirmas} == 4 || $P{noFirmas} == 5]]></printWhenExpression>
			<box>
				<bottomPen lineWidth="1.0"/>
			</box>
			<expression><![CDATA[$P{noFirmas} == 2 ? $P{firmaL1} :$P{firmaL2}]]></expression>
		</element>
		<element kind="textField" uuid="21cbd68d-b175-48ce-a7bf-827dd7e80a81" x="0" y="0" width="125" height="30" stretchType="ElementGroupHeight" fontName="Arial" fontSize="8.0" evaluationTime="Report" bold="false" blankWhenNull="true" hTextAlign="Center">
			<property name="com.jaspersoft.studio.unit.height" value="px"/>
			<printWhenExpression><![CDATA[$P{noFirmas} >= 3]]></printWhenExpression>
			<box>
				<bottomPen lineWidth="1.0"/>
			</box>
			<expression><![CDATA[$P{firmaL1}]]></expression>
		</element>
		<element kind="textField" uuid="5670b6c0-181f-4921-9cbb-fc9cbbe92d74" x="325" y="30" width="125" height="30" stretchType="NoStretch" fontName="Arial" fontSize="8.0" evaluationTime="Report" bold="false" blankWhenNull="true" hTextAlign="Center">
			<property name="com.jaspersoft.studio.unit.height" value="px"/>
			<property name="com.jaspersoft.studio.unit.y" value="px"/>
			<printWhenExpression><![CDATA[$P{noFirmas} ==1 || $P{noFirmas} == 3 ||  $P{noFirmas} == 5]]></printWhenExpression>
			<expression><![CDATA[$P{noFirmas}==1 ? $P{firmaN1} : $P{noFirmas}==3 ? $P{firmaN2} :   $P{noFirmas}==5 ? $P{firmaN3} : ""]]></expression>
		</element>
		<element kind="textField" uuid="48b58d00-6022-44aa-8325-2dec5cffb5ea" x="155" y="30" width="125" height="30" stretchType="NoStretch" fontName="Arial" fontSize="8.0" evaluationTime="Report" bold="false" blankWhenNull="true" hTextAlign="Center">
			<property name="com.jaspersoft.studio.unit.height" value="px"/>
			<property name="com.jaspersoft.studio.unit.y" value="px"/>
			<printWhenExpression><![CDATA[$P{noFirmas}==2 ||  $P{noFirmas} == 4 || $P{noFirmas} == 5]]></printWhenExpression>
			<expression><![CDATA[$P{noFirmas} == 2 ? $P{firmaN1} :$P{firmaN2}]]></expression>
