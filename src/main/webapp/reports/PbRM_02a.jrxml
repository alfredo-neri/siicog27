<jasperReport name="PbRM_02a" language="java" columnCount="1" dpi="72" pageWidth="792" pageHeight="612" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="752" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="94e93bb9-a566-4a8d-85a9-d4f5bcd8e22c">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="gem21"/>
	<property name="net.sf.jasperreports.print.create.bookmarks" value="false"/>
	<parameter name="year" class="java.lang.Integer"/>
	<parameter name="municipioName" class="java.lang.String"/>
	<parameter name="municipioClave" class="java.lang.String"/>
	<parameter name="pathImage1" class="java.lang.String"/>
	<parameter name="pathImage2" class="java.lang.String"/>
	<parameter name="idSector" class="java.lang.Integer"/>
	<parameter name="noFirmas" class="java.lang.Integer"/>
	<parameter name="firmaL1" class="java.lang.String"/>
	<parameter name="firmaN1" class="java.lang.String"/>
	<parameter name="firmaL2" class="java.lang.String"/>
	<parameter name="firmaN2" class="java.lang.String"/>
	<parameter name="firmaL3" class="java.lang.String"/>
	<parameter name="firmaN3" class="java.lang.String"/>
	<parameter name="firmaL4" class="java.lang.String"/>
	<parameter name="firmaN4" class="java.lang.String"/>
	<parameter name="firmaL5" class="java.lang.String"/>
	<parameter name="firmaN5" class="java.lang.String"/>
	<query language="SQL"><![CDATA[SELECT	CAP.CLVDEP||CAP.CLVNEP GRUPO,
				SUBSTR(CAP.CLVNEP,1,10) PROGRAMA,
				MUN.CAMPO6 NOMBRE_PROGRAMA,
				SUBSTR(CAP.CLVNEP,11,2) PROYECTO,
				MU2.CAMPO6 NOMBRE_PROYECTO,
				SUBSTR(CAP.CLVDEP,1,3) DEP_GENERAL,
				CGM.NOMBRE NOMBRE_DEP_GENERAL,
				SUBSTR(CAP.CLVDEP,4,3) DEP_AUXILIAR,
				DAA.NOMBRE NOMBRE_DEP_AUXILIAR,
				MET.CLVMET,
				MET.NOM_IND,
				MET.UNI_MED,
				MET.CAN_METI,
				MET.CAN_METIC_1 METIC1,
				MET.CAN_METIC_2 METIC2,
				MET.CAN_METIC_3 METIC3,
				MET.CAN_METIC_4 METIC4
			FROM PP_CAPP CAP,
						 PP_METT MET,
						 MUNINEP MUN,
						 MUNINEP MU2,
						 CATDGM  CGM,
						 CATDAA  DAA
WHERE	CAP.IDSECTOR = MET.IDSECTOR
	AND CAP.IDSECTOR = MUN.IDSECTOR
	AND CAP.IDSECTOR = MU2.IDSECTOR
	AND CAP.CLVDEP   = MET.CLVDEP
	AND CAP.CLVNEP   = MET.CLVNEP
	AND SUBSTR(CAP.CLVNEP,1,10) = MUN.CAMPO7
	AND CAP.CLVNEP	= MU2.CAMPO7
	AND SUBSTR(CAP.CLVDEP,1,3)  = CGM.CLAVE
	AND SUBSTR(CAP.CLVDEP,4,3)  = DAA.CLAVE
	AND CAP.IDSECTOR = $P{idSector}
ORDER BY GRUPO, CLVMET]]></query>
