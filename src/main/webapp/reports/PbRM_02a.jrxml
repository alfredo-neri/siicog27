	</variable>
	<variable name="trim4porc" class="java.lang.Double">
		<expression><![CDATA[$F{CAN_METI}.doubleValue() == 0.00  ? 0.00 :  ($F{METIC4}.doubleValue() / $F{CAN_METI}.doubleValue()) * 100]]></expression>
	</variable>
