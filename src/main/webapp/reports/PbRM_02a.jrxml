	<variable name="trim1porc" class="java.lang.Double">
		<expression><![CDATA[$F{CAN_METI}.doubleValue() == 0.00  ? 0.00 :  ($F{METIC1}.doubleValue() / $F{CAN_METI}.doubleValue()) * 100]]></expression>
	</variable>
	<variable name="trim2porc" class="java.lang.Double">
		<expression><![CDATA[$F{CAN_METI}.doubleValue() == 0.00  ? 0.00 :  ($F{METIC2}.doubleValue() / $F{CAN_METI}.doubleValue()) * 100]]></expression>
	</variable>
	<variable name="trim3porc" class="java.lang.Double">
