	<subDataset name="DatasetFlujos" uuid="f42ff153-2e36-4b7d-ab9e-40e47d827d93">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="gem21"/>
		<parameter name="p_IdSector" class="java.lang.Integer"/>
		<parameter name="p_TipPol" class="java.lang.String"/>
		<parameter name="p_Mes" class="java.lang.Integer"/>
		<parameter name="p_ConPol" class="java.lang.Integer"/>
		<parameter name="p_RenPol" class="java.math.BigDecimal"/>
		<parameter name="decimalFormat" class="java.lang.String"/>
		<parameter name="pesos" class="java.lang.Integer"/>
		<queryString language="SQL">
			<![CDATA[SELECT 
PF.TIPPOL,
PF.CONPOL,
PF.MESPOL,
PF.RENPOL,
PF.CLVFLU,
PF.CANFLU
FROM POLIFL PF
WHERE PF.IDSECTOR= $P{p_IdSector}
AND PF.TIPPOL=$P{p_TipPol}
AND PF.MESPOL=$P{p_Mes}
AND PF.CONPOL=$P{p_ConPol}
AND PF.RENPOL=$P{p_RenPol}]]>
		</queryString>
		<field name="TIPPOL" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="TIPPOL"/>
			<property name="com.jaspersoft.studio.field.label" value="TIPPOL"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="POLIFL"/>
		</field>
		<field name="CONPOL" class="java.lang.Integer">
			<property name="com.jaspersoft.studio.field.name" value="CONPOL"/>
			<property name="com.jaspersoft.studio.field.label" value="CONPOL"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="POLIFL"/>
		</field>
		<field name="MESPOL" class="java.lang.Integer">
			<property name="com.jaspersoft.studio.field.name" value="MESPOL"/>
			<property name="com.jaspersoft.studio.field.label" value="MESPOL"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="POLIFL"/>
		</field>
		<field name="RENPOL" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="RENPOL"/>
			<property name="com.jaspersoft.studio.field.label" value="RENPOL"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="POLIFL"/>
		</field>
		<field name="CLVFLU" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="CLVFLU"/>
			<property name="com.jaspersoft.studio.field.label" value="CLVFLU"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="POLIFL"/>
		</field>
		<field name="CANFLU" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="CANFLU"/>
			<property name="com.jaspersoft.studio.field.label" value="CANFLU"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="POLIFL"/>
		</field>
	</subDataset>
	<subDataset name="DatasetResumen" uuid="023de289-0af3-42e3-bc07-2250dc916996">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="gem21"/>
		<parameter name="sector" class="java.lang.Integer"/>
		<parameter name="decimalFormat" class="java.lang.String"/>
		<parameter name="pesos" class="java.lang.Integer"/>
		<queryString language="SQL">
			<![CDATA[SELECT C.TIPPOL,
       C.TIPNOM,
       COUNT (P.ID) CUANTAS,
      SUM(NVL(P.CDEBE,0)) DEBE,
       SUM(NVL(P.CHABER,0))HABER 
    FROM CATTPO C
LEFT JOIN POLIEN P ON P.TIPPOL=C.TIPPOL 
			AND P.IDSECTOR= $P{sector}
  GROUP BY C.TIPPOL,
         C.TIPNOM]]>
		</queryString>
		<field name="TIPPOL" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="TIPPOL"/>
			<property name="com.jaspersoft.studio.field.label" value="TIPPOL"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="CATTPO"/>
		</field>
		<field name="TIPNOM" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="TIPNOM"/>
			<property name="com.jaspersoft.studio.field.label" value="TIPNOM"/>
			<property name="com.jaspersoft.studio.field.tree.path" value="CATTPO"/>
		</field>
		<field name="CUANTAS" class="java.lang.Integer">
			<property name="com.jaspersoft.studio.field.name" value="CUANTAS"/>
			<property name="com.jaspersoft.studio.field.label" value="CUANTAS"/>
		</field>
		<field name="DEBE" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="DEBE"/>
			<property name="com.jaspersoft.studio.field.label" value="DEBE"/>
		</field>
		<field name="HABER" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="HABER"/>
			<property name="com.jaspersoft.studio.field.label" value="HABER"/>
		</field>
		<variable name="v_SumNo" class="java.lang.Integer" calculation="Sum">
			<variableExpression><![CDATA[$F{CUANTAS}]]></variableExpression>
		</variable>
		<variable name="v_Debe" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{DEBE}]]></variableExpression>
		</variable>
		<variable name="v_Haber" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{HABER}]]></variableExpression>
		</variable>
	</subDataset>
	<parameter name="imagenPathLeft" class="java.lang.String"/>
