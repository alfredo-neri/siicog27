	<variable name="ANUAL_AUTO_TOTAL" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{AUTO_ANUAL}]]></expression>
	</variable>
	<variable name="MES_AUTO_TOTAL" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{AUTO_MES}]]></expression>
	</variable>
	<variable name="MONTO_TOTAL" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{MONTO}]]></expression>
	</variable>
	<variable name="RECAUDADO_P_TOTAL" class="java.math.BigDecimal">
		<expression><![CDATA[$V{MONTO_TOTAL}.compareTo(BigDecimal.ZERO) == 0 || $V{MES_AUTO_TOTAL}.compareTo(BigDecimal.ZERO) == 0?BigDecimal.ZERO:$V{MONTO_TOTAL}.divide($V{MES_AUTO_TOTAL},2,BigDecimal.ROUND_HALF_UP).multiply(new BigDecimal(100))]]></expression>
	</variable>
	<variable name="NO_RECAUDADO_P_TOTAL" class="java.math.BigDecimal">
		<expression><![CDATA[$V{NO_RECAUDADO_TOTAL}.compareTo(BigDecimal.ZERO) == 0 || $V{MES_AUTO_TOTAL} .compareTo(BigDecimal.ZERO) == 0?BigDecimal.ZERO:$V{NO_RECAUDADO_TOTAL}.divide($V{MES_AUTO_TOTAL},2,BigDecimal.ROUND_HALF_UP).multiply(new BigDecimal(100))]]></expression>
	</variable>
	<variable name="RECAUDADO_P" class="java.math.BigDecimal">
		<expression><![CDATA[$F{AUTO_MES}.compareTo(BigDecimal.ZERO) == 0 || $F{MONTO} .compareTo(BigDecimal.ZERO) == 0?BigDecimal.ZERO:
$F{MONTO}.divide( $F{AUTO_MES},2, RoundingMode.HALF_UP).multiply(new BigDecimal(100))]]></expression>
	</variable>
	<variable name="NO_RECAUDADO_P" class="java.math.BigDecimal">
		<expression><![CDATA[$F{AUTO_MES}.compareTo(BigDecimal.ZERO) == 0||$F{MONTO}.compareTo(BigDecimal.ZERO)==0?BigDecimal.ZERO:
$F{AUTO_MES}.subtract($F{MONTO}).divide($F{AUTO_MES},2, RoundingMode.HALF_UP).multiply(new BigDecimal(100))]]></expression>
	</variable>
	<variable name="NO_RECAUDADO_TOTAL" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{NO_RECAUDADO}]]></expression>
	</variable>
	<variable name="RECAUDADO_P_ANUAL" class="java.math.BigDecimal">
		<expression><![CDATA[$F{RECAUDAR_ANUAL}.compareTo(BigDecimal.ZERO) == 0||$F{AUTO_ANUAL}.compareTo(BigDecimal.ZERO) == 0? BigDecimal.ZERO:$F{RECAUDAR_ANUAL}.divide( $F{AUTO_ANUAL},2,BigDecimal.ROUND_HALF_UP).multiply(new BigDecimal(100))]]></expression>
	</variable>
	<variable name="RECAUDADO_ANUAL_TOTAL" calculation="Sum" class="java.math.BigDecimal">
