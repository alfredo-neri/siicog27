	<field name="AUTO1_12" class="java.math.BigDecimal"/>
	<field name="AUTO1_13" class="java.math.BigDecimal"/>
	<variable name="sumEnero" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[($F{PARTIDA}.substring(1).equals("000")?$F{AUTO1_1}:BigDecimal.ZERO)]]></expression>
	</variable>
	<variable name="sumFebrero" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[($F{PARTIDA}.substring(1).equals("000")?$F{AUTO1_2}:BigDecimal.ZERO)]]></expression>
	</variable>
	<variable name="sumMarzo" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[($F{PARTIDA}.substring(1).equals("000")?$F{AUTO1_3}:BigDecimal.ZERO)]]></expression>
	</variable>
	<variable name="sumAbril" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[($F{PARTIDA}.substring(1).equals("000")?$F{AUTO1_4}:BigDecimal.ZERO)]]></expression>
	</variable>
	<variable name="sumMayo" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[($F{PARTIDA}.substring(1).equals("000")?$F{AUTO1_5}:BigDecimal.ZERO)]]></expression>
	</variable>
	<variable name="sumJunio" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[($F{PARTIDA}.substring(1).equals("000")?$F{AUTO1_6}:BigDecimal.ZERO)]]></expression>
	</variable>
	<variable name="sumJulio" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[($F{PARTIDA}.substring(1).equals("000")?$F{AUTO1_7}:BigDecimal.ZERO)]]></expression>
	</variable>
	<variable name="sumAgosto" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[($F{PARTIDA}.substring(1).equals("000")?$F{AUTO1_8}:BigDecimal.ZERO)]]></expression>
	</variable>
	<variable name="sumSeptiembre" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[($F{PARTIDA}.substring(1).equals("000")?$F{AUTO1_9}:BigDecimal.ZERO)]]></expression>
	</variable>
	<variable name="sumOctubre" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[($F{PARTIDA}.substring(1).equals("000")?$F{AUTO1_10}:BigDecimal.ZERO)]]></expression>
	</variable>
	<variable name="sumNoviembre" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[($F{PARTIDA}.substring(1).equals("000")?$F{AUTO1_11}:BigDecimal.ZERO)]]></expression>
	</variable>
	<variable name="sumDiciembre" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[($F{PARTIDA}.substring(1).equals("000")?$F{AUTO1_12}:BigDecimal.ZERO)]]></expression>
	</variable>
	<variable name="sumTotal" class="java.math.BigDecimal">
		<expression><![CDATA[$V{sumEnero}.add($V{sumFebrero}).add($V{sumMarzo}).add($V{sumAbril}).add($V{sumMayo}).add($V{sumJunio}).add($V{sumJulio}).add($V{sumAgosto}).add($V{sumSeptiembre}).add($V{sumOctubre}).add($V{sumNoviembre}).add($V{sumDiciembre})]]></expression>
	</variable>
