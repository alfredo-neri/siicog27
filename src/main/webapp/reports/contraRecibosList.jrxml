<jasperReport name="contraReciboList" language="java" columnCount="1" dpi="72" pageWidth="1170" pageHeight="792" whenNoDataType="AllSectionsNoDetail" columnWidth="1130" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenResourceMissingType="Empty" uuid="475e29e8-cfa9-41ad-a2a1-8405560034ba">
