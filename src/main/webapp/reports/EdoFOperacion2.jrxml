<jasperReport name="EdoFOperacion" language="java" columnCount="1" dpi="72" pageWidth="612" pageHeight="792" whenNoDataType="AllSectionsNoDetail" columnWidth="612" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="775429a7-b53d-47ed-94f2-052dc4aa9584">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="GEM_LUNUX"/>
	<parameter name="pMes" class="java.lang.Integer"/>
	<parameter name="pIdsector" class="java.lang.Integer"/>
	<parameter name="pMesAnt" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[$P{pMes}-1]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[SELECT DECIMAL( CLVFLU, 24,2)CLVFLU ,NOMFLU, SUM(CANFLU_ANT) CANFLU_ANT, SUM(CANFLU_ACT) CANFLU_ACT  FROM (	
	SELECT	CF.CLVFLU, 
			PF.MESPOL, 
			CF.NOMFLU,
		CASE WHEN PF.MESPOL <=$P{pMesAnt} THEN SUM(ABS(PF.CANFLU)) ELSE 0 END CANFLU_ANT,
		CASE WHEN PF.MESPOL <=$P{pMes} THEN SUM(ABS(PF.CANFLU)) ELSE 0 END CANFLU_ACT
		FROM POLIFL PF
			LEFT JOIN CATFLU CF ON PF.IDSECTOR=CF.IDSECTOR  AND PF.CLVFLU = CF.CLVFLU
	WHERE	PF.MESPOL<=$P{pMes} 
		AND CF.IDSECTOR=1
		AND CF.CLVFLU < 25.00
	GROUP BY CF.CLVFLU,
	         CF.NOMFLU,
	         PF.MESPOL )T1
GROUP BY CLVFLU,NOMFLU]]></query>
	<field name="CLVFLU" class="java.math.BigDecimal"/>
	<field name="NOMFLU" class="java.lang.String"/>
	<field name="CANFLU_ANT" class="java.math.BigDecimal"/>
	<field name="CANFLU_ACT" class="java.math.BigDecimal"/>
	<variable name="vSumO" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[IF($F{CLVFLU}.doubleValue()<20,$F{CANFLU_ACT},0.00 )]]></expression>
	</variable>
	<variable name="vSumA" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[IF($F{CLVFLU}.doubleValue()>20,$F{CANFLU_ACT},0.00 )]]></expression>
	</variable>
	<variable name="vRestaActu" class="java.math.BigDecimal">
		<expression><![CDATA[$V{vSumO}.subtract($V{vSumA})]]></expression>
		<initialValueExpression><![CDATA[$V{vRestaActu}==null?new BigDecimal(0.00):$V{vRestaActu}]]></initialValueExpression>
	</variable>
	<variable name="vSumAnt" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[IF($F{CLVFLU}.doubleValue()<20,$F{CANFLU_ANT},new BigDecimal(0.00))]]></expression>
	</variable>
	<variable name="vSumAntA" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[IF($F{CLVFLU}.doubleValue()>20,$F{CANFLU_ANT},new BigDecimal(0.00))]]></expression>
	</variable>
	<variable name="vRestaAct" class="java.math.BigDecimal">
		<expression><![CDATA[$V{vSumAnt}.subtract($V{vSumAntA})]]></expression>
		<initialValueExpression><![CDATA[$V{vRestaAct}==null?new BigDecimal(0.00):$V{vRestaAct}]]></initialValueExpression>
	</variable>
	<group name="GroupoOrigen">
		<expression><![CDATA[$F{CLVFLU}.doubleValue()<20]]></expression>
