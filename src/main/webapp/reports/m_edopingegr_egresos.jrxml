			</element>
			<element kind="textField" uuid="1f847d61-be6f-4f1f-ac68-eae86be1d129" x="66" y="0" width="214" height="10" positionType="Float" stretchType="NoStretch" printWhenGroupChanges="CUENTA" fontName="Arial" fontSize="6.0" hTextAlign="Left" vTextAlign="Middle">
