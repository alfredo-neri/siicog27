				</box>
				<expression><![CDATA[IF($F{GRUPO}.equals("1000")," SERVICIOS PERSONALES",IF($F{GRUPO}.equals("2000")," MATERIALES Y SUMINISTROS",IF($F{GRUPO}.equals("3000")," SERVICIOS GENERALES",IF($F{GRUPO}.equals("4000")," TRANSFERENCIAS",IF($F{GRUPO}.equals("5000")," MUEBLES E INMUEBLES",IF($F{GRUPO}.equals("6000")," INVERSION PUBLICA",IF($F{GRUPO}.equals("7000")," INVERSIONES FINANCIERAS",IF($F{GRUPO}.equals("8000")," PART. Y APORTACIONES",IF($F{GRUPO}.equals("9000")," DEUDA PUBLICA","")))))))))]]></expression>
