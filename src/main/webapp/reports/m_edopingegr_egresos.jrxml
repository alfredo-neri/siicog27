			<element kind="textField" uuid="c5c31488-2105-4185-b5cd-fa7dc70a532d" x="-20" y="0" width="86" height="10" positionType="Float" stretchType="NoStretch" fontName="Arial" fontSize="6.0" hTextAlign="Center" vTextAlign="Middle" style="Table_TD">
