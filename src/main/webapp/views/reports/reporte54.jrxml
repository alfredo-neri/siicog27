pm5511.mpv as "mpv",
pm5511.pmpv as "pmpv",
pm5511.subsp as "subsp",
pm5511.psubsp as "psubsp",
pm5511.aocr as "aocr",
pm5511.paocr as "paocr",
pm5511.podc as "podc",
pm5511.ppodc as "ppodc",
pm5511.subinf as "subinf",
pm5511.psubinf as "psubinf",
